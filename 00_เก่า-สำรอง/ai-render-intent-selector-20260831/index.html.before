function setLogoFloorPosition(x,z,spec=S){
  const physical=brandPhysicalSize(spec),base=logoBaseSize(spec),footprint=footprintSize({w:Math.max(physical.width,base.width),d:Math.max(spec.logoDepth,base.depth),h:physical.height},spec.logoFloorRotation);
  const halfX=footprint.w/2,halfZ=footprint.d/2;
  spec.logoFloorX=+clampNumber(placementValue(x),halfX,Math.max(halfX,spec.W-halfX)).toFixed(3);
  spec.logoFloorZ=+clampNumber(placementValue(z),halfZ,Math.max(halfZ,spec.D-halfZ)).toFixed(3);
}
function setLogoWallPosition(u,y,spec=S){
  const physical=brandPhysicalSize(spec),height=physical.height,length=logoWallLength(spec),halfW=Math.min(physical.width/2,length/2),halfH=height/2;
  spec.logoWallU=+clampNumber(placementValue(u),halfW,Math.max(halfW,length-halfW)).toFixed(3);
  spec.logoWallY=+clampNumber(placementValue(y),halfH,Math.max(halfH,spec.H-halfH)).toFixed(3);
}
function logoPlacementSummary(spec=S){
  const physical=brandPhysicalSize(spec),size='กว้าง '+physical.width.toFixed(2)+' × สูง '+physical.height.toFixed(2)+' × หนา '+spec.logoDepth.toFixed(2)+' ม.';
  if(spec.logoMount==='floor'){const base=logoBaseSize(spec);return 'ตั้งพื้น · '+size+' · ฐาน '+base.width.toFixed(2)+' × '+base.depth.toFixed(2)+' ม. · สีฐาน '+String(spec.logoBaseColor||'#20252d').toUpperCase()+' · สีโลโก้ '+String(spec.logoColor||spec.primary||'#2e7d4f').toUpperCase()+' · พิกัด X '+spec.logoFloorX.toFixed(2)+' ม. / Z '+spec.logoFloorZ.toFixed(2)+' ม. · หมุน '+spec.logoFloorRotation+'° · ขอบล่างของงานต้องตั้งบนฐาน ไม่ลอยจากพื้น · Snap '+placementStepLabel();}
  const wall=WALL_FACES.find(face=>face.k===spec.logoWall)?.n||spec.logoWall;
  return 'ติด'+wall+' · '+size+' · กึ่งกลางตามแนวผนัง '+spec.logoWallU.toFixed(2)+' ม. · ระดับกึ่งกลางสูง '+spec.logoWallY.toFixed(2)+' ม. · Snap '+placementStepLabel();
}
function footprintSize(size,rotationY=0){
  const rad=((rotationY%360)+360)%360*Math.PI/180,c=Math.abs(Math.cos(rad)),s=Math.abs(Math.sin(rad));
  return{w:size.w*c+size.d*s,d:size.w*s+size.d*c};
}
function placementShape(size,x,z,rotationY=0){
  const rad=((rotationY%360)+360)%360*Math.PI/180,c=Math.cos(rad),s=Math.sin(rad);
  const axes=[{x:c,z:-s},{x:s,z:c}],half=[size.w/2,size.d/2],corners=[];
  [-1,1].forEach(a=>[-1,1].forEach(b=>corners.push({x:x+axes[0].x*half[0]*a+axes[1].x*half[1]*b,
    z:z+axes[0].z*half[0]*a+axes[1].z*half[1]*b})));
  return{x,z,axes,half,corners};
}
function snapAnchorOffsets(size={w:0,d:0,h:0}){
  const w=Math.max(0,Number(size.w)||0),d=Math.max(0,Number(size.d)||0),h=Math.max(0,Number(size.h)||0),x=w/2,z=d/2;
  const horizontal=[
    ['back-left','corner',-x,-z],['back-right','corner',x,-z],['front-left','corner',-x,z],['front-right','corner',x,z],
    ['back-center','edge',0,-z],['front-center','edge',0,z],['left-center','edge',-x,0],['right-center','edge',x,0],['center','center',0,0]
  ];
  return[...horizontal.map(([id,kind,lx,lz])=>({id:'base-'+id,kind,level:'base',x:lx,y:0,z:lz})),
    ...horizontal.map(([id,kind,lx,lz])=>({id:'top-'+id,kind,level:'top',x:lx,y:h,z:lz}))];
}
function sceneObjectSnapAnchors(obj){
  if(!obj?.position||!obj?.size)return[];
  const angle=(Number(obj.rotationY)||0)*Math.PI/180,c=Math.cos(angle),s=Math.sin(angle),p=obj.position,size=sceneObjectOrientedSize(obj);
  return snapAnchorOffsets(size).map(anchor=>({...anchor,targetId:String(obj.id),position:{
    x:(Number(p.x)||0)+anchor.x*c+anchor.z*s,y:(Number(p.y)||0)+anchor.y,z:(Number(p.z)||0)-anchor.x*s+anchor.z*c}}));
}
function rectangularSnapAnchors(targetId,size,position={x:0,y:0,z:0},rotationY=0){
  return sceneObjectSnapAnchors({id:targetId,size,position,rotationY});
}
function boothSnapAnchors(spec=S,ignoreId=''){
  const anchors=rectangularSnapAnchors('booth-floor',{w:Number(spec.W)||0,d:Number(spec.D)||0,h:0},{x:(Number(spec.W)||0)/2,y:0,z:(Number(spec.D)||0)/2},0)
    .filter(anchor=>anchor.level==='base');
  if(hasStore()){
    const G=storeGeom(boothWallThickness(spec));anchors.push(...rectangularSnapAnchors('storage-room',{w:G.w,d:G.d,h:G.h},{x:G.x+G.w/2,y:0,z:G.y+G.d/2},0));
  }
  const platform=photo360PlatformLayout(spec);if(platform)anchors.push(...rectangularSnapAnchors('photo360-platform',
    {w:platform.diameter,d:platform.diameter,h:platform.height},{x:platform.x,y:0,z:platform.z},0));
  (spec.objects||[]).forEach(other=>{if(other?.id&&other.id!==ignoreId)anchors.push(...sceneObjectSnapAnchors(other));});
  return anchors;
}
function magneticSnapPlacement(obj,candidate,mode='plane',preferredSourceId='',spec=S){
  if(spec.magneticSnap===false||obj?.placement?.anchorSnap===false||mode==='surface')return null;
  const proxy={...obj,position:{...obj.position,...candidate}},threshold=Number(obj?.placement?.anchorSnapDistance)||MAGNETIC_SNAP_DISTANCE;
  let sources=sceneObjectSnapAnchors(proxy);if(preferredSourceId)sources=sources.filter(anchor=>anchor.id===preferredSourceId);
  const targets=boothSnapAnchors(spec,obj.id);let best=null;
  sources.forEach(source=>targets.forEach(target=>{
    if(source.kind!==target.kind)return;
    const dx=target.position.x-source.position.x,dy=target.position.y-source.position.y,dz=target.position.z-source.position.z;
    const planar=Math.hypot(dx,dz),distance=mode==='height'?Math.abs(dy):mode==='smart'?Math.hypot(dx,dy,dz):planar;
    if(mode==='plane'&&Math.abs(dy)>.06)return;
    if(mode==='height'&&planar>threshold)return;
    if(distance>threshold||best&&distance>=best.distance)return;
    best={distance,sourceAnchorId:source.id,targetId:target.targetId,targetAnchorId:target.id,kind:source.kind,
      position:{x:mode==='height'?candidate.x:candidate.x+dx,y:mode==='height'||mode==='smart'?candidate.y+dy:candidate.y,z:mode==='height'?candidate.z:candidate.z+dz},
      previewFrom:{...source.position},previewTo:{...target.position}};
  }));
  if(best){best.position.x=+best.position.x.toFixed(3);best.position.y=+best.position.y.toFixed(3);best.position.z=+best.position.z.toFixed(3);}
  return best;
}
function shapesOverlap(a,b,gap=0){
  return [...a.axes,...b.axes].every(axis=>{
    const distance=Math.abs((b.x-a.x)*axis.x+(b.z-a.z)*axis.z);
    const radiusA=a.half[0]*Math.abs(a.axes[0].x*axis.x+a.axes[0].z*axis.z)+
      a.half[1]*Math.abs(a.axes[1].x*axis.x+a.axes[1].z*axis.z);
    const radiusB=b.half[0]*Math.abs(b.axes[0].x*axis.x+b.axes[0].z*axis.z)+
      b.half[1]*Math.abs(b.axes[1].x*axis.x+b.axes[1].z*axis.z);
    return distance<radiusA+radiusB+gap-.0001;
  });
}
function sceneCollisionShapeDefinitions(obj,item=objectCatalogDef(obj?.catalogId)){
  const size=obj?.size||item?.size||{w:0,d:0,h:0};
  if(isEntranceFrameObject(obj)||isEntranceFrameItem(item)){
    const cfg=obj&&isEntranceFrameObject(obj)?normalizeEntranceFrameObject(obj).structure:{
      projection:Number(size.d)||2.4,height:Number(size.h)||2.4,pierWidth:Number(size.w)||1,thickness:.15};
    const pierHeight=Math.max(.05,cfg.height-cfg.thickness);
    return[
      {id:'canopy',type:'box',size:{w:cfg.pierWidth,d:cfg.projection,h:cfg.thickness},offset:{x:0,y:cfg.height-cfg.thickness/2,z:0}},
      {id:'front-pier',type:'box',size:{w:cfg.pierWidth,d:cfg.thickness,h:pierHeight},offset:{x:0,y:pierHeight/2,z:cfg.projection/2-cfg.thickness/2}}
    ];
  }
  const oriented=sceneObjectOrientedSize(obj,size);
  return[{id:'body',type:'box',size:{w:oriented.w,d:oriented.d,h:oriented.h},offset:{x:0,y:oriented.h/2,z:0}}];
}
function worldCollisionVolumes(item,size,x,z,rotationY=0,obj=null){
  const proxy=obj||{catalogId:item?.catalogId,type:item?.type,size,position:{x,y:0,z},rotationY},baseY=Number(proxy.position?.y)||0;
  proxy.size=size||proxy.size;const rad=((Number(rotationY)||0)%360)*Math.PI/180,c=Math.cos(rad),s=Math.sin(rad);
  return sceneCollisionShapeDefinitions(proxy,item).map(def=>{
    const ox=Number(def.offset?.x)||0,oz=Number(def.offset?.z)||0,oy=Number(def.offset?.y)||0;
    const cx=Number(x)+ox*c+oz*s,cz=Number(z)-ox*s+oz*c,h=Math.max(0,Number(def.size?.h)||0);
    return{id:def.id,shape:placementShape({w:Number(def.size?.w)||0,d:Number(def.size?.d)||0},cx,cz,rotationY),minY:baseY+oy-h/2,maxY:baseY+oy+h/2};
  });
}
function collisionVolumesOverlap(a,b,gap=0){
  const vertical=a.minY<b.maxY-.0001&&b.minY<a.maxY-.0001;
  return vertical&&shapesOverlap(a.shape,b.shape,gap);
}
/* Collision ของห้องต้องอ้างอิง "แผ่นผนังจริง" ไม่ใช่กล่องทึบเต็มห้อง
   เพื่อให้ Asset วางในช่องว่าง/ช่องประตู และนำโครงสร้างมาต่อกับห้องได้ */
function storageRoomCollisionVolumes(spec=S){
  if(!hasStore())return[];
  const panels=storagePanels(boothWallThickness(spec)),G=panels.G,t=STORAGE_ROOM_WALL_THICKNESS,volumes=[];
  const add=(id,w,d,x,z,minY=0,maxY=G.h)=>{
    if(w<=.008||d<=.008||maxY-minY<=.008)return;
    volumes.push({id,shape:placementShape({w,d},x,z,0),minY,maxY});
  };
  const addFace=face=>{
    const front=face==='front'||face==='back',length=front?G.w:G.d,doorFace=spec.stDoor===face;
    const z=face==='front'?G.y+G.d-t/2:G.y+t/2,x=face==='left'?G.x+t/2:G.x+G.w-t/2;
    if(!doorFace){
      if(front)add('storage-'+face,G.w,t,G.x+G.w/2,z);
      else add('storage-'+face,t,G.d,x,G.y+G.d/2);
      return;
    }
    const doorWidth=front?Math.min(.8,G.w*.62):Math.min(.8,G.d*.62),doorHeight=Math.min(2.05,G.h*.86),along=doorAlong(length,doorWidth);
    if(front){
      add('storage-'+face+'-before-door',along,t,G.x+along/2,z);
      const after=G.w-along-doorWidth;add('storage-'+face+'-after-door',after,t,G.x+along+doorWidth+after/2,z);
      add('storage-'+face+'-door-header',doorWidth,t,G.x+along+doorWidth/2,z,doorHeight,G.h);
    }else{
      add('storage-'+face+'-before-door',t,along,x,G.y+along/2);
      const after=G.d-along-doorWidth;add('storage-'+face+'-after-door',t,after,x,G.y+along+doorWidth+after/2);
      add('storage-'+face+'-door-header',t,doorWidth,x,G.y+along+doorWidth/2,doorHeight,G.h);
    }
  };
  addFace('front');
  if(panels.back)addFace('back');
  if(panels.left)addFace('left');
  if(panels.right)addFace('right');
  return volumes;
}
function storageRoomPlacementCollision(item,volumes,objectOverride=null,spec=S){
  if(item?.mount==='ceiling'||!hasStore())return null;
  const attached=objectOverride?.attachment?.targetId==='storage-room'||
    objectOverride?.placement?.anchorAttachment?.targetId==='storage-room'||
    (objectOverride?.placement?.mode==='surface'&&objectOverride.placement.targetId==='storage-room'),
    gap=attached?-(objectOverride?.collision?.tolerance||.002):(item?.clearance??.05);
  return storageRoomCollisionVolumes(spec).find(storeVolume=>
    volumes.some(volume=>collisionVolumesOverlap(volume,storeVolume,gap)))||null;
}
function storageRoomCollisionLabel(volume){
  const id=String(volume?.id||'');
  if(id.includes('front'))return'ผนังหน้าห้องเก็บของ';
  if(id.includes('back'))return'ผนังหลังห้องเก็บของ';
  if(id.includes('left'))return'ผนังซ้ายห้องเก็บของ';
  if(id.includes('right'))return'ผนังขวาห้องเก็บของ';
  return'ผนังห้องเก็บของ';
}
function snapVerticalElevation(obj,value,spec=S){
  const floorY=Number(spec.raise||0)/100,minY=-floorY,maxY=Math.max(10,(Number(spec.H)||2.4)*3),threshold=.11;
  let y=clampNumber(Number(value)||0,minY,maxY),surface=null,targetId=null;
  if(obj?.placement?.surfaceSnap===false)return{y,surface,targetId};
  const oriented=sceneObjectOrientedSize(obj),shape=placementShape(oriented,obj.position.x,obj.position.z,obj.rotationY||0),candidates=[{y:0,surface:'floor',targetId:'booth-floor'}];
  if(hasStore()){
    const G=storeGeom(boothWallThickness(spec)),storeShape=placementShape({w:G.w,d:G.d},G.x+G.w/2,G.y+G.d/2,0);
    if(shapesOverlap(shape,storeShape,-.001))candidates.push({y:G.h,surface:'top',targetId:'storage-room'});
  }
  const platform=photo360PlatformLayout(spec);if(platform){
    const platformShape=placementShape({w:platform.diameter,d:platform.diameter},platform.x,platform.z,0);
    if(shapesOverlap(shape,platformShape,-.001))candidates.push({y:platform.height,surface:'top',targetId:'photo360-platform'});
  }
  (spec.objects||[]).forEach(other=>{
    if(other.id===obj.id)return;const otherSize=sceneObjectOrientedSize(other),otherShape=placementShape(otherSize,other.position.x,other.position.z,other.rotationY||0);
    if(shapesOverlap(shape,otherShape,-.001))candidates.push({y:(Number(other.position?.y)||0)+otherSize.h,surface:'top',targetId:other.id});
  });
  const nearest=candidates.map(candidate=>({...candidate,distance:Math.abs(candidate.y-y)})).sort((a,b)=>a.distance-b.distance)[0];
  if(nearest&&nearest.distance<=threshold){y=nearest.y;surface=nearest.surface;targetId=nearest.targetId;}
  return{y:+(surface?y:placementValue(y)).toFixed(3),surface,targetId};
}
function sceneObjectAllowsOutsideBooth(item,obj=null){
  if(typeof obj?.placement?.allowOutsideBooth==='boolean')return obj.placement.allowOutsideBooth;
  if(typeof obj?.placement?.policy?.allowOutsideBooth==='boolean')return obj.placement.policy.allowOutsideBooth;
  return defaultScenePlacementPolicy(item).allowOutsideBooth;
}
function placementLimits(item,rotationY=0,sizeOverride=null){
  const footprint=footprintSize(sizeOverride||item.size,rotationY),walls=typ().walls,edge=item.clearance??.05,t=boothWallThickness(S),ceiling=item.mount==='ceiling';
  const edgeMinX=ceiling?edge:(walls.includes('left')?t:0)+edge,edgeMaxX=ceiling?S.W-edge:S.W-(walls.includes('right')?t:0)-edge;
  const backBoundary=ceiling?0:(walls.includes('back')?(isCurvedWallType(S)?t/2:t):0);
  const edgeMinZ=backBoundary+edge,edgeMaxZ=S.D-edge;
  const minX=edgeMinX+footprint.w/2,maxX=edgeMaxX-footprint.w/2;
  const minZ=edgeMinZ+footprint.d/2,maxZ=edgeMaxZ-footprint.d/2;
  return minX<=maxX&&minZ<=maxZ?{minX,maxX,minZ,maxZ,edgeMinX,edgeMaxX,edgeMinZ,edgeMaxZ,footprint}:null;
}
function isCatalogPlacementValid(catalogId,x,z,rotationY=0,ignoreId=null,sizeOverride=null,allowOverlap=ALLOW_ASSET_OVERLAP,objectOverride=null){
  const item=objectCatalogDef(catalogId),sourceSize=sizeOverride||item?.size,size=objectOverride?sceneObjectOrientedSize(objectOverride,sourceSize):sourceSize,
    limits=item&&placementLimits(item,rotationY,size),allowOutside=sceneObjectAllowsOutsideBooth(item,objectOverride);
  if(!item||!size||(!limits&&!allowOutside))return false;
  const epsilon=.0001,shape=placementShape(size,x,z,rotationY),volumes=worldCollisionVolumes(item,sourceSize,x,z,rotationY,objectOverride);
  if(!allowOutside&&shape.corners.some(corner=>corner.x<limits.edgeMinX-epsilon||corner.x>limits.edgeMaxX+epsilon||
    corner.z<limits.edgeMinZ-epsilon||corner.z>limits.edgeMaxZ+epsilon))return false;
  if(item.mount!=='ceiling'&&isCurvedWallType(S)&&typ().walls.includes('back')&&volumes.some(volume=>volume.minY<S.H&&volume.maxY>0)){
    const curve=wallCurveInfo(S),surfaceContact=objectOverride?.placement?.mode==='surface'&&String(objectOverride.placement.targetId||'').includes('booth-wall-back-curved'),
      clearance=surfaceContact?-(objectOverride.collision?.tolerance||.002):(item.clearance??.05),probes=[];
    [-1,0,1].forEach(a=>[-1,0,1].forEach(b=>probes.push({
      x:shape.x+shape.axes[0].x*shape.half[0]*a+shape.axes[1].x*shape.half[1]*b,
      z:shape.z+shape.axes[0].z*shape.half[0]*a+shape.axes[1].z*shape.half[1]*b
    })));
    const overlapsBoothWidth=shape.corners.some(point=>point.x>=-epsilon&&point.x<=S.W+epsilon)||
      (shape.x>=-epsilon&&shape.x<=S.W+epsilon);
    if(curve&&overlapsBoothWidth&&probes.some(point=>point.x>=-epsilon&&point.x<=S.W+epsilon&&
      point.z<curve.pointAtX(point.x).z+boothWallThickness(S)/2+clearance-epsilon))return false;
  }
  if(item.mount!=='ceiling'&&hasStore()){
    if(storageRoomPlacementCollision(item,volumes,objectOverride,S))return false;
  }
  const photoPlatform=photo360PlatformLayout(S);
  if(item.mount!=='ceiling'&&photoPlatform){
    const platformVolume={shape:placementShape({w:photoPlatform.diameter,d:photoPlatform.diameter},photoPlatform.x,photoPlatform.z,0),minY:0,maxY:photoPlatform.height};
    const onPlatform=objectOverride?.placement?.mode==='surface'&&objectOverride.placement.targetId==='photo360-platform';
    if(volumes.some(volume=>collisionVolumesOverlap(volume,platformVolume,onPlatform?-(objectOverride.collision?.tolerance||.002):(item.clearance??.05))))return false;
  }
  if(allowOverlap)return true;
  return !S.objects.some(other=>{
    if(other.id===ignoreId)return false;
    const otherItem=objectCatalogDef(other.catalogId),gap=Math.max(item.clearance??.05,otherItem?.clearance??.05);
    if((item.mount==='ceiling')!==(otherItem?.mount==='ceiling'))return false;
    const otherVolumes=worldCollisionVolumes(otherItem,other.size,other.position.x,other.position.z,other.rotationY||0,other);
    return volumes.some(volume=>otherVolumes.some(otherVolume=>collisionVolumesOverlap(volume,otherVolume,gap)));
  });
}
function findCatalogPlacement(catalogId,rotationY=0,preferred=null,sizeOverride=null){
  const item=objectCatalogDef(catalogId),limits=item&&placementLimits(item,rotationY,sizeOverride||item.size);if(!item||!limits)return null;
  const anchored=item.anchor==='back-right',backCenter=item.anchor==='back-center';
  const defaultZ=backCenter?clampNumber((typ().walls.includes('back')?boothWallThickness(S):0)+limits.footprint.d/2,limits.minZ,limits.maxZ):
    anchored?limits.minZ:Math.min(limits.maxZ,Math.max(limits.minZ,S.D-.55-limits.footprint.d/2));
  const startX=placementRound(clampNumber(preferred?.x??(anchored?limits.maxX:S.W/2),limits.minX,limits.maxX));
  const startZ=placementRound(clampNumber(preferred?.z??defaultZ,limits.minZ,limits.maxZ));
  const seen=new Set(),maxRadius=Math.ceil(Math.max(S.W,S.D)/PLACEMENT_GRID)+3;
  const tryOffset=(dx,dz)=>{
    const x=+placementRound(startX+dx*PLACEMENT_GRID).toFixed(3),z=+placementRound(startZ+dz*PLACEMENT_GRID).toFixed(3);
    const key=x+':'+z;if(seen.has(key)||x<limits.minX-.0001||x>limits.maxX+.0001||z<limits.minZ-.0001||z>limits.maxZ+.0001)return null;
    /* Assets may intentionally share the same footprint while the customer is
       assembling a layout.  Use the scene-wide overlap policy here too; the
       former hard-coded `false` made newly added/duplicated assets jump away. */
    seen.add(key);return isCatalogPlacementValid(catalogId,x,z,rotationY,null,sizeOverride,ALLOW_ASSET_OVERLAP)?{x,z}:null;
  };
  for(let radius=0;radius<=maxRadius;radius++){
    if(radius===0){const point=tryOffset(0,0);if(point)return point;continue;}
    for(let dx=-radius;dx<=radius;dx++){
      let point=tryOffset(dx,-radius);if(point)return point;
      point=tryOffset(dx,radius);if(point)return point;
    }
    for(let dz=-radius+1;dz<radius;dz++){
      let point=tryOffset(-radius,dz);if(point)return point;
      point=tryOffset(radius,dz);if(point)return point;
    }
  }
  return null;
}
function frontAssetStagingPlacement(size,rotationY=0){
  const footprint=footprintSize(size,rotationY),frontEdge=Number(S.D)||0,epsilon=.001;
  const staged=(S.objects||[]).map(object=>{
    const shape=placementShape(object.size,object.position.x,object.position.z,object.rotationY||0);
    return{minZ:Math.min(...shape.corners.map(point=>point.z)),maxX:Math.max(...shape.corners.map(point=>point.x))};
  }).filter(entry=>entry.minZ>=frontEdge-epsilon);
  const leftEdge=staged.length?Math.max(...staged.map(entry=>entry.maxX))+FRONT_ASSET_STAGING_GAP:0;
  return{x:+placementRound(leftEdge+footprint.w/2).toFixed(3),z:+placementRound(frontEdge+FRONT_ASSET_STAGING_GAP+footprint.d/2).toFixed(3)};
}
function announceCatalog(message,state){
  const text=(state==='success'?'✓ ':'! ')+message,box=document.getElementById('objectCatalogStatus');
  if(box){box.dataset.state=state;box.textContent=text;}
  if(document.getElementById('myAssetPane')&&!document.getElementById('myAssetPane').hidden)setMyAssetStatus(message,state);
  const global=document.getElementById('objectLayoutStatus'),catalogOpen=document.getElementById('dockCatalogPage')?.classList.contains('on');
  if(global)global.textContent=catalogOpen?'':text;
}
function setMyAssetStatus(message,state='success'){
  const box=document.getElementById('myAssetStatus');if(!box)return;
  if(!message){box.textContent='';delete box.dataset.state;return;}
  box.dataset.state=state;box.textContent=(state==='success'?'✓ ':'! ')+message;
}
function openMyAssetDb(){
  if(myAssetDbPromise)return myAssetDbPromise;
  if(!('indexedDB' in window))return Promise.reject(new Error('เบราว์เซอร์นี้ไม่รองรับ IndexedDB'));
  myAssetDbPromise=new Promise((resolve,reject)=>{
    const request=window.indexedDB.open(MY_ASSET_DB_NAME,1);
    request.onupgradeneeded=()=>{const db=request.result;if(!db.objectStoreNames.contains(MY_ASSET_STORE))db.createObjectStore(MY_ASSET_STORE,{keyPath:'id'});};
    request.onsuccess=()=>resolve(request.result);request.onerror=()=>reject(request.error||new Error('เปิดคลัง My Asset ไม่สำเร็จ'));
    request.onblocked=()=>reject(new Error('คลัง My Asset ถูกเปิดค้างจากหน้าต่างอื่น'));
  });
  return myAssetDbPromise;
}
function myAssetReadAll(){return openMyAssetDb().then(db=>new Promise((resolve,reject)=>{
  const request=db.transaction(MY_ASSET_STORE,'readonly').objectStore(MY_ASSET_STORE).getAll();
  request.onsuccess=()=>resolve(request.result||[]);request.onerror=()=>reject(request.error||new Error('อ่านคลัง My Asset ไม่สำเร็จ'));
}));}
function myAssetPut(record){return openMyAssetDb().then(db=>new Promise((resolve,reject)=>{
  const request=db.transaction(MY_ASSET_STORE,'readwrite').objectStore(MY_ASSET_STORE).put(record);
  request.onsuccess=()=>resolve(record);request.onerror=()=>reject(request.error||new Error('บันทึก My Asset ไม่สำเร็จ'));
}));}
function myAssetRemove(id){return openMyAssetDb().then(db=>new Promise((resolve,reject)=>{
  const request=db.transaction(MY_ASSET_STORE,'readwrite').objectStore(MY_ASSET_STORE).delete(id);
  request.onsuccess=()=>resolve();request.onerror=()=>reject(request.error||new Error('ลบ My Asset ไม่สำเร็จ'));
}));}
function customAssetId(){
  const random=globalThis.crypto?.randomUUID?crypto.randomUUID():Math.random().toString(36).slice(2);
  return 'my-asset-'+Date.now().toString(36)+'-'+random;
}
function formatMyAssetDimension(value){
  const number=Number(value);if(!Number.isFinite(number)||number<=0)return '';
  return number.toFixed(2);
}
function setMyAssetDimensions(size){
  [['myAssetW',size.w],['myAssetD',size.d],['myAssetH',size.h]].forEach(([id,value])=>{
    const input=document.getElementById(id);if(!input)return;
    input.value=formatMyAssetDimension(value);input.classList.add('auto-read');input.title='อ่านจากไฟล์ .glb อัตโนมัติ — แก้ไขเองได้';
  });
}
function readMyAssetInputMeters(){
  const meters={w:Number(document.getElementById('myAssetW')?.value),d:Number(document.getElementById('myAssetD')?.value),h:Number(document.getElementById('myAssetH')?.value)};
  return {meters};
}
function parseMyAssetGlb(loader,data){
  return new Promise((resolve,reject)=>loader.parse(data,'',resolve,error=>reject(error instanceof Error?error:new Error('อ่านโครงสร้างไฟล์ .glb ไม่สำเร็จ'))));
}
async function readMyAssetDimensions(file){
  if(!file)throw new Error('ยังไม่ได้เลือกไฟล์ .glb');
  const [THREE,gltfModule]=await Promise.all([import('three'),import('three/addons/loaders/GLTFLoader.js')]);
  const loader=new gltfModule.GLTFLoader(),buffer=await file.arrayBuffer(),gltf=await parseMyAssetGlb(loader,buffer);
  const root=gltf?.scene||gltf?.scenes?.[0];if(!root)throw new Error('ไม่พบโมเดลในไฟล์ .glb');
  root.updateMatrixWorld(true);
  const box=new THREE.Box3().setFromObject(root);if(box.isEmpty())throw new Error('ไฟล์ .glb ไม่มีขนาดที่อ่านได้');
  const size=box.getSize(new THREE.Vector3()),dimensions={w:size.x,d:size.z,h:size.y};
  if(![dimensions.w,dimensions.d,dimensions.h].every(value=>Number.isFinite(value)&&value>0))throw new Error('ขนาดในไฟล์ .glb ไม่ถูกต้อง');
  return dimensions;
}
function normalizeMyAsset(record){
  const size=record?.size||{};
  const w=Number(size.w)>0?Number(size.w):1,d=Number(size.d)>0?Number(size.d):1,h=Number(size.h)>0?Number(size.h):1;
  return furnitureItem({catalogId:record.id,category:'my',type:'custom',name:record.name||'My Asset',icon:'GLB',size:{w,d,h},unitPrice:0,color:'#8d939b',
    modelUrl:'custom',customAsset:true,file:record.file,createdAt:record.createdAt||0,
    placementPolicy:{preferredTarget:'floor',allowedTargets:['floor','wall','ceiling','storage-room','structure','asset','free'],requiresSurface:false,defaultSpawn:'front-staging',allowOutsideBooth:true},
    capabilities:['floorPlaceable','free3DPlaceable','surfaceSnappable','resizable','rotatable','styleable']});
}
function setAssetDropState(active){
  const view=document.getElementById('view');if(view)view.classList.toggle('asset-drop-target',Boolean(active));
}
function draggedMyAssetId(event){
  const transfer=event?.dataTransfer;if(!transfer)return '';
  return transfer.getData('application/x-yp-my-asset')||transfer.getData('text/plain')||'';
}
function bindMyAssetDrop(){
  const view=document.getElementById('view');if(!view||view.dataset.myAssetDropBound==='1')return;
  view.dataset.myAssetDropBound='1';
  view.addEventListener('dragover',event=>{
    const id=draggedMyAssetId(event);if(!id||!objectCatalogDef(id)?.customAsset)return;
    event.preventDefault();if(event.dataTransfer)event.dataTransfer.dropEffect='copy';setAssetDropState(true);
  });
  view.addEventListener('dragleave',event=>{
    if(!view.contains(event.relatedTarget))setAssetDropState(false);
  });
  view.addEventListener('drop',event=>{
    const id=draggedMyAssetId(event);if(!id||!objectCatalogDef(id)?.customAsset)return;
    event.preventDefault();setAssetDropState(false);
    if(S.view==='three'&&threeRenderer&&typeof threeRenderer.addCatalogObjectAtDrop==='function'){
      threeRenderer.addCatalogObjectAtDrop(id,event);return;
    }
    addCatalogObject(id);
  });
}
function renderMyAssetList(){
  const list=document.getElementById('myAssetList');if(!list)return;list.innerHTML='';
  if(!CUSTOM_ASSETS.length){list.innerHTML='<div class="my-asset-empty">ยังไม่มีไฟล์ใน My Asset<br>เลือกไฟล์ .glb ด้านบนเพื่อเพิ่มอุปกรณ์ของลูกค้า</div>';return;}
  CUSTOM_ASSETS.slice().sort((a,b)=>(b.createdAt||0)-(a.createdAt||0)).forEach(item=>{
    const card=el('div','my-asset-card'),icon=el('div','my-asset-icon','GLB'),info=el('div'),actions=el('div','my-asset-actions');
    card.draggable=true;card.dataset.catalogId=item.catalogId;card.title='คอมพิวเตอร์: ลาก '+item.name+' ไปวางบนพื้นในหรือนอกบูธ · มือถือ: กดเพิ่มเพื่อวางไว้ด้านหน้าบูธ';card.setAttribute('aria-label','ลาก '+item.name+' ไปวางบนพื้นในหรือนอกบูธ หรือกดเพิ่มเพื่อวางไว้ด้านหน้าบูธ');
    info.innerHTML='<b title="'+esc(item.name)+'">'+esc(item.name)+'</b><small>'+formatMyAssetDimension(item.size.w)+' × '+formatMyAssetDimension(item.size.d)+' × '+formatMyAssetDimension(item.size.h)+' ม. · GLB</small>';
    const add=el('button','btn sm','เพิ่ม');add.type='button';add.title='เพิ่ม '+item.name+' ไว้ด้านหน้าบูธ';add.onclick=()=>addCatalogObject(item.catalogId);
    const del=el('button','btn sm','ลบ');del.type='button';del.title='ลบ '+item.name+' จาก My Asset';del.onclick=()=>deleteMyAsset(item.catalogId);
    card.addEventListener('dragstart',event=>{
      if(event.dataTransfer){event.dataTransfer.setData('application/x-yp-my-asset',item.catalogId);event.dataTransfer.setData('text/plain',item.catalogId);event.dataTransfer.effectAllowed='copy';}
      card.classList.add('dragging');setAssetDropState(true);
    });
    card.addEventListener('dragend',()=>{card.classList.remove('dragging');setAssetDropState(false);});
    actions.append(add,del);card.append(icon,info,actions);list.appendChild(card);
  });
}
function setAssetTab(tab){
  const valid=['catalog','my','editor'].includes(tab)?tab:'catalog';
  document.querySelectorAll('[data-asset-tab]').forEach(button=>{
    const active=button.dataset.assetTab===valid;button.classList.toggle('on',active);button.setAttribute('aria-selected',String(active));
  });
  document.querySelectorAll('[data-asset-pane]').forEach(pane=>{pane.hidden=pane.dataset.assetPane!==valid;});
}
async function deleteMyAsset(id){
  const item=CUSTOM_ASSETS.find(asset=>asset.catalogId===id);if(!item)return;
  if(S.objects.some(object=>object.catalogId===id)){setMyAssetStatus('ลบไฟล์นี้ไม่ได้ เพราะมีวัตถุชิ้นนี้อยู่ในบูธแล้ว','error');return;}
  try{
    await myAssetRemove(id);CUSTOM_ASSETS.splice(CUSTOM_ASSETS.indexOf(item),1);
    const url=CUSTOM_ASSET_URLS.get(id);if(url)URL.revokeObjectURL(url);CUSTOM_ASSET_URLS.delete(id);
    renderMyAssetList();setMyAssetStatus('ลบ '+item.name+' แล้ว','success');
  }catch(error){setMyAssetStatus(error.message||'ลบ My Asset ไม่สำเร็จ','error');}
}
async function saveMyAsset(){
  let file=pendingMyAssetFile;if(!file){setMyAssetStatus('กรุณาเลือกไฟล์ .glb ก่อนบันทึก','error');return;}
  if(myAssetDimensionReadPromise){
    const readingFile=file;try{await myAssetDimensionReadPromise;}catch(error){}
    if(pendingMyAssetFile!==readingFile){setMyAssetStatus('มีการเลือกไฟล์ใหม่ กรุณารอให้ระบบอ่านขนาดไฟล์ล่าสุดก่อน','error');return;}
    file=pendingMyAssetFile;
  }
  if(!file.name.toLowerCase().endsWith('.glb')){setMyAssetStatus('รองรับเฉพาะไฟล์ .glb','error');return;}
  const name=(document.getElementById('myAssetName')?.value||file.name.replace(/\.glb$/i,'')).trim()||'My Asset';
  const inputDimensions=readMyAssetInputMeters(),size=inputDimensions.meters;
  if(![inputDimensions.meters.w,inputDimensions.meters.d,inputDimensions.meters.h].every(value=>Number.isFinite(value)&&value>0)){setMyAssetStatus('กรุณากรอกขนาด กว้าง ลึก สูง เป็นเมตรให้มากกว่า 0','error');return;}
  const record={id:customAssetId(),name,size,file,createdAt:Date.now()};
  try{
    await myAssetPut(record);CUSTOM_ASSETS.push(normalizeMyAsset(record));renderMyAssetList();
    pendingMyAssetFile=null;document.getElementById('myAssetFile').value='';document.getElementById('myAssetFileName').textContent='ยังไม่ได้เลือกไฟล์';
    document.getElementById('myAssetName').value='';setMyAssetStatus('บันทึก '+name+' ใน My Asset แล้ว','success');
  }catch(error){setMyAssetStatus(error.message||'บันทึก My Asset ไม่สำเร็จ','error');}
}
async function loadMyAssets(){
  try{
    const records=await myAssetReadAll();CUSTOM_ASSETS.splice(0,CUSTOM_ASSETS.length,...records.map(normalizeMyAsset));renderMyAssetList();sync();
  }catch(error){setMyAssetStatus(error.message||'เปิด My Asset ไม่สำเร็จ','error');}
}
const layoutSnapshot=()=>Object.fromEntries(LAYOUT_KEYS.map(key=>[key,S[key]]));
function plannedCatalogLayout(){
  const original=S.objects,planned=[];let possible=true;
  S.objects=planned;
  try{
    for(const object of original){
      const item=objectCatalogDef(object.catalogId);if(!item){possible=false;break;}
      if(isEntranceFrameObject(object))normalizeEntranceFrameObject(object);
      if(isDownlightBeamObject(object))normalizeDownlightBeamObject(object);
      normalizeSceneObjectModel(object,item);if(object.attachment?.targetId)resolveSceneAttachment(object,S);
      const valid=isCatalogPlacementValid(object.catalogId,object.position.x,object.position.z,object.rotationY||0,null,object.size,ALLOW_ASSET_OVERLAP,object);
      const position=valid?{x:object.position.x,z:object.position.z}:sceneAttachmentActive(object)?null:findCatalogPlacement(object.catalogId,object.rotationY||0,object.position,object.size);
      if(!position){possible=false;break;}
      planned.push({...object,position:{...object.position,x:position.x,z:position.z}});
    }
  }finally{S.objects=original;}
  return possible?planned:null;
}
function syncLayoutInputs(){
  syncDims();
  const values={stW:S.stW,stD:S.stD,stHv:S.stHv};
  Object.entries(values).forEach(([id,value])=>{const input=document.getElementById(id);if(input)input.value=value;});
}
function reconcileCatalogLayout(){
  const current=layoutSnapshot();
  if(!lastValidLayout){lastValidLayout=current;return true;}
  const planned=plannedCatalogLayout();
  if(!planned){
    Object.assign(S,lastValidLayout);syncLayoutInputs();
    announceCatalog('เปลี่ยนพื้นที่ไม่ได้ เพราะไม่มีตำแหน่งว่างเพียงพอสำหรับเฟอร์นิเจอร์เดิม','error');return false;
  }
  let moved=0;planned.forEach(next=>{const object=objectById(next.id);
    if(object&&(object.position.x!==next.position.x||object.position.z!==next.position.z)){
      object.position.x=next.position.x;object.position.z=next.position.z;moved++;}});
  lastValidLayout=current;
  if(moved)announceCatalog('ปรับตำแหน่งเฟอร์นิเจอร์ '+moved+' รายการให้พอดีกับพื้นที่ใหม่แล้ว','success');
  return true;
}
function recordObjectHistory(before){
  const after=objectSnapshot();if(before===after)return false;
  objectEditor.past.push(before);if(objectEditor.past.length>50)objectEditor.past.shift();
  objectEditor.future.length=0;return true;
}
function mutateObjects(change,selectedId){
  const before=objectSnapshot();change();recordObjectHistory(before);
  if(selectedId!==undefined)setObjectSelection(selectedId?[selectedId]:[],selectedId);
  sync();
}
function makeCatalogObject(catalogId,x,z){
  const item=objectCatalogDef(catalogId);if(!item)return null;
  const id='obj-'+Date.now().toString(36)+'-'+(++objectEditor.seq).toString(36);
  const object={id,type:item.type,catalogId:item.catalogId,locked:false,
    position:{x:Number.isFinite(x)?x:S.W/2,y:0,z:Number.isFinite(z)?z:S.D/2},
    rotationX:0,rotationY:item.initialRotation||0,rotationZ:0,orientation:'horizontal',size:{w:item.size.w,d:item.size.d,h:item.size.h},unitPrice:item.unitPrice};
  normalizeObjectAIRule(object,item);
  if(isEntranceFrameItem(item)){object.structure=entranceFrameDefaults(S);normalizeEntranceFrameObject(object);}
  if(isDownlightBeamItem(item)){object.structure=downlightBeamDefaults(S);normalizeDownlightBeamObject(object);}
  normalizeSceneObjectModel(object,item);
  return object;
}
function addCatalogObject(catalogId){
  const item=objectCatalogDef(catalogId);if(!item)return false;
  const rotationY=item.initialRotation||0,obj=makeCatalogObject(catalogId,0,S.D+1);if(!obj)return false;
  /* A catalogue click always creates a staging object in front of the booth.
     It must remain free-standing even when the catalogue default is attached. */
  if(isDownlightBeamObject(obj)){obj.structure.wallAttached=false;normalizeDownlightBeamObject(obj,S);}
  normalizeSceneObjectModel(obj,item);obj.attachment=null;obj.placement.mode='free';obj.placement.allowOutsideBooth=true;
  const position=frontAssetStagingPlacement(obj.size,rotationY);obj.position.x=position.x;obj.position.z=position.z;
  mutateObjects(()=>S.objects.push(obj),obj.id);
  const preferredUnavailable=item.backWallOnly&&(!typ().walls.includes('back')||isCurvedWallType(S));
  announceCatalog('เพิ่ม'+item.name+'และวางไว้ด้านหน้าบูธแล้ว'+(preferredUnavailable?' · บูธนี้ไม่มีผนังหลังแบบตรง จึงเริ่มเป็นวัตถุวางอิสระ':''),'success');return true;
}
function positionObjectToolbar(){
  const toolbar=document.getElementById('objectToolbar');if(!toolbar||matchMedia('(max-width:820px)').matches)return;
  const view=document.getElementById('view'),rect=view?.getBoundingClientRect(),pad=14,
    estimatedWidth=Math.min(toolbar.offsetWidth||620,window.innerWidth-pad*2),fallbackX=window.innerWidth/2,
    viewCenter=rect&&rect.width>0?(rect.left+rect.right)/2:fallbackX,
    x=clampNumber(viewCenter,pad+estimatedWidth/2,window.innerWidth-pad-estimatedWidth/2);
  toolbar.style.setProperty('--context-x',x+'px');toolbar.style.removeProperty('--context-y');toolbar.classList.remove('context-below');
}
function selectObject(id,options={}){
  logoEditor.selected=false;
  const obj=objectById(id),additive=options.additive===true||options.toggle===true||objectEditor.multiSelect===true;
  if(!obj)setObjectSelection([]);
  else{
    const unitIds=obj.groupId?groupObjectIds(obj.groupId):[obj.id];
    if(additive){
      const current=new Set(selectedSceneItemIds()),allSelected=unitIds.every(candidate=>current.has(candidate));
      unitIds.forEach(candidate=>allSelected?current.delete(candidate):current.add(candidate));
      setObjectSelection([...current],allSelected?(objectEditor.selectedId===id?[...current].at(-1):objectEditor.selectedId):id);
    }else setObjectSelection(unitIds,id);
  }
  syncObjectControls();if(threeRenderer)threeRenderer.setSceneSelection(selectedSceneItemIds(),objectEditor.selectedId);
  if(S.view==='plan')render();
}
function selectLogoPlacement(selected=true){
  logoEditor.selected=!!selected;
  if(logoEditor.selected)setObjectSelection(['system-brand'],'system-brand');
  else if(objectEditor.selectedId==='system-brand')setObjectSelection([]);
  syncObjectControls();
  if(threeRenderer)threeRenderer.setSceneSelection(selectedSceneItemIds(),objectEditor.selectedId);
  if(S.view==='plan')render();
}
function selectSceneItem(id,options={}){
  const item=sceneItemById(id);if(!item){setObjectSelection([]);logoEditor.selected=false;syncObjectControls();return;}
  if(item.object){selectObject(id,options);return;}
  const additive=options.additive===true||options.toggle===true||objectEditor.multiSelect===true,current=new Set(selectedSceneItemIds());
  if(additive){current.has(id)?current.delete(id):current.add(id);setObjectSelection([...current],current.has(id)?id:([...current].at(-1)||null));}
  else setObjectSelection([id],id);
  logoEditor.selected=objectEditor.selectedId==='system-brand';
  syncObjectControls();if(threeRenderer)threeRenderer.setSceneSelection(selectedSceneItemIds(),objectEditor.selectedId);
  if(S.view==='plan')render();
}
function systemSceneState(id){S.sceneItemState=S.sceneItemState&&typeof S.sceneItemState==='object'?S.sceneItemState:{};return S.sceneItemState[id]||(S.sceneItemState[id]={});}
function setSceneItemsVisibility(ids,visible){
  const targets=ids.map(sceneItemById).filter(Boolean);if(!targets.length)return;const before=objectSnapshot();
  targets.forEach(item=>{if(item.object)item.object.visible=visible;else systemSceneState(item.id).visible=visible;});
  recordObjectHistory(before);sync();announceCatalog((visible?'แสดง ':'ซ่อน ')+targets.length+' รายการแล้ว','success');
}
function setSceneItemsLocked(ids,locked){
  const targets=ids.map(sceneItemById).filter(item=>item?.object);if(!targets.length)return announceCatalog('โครงสร้างระบบถูกล็อกถาวรเพื่อป้องกันแบบเสียหาย','error');
  const before=objectSnapshot();targets.forEach(item=>item.object.locked=locked);recordObjectHistory(before);sync();announceCatalog((locked?'ล็อก ':'ปลดล็อก ')+targets.length+' รายการแล้ว','success');
}
function renameSelectedSceneItem(){
  const item=sceneItemById(objectEditor.selectedId);if(!item)return;const value=window.prompt('ตั้งชื่อ Asset',item.name);if(value===null)return;
  const name=String(value).trim().slice(0,60);if(!name||name===item.name)return;const before=objectSnapshot();
  if(item.object)item.object.label=name;else systemSceneState(item.id).name=name;recordObjectHistory(before);sync();
}
function deleteSceneSelection(){
  const items=selectedSceneItemIds().map(sceneItemById).filter(Boolean);if(!items.length)return;
  if(items.some(item=>item.system))return announceCatalog('พื้น ผนัง ห้อง และ Geometry หลักลบจาก Asset List ไม่ได้ แต่สามารถซ่อนได้','error');
  if(items.some(item=>item.locked))return announceCatalog('มี Asset ที่ล็อกอยู่ กรุณา Unlock ก่อนลบ','error');
  if(!window.confirm('ลบ Asset ที่เลือก '+items.length+' รายการ?'))return;
  const ids=new Set(items.map(item=>item.id));mutateObjects(()=>{S.objects=S.objects.filter(obj=>!ids.has(obj.id));},null);
}
function assetListFilteredItems(){
  const query=assetListUI.query.trim().toLocaleLowerCase('th'),selected=new Set(selectedSceneItemIds());let items=sceneItems();
  if(query)items=items.filter(item=>(item.name+' '+item.type).toLocaleLowerCase('th').includes(query));
  if(assetListUI.filter==='selected')items=items.filter(item=>selected.has(item.id));
  if(assetListUI.filter==='locked')items=items.filter(item=>item.locked);
  if(assetListUI.filter==='hidden')items=items.filter(item=>!item.visible);
  return items;
}
function renderAssetList(){
  const body=document.getElementById('assetListBody');if(!body)return;const items=assetListFilteredItems(),selected=new Set(selectedSceneItemIds());assetListUI.visibleIds=items.map(item=>item.id);
  if(!items.length)body.innerHTML='<div class="asset-list-empty">ไม่พบ Asset ตามคำค้นหาหรือตัวกรองนี้</div>';
  else body.innerHTML=ASSET_LIST_CATEGORIES.map(category=>{const rows=items.filter(item=>item.category===category.key);if(!rows.length)return'';
    return'<section class="asset-list-category"><div class="asset-list-category-title"><span>'+esc(category.label)+'</span><span>'+rows.length+'</span></div>'+rows.map(item=>{
      const thumb=item.thumb?'<img src="'+esc(item.thumb)+'" alt="">':esc(item.icon||'OBJ'),systemLabel=item.system?' · System':item.aiSuggested?' · ยังไม่เพิ่มใน Project':'';
      return'<div class="asset-list-row'+(selected.has(item.id)?' selected':'')+(item.visible?'':' hidden-item')+(item.aiSuggested?' ai-suggested':'')+'" data-scene-item="'+esc(item.id)+'" tabindex="0" role="option" aria-selected="'+selected.has(item.id)+'">'+
        '<input class="asset-list-check" type="checkbox" '+(selected.has(item.id)?'checked ':'')+'aria-label="เลือก '+esc(item.name)+'">'+
        '<span class="asset-list-thumb">'+thumb+'</span><span class="asset-list-copy"><span class="asset-list-name">'+esc(item.name)+'</span><span class="asset-list-type'+(item.system?' asset-list-system':'')+(item.aiSuggested?' asset-list-ai-status':'')+'">'+esc(item.type+systemLabel)+'</span></span>'+
        '<button class="asset-list-icon-btn" type="button" data-list-action="focus" title="Focus" aria-label="จัดกล้องไปที่ '+esc(item.name)+'" '+(item.aiSuggested?'disabled':'')+'>◎</button>'+
        '<button class="asset-list-icon-btn'+(item.visible?' on':'')+'" type="button" data-list-action="visibility" title="'+(item.visible?'ซ่อน':'แสดง')+'" aria-label="'+(item.visible?'ซ่อน ':'แสดง ')+esc(item.name)+'" '+(item.aiSuggested?'disabled':'')+'>'+(item.visible?'◉':'○')+'</button>'+
        '<button class="asset-list-icon-btn'+(item.locked?' on':'')+'" type="button" data-list-action="lock" title="'+(item.system?'System Lock':item.locked?'ปลดล็อก':'ล็อก')+'" aria-label="สถานะล็อก '+esc(item.name)+'" '+(item.system||item.aiSuggested?'disabled':'')+'>'+(item.locked?'▣':'▢')+'</button></div>';}).join('')+'</section>';}).join('');
  body.querySelectorAll('[data-scene-item]').forEach(row=>{
    const id=row.dataset.sceneItem;
    row.onclick=event=>{const action=event.target.closest('[data-list-action]')?.dataset.listAction,item=sceneItemById(id);if(!item)return;
      if(action==='focus'){event.stopPropagation();focusSceneItem(id);return;}
      if(action==='visibility'){event.stopPropagation();setSceneItemsVisibility([id],!item.visible);return;}
      if(action==='lock'){event.stopPropagation();if(!item.system)setSceneItemsLocked([id],!item.locked);return;}
      const checkbox=event.target.closest('.asset-list-check'),shift=event.shiftKey;
      if(shift&&assetListUI.anchorId){const list=assetListUI.visibleIds||[],a=list.indexOf(assetListUI.anchorId),b=list.indexOf(id);if(a>=0&&b>=0){const range=list.slice(Math.min(a,b),Math.max(a,b)+1),current=new Set((event.ctrlKey||event.metaKey)?selectedSceneItemIds():[]);range.forEach(candidate=>current.add(candidate));setObjectSelection([...current],id);logoEditor.selected=id==='system-brand';syncObjectControls();return;}}
      selectSceneItem(id,{additive:!!checkbox||event.ctrlKey||event.metaKey,toggle:!!checkbox||event.ctrlKey||event.metaKey});assetListUI.anchorId=id;};
    row.ondblclick=event=>{if(!event.target.closest('button,input'))focusSceneItem(id);};
    row.onkeydown=event=>{if(event.key==='Enter'||event.key===' '){event.preventDefault();selectSceneItem(id,{additive:event.ctrlKey||event.metaKey,toggle:event.ctrlKey||event.metaKey});}};
  });
  const chosen=selectedSceneItemIds().map(sceneItemById).filter(Boolean),objects=chosen.filter(item=>item.object),primary=sceneItemById(objectEditor.selectedId);
  const buttonState={assetListRename:!primary||primary.aiSuggested,assetListDuplicate:!primary?.object||primary.locked,assetListGroup:objects.length<2||objects.some(item=>item.locked),assetListUngroup:!objects.some(item=>item.object.groupId),assetListFocus:!primary||primary.aiSuggested,assetListLock:!objects.length,assetListVisibility:!chosen.length||chosen.some(item=>item.aiSuggested),assetListDelete:!objects.length||chosen.some(item=>item.system||item.locked||item.aiSuggested)};
  Object.entries(buttonState).forEach(([id,disabled])=>{const button=document.getElementById(id);if(button)button.disabled=disabled;});
  const lock=document.getElementById('assetListLock'),visibility=document.getElementById('assetListVisibility');if(lock)lock.textContent=objects.length&&objects.every(item=>item.locked)?'ปลดล็อก':'ล็อก';if(visibility)visibility.textContent=chosen.length&&chosen.every(item=>!item.visible)?'แสดง':'ซ่อน';
  if(assetListUI.open&&objectEditor.selectedId&&assetListUI.lastPrimary!==objectEditor.selectedId){assetListUI.lastPrimary=objectEditor.selectedId;requestAnimationFrame(()=>body.querySelector('[data-scene-item="'+CSS.escape(objectEditor.selectedId)+'"]')?.scrollIntoView({block:'nearest'}));}
}
function openAssetList(){
  if(!selectedSceneItemIds().length)return false;
  assetListUI.open=true;const panel=document.getElementById('assetListPanel'),button=document.getElementById('btnAssetList');
  if(panel){panel.hidden=false;panel.classList.add('open');panel.setAttribute('aria-hidden','false');}
  button?.setAttribute('aria-expanded','true');renderAssetList();requestAnimationFrame(()=>document.getElementById('assetListSearch')?.focus());return true;
}
function closeAssetList(returnFocus=true){
  assetListUI.open=false;const panel=document.getElementById('assetListPanel'),button=document.getElementById('btnAssetList');
  if(panel){panel.classList.remove('open');panel.setAttribute('aria-hidden','true');panel.hidden=true;}
  button?.setAttribute('aria-expanded','false');if(returnFocus&&!button?.hidden&&button?.offsetParent!==null)button.focus();
}
function resetAssetContextOpenState(){
  const advanced=document.getElementById('moveAdvanced');if(advanced?.open)advanced.open=false;
  closeAssetList(false);resetFinePositionDraft();
  if(document.getElementById('mAssetSettings')?.classList.contains('show'))closeAssetSettings();
}
function focusSceneItem(id){if(threeRenderer?.focusSceneItem)threeRenderer.focusSceneItem(id);}
function entranceFrameSide(obj){return Number(obj?.position?.x)<S.W/2?'left':'right';}
function moveEntranceFrameToSide(id,side){
  const obj=objectById(id),item=obj&&objectCatalogDef(obj.catalogId);if(!obj||!item||!isEntranceFrameObject(obj))return false;
  if(objectLocked(obj)){announceCatalog('Asset นี้ถูกล็อกอยู่ กรุณากด Unlock ก่อน','error');return false;}
  normalizeEntranceFrameObject(obj);const limits=placementLimits(item,0,obj.size);if(!limits)return false;
  const x=side==='left'?limits.minX:limits.maxX,z=limits.minZ;
  if(!isCatalogPlacementValid(obj.catalogId,x,z,0,obj.id,obj.size)){
    announceCatalog('ย้ายกรอบทางเข้าไม่ได้ เพราะอยู่นอกขอบเขตหรือชนโครงสร้างหลัก','error');return false;}
  const before=objectSnapshot();obj.attachment=null;normalizeSceneObjectModel(obj,item);obj.rotationY=0;obj.position.x=+placementRound(x).toFixed(3);obj.position.z=+placementRound(z).toFixed(3);
  recordObjectHistory(before);objectEditor.selectedId=obj.id;sync();announceCatalog('ย้ายกรอบทางเข้าไปด้าน'+(side==='left'?'ซ้าย':'ขวา')+'แล้ว','success');return true;
}
function setEntranceFrameAttachment(id,mode){
  const obj=objectById(id),item=obj&&objectCatalogDef(obj.catalogId);if(!obj||!item||!isEntranceFrameObject(obj))return false;
  if(objectLocked(obj)){announceCatalog('Asset นี้ถูกล็อกอยู่ กรุณากด Unlock ก่อน','error');return false;}
  const before=objectSnapshot(),previous=JSON.parse(JSON.stringify(obj));
  if(mode==='free'){
    obj.attachment=null;normalizeSceneObjectModel(obj,item);recordObjectHistory(before);objectEditor.selectedId=id;sync();
    announceCatalog('ปลดกรอบทางเข้าเป็นการวางอิสระแล้ว','success');return true;
  }
  if(!hasStore()){announceCatalog('ต้องสร้างห้องเก็บของก่อนจึงจะเชื่อมโครงสร้างได้','error');return false;}
  const onLeft=mode==='storage-left';
  obj.rotationY=0;obj.attachment={targetId:'storage-room',sourcePort:onLeft?'frame-right-front':'frame-left-front',
    targetPort:onLeft?'storage-left-front':'storage-right-front',syncDimensions:['depth'],offset:{x:0,y:0,z:0},status:'pending'};
  normalizeSceneObjectModel(obj,item);resolveSceneAttachment(obj,S);
  const limits=placementLimits(item,0,obj.size),valid=limits&&isCatalogPlacementValid(obj.catalogId,obj.position.x,obj.position.z,0,obj.id,obj.size,true,obj);
  if(!valid){Object.keys(obj).forEach(key=>delete obj[key]);Object.assign(obj,previous);
    announceCatalog('เชื่อมด้านนี้ไม่ได้ เพราะกรอบจะอยู่นอกขอบเขตบูธหรือชนโครงสร้าง','error');sync();return false;}
  recordObjectHistory(before);objectEditor.selectedId=id;sync();
  announceCatalog('เชื่อมกรอบทางเข้ากับ'+(onLeft?'ด้านซ้าย':'ด้านขวา')+'ของห้องเก็บของแล้ว','success');return true;
}
function updateEntranceFrameObject(id,key,value){
  const obj=objectById(id),item=obj&&objectCatalogDef(obj.catalogId);if(!obj||!item||!isEntranceFrameObject(obj))return;
  if(objectLocked(obj)){announceCatalog('Asset นี้ถูกล็อกอยู่ กรุณากด Unlock ก่อน','error');return;}
  if(key==='projection'&&sceneAttachmentActive(obj)){announceCatalog('ระยะยื่นกำลังตามความลึกห้องเก็บของ กรุณาปลดการเชื่อมก่อนแก้ไข','error');return;}
  const before=objectSnapshot(),previous={structure:{...obj.structure},size:{...obj.size},position:{...obj.position},rotationY:obj.rotationY};
  if(key==='color'){
    const color=String(value||'').trim();if(!/^#?[0-9a-fA-F]{6}$/.test(color))return;
    obj.structure.color=(color[0]==='#'?color:'#'+color).toLowerCase();
  }else{
    const numeric=Number(value);if(!Number.isFinite(numeric))return;obj.structure[key]=numeric;
  }
  normalizeEntranceFrameObject(obj);const limits=placementLimits(item,0,obj.size);
  if(!limits&&!sceneObjectAllowsOutsideBooth(item,obj)){Object.assign(obj,previous);announceCatalog('ขนาดกรอบทางเข้าใหญ่เกินพื้นที่บูธ','error');sync();return;}
  if(limits){
    obj.position.z=+placementRound(limits.minZ).toFixed(3);
    if(!sceneObjectAllowsOutsideBooth(item,obj))obj.position.x=+placementRound(clampNumber(obj.position.x,limits.minX,limits.maxX)).toFixed(3);
  }
  if(!isCatalogPlacementValid(obj.catalogId,obj.position.x,obj.position.z,0,obj.id,obj.size,ALLOW_ASSET_OVERLAP,obj)){
    const alternate=findCatalogPlacement(obj.catalogId,0,obj.position,obj.size);
    if(!alternate){obj.structure=previous.structure;obj.size=previous.size;obj.position=previous.position;obj.rotationY=previous.rotationY;
      announceCatalog('ปรับขนาดไม่ได้ เพราะชนโครงสร้างหลักหรือตำแหน่งไม่รองรับ','error');sync();return;}
    obj.position.x=alternate.x;obj.position.z=alternate.z;
  }
  recordObjectHistory(before);objectEditor.selectedId=id;sync();
}
function entranceFrameEditorMarkup(obj){
  const cfg=normalizeEntranceFrameObject(obj).structure,side=entranceFrameSide(obj),attachment=sceneAttachmentActive(obj)&&obj.attachment?.targetId==='storage-room'?obj.attachment:null,
    attachedLeft=attachment?.targetPort==='storage-left-front',attachedRight=attachment?.targetPort==='storage-right-front',row=(label,key,value,min,max,initial,disabled=false)=>
    '<div class="structure-editor-row"><label>'+label+'</label><input type="range" min="'+min+'" max="'+max+'" step="0.01" value="'+value.toFixed(2)+'" data-frame-range="'+key+'"'+(disabled?' disabled':'')+'>'+
    '<input type="number" min="'+min+'" max="'+max+'" step="0.01" value="'+value.toFixed(2)+'" data-frame-input="'+key+'" data-reset-default="'+initial+'" aria-label="'+label+'"'+(disabled?' disabled':'')+'><span class="unit">ม.</span></div>';
  return '<div class="structure-editor" data-frame-editor="'+esc(obj.id)+'">'+
    '<div class="structure-editor-actions"><button class="btn sm'+(side==='left'?' on':'')+'" type="button" data-frame-side="left">ชิดซ้าย</button><button class="btn sm'+(side==='right'?' on':'')+'" type="button" data-frame-side="right">ชิดขวา</button></div>'+
    '<label class="structure-editor-note">การเชื่อมโครงสร้าง</label><div class="structure-editor-actions"><button class="btn sm'+(!attachment?' on':'')+'" type="button" data-frame-attach="free">วางอิสระ</button>'+
    '<button class="btn sm'+(attachedLeft?' on':'')+'" type="button" data-frame-attach="storage-left"'+(!hasStore()?' disabled':'')+'>ต่อซ้ายของห้อง</button>'+
    '<button class="btn sm'+(attachedRight?' on':'')+'" type="button" data-frame-attach="storage-right"'+(!hasStore()?' disabled':'')+'>ต่อขวาของห้อง</button></div>'+
    row('ระยะยื่น','projection',cfg.projection,MIN_ASSET_DIMENSION,MAX_ASSET_DIMENSION,Math.min(2.4,S.D).toFixed(2),!!attachment)+
    row('ความสูง','height',cfg.height,MIN_ASSET_DIMENSION,MAX_ASSET_DIMENSION,Math.min(2.4,S.H).toFixed(2))+
    row('ความกว้างเสา','pierWidth',cfg.pierWidth,MIN_ASSET_DIMENSION,MAX_ASSET_DIMENSION,Math.min(1,S.W).toFixed(2))+
    row('ความหนาโครง','thickness',cfg.thickness,MIN_ASSET_DIMENSION,MAX_ASSET_DIMENSION,'0.15')+
    '<label class="structure-editor-note">สีผิวโครงสร้าง</label><div class="structure-editor-color"><input type="color" value="'+cfg.color+'" data-frame-color><input type="text" maxlength="7" value="'+cfg.color.toUpperCase()+'" data-frame-hex aria-label="รหัสสีกรอบทางเข้า"></div>'+
    '<div class="structure-editor-note">'+sceneAttachmentLabel(attachment)+' · '+(attachment?'ระยะยื่นตามความลึกห้องอัตโนมัติ':'ลากบนภาพเพื่อเลื่อนซ้าย–ขวา')+' · Snap '+placementStepLabel()+' · พื้นที่ผิวประมาณ '+entranceFrameArea(obj).toFixed(2)+' ตร.ม.</div></div>';
}
function bindEntranceFrameEditor(box,obj){
  box.querySelectorAll('[data-frame-range]').forEach(range=>{const key=range.dataset.frameRange,input=box.querySelector('[data-frame-input="'+key+'"]');
    range.oninput=()=>{if(input)input.value=range.value;};range.onchange=()=>updateEntranceFrameObject(obj.id,key,range.value);});
  box.querySelectorAll('[data-frame-input]').forEach(input=>{const key=input.dataset.frameInput,range=box.querySelector('[data-frame-range="'+key+'"]');
    input.oninput=()=>{if(range&&input.value!=='')range.value=input.value;};input.onchange=()=>updateEntranceFrameObject(obj.id,key,input.value);});
  box.querySelectorAll('[data-frame-side]').forEach(button=>button.onclick=()=>moveEntranceFrameToSide(obj.id,button.dataset.frameSide));
  box.querySelectorAll('[data-frame-attach]').forEach(button=>button.onclick=()=>setEntranceFrameAttachment(obj.id,button.dataset.frameAttach));
  const pick=box.querySelector('[data-frame-color]'),hex=box.querySelector('[data-frame-hex]');
  if(pick)pick.onchange=()=>updateEntranceFrameObject(obj.id,'color',pick.value);
  if(hex)hex.onchange=()=>updateEntranceFrameObject(obj.id,'color',hex.value);
}
function updateDownlightBeamObject(id,key,value){
  const obj=objectById(id),item=obj&&objectCatalogDef(obj.catalogId);if(!obj||!item||!isDownlightBeamObject(obj))return;
  if(objectLocked(obj)){announceCatalog('Asset นี้ถูกล็อกอยู่ กรุณากด Unlock ก่อน','error');return;}
  const before=objectSnapshot(),previous={structure:{...obj.structure},size:{...obj.size},position:{...obj.position},rotationY:obj.rotationY};
  if(key==='color'||key==='lightColor'){
    const color=String(value||'').trim();if(!/^#?[0-9a-fA-F]{6}$/.test(color))return;
    obj.structure[key]=(color[0]==='#'?color:'#'+color).toLowerCase();
  }else{
    const numeric=Number(value);if(!Number.isFinite(numeric))return;obj.structure[key]=numeric;
  }
  normalizeDownlightBeamObject(obj);const limits=placementLimits(item,obj.rotationY||0,obj.size);
  if(!limits){obj.structure=previous.structure;obj.size=previous.size;announceCatalog('ขนาดคานใหญ่เกินพื้นที่บูธในทิศทางที่เลือก','error');sync();return;}
  obj.position.x=+placementRound(clampNumber(obj.position.x,limits.minX,limits.maxX)).toFixed(3);
  obj.position.z=+placementRound(clampNumber(obj.position.z,limits.minZ,limits.maxZ)).toFixed(3);
  if(!isCatalogPlacementValid(obj.catalogId,obj.position.x,obj.position.z,obj.rotationY||0,obj.id,obj.size)){
    const alternate=findCatalogPlacement(obj.catalogId,obj.rotationY||0,obj.position,obj.size);
    if(!alternate){obj.structure=previous.structure;obj.size=previous.size;obj.position=previous.position;obj.rotationY=previous.rotationY;
      announceCatalog('ปรับขนาดไม่ได้ เพราะคานเกินขอบเขตหรือชนโครงสร้างหลัก','error');sync();return;}
    obj.position.x=alternate.x;obj.position.z=alternate.z;
  }
  recordObjectHistory(before);objectEditor.selectedId=id;sync();
}
function attachDownlightBeamToBackWall(id){
  const obj=objectById(id),item=obj&&objectCatalogDef(obj.catalogId);if(!obj||!item||!isDownlightBeamObject(obj))return;
  if(objectLocked(obj)){announceCatalog('Asset นี้ถูกล็อกอยู่ กรุณากด Unlock ก่อน','error');return;}
  const before=objectSnapshot(),previous={structure:{...obj.structure},position:{...obj.position},rotationY:obj.rotationY};
  obj.structure.wallAttached=true;obj.structure.height=S.H;obj.rotationY=0;obj.position.x=+placementRound(S.W/2).toFixed(3);normalizeDownlightBeamObject(obj);
  if(!isCatalogPlacementValid(obj.catalogId,obj.position.x,obj.position.z,0,obj.id,obj.size)){
    obj.structure=previous.structure;obj.position=previous.position;obj.rotationY=previous.rotationY;
    announceCatalog('ชิดคานกับผนังหลังไม่ได้ เพราะเกินขอบเขตหรือชนโครงสร้างหลัก','error');sync();return;
  }
  recordObjectHistory(before);objectEditor.selectedId=id;sync();announceCatalog('จัดคานชิดด้านหน้าผนังหลังและเสมอยอดผนังแล้ว','success');
}
function downlightBeamEditorMarkup(obj){
  const cfg=normalizeDownlightBeamObject(obj).structure;
  const row=(label,key,value,min,max,step,initial,unit='ม.')=>'<div class="structure-editor-row"><label>'+label+'</label><input type="range" min="'+min+'" max="'+max+'" step="'+step+'" value="'+value+'" data-beam-range="'+key+'">'+
    '<input type="number" min="'+min+'" max="'+max+'" step="'+step+'" value="'+value+'" data-beam-input="'+key+'" data-reset-default="'+initial+'" aria-label="'+label+'"><span class="unit">'+unit+'</span></div>';
  return '<div class="structure-editor" data-beam-editor="'+esc(obj.id)+'">'+
    row('ความยาวคาน','length',cfg.length.toFixed(2),.5,Math.max(.5,S.W),.05,Math.max(.5,S.W).toFixed(2))+
    row('ความลึกคาน','depth',cfg.depth.toFixed(2),MIN_ASSET_DIMENSION,MAX_ASSET_DIMENSION,.01,'0.30')+
    row('ความหนาคาน','thickness',cfg.thickness.toFixed(2),MIN_ASSET_DIMENSION,MAX_ASSET_DIMENSION,.01,'0.20')+
    row('ระดับติดตั้ง','height',cfg.height.toFixed(2),MIN_ASSET_DIMENSION,MAX_ASSET_DIMENSION,.01,Math.min(MAX_ASSET_DIMENSION,Math.max(.01,S.H)).toFixed(2))+
    row('จำนวนดาวน์ไลท์','lightCount',cfg.lightCount,1,12,1,'5','ดวง')+
    '<button class="btn sm'+(cfg.wallAttached?' on':'')+'" type="button" data-beam-attach>ชิดด้านหน้าผนังหลัง · เสมอยอดผนัง</button>'+
    '<div class="structure-editor-actions"><label>สีคาน<input type="color" value="'+cfg.color+'" data-beam-color="color"></label><label>สีแสง<input type="color" value="'+cfg.lightColor+'" data-beam-color="lightColor"></label></div>'+
    '<div class="structure-editor-note">ค่าเริ่มต้นให้ขอบหลังคานชนผิวหน้าผนังหลัง และขอบบนคานเสมอยอดผนัง · ดาวน์ไลท์กระจายระยะเท่ากัน พร้อมเว้นหัว–ท้ายเท่ากัน · ลากเพื่อย้ายคานออกจากผนังได้ · Snap '+placementStepLabel()+'</div></div>';
}
function bindDownlightBeamEditor(box,obj){
  box.querySelectorAll('[data-beam-range]').forEach(range=>{const key=range.dataset.beamRange,input=box.querySelector('[data-beam-input="'+key+'"]');
    range.oninput=()=>{if(input)input.value=range.value;};range.onchange=()=>updateDownlightBeamObject(obj.id,key,range.value);});
  box.querySelectorAll('[data-beam-input]').forEach(input=>{const key=input.dataset.beamInput,range=box.querySelector('[data-beam-range="'+key+'"]');
    input.oninput=()=>{if(range&&input.value!=='')range.value=input.value;};input.onchange=()=>updateDownlightBeamObject(obj.id,key,input.value);});
  box.querySelectorAll('[data-beam-color]').forEach(input=>input.onchange=()=>updateDownlightBeamObject(obj.id,input.dataset.beamColor,input.value));
  const attach=box.querySelector('[data-beam-attach]');if(attach)attach.onclick=()=>attachDownlightBeamToBackWall(obj.id);
}
function rotateSelectedObject(){
  const obj=objectById(objectEditor.selectedId);if(!obj)return;
  if(objectLocked(obj)){announceCatalog('Asset นี้ถูกล็อกอยู่ กรุณากด Unlock ก่อน','error');return;}
  if(isEntranceFrameObject(obj)){moveEntranceFrameToSide(obj.id,obj.position.x<S.W/2?'right':'left');return;}
  const rotationY=(obj.rotationY+45)%360,item=objectCatalogDef(obj.catalogId);
  if(!isCatalogPlacementValid(obj.catalogId,obj.position.x,obj.position.z,rotationY,obj.id,obj.size)){
    announceCatalog('หมุน'+item.name+'ไม่ได้ เพราะพื้นที่ไม่เพียงพอ','error');return;}
  mutateObjects(()=>{obj.rotationY=rotationY;if(isDownlightBeamObject(obj))obj.structure.wallAttached=false;},obj.id);
}
function setSelectedObjectOrientation(mode){
  const obj=objectById(objectEditor.selectedId),preset=ASSET_ORIENTATION_PRESETS[mode];if(!obj||!preset)return;
  normalizeSceneObjectModel(obj);if(objectLocked(obj)){announceCatalog('Asset นี้ถูกล็อกอยู่ กรุณากด Unlock ก่อน','error');return;}
  if(obj.capabilities?.rotatable===false){announceCatalog('Asset โครงสร้างชิ้นนี้ไม่รองรับการเปลี่ยนแนววาง','error');return;}
  if(obj.orientation===mode&&Number(obj.rotationX)===preset.rotationX&&Number(obj.rotationZ)===preset.rotationZ)return;
  const before=objectSnapshot(),previous={orientation:obj.orientation,rotationX:obj.rotationX,rotationZ:obj.rotationZ,placement:JSON.parse(JSON.stringify(obj.placement||{}))};
  obj.orientation=mode;obj.rotationX=preset.rotationX;obj.rotationZ=preset.rotationZ;
  if(obj.placement){obj.placement.mode='free';obj.placement.surface='free';obj.placement.targetId=null;obj.placement.anchorAttachment=null;}
  if(!isCatalogPlacementValid(obj.catalogId,obj.position.x,obj.position.z,obj.rotationY||0,obj.id,obj.size,ALLOW_ASSET_OVERLAP,obj)){
    obj.orientation=previous.orientation;obj.rotationX=previous.rotationX;obj.rotationZ=previous.rotationZ;obj.placement=previous.placement;
    announceCatalog('เปลี่ยนแนววางไม่ได้ เพราะชนโครงสร้างหลักหรือตำแหน่งไม่รองรับ','error');return;
  }
  recordObjectHistory(before);objectEditor.selectedId=obj.id;sync();announceCatalog('เปลี่ยน '+selectedAssetName(obj)+' เป็น'+preset.label+'แล้ว','success');
}
function flipSelectedObject(axis){
  const obj=objectById(objectEditor.selectedId);if(!obj||!['x','y'].includes(axis))return;
  if(objectLocked(obj)){announceCatalog('Asset นี้ถูกล็อกอยู่ กรุณากด Unlock ก่อน','error');return;}
  normalizeSceneObjectModel(obj);const key=axis==='x'?'flipX':'flipY';
  mutateObjects(()=>{obj.transform[key]=!obj.transform[key];},obj.id);
  announceCatalog('กลับด้าน'+(axis==='x'?'ซ้าย–ขวา':'บน–ล่าง')+'แล้ว','success');
}
function selectedAssetName(obj=objectById(objectEditor.selectedId)){
  const item=obj&&objectCatalogDef(obj.catalogId);return obj?.label||item?.name||'Asset';
}
function closeAssetSettings(){
  const modal=document.getElementById('mAssetSettings');if(!modal)return;modal.classList.remove('show');modal.setAttribute('aria-hidden','true');
}
function syncAssetSettingsForm(){
  const obj=objectById(objectEditor.selectedId),modal=document.getElementById('mAssetSettings');if(!obj||!modal){closeAssetSettings();return;}
  const item=objectCatalogDef(obj.catalogId);normalizeSceneObjectModel(obj,item);document.getElementById('assetSettingsTitle').textContent='ตั้งค่า '+selectedAssetName(obj);
  document.getElementById('assetSettingsName').value=obj.label||'';
  ['W','D','H'].forEach(key=>{const prop=key.toLowerCase(),input=document.getElementById('assetSize'+key);input.value=Number(obj.size[prop]||0).toFixed(2);input.disabled=objectLocked(obj);});
  const locked=objectLocked(obj),mode=obj.appearance.mode,color=obj.appearance.color||'#f5f5f5',colorWrap=document.querySelector('#mAssetSettings .asset-settings-color');
  document.getElementById('assetSurfaceColor').value=color;document.getElementById('assetSurfaceHex').value=color.toUpperCase();
  document.querySelectorAll('[data-asset-appearance]').forEach(button=>{button.classList.toggle('on',button.dataset.assetAppearance===mode);button.disabled=locked;button.setAttribute('aria-pressed',String(button.dataset.assetAppearance===mode));});
  colorWrap?.classList.toggle('is-disabled',mode==='original');
  const preview=document.getElementById('assetStickerPreview');preview.src=obj.appearance.textureData||'';preview.classList.toggle('show',!!obj.appearance.textureData);
  document.getElementById('assetRemoveSticker').disabled=!obj.appearance.textureData||locked;
  ['assetSettingsName','assetChooseSticker','assetResetSize','assetResetSurface'].forEach(id=>{const node=document.getElementById(id);if(node)node.disabled=locked;});
  ['assetSurfaceColor','assetSurfaceHex'].forEach(id=>{const node=document.getElementById(id);if(node)node.disabled=locked||mode==='original';});
  const notes={original:'ใช้ Material และ Texture เดิมจากไฟล์'+(item?.customAsset?' GLB':' Asset'),tint:'ย้อมสีทับ Material เดิม โดยยังคงลายและรายละเอียดเดิม',solid:'แทน Material เดิมด้วยพื้นผิวสีล้วนแบบ PBR'};
  document.getElementById('assetSurfaceNote').textContent=(notes[mode]||notes.original)+(obj.appearance.textureData?' · มีสติ๊กเกอร์ภาพซ้อนอยู่':'');
}
function openAssetSettings(){
  const obj=objectById(objectEditor.selectedId);if(!obj)return;syncAssetSettingsForm();
  const modal=document.getElementById('mAssetSettings');modal.classList.add('show');modal.setAttribute('aria-hidden','false');
  requestAnimationFrame(()=>document.getElementById('assetSettingsName')?.focus());
}
function updateSelectedObjectName(value){
  const obj=objectById(objectEditor.selectedId);if(!obj||objectLocked(obj))return;const before=objectSnapshot();obj.label=String(value||'').trim().slice(0,60);recordObjectHistory(before);sync();syncAssetSettingsForm();
}
function updateSelectedObjectSize(axis,value){
  const obj=objectById(objectEditor.selectedId);if(!obj||objectLocked(obj)||!['w','d','h'].includes(axis))return;
  const maxSize={w:MAX_ASSET_WIDTH,d:MAX_ASSET_DEPTH,h:MAX_ASSET_HEIGHT},numeric=assetDimensionValue(value),
    before=objectSnapshot(),previous={...obj.size},previousStructure=isEntranceFrameObject(obj)?{...(obj.structure||{})}:null,
    locked=document.getElementById('assetSizeLock')?.checked!==false;
  if(locked){const ratio=numeric/Math.max(MIN_ASSET_DIMENSION,Number(obj.size[axis])||MIN_ASSET_DIMENSION);['w','d','h'].forEach(key=>obj.size[key]=assetDimensionValue((Number(obj.size[key])||MIN_ASSET_DIMENSION)*ratio));}
  else obj.size[axis]=numeric;
  obj.size={w:+obj.size.w.toFixed(3),d:+obj.size.d.toFixed(3),h:+obj.size.h.toFixed(3)};
  /* Structural Assets rebuild obj.size from obj.structure during every sync.
     Keep both models aligned so the Asset Settings value is not overwritten. */
  if(isEntranceFrameObject(obj)){
    obj.structure={...(obj.structure||{}),pierWidth:obj.size.w,projection:obj.size.d,height:obj.size.h};
    normalizeEntranceFrameObject(obj,S);
  }
  /* A height edit is always allowed above the booth wall.  With aspect lock it
     also changes W/D, but must not be rolled back by a footprint collision. */
  const validateFootprint=axis!=='h'&&(Math.abs(obj.size.w-previous.w)>.0001||Math.abs(obj.size.d-previous.d)>.0001);
  if(validateFootprint&&!isCatalogPlacementValid(obj.catalogId,obj.position.x,obj.position.z,obj.rotationY||0,obj.id,obj.size,ALLOW_ASSET_OVERLAP,obj)){
    obj.size=previous;if(previousStructure)obj.structure=previousStructure;
    announceCatalog('ขนาดนี้ชนโครงสร้างหลักหรือตำแหน่งไม่รองรับ','error');syncAssetSettingsForm();return;
  }
  recordObjectHistory(before);objectEditor.selectedId=obj.id;sync();syncAssetSettingsForm();
}
function resetSelectedObjectSize(){
  const obj=objectById(objectEditor.selectedId);if(!obj||objectLocked(obj))return;normalizeSceneObjectModel(obj);const before=objectSnapshot(),original={
    w:assetDimensionValue(obj.originalSize?.w),d:assetDimensionValue(obj.originalSize?.d),h:assetDimensionValue(obj.originalSize?.h)};
  if(isEntranceFrameObject(obj)){
    obj.structure={...(obj.structure||{}),pierWidth:original.w,projection:original.d,height:original.h};normalizeEntranceFrameObject(obj,S);
  }else obj.size=original;
  recordObjectHistory(before);sync();syncAssetSettingsForm();
}
function updateSelectedObjectColor(value){
  const obj=objectById(objectEditor.selectedId);if(!obj||objectLocked(obj))return;const color=String(value||'').trim();if(!/^#?[0-9a-fA-F]{6}$/.test(color))return;
  normalizeSceneObjectModel(obj);const before=objectSnapshot();obj.appearance.color=(color[0]==='#'?color:'#'+color).toLowerCase();
  if(obj.appearance.mode==='original')obj.appearance.mode=objectCatalogDef(obj.catalogId)?.customAsset?'solid':'tint';
  recordObjectHistory(before);sync();syncAssetSettingsForm();
}
function updateSelectedObjectAppearanceMode(mode){
  const obj=objectById(objectEditor.selectedId);if(!obj||objectLocked(obj)||!SCENE_APPEARANCE_MODES.includes(mode))return;
  normalizeSceneObjectModel(obj);if(obj.appearance.mode===mode)return;const before=objectSnapshot();obj.appearance.mode=mode;
  if((mode==='tint'||mode==='solid')&&!obj.appearance.color)obj.appearance.color='#f5f5f5';
  recordObjectHistory(before);sync();syncAssetSettingsForm();
}
function setSelectedObjectSticker(file){
  const obj=objectById(objectEditor.selectedId);if(!obj||objectLocked(obj)||!file)return;
  if(!/^image\/(png|jpeg|webp)$/i.test(file.type)){announceCatalog('รองรับไฟล์ PNG, JPG และ WebP','error');return;}
  const reader=new FileReader();reader.onload=()=>{const current=objectById(objectEditor.selectedId);if(!current)return;normalizeSceneObjectModel(current);const before=objectSnapshot();
    current.appearance.textureData=String(reader.result);current.appearance.textureName=file.name;current.appearance.textureId=Date.now().toString(36);recordObjectHistory(before);sync();syncAssetSettingsForm();announceCatalog('ใช้สติ๊กเกอร์กับ '+selectedAssetName(current)+' แล้ว','success');};reader.readAsDataURL(file);
}
function resetSelectedObjectSurface(removeAll=true){
  const obj=objectById(objectEditor.selectedId);if(!obj||objectLocked(obj))return;normalizeSceneObjectModel(obj);const before=objectSnapshot();
  obj.appearance.textureData=null;obj.appearance.textureName='';obj.appearance.textureId='';if(removeAll){obj.appearance.mode='original';obj.appearance.color=null;}recordObjectHistory(before);sync();syncAssetSettingsForm();
}
function duplicateSelectedObject(){
  const source=objectById(objectEditor.selectedId);if(!source)return;
  if(objectLocked(source)){announceCatalog('Asset นี้ถูกล็อกอยู่ กรุณากด Unlock ก่อน','error');return;}
  const item=objectCatalogDef(source.catalogId),position=findCatalogPlacement(source.catalogId,source.rotationY,
    {x:source.position.x+.4,z:source.position.z+.4},sceneObjectOrientedSize(source));
  if(!position){announceCatalog('พื้นที่ไม่เพียงพอสำหรับทำสำเนา'+item.name,'error');return;}
  const copy=makeCatalogObject(source.catalogId,position.x,position.z);if(!copy)return;
  copy.position.y=source.position.y;copy.rotationX=source.rotationX;copy.rotationY=source.rotationY;copy.rotationZ=source.rotationZ;copy.orientation=source.orientation;
  copy.size={...source.size};copy.unitPrice=source.unitPrice;
  if(source.structure)copy.structure={...source.structure};
  if(source.transform)copy.transform={...source.transform};if(source.appearance)copy.appearance={...source.appearance};copy.label=source.label||'';copy.originalSize={...(source.originalSize||source.size)};
  if(source.capabilities)copy.capabilities={...source.capabilities};if(source.collision)copy.collision={...source.collision};
  copy.attachment=null;copy.placement={...(source.placement||{}),mode:'free'};normalizeSceneObjectModel(copy,item);
  if(source.ai)copy.ai=JSON.parse(JSON.stringify(source.ai));normalizeObjectAIRule(copy,item);
  mutateObjects(()=>S.objects.push(copy),copy.id);announceCatalog('ทำสำเนา'+item.name+'แล้ว','success');
}
function deleteSelectedObject(){
  deleteSceneSelection();
}
function toggleMultiObjectSelection(force){
  objectEditor.multiSelect=typeof force==='boolean'?force:!objectEditor.multiSelect;
  syncObjectControls();
  announceCatalog(objectEditor.multiSelect?'เปิดเลือกหลายชิ้น · แตะ Asset เพื่อเพิ่มหรือลดจากชุดเลือก':'ปิดเลือกหลายชิ้น','success');
}
function selectedAlignmentBounds(obj){
  const horizontal=promptObjectBounds(obj),size=sceneObjectOrientedSize(obj),base=Number(obj.position?.y)||0;
  return{...horizontal,centerX:(horizontal.minX+horizontal.maxX)/2,centerZ:(horizontal.minZ+horizontal.maxZ)/2,
    minY:base,maxY:base+(Number(size.h)||0),centerY:base+(Number(size.h)||0)/2};
}
const FINE_POSITION_STEP=.05;
const finePositionDraft={selectionKey:'',values:{x:'',y:'',z:''},dirty:new Set(),errors:{}};
function finePositionAxisOverflow(bounds,axis){
  if(axis==='x')return Math.max(0,-bounds.minX)+Math.max(0,bounds.maxX-S.W);
  if(axis==='y')return Math.max(0,-(Number(S.raise)||0)/100-bounds.minY);
  if(axis==='z')return Math.max(0,-bounds.minZ)+Math.max(0,bounds.maxZ-S.D);
  return Infinity;
}
function shiftedFinePositionBounds(bounds,axis,delta){
  const next={...bounds};
  if(axis==='x'){next.minX+=delta;next.maxX+=delta;next.centerX+=delta;}
  else if(axis==='y'){next.minY+=delta;next.maxY+=delta;next.centerY+=delta;}
  else if(axis==='z'){next.minZ+=delta;next.maxZ+=delta;next.centerZ+=delta;}
  return next;
}
function finePositionPrimaryObject(objects=selectedObjects()){
  return objectById(objectEditor.selectedId)||objects.at(-1)||null;
}
function finePositionSelectionKey(objects=selectedObjects()){
  return objects.map(obj=>obj.id).sort().join('|')+'::'+(objectEditor.selectedId||'');
}
function resetFinePositionDraft(){
  finePositionDraft.selectionKey='';finePositionDraft.values={x:'',y:'',z:''};finePositionDraft.dirty.clear();finePositionDraft.errors={};
  document.querySelectorAll('.fine-position-field').forEach(field=>field.classList.remove('is-invalid'));
  document.querySelectorAll('.fine-position-input').forEach(input=>input.removeAttribute('aria-invalid'));
}
function finePositionInput(axis){return document.getElementById('finePosition'+axis.toUpperCase());}
function setFinePositionError(axis,message=''){
  const input=finePositionInput(axis),field=input?.closest('.fine-position-field');finePositionDraft.errors[axis]=message;
  field?.classList.toggle('is-invalid',!!message);if(input)message?input.setAttribute('aria-invalid','true'):input.removeAttribute('aria-invalid');
  const help=document.getElementById('finePositionHelp');if(help&&message){help.classList.add('is-warning');help.textContent=message;}
}
function cancelFinePositionDraft(axis){
  const primary=finePositionPrimaryObject(),input=finePositionInput(axis);finePositionDraft.dirty.delete(axis);delete finePositionDraft.errors[axis];
  finePositionDraft.values[axis]='';setFinePositionError(axis,'');if(input){input.value=primary?Number(primary.position?.[axis]||0).toFixed(2):'';input.placeholder=primary?'':'—';}
  syncFinePositionControls();
}
function parseFinePositionDraft(value){
  const normalized=String(value??'').trim().replace(/,/g,'.');
  if(!/^[+-]?(?:\d+(?:\.\d*)?|\.\d+)$/.test(normalized))return null;
  const numeric=Number(normalized);return Number.isFinite(numeric)?numeric:null;
}
function releaseObjectAttachment(obj){
  obj.attachment=null;if(obj.placement){obj.placement.mode='free';obj.placement.surface='free';obj.placement.targetId=null;obj.placement.anchorAttachment=null;}
}
function commitFinePositionInput(axis){
  const objects=selectedObjects(),input=finePositionInput(axis);if(objects.length!==1||!input)return false;
  const obj=objects[0];if(objectLocked(obj)){setFinePositionError(axis,'ปลดล็อก Asset ก่อนปรับตำแหน่ง');return false;}
  const numeric=parseFinePositionDraft(input.value);if(numeric===null){setFinePositionError(axis,'กรอกพิกัดเป็นตัวเลข เช่น 1.25 หรือ 1,25');return false;}
  const current=Number(obj.position?.[axis])||0,delta=numeric-current,next=shiftedFinePositionBounds(selectedAlignmentBounds(obj),axis,delta);
  if(finePositionAxisOverflow(next,axis)>.0001){setFinePositionError(axis,'ยืนยันไม่ได้ เพราะ Bounding Box ของ Asset จะอยู่นอกพื้นที่บูธ');return false;}
  finePositionDraft.dirty.delete(axis);delete finePositionDraft.errors[axis];setFinePositionError(axis,'');
  if(Math.abs(delta)<.000001){input.value=current.toFixed(2);return true;}
  const before=objectSnapshot();obj.position[axis]=+numeric.toFixed(3);releaseObjectAttachment(obj);normalizeSceneObjectModel(obj);
  recordObjectHistory(before);sync();announceCatalog('ปรับพิกัด '+axis.toUpperCase()+' เป็น '+Number(obj.position[axis]).toFixed(2)+' ม. แล้ว','success');return true;
}
function syncFinePositionControls(){
  const objects=selectedObjects(),primary=finePositionPrimaryObject(objects),locked=objects.some(objectLocked),multi=objects.length>1,buttons=document.querySelectorAll('[data-fine-axis]'),help=document.getElementById('finePositionHelp'),selectionKey=finePositionSelectionKey(objects);
  if(finePositionDraft.selectionKey!==selectionKey){resetFinePositionDraft();finePositionDraft.selectionKey=selectionKey;}
  ['x','y','z'].forEach(axis=>{const input=finePositionInput(axis);if(!input)return;input.disabled=!primary||locked||multi;input.placeholder=multi?'—':primary?'':'—';
    if(multi)input.value='';else if(!finePositionDraft.dirty.has(axis))input.value=primary?Number(primary.position?.[axis]||0).toFixed(2):'';
    input.closest('.fine-position-field')?.classList.toggle('is-invalid',!!finePositionDraft.errors[axis]);});
  buttons.forEach(button=>button.disabled=!objects.length||locked);
  const summary=document.querySelector('#moveAdvanced>summary');if(summary)summary.setAttribute('aria-disabled',String(!objects.length||locked));
  if(!help)return;
  const error=Object.values(finePositionDraft.errors).find(Boolean)||'';help.classList.toggle('is-warning',!!error||!objects.length||locked);
  help.textContent=error||(!objects.length?'เลือก Asset ที่ต้องการปรับ':locked?'ปลดล็อก Asset ก่อนปรับตำแหน่ง':multi?'เลือก '+objects.length+' ชิ้น · ค่า Absolute ปิดอยู่ ใช้ −/+ เพื่อเลื่อนทั้งกลุ่ม':'พิมพ์ค่าแล้วกด Enter · Esc หรือคลิกออกเพื่อยกเลิก');
}
function fineMoveSelectedObjects(axis,delta){
  if(!['x','y','z'].includes(axis))return false;
  const direction=Math.sign(Number(delta));if(!direction)return false;delta=direction*FINE_POSITION_STEP;
  const objects=selectedObjects();
  if(!objects.length){syncFinePositionControls();return announceCatalog('เลือก Asset ที่ต้องการปรับ','error'),false;}
  if(objects.some(objectLocked)){syncFinePositionControls();return announceCatalog('ปลดล็อก Asset ก่อนปรับตำแหน่ง','error'),false;}
  const epsilon=.0001,blocked=objects.some(obj=>{
    const current=selectedAlignmentBounds(obj),next=shiftedFinePositionBounds(current,axis,delta),beforeOverflow=finePositionAxisOverflow(current,axis),afterOverflow=finePositionAxisOverflow(next,axis);
    return afterOverflow>epsilon&&afterOverflow>=beforeOverflow-epsilon;
  });
  if(blocked){
    const direction=axis==='x'?(delta<0?'ซ้าย':'ขวา'):axis==='y'?(delta<0?'ลง':'ขึ้น'):(delta<0?'ด้านหลัง':'ด้านหน้า');
    announceCatalog('เลื่อนไปทาง'+direction+'ไม่ได้ เพราะ Bounding Box ของ Asset จะอยู่นอกพื้นที่บูธ','error');syncFinePositionControls();return false;
  }
  const before=objectSnapshot();
  objects.forEach(obj=>{
    obj.position[axis]=+(Number(obj.position?.[axis]||0)+delta).toFixed(3);
    releaseObjectAttachment(obj);
    normalizeSceneObjectModel(obj);
  });
  recordObjectHistory(before);sync();return true;
}
function alignSelectedObjects(mode){
  const objects=selectedObjects(),reference=objectById(objectEditor.selectedId);
  if(objects.length<2||!reference)return announceCatalog('กรุณาเลือก Asset อย่างน้อย 2 ชิ้น','error');
  if(objects.some(objectLocked))return announceCatalog('มี Asset ที่ล็อกอยู่ กรุณา Unlock ก่อนจัดแนว','error');
  const ref=selectedAlignmentBounds(reference),before=objectSnapshot();
  objects.filter(obj=>obj.id!==reference.id).forEach(obj=>{
    const bounds=selectedAlignmentBounds(obj),position=obj.position;
    if(mode==='horizontal')position.x=ref.centerX;
    else if(mode==='vertical')position.y=ref.centerY-(bounds.maxY-bounds.minY)/2;
    else if(mode==='top')position.y=ref.maxY-(bounds.maxY-bounds.minY);
    else if(mode==='bottom')position.y=ref.minY;
    else if(mode==='front')position.z+=(ref.maxZ-bounds.maxZ);
    else if(mode==='back')position.z+=(ref.minZ-bounds.minZ);
    position.x=+Number(position.x).toFixed(3);position.y=+Number(position.y).toFixed(3);position.z=+Number(position.z).toFixed(3);
    if(sceneAttachmentActive(obj))obj.attachment=null;
    normalizeSceneObjectModel(obj);
  });
  recordObjectHistory(before);sync();
  const labels={horizontal:'กึ่งกลางแนวนอน',vertical:'กึ่งกลางแนวตั้ง',top:'เสมอบน',bottom:'เสมอล่าง',front:'เสมอหน้า',back:'เสมอหลัง'};
  announceCatalog('จัดแนว '+labels[mode]+' โดยยึด '+selectedAssetName(reference)+' แล้ว','success');
}
function groupSelectedObjects(){
  const objects=selectedObjects();if(objects.length<2)return announceCatalog('กรุณาเลือก Asset อย่างน้อย 2 ชิ้นเพื่อ Group','error');
  if(objects.some(objectLocked))return announceCatalog('มี Asset ที่ล็อกอยู่ กรุณา Unlock ก่อน Group','error');
  const before=objectSnapshot(),groupId='group-'+Date.now().toString(36)+'-'+(++objectEditor.seq).toString(36);
  objects.forEach(obj=>obj.groupId=groupId);recordObjectHistory(before);sync();announceCatalog('Group Asset '+objects.length+' ชิ้นแล้ว','success');
}
function ungroupSelectedObjects(){
  const groupIds=[...new Set(selectedObjects().map(obj=>obj.groupId).filter(Boolean))];
  if(!groupIds.length)return announceCatalog('Asset ที่เลือกยังไม่ได้ Group','error');
  if(selectedObjects().some(objectLocked))return announceCatalog('มี Asset ที่ล็อกอยู่ กรุณา Unlock ก่อน Ungroup','error');
  const before=objectSnapshot();S.objects.forEach(obj=>{if(groupIds.includes(obj.groupId))delete obj.groupId;});recordObjectHistory(before);sync();
  announceCatalog('Ungroup Asset แล้ว','success');
}
function toggleSelectedObjectLock(){
  const obj=objectById(objectEditor.selectedId);if(!obj)return;
  const next=!objectLocked(obj),item=objectCatalogDef(obj.catalogId),before=objectSnapshot();
  obj.locked=next;recordObjectHistory(before);objectEditor.selectedId=obj.id;sync();
  announceCatalog((next?'ล็อก ':'ปลดล็อก ')+(item?.name||'Asset')+'แล้ว','success');
}
function setObjectMoveMode(mode){
  if(!['smart','plane','height','surface'].includes(mode))return;
  objectEditor.moveMode=mode;syncObjectControls();if(threeRenderer)threeRenderer.setSceneSelection(selectedSceneItemIds(),objectEditor.selectedId);
  const advanced=document.getElementById('moveAdvanced');if(advanced)advanced.removeAttribute('open');
  const labels={smart:'Smart Move · ลากตัว Asset ที่ระดับเดิม หรือลาก Anchor ไปยังจุด/ผิวเป้าหมาย',plane:'ย้ายซ้าย–ขวาและหน้า–หลัง (X/Z)',height:'ยกหรือลดระดับ (Y)',surface:'ลากเข้าใกล้พื้นผิวเพื่อ Snap'};
  const status=document.getElementById('objectLayoutStatus');if(status)status.textContent=labels[mode];
}
function undoObjectChange(){
  if(!objectEditor.past.length)return;
  const selectedId=objectEditor.selectedId;objectEditor.future.push(objectSnapshot());restoreObjectSnapshot(objectEditor.past.pop());
  const valid=selectedSceneItemIds().filter(sceneItemExists);setObjectSelection(valid,sceneItemExists(selectedId)?selectedId:(valid.at(-1)||null));sync();
}
function redoObjectChange(){
  if(!objectEditor.future.length)return;
  const selectedId=objectEditor.selectedId;objectEditor.past.push(objectSnapshot());restoreObjectSnapshot(objectEditor.future.pop());
  const valid=selectedSceneItemIds().filter(sceneItemExists);setObjectSelection(valid,sceneItemExists(selectedId)?selectedId:(valid.at(-1)||null));sync();
}
function syncObjectControls(){
  const obj=objectById(objectEditor.selectedId),item=obj&&objectCatalogDef(obj.catalogId),sceneItem=sceneItemById(objectEditor.selectedId),locked=objectLocked(obj),brandSelected=objectEditor.selectedId==='system-brand',box=document.getElementById('objectSelected');
  logoEditor.selected=brandSelected;const selectionCount=selectedSceneItemIds().length;if(!selectionCount)resetAssetContextOpenState();
  box.classList.toggle('on',!!sceneItem||brandSelected);
  box.classList.toggle('structure-active',!!obj&&(isEntranceFrameObject(obj)||isDownlightBeamObject(obj)));
  const info=document.getElementById('placementGridInfo');
  if(obj){
    const name=selectedAssetName(obj),p=obj.position||{},snap=S.placementSnap===false?'วางอิสระ':'Snap 5 ซม.',
      moveLabel={smart:'Smart Move',plane:'ย้ายพื้น X/Z',height:'ยก–ลด Y',surface:'Snap พื้นผิว'}[objectEditor.moveMode];
    const anchor=obj.placement?.anchorAttachment,anchorLabel=anchor?' · แม่เหล็ก '+esc(anchor.sourceAnchorId)+' → '+esc(anchor.targetId)+' / '+esc(anchor.targetAnchorId):'';
    const orientationLabel=ASSET_ORIENTATION_PRESETS[obj.orientation]?.label||'แนวนอน';
    box.innerHTML='<b>'+esc(name)+'</b> · '+esc(orientationLabel)+' · หมุน Y '+Number(obj.rotationY||0).toFixed(0)+'°'+(selectionCount>1?' · เลือก '+selectionCount+' ชิ้น':'')+
      '<small>จุดกึ่งกลางฐาน · X '+placementMeters(p.x)+' · Y '+placementMeters(p.y)+' · Z '+placementMeters(p.z)+' ม.</small>'+ 
      '<small>'+moveLabel+' · '+snap+' · ระยะจัดวาง '+placementStepLabel()+anchorLabel+'</small>'+
      (locked?'<small class="object-lock-state">ล็อกอยู่ · กด Unlock ก่อนแก้ไขหรือย้ายตำแหน่ง</small>':'')+
      '<button class="btn sm object-inspector-lock" type="button" aria-label="'+(locked?'ปลดล็อก':'ล็อก')+' Asset ที่เลือก">'+(locked?'Unlock Asset':'Lock Asset')+'</button>'+
      (isEntranceFrameObject(obj)?entranceFrameEditorMarkup(obj):isDownlightBeamObject(obj)?downlightBeamEditorMarkup(obj):'');
    const inspectorLock=box.querySelector('.object-inspector-lock');if(inspectorLock)inspectorLock.onclick=toggleSelectedObjectLock;
    if(isEntranceFrameObject(obj)){bindEntranceFrameEditor(box,obj);if(locked)box.querySelectorAll('.structure-editor input,.structure-editor button').forEach(control=>control.disabled=true);}
    if(isDownlightBeamObject(obj)){bindDownlightBeamEditor(box,obj);if(locked)box.querySelectorAll('.structure-editor input,.structure-editor button').forEach(control=>control.disabled=true);}
    if(info)info.innerHTML='<b>'+esc(name)+(locked?' · ล็อก':'')+'</b><small>พิกัดกลางฐาน: X '+placementMeters(p.x)+' · Y '+placementMeters(p.y)+' · Z '+placementMeters(p.z)+' ม. · '+moveLabel+'</small>';
  }else if(brandSelected){
    const location=S.logoMount==='floor'
      ?'พิกัด X '+placementMeters(S.logoFloorX)+' · Z '+placementMeters(S.logoFloorZ)+' ม.'
      :'ตำแหน่งตามผนัง '+placementMeters(S.logoWallU)+' · สูง '+placementMeters(S.logoWallY)+' ม.';
    box.innerHTML='<b>โลโก้และชื่อแบรนด์</b><small>'+location+'</small><small>ลากบนภาพ 3D เพื่อย้าย · Snap '+placementStepLabel()+'</small>';
    if(info)info.innerHTML='<b>โลโก้และชื่อแบรนด์</b><small>'+location+'</small>';
  }else if(sceneItem){
    box.innerHTML='<b>'+esc(sceneItem.name)+'</b> · System/Structure'+(selectionCount>1?' · เลือก '+selectionCount+' รายการ':'')+'<small>'+esc(sceneItem.type)+' · เลือกและซ่อนได้ แต่ลบหรือแก้ Geometry โดยตรงไม่ได้</small>';
    if(info)info.innerHTML='<b>'+esc(sceneItem.name)+'</b><small>System/Structure · ล็อกเพื่อป้องกันแบบเสียหาย</small>';
  }else{
    box.textContent='ยังไม่ได้เลือกองค์ประกอบ';
    if(info)info.textContent='Snap 5 ซม. · คลิก Asset เพื่อดูพิกัด';
    if(document.getElementById('mAssetSettings')?.classList.contains('show'))closeAssetSettings();
  }
  ['btnRotateObject','btnFlipObjectX','btnFlipObjectY','btnOpenAssetSettings','btnDuplicateObject','btnDeleteObject'].forEach(id=>document.getElementById(id).disabled=!obj||(locked&&id!=='btnOpenAssetSettings'));
  const lockButton=document.getElementById('btnLockObject');if(lockButton){
    lockButton.disabled=!obj;lockButton.classList.toggle('on',!!obj&&locked);lockButton.textContent=locked?'Unlock':'Lock';
    lockButton.title=locked?'ปลดล็อก Asset':'ล็อก Asset';lockButton.setAttribute('aria-label',locked?'ปลดล็อก Asset ที่เลือก':'ล็อก Asset ที่เลือก');
    lockButton.setAttribute('aria-pressed',String(!!obj&&locked));
  }
  const rotateButton=document.getElementById('btnRotateObject');if(rotateButton){const frame=!!obj&&isEntranceFrameObject(obj);
    rotateButton.textContent=frame?'⇄ สลับด้าน':'↻ หมุน 45°';rotateButton.title=frame?'สลับกรอบทางเข้าระหว่างซ้ายและขวา':'หมุน 45 องศา';}
  document.getElementById('btnUndoObject').disabled=!objectEditor.past.length;
  document.getElementById('btnRedoObject').disabled=!objectEditor.future.length;
  const snapToggle=document.getElementById('placementSnapEnabled');if(snapToggle)snapToggle.checked=S.placementSnap!==false;
  const magneticToggle=document.getElementById('magneticSnapEnabled');if(magneticToggle)magneticToggle.checked=S.magneticSnap!==false;
  const count=document.getElementById('dockCount');if(count)count.textContent=S.objects.length?String(S.objects.length):'';
  const toolbar=document.getElementById('objectToolbar'),workspaceNode=document.getElementById('workspace'),positionButton=document.getElementById('btnPositionLogo3D');
  if(toolbar){toolbar.hidden=!selectionCount;toolbar.setAttribute('aria-hidden',String(!selectionCount));toolbar.classList.toggle('brand-selected',brandSelected);toolbar.classList.toggle('locked-selected',!!obj&&locked);
    toolbar.classList.toggle('no-object-selection',!obj&&!brandSelected);requestAnimationFrame(positionObjectToolbar);}
  const moveButtons={smart:'btnMoveSmart'};
  Object.entries(moveButtons).forEach(([mode,id])=>{const button=document.getElementById(id);if(!button)return;
    button.disabled=!obj||locked;button.classList.toggle('on',objectEditor.moveMode===mode);button.setAttribute('aria-pressed',String(objectEditor.moveMode===mode));});
  const advanced=document.getElementById('moveAdvanced'),advancedSummary=advanced?.querySelector('summary');if(advancedSummary)advancedSummary.classList.toggle('on',!!advanced?.open);
  if(workspaceNode){workspaceNode.classList.toggle('logo-placement-active',brandSelected);workspaceNode.classList.toggle('has-object-selection',!!obj);}
  if(toolbar&&obj){normalizeSceneObjectModel(obj);toolbar.classList.toggle('flipped-x',obj.transform.flipX);toolbar.classList.toggle('flipped-y',obj.transform.flipY);}
  if(positionButton){positionButton.classList.toggle('on',brandSelected);positionButton.textContent=brandSelected?'✓ พร้อมลากโลโก้ใน 3D':'จัดตำแหน่งใน 3D';}
  if(threeRenderer)threeRenderer.setSceneSelection(selectedSceneItemIds(),objectEditor.selectedId);
  syncFinePositionControls();
  renderAssetList();
  window.dispatchEvent(new CustomEvent('yp:asset-editor-sync'));
}
function objectListLabel(){
  if(!S.objects.length)return'ไม่มี';
  const counts=new Map();S.objects.forEach(o=>counts.set(o.catalogId,(counts.get(o.catalogId)||0)+1));
  return allObjectCatalog().filter(item=>counts.has(item.catalogId)).map(item=>item.name+' × '+counts.get(item.catalogId)).join(' · ');
}
function promptSafeNumber(value,fallback=0){
  const numeric=Number(value);return Number.isFinite(numeric)?numeric:fallback;
}
function promptNumber(value,digits=2){return promptSafeNumber(value).toFixed(digits);}
function promptWallThickness(){
  try{return promptSafeNumber(boothWallThickness(S));}catch(e){return 0;}
}
function promptObjectShape(obj){
  const position=obj?.position||{},size=sceneObjectOrientedSize(obj),rotation=promptSafeNumber(obj?.rotationY);
  return placementShape({w:promptSafeNumber(size.w),d:promptSafeNumber(size.d)},
    promptSafeNumber(position.x),promptSafeNumber(position.z),rotation);
}
function promptObjectBounds(obj){
  const shape=promptObjectShape(obj),corners=shape.corners||[];
  const xs=corners.map(point=>point.x),zs=corners.map(point=>point.z);
  return{minX:Math.min(...xs),maxX:Math.max(...xs),minZ:Math.min(...zs),maxZ:Math.max(...zs)};
}
function promptObjectWallDistances(obj){
  const bounds=promptObjectBounds(obj),width=promptSafeNumber(S.W),depth=promptSafeNumber(S.D),thickness=promptWallThickness(),curve=wallCurveInfo(S);
  const walls=typ()?.walls||[],leftBoundary=walls.includes('left')?thickness:0,rightBoundary=width-(walls.includes('right')?thickness:0),
    backBoundary=walls.includes('back')?thickness:0,frontBoundary=depth,
    curvedBackBoundary=curve?curve.pointAtX((bounds.minX+bounds.maxX)/2).z+thickness/2:backBoundary;
  return{
    left:Math.max(0,bounds.minX-leftBoundary),right:Math.max(0,rightBoundary-bounds.maxX),
    back:Math.max(0,bounds.minZ-curvedBackBoundary),front:Math.max(0,frontBoundary-bounds.maxZ)
  };
}
function promptObjectZone(obj){
  const position=obj?.position||{},x=promptSafeNumber(position.x),z=promptSafeNumber(position.z),width=promptSafeNumber(S.W),depth=promptSafeNumber(S.D);
  const horizontal=width&&x<width/3?'ซ้าย':width&&x>width*2/3?'ขวา':'กลาง';
  const vertical=depth&&z<depth/3?'ด้านหลัง':depth&&z>depth*2/3?'ด้านหน้า':'กึ่งกลาง';
  const distances=promptObjectWallDistances(obj),nearest=Object.entries(distances).sort((a,b)=>a[1]-b[1])[0];
  const nearestLabel={left:'ผนังซ้าย',right:'ผนังขวา',back:'ผนังหลัง',front:'ขอบเปิดด้านหน้า'}[nearest?.[0]]||'ขอบพื้นที่';
  return vertical+'-'+horizontal+' · ใกล้'+nearestLabel;
}
function boothGeometryPrompt(){
  const boothType=typ()||{},width=promptSafeNumber(S.W),depth=promptSafeNumber(S.D),height=promptSafeNumber(S.H),thickness=promptWallThickness();
  const floorLevel=promptSafeNumber(S.raise)/100;
  const walls=boothType.walls||[],wallName=face=>WALL_FACES.find(item=>item.k===face)?.n||face;
  const curve=wallCurveInfo(S);
  const wallSegments=walls.map(face=>{
    if(face==='back'&&curve)return'- '+wallName(face)+': ผนังโค้งเว้าเข้าพื้นที่ถ่ายภาพ · รัศมี R '+promptNumber(curve.radius)+' ม. · ความยาวแนวโค้ง '+promptNumber(curve.arcLength)+' ม. · ความลึกโค้ง (sagitta) '+promptNumber(curve.sagitta)+' ม. · สูง '+promptNumber(height)+' ม. × หนา '+promptNumber(thickness)+' ม. · ปลายผนังอยู่ตามแนวกว้าง 0 ถึง '+promptNumber(width)+' ม.';
    if(face==='back')return'- '+wallName(face)+': ยาวตามแกน X '+promptNumber(width)+' ม. × สูง '+promptNumber(height)+' ม. × หนา '+promptNumber(thickness)+' ม. · อยู่ที่ Z=0 ถึง Z='+promptNumber(thickness)+' ม. และครอบคลุม X=0 ถึง X='+promptNumber(width)+' ม.';
    if(face==='left')return'- '+wallName(face)+': ยาวตามแกน Z '+promptNumber(depth)+' ม. × สูง '+promptNumber(height)+' ม. × หนา '+promptNumber(thickness)+' ม. · อยู่ที่ X=0 ถึง X='+promptNumber(thickness)+' ม. และครอบคลุม Z=0 ถึง Z='+promptNumber(depth)+' ม.';
    if(face==='right')return'- '+wallName(face)+': ยาวตามแกน Z '+promptNumber(depth)+' ม. × สูง '+promptNumber(height)+' ม. × หนา '+promptNumber(thickness)+' ม. · อยู่ที่ X='+promptNumber(Math.max(0,width-thickness))+' ถึง X='+promptNumber(width)+' ม. และครอบคลุม Z=0 ถึง Z='+promptNumber(depth)+' ม.';
    return'- '+wallName(face)+': ยึดตามแนวขอบบูธในแบบ 3D โดยใช้ความหนา '+promptNumber(thickness)+' ม.';
  });
  const wallStickerSegments=walls.filter(face=>wallFinishKind(S,face)==='sticker').map(face=>{
    const sticker=wallStickerFor(face),name=wallName(face);if(!sticker.data)return'- สติ๊กเกอร์'+name+': เลือกผิวสติ๊กเกอร์แล้วแต่ยังไม่มีไฟล์ภาพ ห้ามสร้างกราฟิกขึ้นเอง';
    const widthM=Math.min(wallFaceLength(S,face),Math.max(.1,promptSafeNumber(sticker.w))),heightM=Math.min(height,Math.max(.1,promptSafeNumber(sticker.h)));
    const horizontal=face==='back'?'กึ่งกลางแนวผนัง/แกน X':'กึ่งกลางแนวลึก/แกน Z';
    const display=sticker.mode==='repeat'?'ต่อลายโดยรักษาสัดส่วนเดิม · ขนาดลาย '+promptNumber(sticker.patternSize)+' ม.':sticker.mode==='cover'?'เต็มพื้นที่แบบรักษาสัดส่วนและตัดส่วนเกิน':'ภาพเดียวแบบรักษาสัดส่วน';
    return'- สติ๊กเกอร์'+name+' ชื่อ '+(sticker.name||'ไฟล์กราฟิก')+': ขนาด '+promptNumber(widthM)+' × '+promptNumber(heightM)+' ม. · '+display+' · เลื่อนแนวนอน '+promptNumber(sticker.offsetX)+' ม. / แนวตั้ง '+promptNumber(sticker.offsetY)+' ม. · หมุนภาพ '+Number(sticker.rotation||0)+'° · วาง'+horizontal+'และกึ่งกลางแนวสูง Y · '+(face==='back'&&curve?'แนบโค้งตามผนัง R โดยรักษาความยาวภาพตามแนวโค้ง':'แนบระนาบเดียวกับผิวผนัง')+' · ห้ามบิดหรือยืดสัดส่วนภาพ และห้ามย้ายกรอบพื้นที่ติด';
  });
  const floorLabel=(()=>{try{return floorName();}catch(e){return S.floor||'พื้นตามแบบ';}})();
  const activeCarpetUpload=activeCarpetTexture(S);
  const activeTileUpload=activeTileTexture(S);
  const uploadedFloorTexture=S.floor==='carpet'?activeCarpetUpload?.data:S.floor==='tile'?activeTileUpload?.data:null;
  const uploadedFloorTextureName=S.floor==='carpet'?activeCarpetUpload?.name||'':S.floor==='tile'?activeTileUpload?.name||'':'';
  const textureLabel=S.floor==='sticker'?'พื้นฐานเรียบเต็มพื้นที่ โดยมีภาพสติ๊กเกอร์เป็นชิ้นงานแยกวางทับด้านบน':
    uploadedFloorTexture?'ใช้ Texture ที่ลูกค้าอัปโหลดชื่อ '+(uploadedFloorTextureName||'ไฟล์พื้น')+' ปูต่อเนื่องเต็มพื้นที่':'ใช้พื้นผิวมาตรฐานของโปรแกรม ปูต่อเนื่องเต็มพื้นที่';
  const stickerW=Math.min(width,Math.max(.1,promptSafeNumber(S.floorStickerW))),stickerD=Math.min(depth,Math.max(.1,promptSafeNumber(S.floorStickerD)));
  const stickerGraphic=S.floor==='sticker'?(S.floorStickerData?
    'ภาพสติ๊กเกอร์พื้นชื่อ '+(S.floorStickerName||'ไฟล์กราฟิก')+' เป็นสี่เหลี่ยมขนาดยาวตามแกน X '+promptNumber(stickerW)+' ม. × ลึกตามแกน Z '+promptNumber(stickerD)+' ม. · วางกึ่งกลางพื้นที่ที่ X='+promptNumber((width-stickerW)/2)+' ถึง '+promptNumber((width+stickerW)/2)+' ม. และ Z='+promptNumber((depth-stickerD)/2)+' ถึง '+promptNumber((depth+stickerD)/2)+' ม. · รูปแบบ '+stickerModeName(S.floorStickerMode)+(S.floorStickerMode==='repeat'?' ขนาดลาย '+promptNumber(S.floorStickerPatternSize)+' ม.':'')+' · เลื่อน X '+promptNumber(S.floorStickerOffsetX)+' ม. / Z '+promptNumber(S.floorStickerOffsetY)+' ม. · หมุนภาพ '+Number(S.floorStickerRotation||0)+' องศา · ห้ามบิดหรือยืดสัดส่วนภาพ และห้ามย้ายกรอบพื้นที่ติดออกจากกึ่งกลาง':
    'เลือกสติ๊กเกอร์พื้นแต่ยังไม่มีไฟล์ภาพ ห้ามสร้างกราฟิกพื้นขึ้นเอง') :'';
  const innerStartX=walls.includes('left')?thickness:0,innerEndX=walls.includes('right')?Math.max(innerStartX,width-thickness):width;
  const innerStartZ=curve?curve.sagitta+thickness/2:(walls.includes('back')?thickness:0);
  return[
    'ล็อกเรขาคณิตผนังและพื้น (ต้องรักษาตามแบบ 3D ห้าม AI วาดใหม่)',
    'ขอบเขตพื้นที่บูธจริง: กว้าง '+promptNumber(width)+' ม. × ลึก '+promptNumber(depth)+' ม. · จุดอ้างอิงมุมหลังซ้ายคือ X=0, Y=0, Z=0 · พื้นด้านบนอยู่ที่ Y='+promptNumber(floorLevel)+' ม.',
    'พื้น/พรมคือพื้นบูธชิ้นเดียวแบบสี่เหลี่ยมเต็มขนาด กว้าง '+promptNumber(width)+' ม. × ลึก '+promptNumber(depth)+' ม. · ขอบนอกอยู่ที่ X=0 ถึง X='+promptNumber(width)+' ม. และ Z=0 ถึง Z='+promptNumber(depth)+' ม. · '+floorLabel+' · '+textureLabel,
    stickerGraphic,
    'ขอบพื้นต้องเสมอกรอบพื้นที่บูธ ห้ามทำเป็นพรมผืนเล็กหรือพรมแยกชิ้น ห้ามล้นออกนอกกรอบ ห้ามมีขอบพรม/ฐานดำเพิ่ม และห้ามเว้นช่องระหว่างพรมกับผนัง',
    'แนวพื้นที่ใช้งานที่มองเห็นภายในผนังอยู่ประมาณ X='+promptNumber(innerStartX)+' ถึง X='+promptNumber(innerEndX)+' ม. และ Z='+promptNumber(innerStartZ)+' ถึง Z='+promptNumber(depth)+' ม. '+(curve?'โดยแนวผนังหลังเปลี่ยนตามส่วนโค้งและระยะจริงตาม R':'')+' แต่ห้ามเปลี่ยนขนาดพื้นเต็ม W×D',
    'เมื่อตรวจจากมุมมองด้านบน มุมและขอบพรมต้องตรงกับกรอบบูธและแนวฐานผนังทุกด้านที่มีจริง โดยเฉพาะมุมผนังหลัง–ผนังซ้าย/ขวา · ให้ยึดผังด้านบนและตัวเลขนี้ก่อนมุมมอง perspective',
    'ผนังจริง '+(walls.length?walls.map(wallName).join(' + '):'ไม่มี')+' · ความหนาผนังทุกด้าน '+promptNumber(thickness)+' ม. · ผนังต้องตั้งฉากกับพื้นและเริ่มจากแนวขอบเดียวกับพื้น',
    wallSegments.length?'รายละเอียดแนวผนัง:\n'+wallSegments.join('\n'):'',
    wallStickerSegments.length?'รายละเอียดสติ๊กเกอร์ผนัง (ต้องคงตามแบบ):\n'+wallStickerSegments.join('\n'):'',
    'ข้อบังคับเรขาคณิต: ห้ามเพิ่ม ลด เลื่อน หมุน เอียง หรือตัดผนังและพื้น ห้ามเปลี่ยนสัดส่วน W/D/H ห้ามเพิ่มผนังที่ไม่มีในรูปแบบบูธที่เลือก และห้ามใช้เลนส์กว้างจนทำให้แนวขอบดูคลาดเคลื่อน'
  ].filter(Boolean).join('\n');
}
function objectLayoutPrompt(){
  const boothType=typ()||{},width=promptSafeNumber(S.W),depth=promptSafeNumber(S.D),height=promptSafeNumber(S.H);
  const walls=(boothType.walls||[]).map(face=>WALL_FACES.find(item=>item.k===face)?.n||face).join(', ')||'ไม่มี';
  const openFaceName={back:'ด้านหลัง',left:'ด้านซ้าย',right:'ด้านขวา'};
  const openFaces=['back','left','right'].filter(face=>!(boothType.walls||[]).includes(face))
    .map(face=>openFaceName[face]||face);
  const objects=Array.isArray(S.objects)?S.objects:[];
  const header=[
    'ข้อมูลผังบูธและตำแหน่งอุปกรณ์ (ต้องคงตามแบบ 3D)',
    'ระบบอ้างอิงตำแหน่ง: มุมหลังซ้ายของพื้นบูธเป็นจุดเริ่มต้น; แกน X จากซ้ายไปขวา, แกน Y จากพื้นขึ้นด้านบน, แกน Z จากด้านหลังไปด้านหน้า; หน่วยเมตร',
    'การจัดวาง Asset ใช้ Snap ระยะ 5 ซม. (0.05 ม.) โดยไม่แสดงเส้นกริด · พิกัดที่ระบุคือจุดกึ่งกลางฐานและต้องคงตามค่า',
    'ขนาดบูธ: กว้าง '+promptNumber(width)+' ม. × ลึก '+promptNumber(depth)+' ม. × สูง '+promptNumber(height)+' ม.',
    'ผนังที่มีจริง: '+walls,
    'ด้านเปิดและทางเดิน: '+(openFaces.length?openFaces.join(', ')+' และด้านหน้า':'ด้านหน้าเท่านั้น')
  ];
  if(boothType.note)header.push('รายละเอียดรูปแบบบูธ: '+boothType.note);
  if(!objects.length)return header.concat('อุปกรณ์ที่ลูกค้าเลือกและต้องคงตำแหน่ง: ไม่มี',
    'เป้าหมายภาพ: แสดงบูธที่เปิดใช้งานจริงด้วย AI AUTO-STAGING ที่ได้รับอนุญาต โดยห้ามเปลี่ยน Geometry พิกัด สัดส่วน และมุมกล้องจากแบบ 3 มิติ').join('\n');
  const records=objects.map((obj,index)=>{
    const item=objectCatalogDef(obj.catalogId),position=obj.position||{},size=obj.size||item?.size||{},distances=promptObjectWallDistances(obj);
    const name=obj.label||item?.name||'อุปกรณ์กำหนดเอง',rotation=promptSafeNumber(obj.rotationY),rotationX=promptSafeNumber(obj.rotationX),rotationZ=promptSafeNumber(obj.rotationZ),x=promptSafeNumber(position.x),z=promptSafeNumber(position.z);
    const baseY=promptSafeNumber(position.y),heightM=promptSafeNumber(size.h),oriented=sceneObjectOrientedSize(obj,size);
    normalizeSceneObjectModel(obj,item);return{
      index:index+1,name,x,z,baseY,heightM,
      normalizedX:width?x/width:0,normalizedZ:depth?z/depth:0,
      size:{w:promptSafeNumber(size.w),d:promptSafeNumber(size.d),h:heightM},
      rotation,rotationX,rotationZ,orientation:obj.orientation||'horizontal',groupId:obj.groupId||null,orientedSize:oriented,zone:promptObjectZone(obj),attachment:obj.attachment?JSON.parse(JSON.stringify(obj.attachment)):null,
      placement:obj.placement?JSON.parse(JSON.stringify(obj.placement)):null,transform:obj.transform?JSON.parse(JSON.stringify(obj.transform)):null,
      appearance:obj.appearance?{color:obj.appearance.color||null,textureName:obj.appearance.textureName||null}:null,
      distance_to_walls_m:{left:distances.left,right:distances.right,back:distances.back,front_open:distances.front}
    };
  });
  const readable=records.map(record=>{
    const d=record.distance_to_walls_m,s=record.size;
    const source=objects[record.index-1],frame=isEntranceFrameObject(source)?normalizeEntranceFrameObject(source).structure:null;
    const frameDetail=frame?' · เป็นโครงรูปตัว L เปิดโล่งใต้คาน: แผ่นคานบนกว้าง '+promptNumber(frame.pierWidth)+' ม. ยื่นจากผนังหลัง '+promptNumber(frame.projection)+' ม. หนา '+promptNumber(frame.thickness)+' ม.; เสาหน้ากว้าง '+promptNumber(frame.pierWidth)+' ม. สูง '+promptNumber(frame.height)+' ม. หนา '+promptNumber(frame.thickness)+' ม.; สี '+frame.color.toUpperCase()+'; ต้องเชื่อมกับผนังหลังและห้ามปิดช่องทางเข้า':'';
    const beam=isDownlightBeamObject(source)?normalizeDownlightBeamObject(source).structure:null;
    const beamDetail=beam?' · เป็นคานแขวนแนวนอน: ยาว '+promptNumber(beam.length)+' ม. × ลึก '+promptNumber(beam.depth)+' ม. × หนา '+promptNumber(beam.thickness)+' ม. · ระดับท้องคาน '+promptNumber(beam.height-beam.thickness)+' ม. · ฝังดาวน์ไลท์ '+beam.lightCount+' ดวง กระจายเท่ากันและส่องลงพื้น · สีคาน '+beam.color.toUpperCase()+' · สีแสง '+beam.lightColor.toUpperCase():'';
    const attachmentDetail=record.attachment?' · ความสัมพันธ์โครงสร้าง: '+sceneAttachmentLabel(record.attachment)+' และต้องรักษารอยต่อกับชิ้นเป้าหมายให้ตรงกัน':'';
    const surfaceDetail=record.placement?.mode==='surface'?' · Snap อยู่กับพื้นผิว '+String(record.placement.surface||'surface')+
      ' ของ '+String(record.placement.targetId||'ชิ้นส่วนบูธ')+' ต้องรักษาการสัมผัสและระดับ Y นี้ไว้':'';
    const anchor=record.placement?.anchorAttachment,anchorDetail=anchor?' · จุดยึดแม่เหล็ก '+String(anchor.sourceAnchorId||'anchor')+
      ' ชน '+String(anchor.targetId||'target')+' / '+String(anchor.targetAnchorId||'anchor')+' ต้องรักษามุมหรือกึ่งกลางที่ชนกันนี้ไว้':'';
    const flipDetail=record.transform?.flipX||record.transform?.flipY?' · กลับด้าน '+[record.transform.flipX?'ซ้าย–ขวา':'',record.transform.flipY?'บน–ล่าง':''].filter(Boolean).join(' และ ')+' ตามแบบ':'';
    const appearanceDetail=record.appearance?.textureName?' · พื้นผิวใช้สติ๊กเกอร์ '+record.appearance.textureName:record.appearance?.color?' · สีพื้นผิว '+String(record.appearance.color).toUpperCase():'';
    const groupDetail=record.groupId?' · อยู่ใน Group '+record.groupId+' ต้องรักษาระยะสัมพัทธ์กับสมาชิกกลุ่ม':'';
    const orientationLabel=ASSET_ORIENTATION_PRESETS[record.orientation]?.label||record.orientation,oriented=record.orientedSize;
    return'- ชิ้นที่ '+record.index+': '+record.name+' 1 ชิ้น · จุดอ้างอิงกลางฐาน X '+promptNumber(record.x)+' ม., Z '+promptNumber(record.z)+' ม. · ตำแหน่งสัมพัทธ์ X '+promptNumber(record.normalizedX*100,1)+'% / Z '+promptNumber(record.normalizedZ*100,1)+'% · ฐานสูงจากพื้น '+promptNumber(record.baseY)+' ม. · ขนาดชิ้นงานเดิม กว้าง '+promptNumber(s.w)+' × ลึก '+promptNumber(s.d)+' × สูง '+promptNumber(s.h)+' ม. · แนววาง '+orientationLabel+' · หมุนแกน X/Y/Z '+promptNumber(record.rotationX)+'° / '+promptNumber(record.rotation)+'° / '+promptNumber(record.rotationZ)+'° · ขอบเขตหลังหมุน '+promptNumber(oriented.w)+' × '+promptNumber(oriented.d)+' × '+promptNumber(oriented.h)+' ม. · โซน '+record.zone+' · ระยะจากขอบ ซ้าย '+promptNumber(d.left)+' / ขวา '+promptNumber(d.right)+' / หลัง '+promptNumber(d.back)+' / ด้านหน้า '+promptNumber(d.front_open)+' ม.'+groupDetail+flipDetail+appearanceDetail+frameDetail+beamDetail+attachmentDetail+surfaceDetail+anchorDetail;
  }).join('\n');
  return header.concat('อุปกรณ์ที่ลูกค้าเลือกและตำแหน่งที่ต้องคงเดิม:',readable,
    'ข้อบังคับสำหรับอุปกรณ์ที่ลูกค้าเลือก: ห้ามเพิ่ม ลด ย้าย หรือหมุน ห้ามเปลี่ยนขนาดและจำนวน ให้ยึดตำแหน่งและระยะจากผนังตามรายการนี้ ส่วน AI AUTO-STAGING เติมได้เฉพาะองค์ประกอบใหม่ที่ไม่ชนหรือซ้อนกับรายการเหล่านี้').join('\n');
}
const PROMPT_FIDELITY_MIN=0,PROMPT_FIDELITY_MAX=10;
function promptFidelityValue(value=S.stagingFreedom){
  const numeric=Number(value);
  return Number.isFinite(numeric)?clampNumber(Math.round(numeric),PROMPT_FIDELITY_MIN,PROMPT_FIDELITY_MAX):6;
}
function promptFidelityGuidance(value=S.stagingFreedom){
  const level=promptFidelityValue(value);
  if(level===0)return'ไม่เติมองค์ประกอบเกินกว่าหมวดที่เลือก และเว้นพื้นที่ว่างให้มากที่สุด';
  if(level<=3)return'เติมองค์ประกอบเพียงเล็กน้อย เน้นความโล่งและการใช้งานที่จำเป็น';
  if(level<=6)return'เติมองค์ประกอบในระดับสมดุล โดยไม่เปลี่ยน Geometry ที่ล็อกไว้';
  if(level<=8)return'เพิ่มรายละเอียดการจัดฉากได้มากขึ้น แต่ยังต้องไม่ชนอุปกรณ์เดิมหรือกีดขวางทางเดิน';
  return'จัดฉากได้เต็มขึ้นภายในหมวดที่อนุญาต โดย Geometry 3D ยังคงล็อกที่ 10/10';
}
function syncPromptFidelityControls(){
  const value=promptFidelityValue();
  const range=document.getElementById('promptFidelityRange');if(range)range.value=value;
  const field=document.getElementById('promptFidelityVal');
  if(field&&document.activeElement!==field)field.value=value;
  const note=document.getElementById('promptFidelityNote');if(note)note.textContent=promptFidelityGuidance(value);
}
function setPromptFidelity(value){
  const numeric=Number(value);
  if(!Number.isFinite(numeric)){syncPromptFidelityControls();return false;}
  S.stagingFreedom=promptFidelityValue(numeric);S.promptFidelity=S.stagingFreedom;
  syncPromptFidelityControls();updatePromptPreview();return true;
}
function syncPromptRenderStyleControls(){
  const state=normalizeAIRenderingSettings(S),style=aiRenderStyle(state.renderStyle);
  const select=document.getElementById('promptRenderStyle');if(select&&select.value!==style.key)select.value=style.key;
  const note=document.getElementById('promptRenderStyleNote');if(note)note.textContent=style.prompt;
}
function setPromptRenderStyle(value){
  const state=normalizeAIRenderingSettings(S),style=aiRenderStyle(value);
  state.renderStyle=style.key;syncPromptRenderStyleControls();updatePromptPreview();return style;
}
function syncPromptStagingControls(){
  const state=normalizeAIStagingSettings(S),container=document.getElementById('promptStagingControl');
  if(container)container.classList.toggle('is-disabled',!state.enabled);
  document.querySelectorAll('[data-staging-enabled]').forEach(button=>button.setAttribute('aria-checked',String((button.dataset.stagingEnabled==='true')===state.enabled)));
  const density=document.getElementById('promptStagingDensity');if(density){density.value=state.density;density.disabled=!state.enabled;}
  const controls={promptStagingFurniture:state.allowFurniture,promptStagingProducts:state.allowProducts,promptStagingPeople:state.allowPeople,
    promptStagingDecor:state.allowDecor&&state.allowPlants};
  Object.entries(controls).forEach(([id,checked])=>{const input=document.getElementById(id);if(input){input.checked=checked;input.disabled=!state.enabled;}});
}
function setPromptStagingEnabled(enabled){
  normalizeAIStagingSettings(S).enabled=enabled===true;normalizeAIRenderingSettings(S);syncPromptStagingControls();updatePromptPreview();
}
function setPromptStagingDensity(value){
  const state=normalizeAIStagingSettings(S);state.density=['low','medium','high'].includes(value)?value:'medium';syncPromptStagingControls();updatePromptPreview();
}
function setPromptStagingPermission(key,value){
  const state=normalizeAIStagingSettings(S),enabled=value===true;
  if(key==='decorPlants'){state.allowDecor=enabled;state.allowPlants=enabled;}
  else if(['allowFurniture','allowProducts','allowPeople'].includes(key))state[key]=enabled;
  normalizeAIRenderingSettings(S);syncPromptStagingControls();updatePromptPreview();
}
function businessCategoryLabel(spec=S){
  const category=ALLCATS.find(item=>item.k===spec.cat),custom=String(spec.customBusinessCategory||'').trim();
  return spec.cat==='other'&&custom?custom:(category?.n||spec.cat||'ไม่ระบุ');
}
function businessCategoryPromptLines(spec=S){
  const api=globalThis.YPQuickSetupContext;if(!api?.categoryPromptLines)return[];
  const userChoices=(spec.objects||[]).map(object=>objectCatalogDef(object.catalogId)?.name||object.name||'').filter(Boolean);
  return api.categoryPromptLines({categoryId:spec.cat,categoryLabel:businessCategoryLabel(spec),customBusinessCategory:spec.customBusinessCategory,userChoices}).slice(1);
}
function buildFullDesignPrompt(){
  const boothType=typ()||{};
  const business=businessCategoryLabel(S);
  const stagingFreedom=promptFidelityValue();
  const staging=normalizeAIStagingSettings(S);
  const renderStyle=aiRenderStyle(normalizeAIRenderingSettings(S).renderStyle);
  const floor=(()=>{try{return floorName();}catch(e){return S.floor||'ไม่ระบุ';}})();
  const logoType=LOGOTYPES.find(item=>item.k===S.logoType)?.n||S.logoType||'ไม่ระบุ';
  const logoShape=LOGOSHAPES.find(item=>item.k===S.logoShape)?.n||S.logoShape||'ไม่ระบุ';
  const lockup=LOCKUPS.find(item=>item.k===S.lockup)?.n||S.lockup||'ไม่ระบุ';
  const wallFaces=(boothType.walls||[]).map(face=>WALL_FACES.find(item=>item.k===face)?.n||face).join(', ')||'ไม่มี';
  const lights=S.lights?(()=>{
    const model=lightModelDef()?.n||S.lightFixture||'ไม่ระบุ';
    const colour=LIGHTCOL.find(item=>item.k===S.lightCol)?.n||S.lightCol||'ไม่ระบุ';
    const wall=LIGHTWALL.find(item=>item.k===S.lightWall)?.n||S.lightWall||'ไม่ระบุ';
    const watt=lightWattDef()?.n||S.lightWatts||'ไม่ระบุ';
    return model+' · '+colour+' · '+wall+' · '+lightTotal()+' จุด · '+watt+' / ดวง';
  })():'ไม่มี';
  const store=hasStore()?stChosenLabel():'ไม่มี';
  const storeHeight=hasStore()?(()=>{try{return storeGeom(boothWallThickness(S)).h.toFixed(2)+' ม.';}catch(e){return'';}})():'';
  const categorySuggestions=businessCategoryPromptLines(S);
  const autoStagingLines=globalThis.YPAIStaging?.buildAutoStagingPromptLines({settings:staging,selectedAssetCount:S.objects.length,
    business,brandColor:S.primary,renderStyle:renderStyle.th+' ('+renderStyle.en+')',categorySuggestions,
    geometryFidelity:S.geometryFidelity,stagingFreedom})||[];
  return[
    'สร้างภาพเรนเดอร์ 3D ของบูธแสดงสินค้าแบบสมจริง',
    'ประเภทธุรกิจ: '+business,
    'สีแบรนด์หลัก: '+String(S.primary||'#2E7D4F').toUpperCase()+' · ใช้เป็นสีหลักขององค์ประกอบ กราฟิก และจุดเน้นของบูธ',
    'สีแบรนด์รอง: '+String(S.secondary||'ไม่ระบุ').toUpperCase()+' · ใช้เสริมโดยไม่กลบสีหลัก',
    'สไตล์การออกแบบและเรนเดอร์: '+renderStyle.th+' ('+renderStyle.en+')',
    'แนวทางสไตล์: '+renderStyle.prompt,
    '',
    'LAYER A — LOCKED 3D GEOMETRY',
    'Geometry Fidelity: '+S.geometryFidelity+'/10 · ใช้ Screenshot และข้อมูลจากระบบ 3D เป็น Geometry Reference แบบบังคับ',
    'รูปแบบบูธ: '+(boothType.n||S.type||'ไม่ระบุ'),
    'ขนาดบูธ (ต้องคงที่): กว้าง '+S.W+' ม. × ลึก '+S.D+' ม. × สูง '+S.H+' ม. — ห้าม AI เปลี่ยนแปลง',
    'ผนังที่ใช้งาน: '+wallFaces,
    'พื้น: '+(S.raise?'ยกพื้น '+S.raise+' ซม. · ':'ไม่ยกพื้น · ')+floor,
    'ผิวผนัง: '+wallFinishSummary(),
    boothGeometryPrompt(),
    ...(S.type==='photo360'?['แท่นยืนวงกลมสำหรับมุมถ่ายภาพ 360: เส้นผ่านศูนย์กลาง 1.00 ม. × สูง 0.10 ม. · อยู่กึ่งกลางด้านหน้าผนังโค้ง']:[]),
    ...(S.type==='island'
      ?['โลโก้และชื่อแบรนด์: ไม่มี']
      :['โลโก้: '+logoType+' · รูปทรง '+logoShape+' · '+lockup+' · ขนาดโลโก้ '+S.logoScale+'/'+BRAND_SCALE_MAX+' · '+logoPlacementSummary(S),
        'ชื่อแบรนด์: '+(S.brand||'YOUR BRAND')+' · ขนาดชื่อ '+S.nameScale+'/'+BRAND_SCALE_MAX]),
    'ห้องเก็บของ: '+store+(storeHeight?' · สูง '+storeHeight:''),
    'แสงสว่าง: '+lights,
    'อุปกรณ์ที่ลูกค้าเลือกและต้องคงตำแหน่ง: '+objectListLabel(),
    objectLayoutPrompt(),
    'ข้อกำหนด LOCKED: ต้องคงขนาดพื้นที่ พื้น ระดับพื้น ผนัง ห้องเก็บของ โลโก้ ป้ายแบรนด์ และพิกัด/ขนาด/การหมุนของอุปกรณ์ที่ลูกค้าเลือกตามแบบเดิมทั้งหมด',
    'ห้ามเพิ่มหรือเปลี่ยนโครงสร้างถาวรที่ไม่มีในแบบ แต่อนุญาตให้เพิ่มเฟอร์นิเจอร์ลอยตัว สินค้า คน พร็อพ และของตกแต่งที่เหมาะกับหมวดธุรกิจ เพื่อทำให้ภาพสมบูรณ์และสื่อถึงการใช้งานจริงตามกฎ LAYER B',
    '',
    ...autoStagingLines,
    '',
    'มุมมอง: perspective ระดับสายตา เน้นสัดส่วนจริง วัสดุ เงา และแสงสมจริง'
  ].join('\n');
}
function compactSelectedObjectLines(){
  const objects=Array.isArray(S.objects)?S.objects:[];
  if(!objects.length)return['อุปกรณ์ที่ลูกค้าเลือกและต้องคงตำแหน่ง: ไม่มี'];
  return['อุปกรณ์ที่ลูกค้าเลือกและต้องคงตำแหน่ง ('+objects.length+' ชิ้น):'].concat(objects.map((obj,index)=>{
    const item=objectCatalogDef(obj.catalogId),position=obj.position||{},size=obj.size||item?.size||{};
    const oriented=sceneObjectOrientedSize(obj,size),attachment=obj.attachment?' · ต่อกับ '+sceneAttachmentLabel(obj.attachment):'';
    const surface=obj.placement?.mode==='surface'?' · Snap '+String(obj.placement.surface||'surface')+' กับ '+String(obj.placement.targetId||'โครงสร้าง'):'';
    return'- '+(index+1)+' '+(obj.label||item?.name||'Asset')+' ['+(obj.id||obj.catalogId||'object')+']'+
      ' · จุดกลางฐาน XYZ '+promptNumber(position.x)+'/'+promptNumber(position.y)+'/'+promptNumber(position.z)+' ม.'+
      ' · ขนาด W/D/H '+promptNumber(size.w)+'/'+promptNumber(size.d)+'/'+promptNumber(size.h)+' ม.'+
      ' · หมุน XYZ '+promptNumber(obj.rotationX)+'°/'+promptNumber(obj.rotationY)+'°/'+promptNumber(obj.rotationZ)+'°'+
      ' · ขอบเขตหลังหมุน '+promptNumber(oriented.w)+'/'+promptNumber(oriented.d)+'/'+promptNumber(oriented.h)+' ม.'+attachment+surface;
  }));
}
function buildCompactDesignPrompt(){
  const boothType=typ()||{},business=businessCategoryLabel(S),staging=normalizeAIStagingSettings(S);
  const stagingFreedom=promptFidelityValue(),renderStyle=aiRenderStyle(normalizeAIRenderingSettings(S).renderStyle);
  const walls=boothType.walls||[],wallFaces=walls.map(face=>WALL_FACES.find(item=>item.k===face)?.n||face).join(', ')||'ไม่มี';
  const openFaces=['left','right','back'].filter(face=>!walls.includes(face)).map(face=>({left:'ซ้าย',right:'ขวา',back:'หลัง'})[face]);
  const floor=(()=>{try{return floorName();}catch(e){return S.floor||'ไม่ระบุ';}})();
  const wallThickness=boothWallThickness(S),floorLevel=promptSafeNumber(S.raise)/100;
  const geometry=[
    'รูปแบบ '+(boothType.n||S.type)+' · W/D/H '+promptNumber(S.W)+'/'+promptNumber(S.D)+'/'+promptNumber(S.H)+' ม.',
    'ระบบพิกัดครั้งเดียว: origin มุมหลังซ้ายบนพื้น, X ซ้าย→ขวา, Y ล่าง→บน, Z หลัง→หน้า, หน่วยเมตร',
    'พื้นเต็มกรอบ X 0–'+promptNumber(S.W)+', Z 0–'+promptNumber(S.D)+', ระดับบน Y '+promptNumber(floorLevel)+' · '+(S.raise?'ยก '+S.raise+' ซม.':'ไม่ยกพื้น')+' · '+floor,
    'ผนัง '+wallFaces+' · หนา '+promptNumber(wallThickness)+' ม. · สูง '+promptNumber(S.H)+' ม. · ด้านเปิด '+(openFaces.length?openFaces.join(', ')+' และหน้า':'หน้า'),
    ...(S.type==='photo360'?['ผนังหลังโค้ง R '+promptNumber(S.wallRadius)+' ม. และแท่นวงกลม Ø1.00 × สูง 0.10 ม. กึ่งกลาง']:[]),
    'ผิวผนัง '+wallFinishSummary()
  ];
  if(S.floor==='sticker'&&S.floorStickerData)geometry.push('กราฟิกพื้น '+(S.floorStickerName||'ไฟล์ลูกค้า')+' · '+promptNumber(S.floorStickerW)+' × '+promptNumber(S.floorStickerD)+' ม. · กึ่งกลาง · หมุน '+promptNumber(S.floorStickerRotation)+'° · รักษาสัดส่วนภาพ');
  (S.wallStickerFaces||[]).forEach(face=>{
    const sticker=S.wallStickers?.[face];if(!sticker?.data)return;
    geometry.push('กราฟิก'+(WALL_FACES.find(item=>item.k===face)?.n||face)+' '+(sticker.name||'ไฟล์ลูกค้า')+' · '+promptNumber(sticker.w)+' × '+promptNumber(sticker.h)+' ม. · หมุน '+promptNumber(sticker.rotation)+'° · รักษาสัดส่วนภาพ');
  });
  if(hasStore())geometry.push('ห้องเก็บของ '+stChosenLabel()+' · รักษาขนาด ตำแหน่ง และช่องประตูจาก Screenshot');
  if(S.type!=='island')geometry.push('Branding: โลโก้ '+(LOGOTYPES.find(item=>item.k===S.logoType)?.n||S.logoType)+' ขนาด '+S.logoScale+'/'+BRAND_SCALE_MAX+
    ' · ชื่อ “'+(S.brand||'YOUR BRAND')+'” ขนาด '+S.nameScale+'/'+BRAND_SCALE_MAX+' · '+logoPlacementSummary(S));
  const categorySuggestions=businessCategoryPromptLines(S);
  const autoStagingLines=globalThis.YPAIStaging?.buildAutoStagingPromptLines({settings:staging,selectedAssetCount:S.objects.length,
    business,brandColor:S.primary,renderStyle:renderStyle.th+' ('+renderStyle.en+')',categorySuggestions,
    geometryFidelity:S.geometryFidelity,stagingFreedom})||[];
  return[
    'สร้างภาพบูธแสดงสินค้าที่เปิดใช้งานจริงแบบ Photorealistic โดยใช้ Clean Screenshot เป็น Geometry Reference แบบบังคับ',
    'ธุรกิจ '+business+' · สีหลัก '+String(S.primary||'#2E7D4F').toUpperCase()+' · สีรอง '+String(S.secondary||'ไม่ระบุ').toUpperCase(),
    'สไตล์ '+renderStyle.th+' ('+renderStyle.en+') · '+renderStyle.prompt,
    '',
    'LAYER A — LOCKED 3D GEOMETRY · Fidelity '+S.geometryFidelity+'/10',
    ...geometry,
    ...compactSelectedObjectLines(),
    'LOCK: คงขนาด ผัง พื้น ผนัง ห้อง Branding ช่องเปิด มุมกล้อง จำนวน และ Transform ของทุกชิ้นตาม Screenshot/รายการ ห้ามย้าย ลบ เพิ่ม หรือเปลี่ยนสัดส่วนโครงสร้างถาวร',
    '',
    ...autoStagingLines,
    '',
    'RENDER: คง Perspective เดิม ใช้วัสดุ PBR, global illumination, ambient occlusion, contact shadows, realistic reflections และแสง Exhibition Hall แบบมืออาชีพ',
    'ผลลัพธ์ต้องลบ Grid เส้นแกน ตัวเลข Bounding Box และ UI ทั้งหมด และต้องผลิตก่อสร้างได้จริง'
  ].filter(Boolean).join('\n');
}
function currentPromptVariant(){return normalizeAIRenderingSettings(S).promptVariant;}
function currentRenderIntent(){return normalizeAIRenderingSettings(S).renderIntent;}
function currentRenderQuality(){return normalizeAIRenderingSettings(S).quality;}
function conceptPromptContext(){
  const type=typ()||{},floor=(()=>{try{return(S.raise?'ยกพื้น '+S.raise+' ซม.':'ไม่ยกพื้น')+' · '+floorName();}catch(e){return S.floor||'ไม่ระบุ';}})();
  return{business:businessCategoryLabel(S),primary:S.primary,secondary:S.secondary,style:aiRenderStyle(normalizeAIRenderingSettings(S).renderStyle).th+
    ' ('+aiRenderStyle(normalizeAIRenderingSettings(S).renderStyle).en+')',floor,hasStorage:hasStore(),booth:{type:type.n||S.type,width:S.W,depth:S.D,height:S.H,openSides:type.s||''}};
}
function buildConceptDesignPrompt(){
  return globalThis.YPAIRenderIntent?.buildConceptPrompt(conceptPromptContext())||'AI CONCEPT DESIGN · '+JSON.stringify(conceptPromptContext());
}
function buildDesignPrompt(variant=currentPromptVariant(),intent=currentRenderIntent()){
  if(intent==='concept')return buildConceptDesignPrompt();
  return variant==='compact'?buildCompactDesignPrompt():buildFullDesignPrompt();
}
function setRenderIntent(value,{update=true}={}){
  normalizeAIRenderingSettings(S).renderIntent=globalThis.YPAIRenderIntent?.normalizeIntent(value)||'from3d';
  if(update)updatePromptPreview();return currentRenderIntent();
}
function setRenderQuality(value){
  normalizeAIRenderingSettings(S).quality=globalThis.YPAIRenderIntent?.normalizeQuality(value)||'preview';
  document.querySelectorAll('[data-render-quality]').forEach(button=>{const on=button.dataset.renderQuality===currentRenderQuality();button.classList.toggle('on',on);button.setAttribute('aria-checked',String(on));});
  return currentRenderQuality();
}
function updatePromptPreview(){
  syncPromptRenderStyleControls();
  syncPromptStagingControls();
  const variant=document.getElementById('promptVariant');if(variant&&variant.value!==currentPromptVariant())variant.value=currentPromptVariant();
  const field=document.getElementById('designPrompt');
  if(field)field.value=buildDesignPrompt(currentPromptVariant(),currentRenderIntent());
}
async function copyDesignPrompt(){
  const field=document.getElementById('designPrompt'),status=document.getElementById('promptStatus');
  if(!field||!field.value)return;
  try{
    let copied=false;
    if(navigator.clipboard?.writeText){try{await navigator.clipboard.writeText(field.value);copied=true;}catch(e){}}
    if(!copied){field.focus();field.select();copied=document.execCommand('copy');field.setSelectionRange(field.value.length,field.value.length);}
    if(!copied)throw new Error('copy failed');
    if(status)status.textContent='คัดลอก PROMPT แล้ว';
  }catch(e){
    if(status)status.textContent='คัดลอกไม่สำเร็จ กรุณาเลือกข้อความแล้วคัดลอกเอง';
  }
  window.clearTimeout(copyDesignPrompt.timer);
  copyDesignPrompt.timer=window.setTimeout(()=>{if(status)status.textContent='';},2400);
}
async function createCleanScreenshot(options={}){
  const renderer=threeRenderer||await loadThreeRenderer();
  renderer.update(BoothSpec);
  return renderer.exportCleanScreenshot(options);
}
async function downloadCleanScreenshot(){
  const button=document.getElementById('promptCleanScreenshot'),status=document.getElementById('promptStatus');
  if(button?.disabled)return;
  if(button)button.disabled=true;if(status)status.textContent='กำลังเตรียม Scene และสร้าง Clean Screenshot…';
  try{
    const result=await createCleanScreenshot({download:true,minLongEdge:1536,maxLongEdge:2048,maxBytes:4*1024*1024,includeDataUrl:false});
    if(status)status.textContent='ดาวน์โหลด '+result.fileName+' ('+result.width+' × '+result.height+' px · '+Math.max(1,Math.round(result.blob.size/1024))+' KB) แล้ว';
  }catch(error){
    console.error('Clean Screenshot export failed',error);
    if(status)status.textContent='สร้าง Clean Screenshot ไม่สำเร็จ กรุณาลองใหม่';
  }finally{
    if(button)button.disabled=false;
    window.clearTimeout(downloadCleanScreenshot.timer);
    downloadCleanScreenshot.timer=window.setTimeout(()=>{if(status)status.textContent='';},5000);
  }
}
const AI_RENDER_DEVELOPMENT=location.hostname===''||location.hostname==='localhost'||location.hostname==='127.0.0.1'||new URLSearchParams(location.search).get('aiRenderDev')==='1';
const aiRenderPipeline=globalThis.YPAIRenderPipeline?.create({development:AI_RENDER_DEVELOPMENT,onStatus:updateAIRenderStatus})||null;
function updateAIRenderStatus(payload={}){
  const progress=document.getElementById('promptRenderProgress'),status=document.getElementById('promptStatus');
  const order=['preparing','uploading','generating','displaying'],activeIndex=order.indexOf(payload.status);
  const uploadStep=document.querySelector('[data-render-step="uploading"]');if(uploadStep)uploadStep.textContent=currentRenderIntent()==='concept'?'กำลังเตรียม Concept':'กำลังอัปโหลดแบบ 3D';
  if(progress)progress.hidden=!order.includes(payload.status)&&payload.status!=='complete'&&payload.status!=='error';
  document.querySelectorAll('[data-render-step]').forEach((step,index)=>{
    step.classList.toggle('is-active',activeIndex===index);
    step.classList.toggle('is-done',payload.status==='complete'||(activeIndex>=0&&index<activeIndex));
    step.classList.toggle('is-error',payload.status==='error'&&index===Math.max(0,activeIndex));
  });
  const statusLabel=payload.status==='uploading'&&currentRenderIntent()==='concept'?'กำลังเตรียม Concept':payload.label;
  if(status)status.textContent=statusLabel+(payload.detail?' · '+payload.detail:'')+(payload.requestId?' · '+payload.requestId:'');
}
function aiReferenceLimits(){
  const size=threeRenderer?.lastSize||[],expectedAspect=Number(size[0])&&Number(size[1])?Number(size[0])/Number(size[1]):0;
  return{minLongEdge:1536,maxLongEdge:2048,maxBytes:4*1024*1024,expectedAspect,aspectTolerance:.005};
}
async function prepareAIRenderReference(){
  return createCleanScreenshot({download:false,minLongEdge:1536,maxLongEdge:2048,maxBytes:4*1024*1024,includeDataUrl:false});
}
function extractAIRenderImage(result){
  if(typeof result==='string'&&/^(data:|blob:|https?:)/.test(result))return result;
  const candidates=[result?.imageUrl,result?.image_url,result?.url,result?.dataUrl,result?.output?.imageUrl,result?.image?.url];
  const found=candidates.find(value=>typeof value==='string'&&value);if(found)return found;
  const blob=result?.imageBlob||result?.blob;return typeof Blob!=='undefined'&&blob instanceof Blob?URL.createObjectURL(blob):'';
}
function matchedConceptSuggestion(source){
  const suggestion={...source},match=globalThis.YPAIRenderIntent?.matchSuggestedAsset(suggestion,allObjectCatalog());
  suggestion.matchedCatalogId=match?.catalogId||null;suggestion.matchName=match?.item?.name||'';
  if(!suggestion.renderOnly&&!match){suggestion.renderOnly=true;suggestion.status='Render Staging เท่านั้น · ไม่พบโมเดล 3D ที่ตรง';}
  return suggestion;
}
function renderAIConceptProposal(){
  const panel=document.getElementById('conceptProposal'),list=document.getElementById('conceptProposalList'),summary=document.getElementById('conceptProposalSummary');
  if(!panel||!list||!summary)return;const proposal=aiConceptUI.proposal,suggestions=aiConceptUI.suggestions;
  panel.hidden=!proposal;if(!proposal)return;
  summary.textContent=proposal.summary||'AI เสนอองค์ประกอบสำหรับทำให้บูธพร้อมใช้งานจริง กรุณาตรวจและยืนยันก่อนเพิ่มลง Project';
  if(!suggestions.length)list.innerHTML='<div class="asset-list-empty">ผลลัพธ์นี้ไม่มี Asset 3D ที่เสนอเพิ่มเติม</div>';
  else list.innerHTML=suggestions.map(item=>'<label class="concept-proposal-row"><input type="checkbox" data-concept-suggestion="'+esc(item.id)+'" '+(aiConceptUI.selectedIds.has(item.id)?'checked ':'')+(item.confirmed?'disabled ':'')+'><span><b>'+esc(item.name)+'</b><small>'+esc(item.category+' · '+item.dimensions.w.toFixed(2)+' × '+item.dimensions.d.toFixed(2)+' × '+item.dimensions.h.toFixed(2)+' ม.'+(item.matchName?' · จับคู่ '+item.matchName:''))+'</small></span><span class="concept-proposal-status">'+esc(item.status)+'</span></label>').join('');
  list.querySelectorAll('[data-concept-suggestion]').forEach(input=>input.onchange=()=>{input.checked?aiConceptUI.selectedIds.add(input.dataset.conceptSuggestion):aiConceptUI.selectedIds.delete(input.dataset.conceptSuggestion);});
  renderAssetList();
}
function setAIConceptProposal(result){
  const proposal=globalThis.YPAIRenderIntent?.normalizeSceneProposal(result)||{summary:'',suggestedAssets:[]};
  aiConceptUI.proposal=proposal;aiConceptUI.suggestions=proposal.suggestedAssets.map(matchedConceptSuggestion);aiConceptUI.selectedIds=new Set(aiConceptUI.suggestions.map(item=>item.id));renderAIConceptProposal();return proposal;
}
function displayAIRenderOutcome(report,intent){
  const raw=report?.rawResult&&typeof report.rawResult==='object'?report.rawResult:{},displayed=report?.result&&typeof report.result==='object'?report.result:{},result=typeof report?.result==='string'?report.result:{...raw,...displayed},panel=document.getElementById('promptRenderResult'),badge=document.getElementById('promptResultBadge'),request=document.getElementById('promptResultRequest'),image=document.getElementById('promptResultImage');
  if(!panel)return;panel.hidden=false;if(badge)badge.textContent=intent==='concept'?'AI Concept — ผังยังไม่ยืนยัน':'3D-Based Render';if(request)request.textContent=report?.requestId||'';
  const src=extractAIRenderImage(result);if(image){image.hidden=!src;if(src)image.src=src;}
  if(intent==='concept')setAIConceptProposal(result);else{aiConceptUI.proposal=null;aiConceptUI.suggestions=[];aiConceptUI.selectedIds.clear();renderAIConceptProposal();renderAssetList();}
  aiConceptUI.lastReport=report;
}
function clearAIConceptProposal(){
  const suggestionIds=new Set(aiConceptUI.suggestions.map(item=>'ai-suggested-'+item.id));setObjectSelection(selectedSceneItemIds().filter(id=>!suggestionIds.has(id)),objectEditor.selectedId&&!suggestionIds.has(objectEditor.selectedId)?objectEditor.selectedId:null);
  aiConceptUI.proposal=null;aiConceptUI.suggestions=[];aiConceptUI.selectedIds.clear();renderAIConceptProposal();syncObjectControls();renderAssetList();
}
function confirmAIConceptSuggestions(mode='selected'){
  const selected=(mode==='all'?aiConceptUI.suggestions:aiConceptUI.suggestions.filter(item=>aiConceptUI.selectedIds.has(item.id))).filter(item=>!item.confirmed);if(!selected.length)return;
  const before=objectSnapshot(),created=[],acceptedRenderOnly=[];
  selected.forEach(suggestion=>{
    if(suggestion.renderOnly||!suggestion.matchedCatalogId){suggestion.confirmed=true;suggestion.status='Render Staging · ยืนยันสำหรับภาพ';acceptedRenderOnly.push(suggestion);return;}
    const obj=makeCatalogObject(suggestion.matchedCatalogId);if(!obj)return;const position=suggestion.position,size=obj.size||suggestion.dimensions;
    if(position){obj.position.x=clampNumber(position.x,size.w/2,Math.max(size.w/2,S.W-size.w/2));obj.position.z=clampNumber(position.z,size.d/2,Math.max(size.d/2,S.D-size.d/2));obj.position.y=Math.max(0,Number(position.y)||0);}
    else{const staging=frontAssetStagingPlacement(size,obj.rotationY||0);obj.position.x=staging.x;obj.position.z=staging.z;obj.placement.allowOutsideBooth=true;}
    obj.rotationY=Number(suggestion.rotationY)||0;obj.aiSource={status:'AI Suggested · ยืนยันแล้ว',proposalId:suggestion.id,renderIntent:'concept'};normalizeSceneObjectModel(obj,objectCatalogDef(obj.catalogId));S.objects.push(obj);created.push(obj);
  });
  if(created.length){recordObjectHistory(before);setObjectSelection(created.map(obj=>obj.id),created.at(-1).id);}
  const createdIds=new Set(selected.filter(item=>!item.renderOnly&&item.matchedCatalogId).map(item=>item.id));aiConceptUI.suggestions=aiConceptUI.suggestions.filter(item=>!createdIds.has(item.id));aiConceptUI.selectedIds=new Set(acceptedRenderOnly.map(item=>item.id));
  sync();renderAIConceptProposal();announceCatalog('ยืนยันและเพิ่ม Asset จาก AI '+created.length+' ชิ้น'+(acceptedRenderOnly.length?' · Render Staging '+acceptedRenderOnly.length+' รายการไม่ถูกเพิ่มเป็น Geometry':''),'success');
}
function syncAIRenderControls(){
  const renders=[document.getElementById('promptRenderConcept'),document.getElementById('promptRender3d')].filter(Boolean),ab=document.getElementById('promptRunAB'),tools=document.getElementById('promptDevTools');
  const ready=!!aiRenderPipeline?.ready(),busy=!!aiRenderPipeline?.active;
  renders.forEach(render=>{render.disabled=!ready||busy;render.setAttribute('aria-disabled',String(!ready||busy));render.title=ready?(busy?'กำลังสร้างภาพ':'สร้างภาพด้วย AI Render Adapter ที่เชื่อมต่อแล้ว'):'ยังไม่ได้เชื่อมต่อ AI Render API';});
  if(tools)tools.hidden=!AI_RENDER_DEVELOPMENT;
  if(ab)ab.disabled=!ready||busy;
  const variant=document.getElementById('promptVariant');if(variant)variant.value=currentPromptVariant();
  setRenderQuality(currentRenderQuality());
}
async function runAIRender(intent=currentRenderIntent()){
  if(!aiRenderPipeline?.ready()){syncAIRenderControls();return null;}
  intent=setRenderIntent(intent);syncAIRenderControls();
  try{
    const concept=intent==='concept',report=await aiRenderPipeline.run({renderIntent:intent,quality:currentRenderQuality(),requiresReference:!concept,
      promptVariant:currentPromptVariant(),buildPrompt:context=>buildDesignPrompt(context.promptVariant,intent),
      prepareReferenceImage:concept?undefined:prepareAIRenderReference,referenceLimits:concept?undefined:aiReferenceLimits(),
      projectContext:concept?conceptPromptContext():{geometryManifest:buildGeometryManifest(S),camera:currentCameraManifest(S)},
      expectedOutput:concept?{image:true,sceneProposal:true,suggestedAssetsStatus:'AI Suggested'}:{image:true,label:'3D-Based Render'}});
    displayAIRenderOutcome(report,intent);return report;
  }catch(error){console.error('AI Render failed',error);return null;}
  finally{syncAIRenderControls();}
}
function formatAIRenderABReport(result){
  if(!result)return'';
  const full=result.full,compact=result.compact,reduction=full.promptCharacters?Math.round((1-compact.promptCharacters/full.promptCharacters)*100):0;
  const largest=report=>Object.entries(report.timings||{}).sort((a,b)=>b[1]-a[1])[0]||['-',0];
  const fullLargest=largest(full),compactLargest=largest(compact);
  return[
    'A/B '+result.abTestId+' · ใช้ภาพอ้างอิงเดียวกัน',
    'Full: '+full.promptCharacters.toLocaleString()+' ตัวอักษร · '+Math.round(full.totalMs)+' ms · ช้าที่สุด '+fullLargest[0]+' '+Math.round(fullLargest[1])+' ms',
    'Compact: '+compact.promptCharacters.toLocaleString()+' ตัวอักษร · '+Math.round(compact.totalMs)+' ms · ช้าที่สุด '+compactLargest[0]+' '+Math.round(compactLargest[1])+' ms',
    'ลดความยาว Prompt '+reduction+'% · คุณภาพภาพต้องตรวจเทียบด้วยสายตาก่อนเลือกใช้จริง'
  ].join('\n');
}
async function runAIRenderABTest(){
  if(!aiRenderPipeline?.ready()){syncAIRenderControls();return null;}
  setRenderIntent('from3d');
  const report=document.getElementById('promptDevReport');if(report)report.textContent='กำลังรัน Full และ Compact ด้วยภาพอ้างอิงเดียวกัน…';
  syncAIRenderControls();
  try{
    const result=await aiRenderPipeline.runABTest({buildFullPrompt:()=>buildFullDesignPrompt(),buildCompactPrompt:()=>buildCompactDesignPrompt(),
      prepareReferenceImage:prepareAIRenderReference,referenceLimits:aiReferenceLimits()});
    if(report)report.textContent=formatAIRenderABReport(result);return result;
  }catch(error){if(report)report.textContent='A/B Test ไม่สำเร็จ · '+(error?.message||error);console.error('AI Render A/B Test failed',error);return null;}
  finally{syncAIRenderControls();}
}
function configureAIRenderAdapter(adapter){const ready=!!aiRenderPipeline?.configure(adapter);syncAIRenderControls();return ready;}
window.YPAIRenderBridge=Object.freeze({
  configureAdapter:configureAIRenderAdapter,
  run:runAIRender,
  runConcept:()=>runAIRender('concept'),
  runFrom3D:()=>runAIRender('from3d'),
  runABTest:runAIRenderABTest,
  buildPrompt:(variant,intent=currentRenderIntent())=>buildDesignPrompt(variant,intent),
  prepareReferenceImage:prepareAIRenderReference,
  setConceptProposal:setAIConceptProposal,
  confirmSuggestions:confirmAIConceptSuggestions,
  rejectSuggestions:clearAIConceptProposal,
  getState:()=>({ready:!!aiRenderPipeline?.ready(),active:aiRenderPipeline?.active||null,lastReport:aiRenderPipeline?.lastReport||null,promptVariant:currentPromptVariant(),renderIntent:currentRenderIntent(),quality:currentRenderQuality(),suggestions:aiConceptUI.suggestions})
});
function hx(h){h=h.replace('#','');if(h.length===3)h=h.split('').map(c=>c+c).join('');
  return[parseInt(h.substr(0,2),16),parseInt(h.substr(2,2),16),parseInt(h.substr(4,2),16)];}
const toHex=a=>'#'+a.map(v=>Math.max(0,Math.min(255,Math.round(v))).toString(16).padStart(2,'0')).join('');
function mix(a,b,t){const A=hx(a),B=hx(b);return toHex([0,1,2].map(i=>A[i]+(B[i]-A[i])*t));}
function shade(h,a){return toHex(hx(h).map(v=>v*a));}
function lum(h){const c=hx(h);return(0.299*c[0]+0.587*c[1]+0.114*c[2])/255;}
function rgb2hsl(r,g,b){r/=255;g/=255;b/=255;const mx=Math.max(r,g,b),mn=Math.min(r,g,b);
  let h=0,s=0;const l=(mx+mn)/2,d=mx-mn;
  if(d){s=l>.5?d/(2-mx-mn):d/(mx+mn);
    h=mx===r?((g-b)/d+(g<b?6:0)):mx===g?((b-r)/d+2):((r-g)/d+4);h*=60;}
  return[h,s,l];}
function hsl2rgb(h,s,l){h=((h%360)+360)%360;const c=(1-Math.abs(2*l-1))*s,x=c*(1-Math.abs((h/60)%2-1)),m=l-c/2;
  const a=h<60?[c,x,0]:h<120?[x,c,0]:h<180?[0,c,x]:h<240?[0,x,c]:h<300?[x,0,c]:[c,0,x];
  return a.map(v=>(v+m)*255);}
function rotate(h,d){const s=rgb2hsl.apply(null,hx(h));return toHex(hsl2rgb(s[0]+d,s[1],s[2]));}
function adjust(h,o){const s=rgb2hsl.apply(null,hx(h));
  return toHex(hsl2rgb(s[0],o.s!=null?o.s:s[1],o.l!=null?o.l:s[2]));}

/* วัดความกว้างข้อความจริง — ภาษาไทยมีสระ/วรรณยุกต์ที่ไม่กินความกว้าง
   การนับจำนวนตัวอักษรจึงคลาดเคลื่อนมาก ต้องวัดด้วย canvas */
const _mc=document.createElement('canvas').getContext('2d');
function unitTextW(t){
  _mc.font='700 100px Inter,"Noto Sans Thai",sans-serif';
  return _mc.measureText(t).width/100 + 0.05*Math.max(0,t.length-1);
}
const cat=()=>ALLCATS.find(c=>c.k===S.cat);
const pair=()=>PAIRS.find(p=>p.k===S.pair);
const cornerSideDef=()=>CORNER_SIDES.find(side=>side.k===S.cornerSide)||CORNER_SIDES[1];
const cornerWallKey=()=>S.cornerSide==='left'?'right':'left';
const typ=()=>{
  const t=TYPES.find(item=>item.k===S.type);
  if(!t||t.k!=='corner')return t;
  const side=cornerSideDef();
  return{...t,n:t.n+' · '+side.n,walls:[...side.walls],note:'บูธหัวมุม '+side.n+' ผนัง '+side.walls.map(w=>WALL_FACES.find(face=>face.k===w)?.n||w).join(' + ')+' เปิดด้านหน้าและด้าน'+side.open};};
const floorDef=()=>FLOORS.find(f=>f.k===S.floor);
const hasStore=()=>S.stSize!=='none';
/* แสดงค่าที่ลูกค้าเลือกเอง ไม่ใช่ค่าที่ระบบหักแล้ว */
function stChosenLabel(){
  if(S.stSize==='full')return'เต็มผนัง';
  if(S.stSize==='custom')return S.stW+' × '+S.stD+' ม.';
  const o=ST_SIZE.find(x=>x.k===S.stSize);return o?o.n+' ม.':'';}
/* ห้องกว้างเกินครึ่งผนัง = ถือว่าผนังห้องคือผนังบูธ → ย้ายชุดโลโก้มาไว้หน้าห้อง */
/* ย้ายโลโก้มาหน้าห้องเฉพาะตอนห้องบังผนังจนแทบไม่เหลือที่ —
   ถ้าเหนือห้องยังเหลือผนังตั้งแต่ 1 ม. ขึ้นไป โลโก้อยู่บนผนังบูธตามเดิม */
/* ช่วงผนังหลังที่ยังว่างจริง — เลือกช่วงกว้างสุดที่ห้องไม่บัง
   คิดเฉพาะตอนห้องสูงพอจะบังแถบโลโก้ ถ้าห้องเตี้ยก็ใช้ผนังเต็มผืนตามเดิม */
function backFreeSpan(t){
  const full={s:0,e:S.W};
  if(!hasStore())return full;
  const G=storeGeom(t), z0=S.raise/100;
  if(z0+G.h < S.H*0.45) return full;            /* ห้องเตี้ย ไม่บังชุดโลโก้ */
  const a=[{s:0,e:G.x},{s:G.x+G.w,e:S.W}].sort((p,q)=>(q.e-q.s)-(p.e-p.s));
  return (a[0].e-a[0].s)>=.8 ? a[0] : full;}

/* ช่วงผนังข้างที่ยังว่างจริง หลังหักส่วนที่ห้องเก็บของบัง */
function sideFreeLen(t){
  const G=hasStore()?storeGeom(t):null;
  const sideWall=cornerWallKey();
  const blocked=(G&&((sideWall==='left'&&G.x<=t+.002)||
    (sideWall==='right'&&G.x+G.w>=S.W-t-.002)))?(G.y+G.d):0;
  return Math.max(0,S.D-blocked);}
const wallAboveStore=()=>{const G=storeGeom(boothWallThickness(S));return S.H-((S.raise/100)+G.h);};
const lockOnStore=()=>hasStore()&&storeGeom(boothWallThickness(S)).w>S.W*0.5&&wallAboveStore()<1.0;
/* ประตูห้อง: ด้านที่ชิดผนังบูธเปิดไม่ได้ ต้องเลี่ยงไปด้านอื่น */
function doorBlocked(side,t){
  const wl=typ().walls,G=storeGeom(t),e=.002;
  if(side==='left')  return wl.indexOf('left')>=0 && G.x<=t+e;
  if(side==='right') return wl.indexOf('right')>=0 && (G.x+G.w)>=S.W-t-e;
  return false;
}
/* ---- ไฟสปอตไลท์บนผนัง ----
   ระยะมาตรฐานขึ้นกับรุ่นโคม · ห้องสูงตั้งแต่ 70% จะหักช่วงผนังที่บังออกก่อนคำนวณ */
function lightBlocker(t){
  if(!hasStore())return null;
  const room=storeGeom(t);
  return room.h>=S.H*STORAGE_LIGHT_BLOCK_RATIO?room:null;
}
function lightSpans(t){
  const out=[],wl=typ().walls,G=lightBlocker(t),e=.002;
  const want=k=> S.lightWall==='all' ? wl.indexOf(k)>=0 : (k==='back'&&wl.indexOf('back')>=0);
  const add=(w,s,end)=>{if(end-s>e)out.push({w,s,e:end});};
  if(want('back')){
    if(G){add('back',0,G.x);add('back',G.x+G.w,S.W);}
    else add('back',0,S.W);
  }
  if(want('left')){
    if(G&&G.x<=t+e)add('left',G.y+G.d,S.D);
    else add('left',0,S.D);
  }
  if(want('right')){
    if(G&&G.x+G.w>=S.W-t-e)add('right',G.y+G.d,S.D);
    else add('right',0,S.D);
  }
  return out;}
function lightSpacing(){
  const spacing=lightModelDef()?.spacing;
  return Number.isFinite(spacing)&&spacing>0?spacing:LIGHT_SPACING;}
function lightAutoCount(length){
  const spacing=lightSpacing(),rule=lightModelDef()?.spacingRule;
  if(length<.5)return 0;
  /* Clear Light ใช้ระยะขั้นต่ำ: ถ้าแบ่งไม่ลงตัวให้เหลือจำนวนดวงที่ทำให้
     ค่าเฉลี่ยไม่ถี่กว่า 2 ม. แล้วกระจายเท่า ๆ กันตลอดช่วง */
  const raw=length/spacing,count=rule==='min'?Math.floor(raw):Math.round(raw);
  return Math.max(1,count);}
function lightCounts(t){
  const sp=lightSpans(t);
  const n=sp.map(x=>lightAutoCount(x.e-x.s));
  const model=lightModelDef(),isArm=model?.k==='arm',backClearance=isArm&&Number.isFinite(model?.backWallClearance)?Math.max(0,model.backWallClearance):0,spacing=lightSpacing(),eps=.003;
  if(isArm&&backClearance>0)sp.forEach((x,i)=>{
    if(x.w!=='back')return;
    const atStart=Math.abs(x.s)<eps,atEnd=Math.abs(x.e-S.W)<eps;
    if(!atStart&&!atEnd)return;
    const available=x.e-x.s-(atStart?backClearance:0)-(atEnd?backClearance:0);
    if(available<=spacing*.75)n[i]=atStart&&atEnd?1:0;
    else n[i]=Math.max(1,Math.round(available/spacing)+1);
  });
  const autoTotal=n.reduce((a,b)=>a+b,0);
  if(S.lightAdj&&sp.length){                       /* ปรับเพิ่ม-ลดที่ช่วงยาวสุด */
    let bi=0; sp.forEach((x,i)=>{if(x.e-x.s>sp[bi].e-sp[bi].s)bi=i;});
    n[bi]=Math.max(0,n[bi]+S.lightAdj);}
  return{sp,n,total:n.reduce((a,b)=>a+b,0),autoTotal};}
const lightTotal=()=>S.lights?lightCounts(boothWallThickness(S)).total:0;
const lightModelDef=()=>LIGHT_MODELS.find(x=>x.k===S.lightFixture)||LIGHT_MODELS[0];
const lightWattDef=()=>LIGHT_WATTS.find(x=>x.k===S.lightWatts)||LIGHT_WATTS[0];
const lightTotalWatts=()=>lightTotal()*lightWattDef().k;
const lightPriceTotal=()=>lightTotal()*lightWattDef().price;
function lightPoints(t){
  if(!S.lights)return[];
  const {sp,n}=lightCounts(t),out=[],model=lightModelDef(),isArm=model?.k==='arm',backClearance=isArm&&Number.isFinite(model?.backWallClearance)?Math.max(0,model.backWallClearance):0;
  sp.forEach((x,i)=>{const c=n[i];
    const fullLen=x.w==='back'?S.W:S.D,eps=.003,spacing=lightSpacing();
    let start=x.s,end=x.e,count=c,includeEnds=false;
    /* Arm Light ผนังหลัง: ตัดโคมปลายช่วงที่อยู่ใกล้ผนังซ้าย/ขวา
       แล้วคำนวณจำนวนใหม่จากช่วงที่เหลือ; ผนังข้างยังใช้ระยะ 1 ม. ตามปกติ */
    if(isArm&&x.w==='back'&&backClearance>0){
      const atStart=Math.abs(x.s)<eps,atEnd=Math.abs(x.e-fullLen)<eps;
      if(atStart)start+=backClearance;
      if(atEnd)end-=backClearance;
      const available=end-start;
      if(available<=spacing*.75){
        /* ช่วงปลายผนังที่สั้นเกินไปถูกตัดจาก lightCounts แล้ว;
           ถ้าเป็นผนังหลังทั้งช่วงจริง ๆ ให้ใช้โคมกลางหนึ่งดวง */
        if(atStart!==atEnd)count=0;
        else{start=x.s;end=x.e;count=Math.max(1,c);}
      }else if(atStart||atEnd){
        includeEnds=true;
      }
    }
    if(count<=0)return;
    if(end<=start){start=x.s;end=x.e;count=Math.max(1,c);}
    for(let j=0;j<count;j++){
      const fraction=includeEnds&&count>1?j/(count-1):(j+.5)/count;
      out.push({w:x.w,u:start+(end-start)*fraction});
    }
  });
  return out;}

/* ตำแหน่งประตูตามแนวยาวของด้านนั้น */
function doorAlong(len,dw){
  const m=Math.min(.15,len*.05);
  if(S.doorOff==='start')return m;
  if(S.doorOff==='end')return Math.max(m,len-dw-m);
  return (len-dw)/2;}
function autoDoorFor(){
  const pref=S.stPos==='right'?'left':'right';
  const other=pref==='left'?'right':'left';
  if(!doorBlocked(pref,boothWallThickness(S)))return pref;
  if(!doorBlocked(other,boothWallThickness(S)))return other;
  return 'front';
}
const suggestedSec=()=>pair().sec(S.primary);
function palette(){const t=pair(),p=S.primary;
  const sec=S.secTouched?S.secondary:suggestedSec();
  const wall=S.wallCol==='white'?WHITE:p;
  return{acc:p,sec:sec,wall:wall,base:t.base(p),floor:t.floor(p),warm:t.warm};}
function wallFinishKind(spec,face){
  if(spec.wallMat==='sticker')return'sticker';
  return Array.isArray(spec.wallStickerFaces)&&spec.wallStickerFaces.includes(face)?'sticker':'paint';
}
function wallFaceColor(spec,face,a=palette()){
  return a.wall;
}
const activeWallStickerFaces=()=>typ().walls.filter(face=>wallFinishKind(S,face)==='sticker');
function wallFinishSummary(){
  const color=WALLCOL.find(item=>item.k===S.wallCol)?.n||S.wallCol;
  const walls=typ().walls,stickers=activeWallStickerFaces(),painted=walls.filter(face=>!stickers.includes(face));
  const names=faces=>faces.map(face=>WALL_FACES.find(item=>item.k===face)?.n||face).join(', ');
  if(!stickers.length)return color+' · ทาสีทุกด้าน';
  if(!painted.length)return color+' · สติกเกอร์ทุกด้าน';
  return color+' · ทาสี: '+names(painted)+' · สติกเกอร์: '+names(stickers);
}
function setWallFaceFinish(face,finish){
  const selected=new Set(Array.isArray(S.wallStickerFaces)?S.wallStickerFaces:[]);
  if(finish==='sticker')selected.add(face);else selected.delete(face);
  S.wallStickerFaces=WALL_FACES.map(item=>item.k).filter(key=>selected.has(key));
}
const inkOn=bg=>lum(bg)<.55?'#ffffff':'#161616';
function stPaintColor(a){
  return S.stPaint==='white'?WHITE:S.stPaint==='primary'?a.acc:
         S.stPaint==='secondary'?a.sec:a.wall;}
function floorColor(){
  if(S.floor==='carpet'){const c=CARPETS.find(x=>x.k===S.carpet);return c.c||adjust(S.primary,{l:.26});}
  if(S.floor==='grass')return'#4a6b47';
  if(S.floor==='tile')return TILES.find(x=>x.k===S.tile).c;
  if(S.floor==='sticker')return'#e8e9e6';
  return mix(S.primary,'#ffffff',.74);}
function floorName(){const f=floorDef();
  const activeCarpetUpload=activeCarpetTexture(S);
  if(f.k==='carpet'&&activeCarpetUpload)return'พรมลายอัปโหลด '+(activeCarpetUpload.name||'ของลูกค้า');
  if(f.k==='carpet')return'พรม '+CARPETS.find(c=>c.k===S.carpet).n;
  const activeUpload=activeTileTexture(S);
  if(f.k==='tile'&&activeUpload)return'กระเบื้องยาง ลายอัปโหลด '+(activeUpload.name||'ของลูกค้า');
  if(f.k==='tile')return'กระเบื้องยาง ลาย'+TILES.find(t=>t.k===S.tile).n;
  if(f.k==='sticker')return S.floorStickerData?'สติ๊กเกอร์พื้น '+(S.floorStickerName||'ภาพอัปโหลด')+' · '+Number(S.floorStickerW).toFixed(2)+' × '+Number(S.floorStickerD).toFixed(2)+' ม. · '+stickerModeName(S.floorStickerMode)+' · หมุน '+Number(S.floorStickerRotation||0)+'°':'สติ๊กเกอร์พื้น · รออัปโหลดภาพ';
  return f.n;}
/* ห้องตั้งอยู่บนพื้นที่ยก จึงต้องหักความสูงพื้นออก ไม่งั้นยอดห้องโผล่พ้นผนัง */
const maxStH=()=>S.H-(S.raise/100);
function stHeight(){const h=S.stHmode===0?S.stHv:S.stHmode;return Math.min(h,maxStH());}
function stDims(){
  if(S.stSize==='custom')return{w:S.stW,d:S.stD};
  if(S.stSize==='full')  return{w:S.W,   d:S.stD};
  const o=ST_SIZE.find(x=>x.k===S.stSize);return(o&&o.w)?{w:o.w,d:o.d}:{w:1.2,d:1.2};}
/* ห้องหลบผนังบูธ — ด้านไหนมีผนังบูธอยู่แล้ว ผนังนั้นทำหน้าที่เป็นผนังห้องเลย
   ด้านที่ไม่มีผนัง ห้องชิดขอบบูธได้เต็มที่ */
function storeGeom(t){
  const dm=stDims(), wl=typ().walls;
  const hasL=wl.indexOf('left')>=0, hasR=wl.indexOf('right')>=0;
  const x0=hasL?t:0, x1=hasR?S.W-t:S.W, avail=Math.max(.2,x1-x0);
  const y=(wl.indexOf('back')>=0)?t:0;
  /* ไม่คาปที่ 50% แล้ว — ลูกค้าออกแบบเองได้ ห้องยาวเท่าผนังหลัง หรือลึกเท่าผนังข้างก็ได้
     คาปแค่ไม่ให้ทะลุขอบบูธ */
  const w=Math.min(dm.w,avail), d=Math.min(dm.d,S.D-y), h=stHeight();
  const x=S.stPos==='left'?x0:S.stPos==='center'?x0+(avail-w)/2:x1-w;
  return{x,y,w,d,h};}
function storagePanels(t){
  const G=storeGeom(t),walls=typ().walls,e=.002;
  return{G,
    back:!(walls.includes('back')&&G.y<=t+e),
    left:!(walls.includes('left')&&G.x<=t+e),
    right:!(walls.includes('right')&&G.x+G.w>=S.W-t-e)};
}

/* ================= build ================= */
function build(){
  const oC=document.getElementById('oCat');oC.innerHTML='';
  CATGROUPS.forEach(gr=>{const box=el('div','cgrp');if(gr.g)box.appendChild(el('h5',null,gr.g));
    const row=el('div','cats');
    gr.items.forEach(c=>{const b=el('button','cat',c.n);b.dataset.k=c.k;
      b.onclick=()=>{S.cat=c.k;if(!S.colTouched)S.primary=c.col;if(!S.pairTouched)S.pair=c.pr;sync();};
      row.appendChild(b);});
    box.appendChild(row);oC.appendChild(box);});

  const oCI=document.getElementById('oCI');oCI.innerHTML='';
  CI.forEach(c=>{const b=el('button','sw1');b.style.background=c;b.dataset.c=c;b.title=c;
    b.onclick=()=>setPrimary(c);oCI.appendChild(b);});
  const oP=document.getElementById('oPair');oP.innerHTML='';
  PAIRS.forEach(t=>{const b=el('button','th');b.dataset.k=t.k;
    b.onclick=()=>{S.pair=t.k;S.pairTouched=true;sync();};oP.appendChild(b);});

  const oPre=document.getElementById('oPreset');oPre.innerHTML='';
  PRESETS.forEach(p=>{const b=el('button','opt',p.w+' × '+p.d+'<small>'+(p.w*p.d)+' ตร.ม.</small>');
    b.dataset.k=p.w+'x'+p.d;b.onclick=()=>{if(isFixedBoothType(S.type))return;S.W=p.w;S.D=p.d;syncDims();sync();};oPre.appendChild(b);});
  const oH=document.getElementById('oHeight');oH.innerHTML='';
  HEIGHTS.forEach(h=>{const b=el('button','opt',h+' ม.');b.dataset.k=h;
    b.onclick=()=>{if(isFixedBoothType(S.type))return;S.H=h;syncDims();sync();};oH.appendChild(b);});

  const oT=document.getElementById('oType');oT.innerHTML='';
  TYPES.forEach(t=>{const b=el('button','opt'+(t.on?'':' off'),
    t.n+'<small>'+t.s+'</small>'+(t.on?'':'<span class="soon">ยังไม่เปิดในเฟสแรก</span>'));
    b.dataset.k=t.k;b.onclick=()=>selectBoothType(t.k);oT.appendChild(b);});

  const mk=(id,arr,set,f)=>{const box=document.getElementById(id);box.innerHTML='';
    arr.forEach(o=>{const b=el('button','opt',f?f(o):(o.n+(o.s?'<small>'+o.s+'</small>':'')));
      b.dataset.k=String(o.k);b.onclick=()=>{set(o.k);sync();};box.appendChild(b);});};
  mk('oCornerSide',CORNER_SIDES,v=>{S.cornerSide=v;},o=>o.n+'<small>'+o.s+'</small>');
  mk('oStSize',ST_SIZE,v=>S.stSize=v,o=>o.n+'<small>'+o.s+'</small>');
  mk('oStH',ST_H,v=>{S.stHmode=v;});
  mk('oStPos',ST_POS,v=>{S.stPos=v; if(!S.doorTouched)S.stDoor=autoDoorFor();});
  mk('oStDoor',ST_DOOR,v=>{if(doorBlocked(v,boothWallThickness(S)))return;S.stDoor=v;S.doorTouched=true;});
  mk('oStDoorType',ST_DOOR_TYPE,v=>S.stDoorType=v);
  mk('oDoorOff',DOOROFF,v=>S.doorOff=v,()=>'');
  mk('oLights',[{k:'on',n:'มีไฟ',s:'ค่าเริ่มต้น'},{k:'off',n:'ไม่มี',s:''}],v=>S.lights=(v==='on'));
  const oLightModel=document.getElementById('oLightModel');oLightModel.innerHTML='';
  LIGHT_MODELS.forEach(model=>{const b=el('button','light-model-card','<div class="light-model-thumb-live" data-thumb-key="'+model.k+'" aria-label="ภาพพรีวิวโคม '+model.n+'"><span>กำลังโหลดภาพพรีวิว…</span></div>'+
      '<span class="light-model-copy"><b>'+model.n+'</b><small>'+model.s+'</small></span>');
    b.type='button';b.dataset.k=model.k;b.setAttribute('aria-pressed','false');b.onclick=()=>{S.lightFixture=model.k;sync();};oLightModel.appendChild(b);});
  mk('oLightCol',LIGHTCOL,v=>S.lightCol=v);
  mk('oLightWatts',LIGHT_WATTS,v=>S.lightWatts=v,o=>o.n+'<small>สเปกมาตรฐาน</small>');
  mk('oLightWall',LIGHTWALL,v=>{S.lightWall=v;S.lightAdj=0;});
  document.getElementById('lminus').onclick=()=>{if(lightTotal()>0){S.lightAdj--;sync();}};
  document.getElementById('lplus').onclick=()=>{S.lightAdj++;sync();};
  document.getElementById('lreset').onclick=()=>{S.lightAdj=0;sync();};
  mk('oStSurf',[{k:'paint',n:'ทาสี'},{k:'sticker',n:'ติดสติ๊กเกอร์'}],v=>S.stSurf=v);
  mk('oStFace',ST_FACE,v=>S.stFace=v);
  mk('oRaise',RAISE,v=>S.raise=v);
  const oF=document.getElementById('oFloor');oF.innerHTML='';
  FLOORS.forEach(f=>{const b=el('button','opt',f.n+'<small>'+f.s+'</small>');b.dataset.k=f.k;
    b.onclick=()=>{S.floor=f.k;sync();};oF.appendChild(b);});

  const lt=document.getElementById('logoType');lt.innerHTML='';
  LOGOTYPES.forEach(t=>{const o=document.createElement('option');o.value=t.k;o.textContent=t.n;lt.appendChild(o);});
  lt.onchange=()=>{S.logoType=lt.value;sync();};
  mk('oLogoShape',LOGOSHAPES,v=>{S.logoShape=v;sync();},o=>o.n+'<small>'+o.s+'</small>');
  mk('oLogoMount',[{k:'wall',n:'ติดผนัง',s:'ยึดตามผนังที่เลือก'},{k:'floor',n:'ตั้งพื้น',s:'วางบนกริดพื้น'}],v=>{S.logoMount=v;sync();});
  mk('oLogoWall',WALL_FACES,v=>{S.logoWall=v;S.logoWallU=wallFaceLength(S,v)/2;sync();},o=>o.n);
  mk('oLogoFloorRotation',[0,90,180,270].map(k=>({k,n:k+'°'})),v=>{S.logoFloorRotation=v;sync();},o=>o.n);
  const ow=document.getElementById('oWallCol');ow.innerHTML='';
  WALLCOL.forEach(w=>{const b=el('button','opt',w.n+(w.s?'<small>'+w.s+'</small>':''));b.dataset.k=w.k;
    b.onclick=()=>{S.wallCol=w.k;sync();};ow.appendChild(b);});
  const wallFaces=document.getElementById('oWallFaceFinish');wallFaces.innerHTML='';
  WALL_FACES.forEach(face=>{const row=el('div','wall-face-row');row.dataset.face=face.k;
    row.appendChild(el('div','wall-face-name','<b>'+face.n+'</b><small>'+face.s+'</small>'));
    const choices=el('div','wall-face-options');choices.setAttribute('role','group');choices.setAttribute('aria-label','ผิว'+face.n);
    [{k:'base',n:'ทาสี'},{k:'sticker',n:'สติกเกอร์'}].forEach(choice=>{const b=el('button','opt',choice.n);
      b.type='button';b.dataset.k=choice.k;b.setAttribute('aria-pressed','false');
      b.onclick=()=>{setWallFaceFinish(face.k,choice.k);sync();};choices.appendChild(b);});
    row.appendChild(choices);wallFaces.appendChild(row);});
  const op2=document.getElementById('oStPaint');op2.innerHTML='';
  ST_PAINT.forEach(o=>{const b=el('button','opt',o.n+(o.s?'<small>'+o.s+'</small>':''));b.dataset.k=o.k;
    b.onclick=()=>{S.stPaint=o.k;sync();};op2.appendChild(b);});

  const lp=document.getElementById('oLockup');lp.innerHTML='';
  LOCKUPS.forEach(t=>{const b=el('button','opt',
    '<div style="display:flex;align-items:center;gap:9px;justify-content:center">'+lockIcon(t.k)+
    '<div style="text-align:left"><b style="font-size:12px">'+t.n+'</b><small>'+t.s+'</small></div></div>');
    b.dataset.k=t.k;b.onclick=()=>{S.lockup=t.k;sync();};lp.appendChild(b);});
  document.getElementById('btnSide').onclick=()=>{
    if(S.type!=='corner'||S.logoMount!=='wall'||S.logoWall!=='back'||sideFreeLen(boothWallThickness(S))<.8)return; S.sideLogo=!S.sideLogo;sync();};
  const sp=document.getElementById('oSidePos');sp.innerHTML='';
  SIDEPOS.forEach(t=>{const b=el('button','opt',t.n+(t.s?'<small>'+t.s+'</small>':''));b.dataset.k=t.k;
    b.onclick=()=>{S.sidePos=t.k;sync();};sp.appendChild(b);});

  const objectCatalog=document.getElementById('objectCatalog');objectCatalog.innerHTML='';
  const knownCategories=new Set(FURNITURE_CATEGORIES.map(category=>category.k));
  const catalogGroups=FURNITURE_CATEGORIES.map(category=>[category.n,category.k]);
  if(OBJECT_CATALOG.some(item=>!knownCategories.has(item.category)))catalogGroups.push(['อื่น ๆ','other']);
  document.querySelector('#catalogSection .hint').textContent=OBJECT_CATALOG.length+' รายการ';
  catalogGroups.forEach(([name,category])=>{
    const group=el('div','catalog-group'),title=el('h5',null,name),grid=el('div','catalog-grid');
    OBJECT_CATALOG.filter(item=>category==='other'?!knownCategories.has(item.category):item.category===category).forEach(item=>{
      const b=el('button','catalog-item'),media=el('span','catalog-icon',item.icon),copy=el('span','catalog-copy',
        '<b>'+item.name+'</b><small>'+(isEntranceFrameItem(item)?'เสา 1.00 ม. · ยื่น 2.40 ม. · สูง 2.40 ม.':isDownlightBeamItem(item)?'ยาวเต็มบูธ · 0.30 × 0.20 ม. · ไฟ 5 ดวง':item.size.w+' × '+item.size.d+' × '+item.size.h+' ม.')+'</small>');
      if(item.thumbUrl){const img=document.createElement('img');img.className='catalog-thumb';img.src=item.thumbUrl;
        img.alt='';img.loading='lazy';img.setAttribute('aria-hidden','true');img.onerror=()=>img.remove();media.appendChild(img);}
      b.type='button';b.dataset.catalogId=item.catalogId;b.setAttribute('aria-label','เพิ่ม'+item.name+'ไว้ด้านหน้าบูธ');
      b.title='คลิกเพื่อเพิ่ม'+item.name+'ไว้ด้านหน้าบูธ';b.onclick=()=>addCatalogObject(item.catalogId);b.append(media,copy);
      grid.appendChild(b);
    });
    group.append(title,grid);objectCatalog.appendChild(group);
  });
  document.getElementById('btnUndoObject').onclick=undoObjectChange;
  document.getElementById('btnRedoObject').onclick=redoObjectChange;
  document.getElementById('btnMoveSmart').onclick=()=>setObjectMoveMode('smart');
  document.querySelectorAll('[data-fine-axis]').forEach(button=>button.onclick=event=>{
    event.preventDefault();event.stopPropagation();fineMoveSelectedObjects(button.dataset.fineAxis,button.dataset.fineDelta);
  });
  ['x','y','z'].forEach(axis=>{const input=finePositionInput(axis);if(!input)return;
    input.oninput=()=>{finePositionDraft.values[axis]=input.value;finePositionDraft.dirty.add(axis);setFinePositionError(axis,'');};
    input.onkeydown=event=>{if(event.key==='Enter'){event.preventDefault();event.stopPropagation();commitFinePositionInput(axis);}
      else if(event.key==='Escape'){event.preventDefault();event.stopPropagation();cancelFinePositionDraft(axis);input.blur();}};
    input.onblur=()=>{if(finePositionDraft.dirty.has(axis))cancelFinePositionDraft(axis);};
  });
  document.getElementById('moveAdvanced').ontoggle=syncFinePositionControls;
  document.getElementById('btnLockObject').onclick=toggleSelectedObjectLock;
  document.getElementById('btnRotateObject').onclick=rotateSelectedObject;
  document.getElementById('btnFlipObjectX').onclick=()=>flipSelectedObject('x');
  document.getElementById('btnFlipObjectY').onclick=()=>flipSelectedObject('y');
  document.getElementById('btnOpenAssetSettings').onclick=openAssetSettings;
  document.getElementById('btnAssetList').onclick=()=>assetListUI.open?closeAssetList():openAssetList();
  document.getElementById('assetListClose').onclick=closeAssetList;
  document.getElementById('assetListSearch').oninput=event=>{assetListUI.query=event.target.value;renderAssetList();};
  document.querySelectorAll('[data-asset-list-filter]').forEach(button=>button.onclick=()=>{assetListUI.filter=button.dataset.assetListFilter;
    document.querySelectorAll('[data-asset-list-filter]').forEach(candidate=>{const on=candidate===button;candidate.classList.toggle('on',on);candidate.setAttribute('aria-pressed',String(on));});renderAssetList();});
  document.getElementById('assetListRename').onclick=renameSelectedSceneItem;
  document.getElementById('assetListDuplicate').onclick=duplicateSelectedObject;
  document.getElementById('assetListGroup').onclick=groupSelectedObjects;
  document.getElementById('assetListUngroup').onclick=ungroupSelectedObjects;
  document.getElementById('assetListFocus').onclick=()=>focusSceneItem(objectEditor.selectedId);
  document.getElementById('assetListLock').onclick=()=>{const items=selectedObjectIds().map(sceneItemById).filter(Boolean);if(items.length)setSceneItemsLocked(items.map(item=>item.id),!items.every(item=>item.locked));};
  document.getElementById('assetListVisibility').onclick=()=>{const items=selectedSceneItemIds().map(sceneItemById).filter(Boolean);if(items.length)setSceneItemsVisibility(items.map(item=>item.id),!items.some(item=>item.visible));};
  document.getElementById('assetListDelete').onclick=deleteSceneSelection;
  document.getElementById('btnDuplicateObject').onclick=duplicateSelectedObject;
  document.getElementById('btnDeleteObject').onclick=deleteSelectedObject;
  document.getElementById('assetSettingsClose').onclick=closeAssetSettings;
  document.getElementById('assetSettingsDone').onclick=closeAssetSettings;
  document.getElementById('assetSettingsName').onchange=event=>updateSelectedObjectName(event.target.value);
  ['W','D','H'].forEach(key=>document.getElementById('assetSize'+key).onchange=event=>updateSelectedObjectSize(key.toLowerCase(),event.target.value));
  document.getElementById('assetResetSize').onclick=resetSelectedObjectSize;
  document.querySelectorAll('[data-asset-appearance]').forEach(button=>button.onclick=()=>updateSelectedObjectAppearanceMode(button.dataset.assetAppearance));
  document.getElementById('assetSurfaceColor').onchange=event=>updateSelectedObjectColor(event.target.value);
  document.getElementById('assetSurfaceHex').onchange=event=>updateSelectedObjectColor(event.target.value);
  document.getElementById('assetChooseSticker').onclick=()=>document.getElementById('assetStickerFile').click();
  document.getElementById('assetStickerFile').onchange=event=>{const file=event.target.files?.[0];if(file)setSelectedObjectSticker(file);event.target.value='';};
  document.getElementById('assetRemoveSticker').onclick=()=>resetSelectedObjectSurface(false);
  document.getElementById('assetResetSurface').onclick=()=>resetSelectedObjectSurface(true);

  document.querySelectorAll('[data-asset-tab]').forEach(button=>{
    button.onclick=()=>setAssetTab(button.dataset.assetTab);
  });
  const myAssetFile=document.getElementById('myAssetFile'),myAssetChoose=document.getElementById('myAssetChoose');
  if(myAssetChoose&&myAssetFile){
    myAssetChoose.onclick=()=>myAssetFile.click();
    myAssetFile.onchange=async event=>{
      pendingMyAssetFile=event.target.files?.[0]||null;
      const name=document.getElementById('myAssetName'),label=document.getElementById('myAssetFileName');
      if(label)label.textContent=pendingMyAssetFile?.name||'ยังไม่ได้เลือกไฟล์';
      if(name&&pendingMyAssetFile&&!name.value)name.value=pendingMyAssetFile.name.replace(/\.glb$/i,'');
      const selectedFile=pendingMyAssetFile;
      if(selectedFile){
        setMyAssetStatus('กำลังอ่านขนาดจาก '+selectedFile.name+'…','success');
        const readPromise=readMyAssetDimensions(selectedFile);myAssetDimensionReadPromise=readPromise;
        try{
          const dimensions=await readPromise;
          if(pendingMyAssetFile!==selectedFile)return;
          setMyAssetDimensions(dimensions);
          setMyAssetStatus('อ่านขนาดอัตโนมัติแล้ว: '+formatMyAssetDimension(dimensions.w)+' × '+formatMyAssetDimension(dimensions.d)+' × '+formatMyAssetDimension(dimensions.h)+' ม. — กดบันทึกเพื่อเก็บไว้ใน My Asset','success');
        }catch(error){
          if(pendingMyAssetFile===selectedFile)setMyAssetStatus('อ่านขนาดอัตโนมัติไม่ได้ ('+(error.message||'ไฟล์ไม่สมบูรณ์')+') — กรุณากรอกขนาดเองแล้วกดบันทึก','error');
        }finally{
          if(myAssetDimensionReadPromise===readPromise)myAssetDimensionReadPromise=null;
        }
      }else setMyAssetStatus('','success');
    };
  }
  const myAssetUpload=document.getElementById('myAssetUpload');if(myAssetUpload)myAssetUpload.onclick=saveMyAsset;
  renderMyAssetList();
  bindMyAssetDrop();

  document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>selectView(t.dataset.v));
}
function wallStickerSummary(){
  const rows=activeWallStickerFaces().map(face=>{const def=WALL_FACES.find(item=>item.k===face),sticker=wallStickerFor(face);
    return def.n+': '+(sticker.data?(Number(sticker.w).toFixed(2)+' × '+Number(sticker.h).toFixed(2)+' ม. · '+stickerModeName(sticker.mode)+' · หมุน '+Number(sticker.rotation||0)+'°'):'รออัปโหลดภาพ');});
  return rows.join(' · ');
}
function appendStickerDisplayControls(card,values,commit,limits={}){
  card.appendChild(el('div','lbl','รูปแบบการแสดงภาพ'));
  const modes=el('div','sticker-mode-grid');STICKER_MODES.forEach(mode=>{const button=el('button','btn sm'+(values.mode===mode.k?' on':''),mode.n);button.type='button';
    button.onclick=()=>{commit('mode',mode.k,true);sync();};modes.appendChild(button);});card.appendChild(modes);
  const controls=el('div','floor-sticker-size'),maxX=Math.max(.1,Number(limits.x)||1),maxY=Math.max(.1,Number(limits.y)||1);
  const live=(key,value)=>{commit(key,Number(value),true);if(threeRenderer)threeRenderer.currentKey='';render();updatePromptPreview();};
  const row=(key,label,min,max,step)=>{const wrap=el('div','floor-sticker-control'),lab=el('label',null,label),range=document.createElement('input'),number=document.createElement('input'),resetDefault=key==='patternSize'?1.2:0;
    range.type='range';range.min=String(min);range.max=String(max);range.step=String(step);range.value=values[key];range.setAttribute('aria-label',label);
    number.type='number';number.min=String(min);number.max=String(max);number.step=String(step);number.inputMode='decimal';number.value=Number(values[key]).toFixed(2);number.dataset.resetDefault=String(resetDefault);number.setAttribute('aria-label','ค่า'+label);
    range.oninput=()=>{number.value=Number(range.value).toFixed(2);live(key,range.value);};range.onchange=()=>sync();number.onchange=()=>{commit(key,Number(number.value),true);sync();};
    wrap.append(lab,range,number,el('em',null,'ม.'));return wrap;};
  if(values.mode==='repeat')controls.appendChild(row('patternSize','ขนาดลาย',.1,Math.max(maxX,maxY)*2,.05));
  controls.append(row('offsetX',limits.xLabel||'เลื่อนแนวนอน',-maxX/2,maxX/2,.05),row('offsetY',limits.yLabel||'เลื่อนแนวตั้ง',-maxY/2,maxY/2,.05));
  card.appendChild(controls);
  card.appendChild(el('div','note',values.mode==='repeat'?'ขนาดลายใช้ค่าเดียวและรักษาสัดส่วนภาพเดิม จึงไม่ทำให้อิฐหรือแพตเทิร์นบิดเบี้ยว':
    values.mode==='cover'?'ขยายภาพแบบรักษาสัดส่วนแล้วตัดส่วนเกินให้เต็มพื้นที่ โดยไม่ยืดภาพ':'แสดงภาพเดียวแบบรักษาสัดส่วนและวางกึ่งกลางพื้นที่'));
}
function buildFloorSub(){
  const box=document.getElementById('oFloorSub');box.innerHTML='';
  if(S.floor==='carpet'){
    const uploads=carpetTextureUploadsFor(S),activeUpload=activeCarpetTexture(S),customActive=!!activeUpload;
    const w=el('div','subrow','<h6>สีพรม</h6>'),g=el('div','pats');
    CARPETS.forEach(c=>{const col=c.c||adjust(S.primary,{l:.26});
      const b=el('button','pat'+(!customActive&&S.carpet===c.k?' on':''),'<i style="background:'+col+'"></i><span>'+c.n+'</span>');
      b.onclick=()=>{S.carpet=c.k;S.carpetTextureMode='builtin';sync();};g.appendChild(b);});
    uploads.forEach((item,index)=>{
      const itemBox=el('div','upload-pat'),selected=customActive&&activeUpload.id===item.id;
      const custom=el('button','pat'+(selected?' on':''),'<i></i><span>อัปโหลด '+(index+1)+'</span>');custom.type='button';custom.title=item.name||'ลายพรมที่อัปโหลด';
      const preview=custom.querySelector('i');preview.style.backgroundImage='url("'+item.data+'")';preview.style.backgroundSize='cover';preview.style.backgroundPosition='center';
      custom.onclick=()=>{S.carpetTextureMode='custom';S.carpetTextureActiveId=item.id;sync();};
      const remove=el('button','pat-remove','×');remove.type='button';remove.title='ลบ '+(item.name||'ลายพรมที่อัปโหลด');
      remove.onclick=event=>{event.stopPropagation();const wasActive=S.carpetTextureMode==='custom'&&activeCarpetTexture(S)?.id===item.id;
        S.carpetTextureUploads=carpetTextureUploadsFor(S).filter(upload=>upload.id!==item.id);S.carpetTextureData=null;S.carpetTextureName='';
        if(wasActive){S.carpet='grey';S.carpetTextureMode='builtin';S.carpetTextureActiveId='';}
        S.carpetTextureId=(S.carpetTextureId||0)+1;sync();};
      itemBox.append(custom,remove);g.appendChild(itemBox);});
    w.appendChild(g);box.appendChild(w);
    const textureBox=el('div','subrow','<h6>พื้นผิวพรม</h6>'),controls=el('div','mini');
    const full=uploads.length>=MAX_CARPET_TEXTURE_UPLOADS;
    const choose=el('button','btn sm',full?'ครบ 3 ลายแล้ว':'อัปโหลดลายพรมใหม่ ('+uploads.length+'/3)');choose.type='button';choose.disabled=full;
    const input=document.createElement('input');input.type='file';input.accept='image/jpeg,image/png,image/webp';input.hidden=true;
    input.onchange=()=>{const file=input.files?.[0];if(!file)return;
      if(file.size>8*1024*1024){window.alert('รูปพื้นมีขนาดใหญ่เกิน 8 MB กรุณาเลือกไฟล์ที่เล็กกว่านี้');input.value='';return;}
      const reader=new FileReader();reader.onload=()=>{if(typeof reader.result!=='string')return;
        const current=carpetTextureUploadsFor(S);if(current.length>=MAX_CARPET_TEXTURE_UPLOADS)return;
        const id='carpet-upload-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,7);
        S.carpetTextureUploads=[...current,{id,name:file.name,data:reader.result}];S.carpetTextureData=null;S.carpetTextureName='';
        S.carpetTextureActiveId=id;S.carpetTextureMode='custom';S.carpetTextureId=(S.carpetTextureId||0)+1;sync();};
      reader.readAsDataURL(file);};
    choose.onclick=()=>input.click();controls.append(choose,input);
    textureBox.appendChild(controls);
    const status=el('div','note');status.textContent=customActive?'กำลังใช้รูป '+activeUpload.name+' · เก็บไว้ '+uploads.length+'/3 ลาย':
      'กำลังใช้พรมสี '+CARPETS.find(c=>c.k===S.carpet).n+(uploads.length?' · มีลายอัปโหลด '+uploads.length+'/3 ลาย':'');
    if(full)status.textContent+=' · ลบลายเดิมก่อนอัปโหลดเพิ่ม';textureBox.appendChild(status);
    box.appendChild(textureBox);
  }else if(S.floor==='tile'){
    const uploads=tileTextureUploadsFor(S),activeUpload=activeTileTexture(S),customActive=!!activeUpload;
    const w=el('div','subrow','<h6>ลายกระเบื้องยาง</h6>'),g=el('div','pats');
    TILES.forEach(t=>{const preview=t.texture
        ?'background-color:'+t.c+';background-image:url(&quot;'+t.texture+'&quot;);background-size:cover;background-position:center'
        :'background:'+t.c;
      const b=el('button','pat'+(!customActive&&S.tile===t.k?' on':''),'<i style="'+preview+'"></i><span>'+t.n+'</span>');
      b.onclick=()=>{S.tile=t.k;S.tileTextureMode='builtin';sync();};g.appendChild(b);});
    uploads.forEach((item,index)=>{
      const itemBox=el('div','upload-pat'),selected=customActive&&activeUpload.id===item.id;
      const custom=el('button','pat'+(selected?' on':''),'<i></i><span>อัปโหลด '+(index+1)+'</span>');custom.type='button';custom.title=item.name||'ลายที่อัปโหลด';
      const preview=custom.querySelector('i');preview.style.backgroundImage='url("'+item.data+'")';preview.style.backgroundSize='cover';preview.style.backgroundPosition='center';
      custom.onclick=()=>{S.tileTextureMode='custom';S.tileTextureActiveId=item.id;sync();};
      const remove=el('button','pat-remove','×');remove.type='button';remove.title='ลบ '+(item.name||'ลายที่อัปโหลด');
      remove.onclick=event=>{event.stopPropagation();const wasActive=S.tileTextureMode==='custom'&&activeTileTexture(S)?.id===item.id;
        S.tileTextureUploads=tileTextureUploadsFor(S).filter(upload=>upload.id!==item.id);S.tileTextureData=null;S.tileTextureName='';
        if(wasActive){S.tile='woodL';S.tileTextureMode='builtin';S.tileTextureActiveId='';}
        S.tileTextureId=(S.tileTextureId||0)+1;sync();};
      itemBox.append(custom,remove);g.appendChild(itemBox);});
    w.appendChild(g);box.appendChild(w);
    const textureBox=el('div','subrow','<h6>พื้นผิวกระเบื้องยาง</h6>'),controls=el('div','mini');
    const full=uploads.length>=MAX_TILE_TEXTURE_UPLOADS;
    const choose=el('button','btn sm',full?'ครบ 3 ลายแล้ว':'อัปโหลดลายใหม่ ('+uploads.length+'/3)');choose.type='button';choose.disabled=full;
    const input=document.createElement('input');input.type='file';input.accept='image/jpeg,image/png,image/webp';input.hidden=true;
    input.onchange=()=>{const file=input.files?.[0];if(!file)return;
      if(file.size>8*1024*1024){window.alert('รูปลายกระเบื้องยางมีขนาดใหญ่เกิน 8 MB กรุณาเลือกไฟล์ที่เล็กกว่านี้');input.value='';return;}
      const reader=new FileReader();reader.onload=()=>{if(typeof reader.result!=='string')return;
        const current=tileTextureUploadsFor(S);if(current.length>=MAX_TILE_TEXTURE_UPLOADS)return;
        const id='tile-upload-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,7);
        S.tileTextureUploads=[...current,{id,name:file.name,data:reader.result}];S.tileTextureData=null;S.tileTextureName='';
        S.tileTextureActiveId=id;S.tileTextureMode='custom';S.tileTextureId=(S.tileTextureId||0)+1;sync();};
      reader.readAsDataURL(file);};
    choose.onclick=()=>input.click();controls.append(choose,input);
    textureBox.appendChild(controls);
    const status=el('div','note');status.textContent=customActive?'กำลังใช้รูป '+activeUpload.name+' · เก็บไว้ '+uploads.length+'/3 ลาย':
      'กำลังใช้ลาย '+TILES.find(t=>t.k===S.tile).n+(uploads.length?' · มีลายอัปโหลด '+uploads.length+'/3 ลาย':'');
    if(full)status.textContent+=' · ลบลายเดิมก่อนอัปโหลดเพิ่ม';
    textureBox.appendChild(status);box.appendChild(textureBox);
  }else if(S.floor==='sticker'){
    const card=el('div','subrow floor-sticker-card'),heading=el('h6',null,'สติ๊กเกอร์พื้น');card.appendChild(heading);
    const preview=el('div','floor-sticker-preview'+(S.floorStickerData?' has-image':''));
    if(S.floorStickerData){const image=document.createElement('img');image.src=S.floorStickerData;image.alt='ตัวอย่างภาพสติ๊กเกอร์พื้น '+(S.floorStickerName||'');preview.appendChild(image);}
    else preview.appendChild(el('span',null,'อัปโหลดภาพกราฟิก แล้วระบบจะวางภาพไว้ตรงกลางพื้นบูธ'));
    card.appendChild(preview);

    const actions=el('div','floor-sticker-actions'),choose=el('button','btn sm',S.floorStickerData?'เปลี่ยนภาพ':'อัปโหลดภาพ');choose.type='button';
    const input=document.createElement('input');input.type='file';input.accept='image/jpeg,image/png,image/webp';input.hidden=true;
    input.onchange=()=>{const file=input.files?.[0];if(!file)return;
      if(file.size>8*1024*1024){window.alert('ภาพสติ๊กเกอร์พื้นมีขนาดใหญ่เกิน 8 MB กรุณาเลือกไฟล์ที่เล็กกว่านี้');input.value='';return;}
      const reader=new FileReader();reader.onload=()=>{if(typeof reader.result!=='string')return;
        const image=new Image();image.onload=()=>{S.floorStickerData=reader.result;S.floorStickerName=file.name;
          S.floorStickerId=(S.floorStickerId||0)+1;setDefaultFloorStickerSize(image.naturalWidth/Math.max(1,image.naturalHeight));sync();};
        image.onerror=()=>window.alert('อ่านภาพสติ๊กเกอร์พื้นไม่สำเร็จ กรุณาเลือกไฟล์ภาพใหม่');image.src=reader.result;};
      reader.readAsDataURL(file);};
    choose.onclick=()=>input.click();actions.append(choose,input);
    if(S.floorStickerData){const remove=el('button','btn sm','ลบภาพ');remove.type='button';remove.onclick=()=>{
        S.floorStickerData=null;S.floorStickerName='';S.floorStickerRotation=0;S.floorStickerId=(S.floorStickerId||0)+1;sync();};actions.appendChild(remove);}
    card.appendChild(actions);

    if(S.floorStickerData){
      const sizeBox=el('div','floor-sticker-size'),controls={};
      const refresh=()=>{if(!controls.w)return;controls.w.range.value=S.floorStickerW;controls.w.number.value=Number(S.floorStickerW).toFixed(2);
        controls.d.range.value=S.floorStickerD;controls.d.number.value=Number(S.floorStickerD).toFixed(2);
        meta.textContent='วางกึ่งกลางพื้น · '+stickerModeName(S.floorStickerMode)+' · ขนาด '+Number(S.floorStickerW).toFixed(2)+' × '+Number(S.floorStickerD).toFixed(2)+' ม. · หมุน '+Number(S.floorStickerRotation||0)+'° · พื้นที่ '+floorStickerArea().toFixed(2)+' ตร.ม.';};
      const live=(axis,value)=>{setFloorStickerDimension(axis,value);refresh();render();document.getElementById('price').textContent='฿'+fmt(priceTotal());};
      const makeControl=(axis,label,max)=>{const row=el('div','floor-sticker-control'),lab=el('label',null,label);
        const range=document.createElement('input');range.type='range';range.min='.1';range.max=String(max);range.step=String(FLOOR_STICKER_STEP);range.value=axis==='w'?S.floorStickerW:S.floorStickerD;range.setAttribute('aria-label',label+'ของสติ๊กเกอร์พื้น');
        const number=document.createElement('input');number.type='number';number.min='.1';number.max=String(max);number.step=String(FLOOR_STICKER_STEP);number.inputMode='decimal';number.value=Number(axis==='w'?S.floorStickerW:S.floorStickerD).toFixed(2);number.dataset.resetDefault=String(axis==='w'?(S.floorStickerResetW||2):(S.floorStickerResetD||1));number.setAttribute('aria-label','ค่า'+label+'ของสติ๊กเกอร์พื้น');
        range.oninput=()=>live(axis,range.value);range.onchange=()=>sync();number.onchange=()=>{setFloorStickerDimension(axis,number.value);sync();};
        row.append(lab,range,number,el('em',null,'ม.'));controls[axis]={range,number};return row;};
      sizeBox.append(makeControl('w','ความยาว',S.W),makeControl('d','ความลึก',S.D));card.appendChild(sizeBox);
      appendStickerDisplayControls(card,{mode:S.floorStickerMode,patternSize:S.floorStickerPatternSize,offsetX:S.floorStickerOffsetX,offsetY:S.floorStickerOffsetY},
        (key,value,touch)=>{const map={mode:'floorStickerMode',patternSize:'floorStickerPatternSize',offsetX:'floorStickerOffsetX',offsetY:'floorStickerOffsetY'};S[map[key]]=value;if(touch)S.floorStickerId=(S.floorStickerId||0)+1;},
        {x:S.floorStickerW,y:S.floorStickerD,xLabel:'เลื่อนซ้าย–ขวา',yLabel:'เลื่อนหน้า–หลัง'});
      card.appendChild(el('div','lbl','หมุนภาพ'));
      const rotate=el('div','floor-sticker-rotate');[0,90,180,270].forEach(degree=>{const button=el('button','btn sm'+(Number(S.floorStickerRotation||0)===degree?' on':''),degree+'°');button.type='button';
        button.onclick=()=>{setFloorStickerRotation(degree);S.floorStickerId=(S.floorStickerId||0)+1;sync();};rotate.appendChild(button);});card.appendChild(rotate);
      const lock=el('label','floor-sticker-lock'),check=document.createElement('input');check.type='checkbox';check.checked=S.floorStickerLock!==false;
      check.onchange=()=>{S.floorStickerLock=check.checked;if(check.checked)setFloorStickerDimension('w',S.floorStickerW);sync();};
      lock.append(check,document.createTextNode('ล็อกสัดส่วนภาพ'));card.appendChild(lock);
      const meta=el('div','floor-sticker-meta');card.appendChild(meta);refresh();
      card.appendChild(el('div','note','ปรับละเอียดทุก 5 ซม. ภาพจะอยู่กึ่งกลางพื้นเสมอ และไม่ปูซ้ำเต็มพื้นที่'));
    }else card.appendChild(el('div','note','รองรับ JPG, PNG และ WebP ขนาดไม่เกิน 8 MB'));
    box.appendChild(card);}
}
function buildWallStickerSettings(){
  const box=document.getElementById('wallStickerSettings');if(!box)return;box.innerHTML='';
  activeWallStickerFaces().forEach(face=>{
    const faceDef=WALL_FACES.find(item=>item.k===face),sticker=wallStickerFor(face),card=el('div','subrow floor-sticker-card');
    card.appendChild(el('h6',null,'สติ๊กเกอร์'+faceDef.n));
    const preview=el('div','floor-sticker-preview'+(sticker.data?' has-image':''));
    if(sticker.data){const image=document.createElement('img');image.src=sticker.data;image.alt='ตัวอย่างสติ๊กเกอร์'+faceDef.n+' '+(sticker.name||'');preview.appendChild(image);}
    else preview.appendChild(el('span',null,'อัปโหลดภาพกราฟิก แล้วระบบจะวางภาพไว้กึ่งกลาง'+faceDef.n));
    card.appendChild(preview);
    const actions=el('div','floor-sticker-actions'),choose=el('button','btn sm',sticker.data?'เปลี่ยนภาพ':'อัปโหลดภาพ');choose.type='button';
    const input=document.createElement('input');input.type='file';input.accept='image/jpeg,image/png,image/webp';input.hidden=true;
    input.onchange=()=>{const file=input.files?.[0];if(!file)return;
      if(file.size>8*1024*1024){window.alert('ภาพสติ๊กเกอร์ผนังมีขนาดใหญ่เกิน 8 MB กรุณาเลือกไฟล์ที่เล็กกว่านี้');input.value='';return;}
      const reader=new FileReader();reader.onload=()=>{if(typeof reader.result!=='string')return;
        const image=new Image();image.onload=()=>{const target=wallStickerFor(face);target.data=reader.result;target.name=file.name;target.id=(target.id||0)+1;
          setDefaultWallStickerSize(face,image.naturalWidth/Math.max(1,image.naturalHeight));sync();};
        image.onerror=()=>window.alert('อ่านภาพสติ๊กเกอร์ผนังไม่สำเร็จ กรุณาเลือกไฟล์ภาพใหม่');image.src=reader.result;};reader.readAsDataURL(file);};
    choose.onclick=()=>input.click();actions.append(choose,input);
    if(sticker.data){const remove=el('button','btn sm','ลบภาพ');remove.type='button';remove.onclick=()=>{const target=wallStickerFor(face);
        target.data=null;target.name='';target.rotation=0;target.id=(target.id||0)+1;sync();};actions.appendChild(remove);}
    card.appendChild(actions);
    if(sticker.data){
      const sizeBox=el('div','floor-sticker-size'),controls={};let meta;
      const refresh=()=>{const current=wallStickerFor(face);if(!controls.w)return;
        controls.w.range.value=current.w;controls.w.number.value=Number(current.w).toFixed(2);
        controls.h.range.value=current.h;controls.h.number.value=Number(current.h).toFixed(2);
        meta.textContent='วางกึ่งกลาง'+faceDef.n+' · '+stickerModeName(current.mode)+' · ขนาด '+Number(current.w).toFixed(2)+' × '+Number(current.h).toFixed(2)+' ม. · หมุน '+Number(current.rotation||0)+'° · พื้นที่ '+wallStickerArea(face).toFixed(2)+' ตร.ม.';};
      const live=(axis,value)=>{setWallStickerDimension(face,axis,value);wallStickerFor(face).id++;refresh();if(threeRenderer)threeRenderer.currentKey='';render();document.getElementById('price').textContent='฿'+fmt(priceTotal());updatePromptPreview();};
      const makeControl=(axis,label,max)=>{const row=el('div','floor-sticker-control'),lab=el('label',null,label);
        const range=document.createElement('input');range.type='range';range.min='.1';range.max=String(max);range.step=String(WALL_STICKER_STEP);range.value=axis==='w'?sticker.w:sticker.h;range.setAttribute('aria-label',label+'ของสติ๊กเกอร์'+faceDef.n);
        const number=document.createElement('input');number.type='number';number.min='.1';number.max=String(max);number.step=String(WALL_STICKER_STEP);number.inputMode='decimal';number.value=Number(axis==='w'?sticker.w:sticker.h).toFixed(2);number.dataset.resetDefault=String(axis==='w'?(sticker.resetW||2):(sticker.resetH||1));number.setAttribute('aria-label','ค่า'+label+'ของสติ๊กเกอร์'+faceDef.n);
        range.oninput=()=>live(axis,range.value);range.onchange=()=>sync();number.onchange=()=>{setWallStickerDimension(face,axis,number.value);wallStickerFor(face).id++;sync();};
        row.append(lab,range,number,el('em',null,'ม.'));controls[axis]={range,number};return row;};
      sizeBox.append(makeControl('w','ความยาว',wallFaceLength(S,face)),makeControl('h','ความสูง',S.H));card.appendChild(sizeBox);
      appendStickerDisplayControls(card,{mode:sticker.mode,patternSize:sticker.patternSize,offsetX:sticker.offsetX,offsetY:sticker.offsetY},
        (key,value,touch)=>{const target=wallStickerFor(face);target[key]=value;if(touch)target.id=(target.id||0)+1;},
        {x:sticker.w,y:sticker.h,xLabel:'เลื่อนแนวนอน',yLabel:'เลื่อนแนวตั้ง'});
      card.appendChild(el('div','lbl','หมุนภาพ'));
      const rotate=el('div','floor-sticker-rotate');[0,90,180,270].forEach(degree=>{const button=el('button','btn sm'+(Number(sticker.rotation||0)===degree?' on':''),degree+'°');button.type='button';
        button.onclick=()=>{setWallStickerRotation(face,degree);wallStickerFor(face).id++;sync();};rotate.appendChild(button);});card.appendChild(rotate);
      const lock=el('label','floor-sticker-lock'),check=document.createElement('input');check.type='checkbox';check.checked=sticker.lock!==false;
      check.onchange=()=>{sticker.lock=check.checked;if(check.checked)setWallStickerDimension(face,'w',sticker.w);sync();};lock.append(check,document.createTextNode('ล็อกสัดส่วนภาพ'));card.appendChild(lock);
      meta=el('div','floor-sticker-meta');card.appendChild(meta);refresh();
      card.appendChild(el('div','note','ปรับละเอียดทุก 5 ซม. ภาพอยู่กึ่งกลางผนังเสมอ'+(face==='back'&&isCurvedWallType(S)?' และแนบตามแนวผนังโค้ง':'')+' · คิดราคาตามพื้นที่ภาพจริง'));
    }else card.appendChild(el('div','note','รองรับ JPG, PNG และ WebP ขนาดไม่เกิน 8 MB · ตั้งค่าแยกจากผนังด้านอื่น'));
    box.appendChild(card);
  });
}
function lockIcon(k){
  const box='fill="#f72585"',txt='fill="#8a919c"';
  if(k==='stack')return '<svg width="34" height="26" viewBox="0 0 34 26"><rect x="11" y="3" width="12" height="8" rx="2" '+box+'/><rect x="6" y="15" width="22" height="4" rx="2" '+txt+'/></svg>';
  if(k==='logoLeft')return '<svg width="34" height="26" viewBox="0 0 34 26"><rect x="3" y="8" width="11" height="10" rx="2" '+box+'/><rect x="17" y="11" width="14" height="4" rx="2" '+txt+'/></svg>';
  return '<svg width="34" height="26" viewBox="0 0 34 26"><rect x="20" y="8" width="11" height="10" rx="2" '+box+'/><rect x="3" y="11" width="14" height="4" rx="2" '+txt+'/></svg>';}
function setPrimary(c){S.primary=c;S.colTouched=true;
  document.getElementById('cPick').value=c;document.getElementById('cHex').value=c.toUpperCase();sync();}
function syncDims(){document.getElementById('dW').value=S.W;
  document.getElementById('dD').value=S.D;document.getElementById('dH').value=S.H;}
function selectBoothType(type){
  const selected=TYPES.find(item=>item.k===type);if(!selected||!selected.on)return;
  const previousType=S.type;
  S.type=type;
  if(type==='backdrop'&&previousType!=='backdrop'){S.W=6;S.D=3;S.H=2.4;}
  if(type==='island'&&previousType!=='island'){S.W=6;S.D=6;S.H=2.4;S.floor='carpet';}
  if(isFixedBoothType(type)){S.W=6;S.D=3;S.H=2.4;}
  if(type==='photo360'&&!Number.isFinite(Number(S.wallRadius)))S.wallRadius=PHOTO360_DEFAULT_RADIUS;
  if(!selected.walls.length){if(type!=='island')S.logoMount='floor';S.lights=false;}
  syncDims();sync();
}

/* ================= ราคา (สมมติ) ================= */
function wallRun(){const w=typ().walls,curve=wallCurveInfo(S);
  return(w.indexOf('back')>=0?(curve?curve.arcLength:S.W):0)+(w.indexOf('left')>=0?S.D:0)+(w.indexOf('right')>=0?S.D:0);}
function priceLines(){
  const area=S.W*S.D,r=[],wa=wallRun()*S.H;
  if(wa)r.push(['ผนังบูธ '+wa.toFixed(1)+' ตร.ม.',wa*3200]);
  activeWallStickerFaces().forEach(face=>{const area=wallStickerArea(face),name=WALL_FACES.find(item=>item.k===face)?.n||face;
    if(area)r.push(['สติ๊กเกอร์ PVC ติด'+name+' · '+area.toFixed(2)+' ตร.ม. · รวมติดตั้ง',area*WALL_STICKER_RATE]);});
  if(hasStore()){const g=storeGeom(boothWallThickness(S));
    let st=22000+g.w*g.d*9000+g.h*3500;
    if(S.stSurf==='sticker')st*=1.22;
    r.push(['ห้องเก็บของ · '+stChosenLabel(),st]);}
  const nL=lightTotal();
  if(nL)r.push(['ไฟสปอตไลท์ '+nL+' จุด · '+lightModelDef().n+' · '+lightWattDef().n,lightPriceTotal()]);
  const objectGroups=new Map();
  S.objects.forEach(o=>{const row=objectGroups.get(o.catalogId)||{count:0,total:0};row.count++;row.total+=o.unitPrice;objectGroups.set(o.catalogId,row);});
  allObjectCatalog().forEach(item=>{const row=objectGroups.get(item.catalogId);
    if(row)r.push(['องค์ประกอบ · '+item.name+' × '+row.count,row.total]);});
  if(S.raise>0)r.push(['งานยกพื้น '+S.raise+' ซม.',area*(900+S.raise*38)]);
  const billedFloorArea=S.floor==='sticker'?floorStickerArea(S):area;
  const floorLineName=S.floor==='sticker'?'สติ๊กเกอร์ PVC Remove ติดพื้นบูธ · '+billedFloorArea.toFixed(2)+' ตร.ม. · รวมติดตั้ง':'วัสดุปูพื้น · '+floorName();
  r.push([floorLineName,billedFloorArea*floorDef().rate]);
  const sub=r.reduce((a,b)=>a+b[1],0);
  r.push(['ออกแบบและเขียนแบบ',sub*.08]);
  r.push(['ติดตั้ง ขนส่ง รื้อถอน',sub*.14]);
  return r;}
const priceTotal=()=>priceLines().reduce((sum,row)=>sum+row[1],0);

/* ================= Three.js renderer ================= */
const THREE_VERSION='0.180.0';
const BOOTH_WALL_THICKNESS=.1;
/* Peninsular / Photo Backdrop / Photo 360 ใช้ผนังเดี่ยวแบบหนา 30 ซม.; รูปแบบอื่นคงผนังมาตรฐาน 10 ซม. */
const PENINSULAR_WALL_THICKNESS=.3;
const boothWallThickness=spec=>['penin','backdrop','photo360'].includes(spec?.type)?PENINSULAR_WALL_THICKNESS:BOOTH_WALL_THICKNESS;
/* ผนังห้องเก็บของเป็นโครงสร้างภายในหนา 10 ซม. เสมอ ไม่รับค่าผนังหลัง 30 ซม. ของ Peninsular */
const STORAGE_ROOM_WALL_THICKNESS=BOOTH_WALL_THICKNESS;
const PHOTO360_PLATFORM_DIAMETER=1;
const PHOTO360_PLATFORM_HEIGHT=.1;
const PHOTO360_PLATFORM_FRONT_GAP=.15;
const photo360PlatformLayout=spec=>spec?.type==='photo360'?{
  diameter:PHOTO360_PLATFORM_DIAMETER,height:PHOTO360_PLATFORM_HEIGHT,
  x:(Number(spec.W)||6)/2,z:Math.max(PHOTO360_PLATFORM_DIAMETER/2,Number(spec.D||3)-PHOTO360_PLATFORM_DIAMETER/2-PHOTO360_PLATFORM_FRONT_GAP)
}:null;
const wallCurveMinRadius=spec=>Math.max(3,(Number(spec?.W)||6)/2);
function wallCurveInfo(spec){
  if(spec?.type!=='photo360')return null;
  const width=Math.max(1,Number(spec.W)||6),half=width/2,minRadius=wallCurveMinRadius({...spec,W:width});
  const radius=Math.max(minRadius,Math.min(100,Number(spec.wallRadius)||PHOTO360_DEFAULT_RADIUS));
  const root=Math.sqrt(Math.max(.000001,radius*radius-half*half)),sagitta=radius-root;
  const pointAt=(fraction,offset=0)=>{
    const u=Math.max(0,Math.min(1,Number(fraction)||0)),x=width*u,dx=x-half;
    const rise=Math.sqrt(Math.max(.000001,radius*radius-dx*dx)),z=radius-rise,slope=dx/Math.max(.000001,rise);
    const tangentLength=Math.hypot(1,slope),tx=1/tangentLength,tz=slope/tangentLength;
    const signedOffset=Number(offset)||0;
    return{x:x+(-tz)*signedOffset,z:z+tx*signedOffset,centerX:x,centerZ:z,tangentX:tx,tangentZ:tz,normalX:-tz,normalZ:tx,rotationY:Math.atan2(-tz,tx)};
  };
  return{width,radius,half,root,sagitta,arcAngle:2*Math.asin(Math.min(1,half/radius)),arcLength:radius*2*Math.asin(Math.min(1,half/radius)),pointAt,
    pointAtX:(x,offset=0)=>pointAt(Math.max(0,Math.min(1,Number(x)/width)),offset)};
}
const isCurvedWallType=spec=>spec?.type==='photo360';
const FIXTURE_WALL_GAP=.001;
const FIXTURE_LIGHT_INSET=.16;
/* ลดจากยอดผนังเล็กน้อย เพื่อให้แผ่นฐานติดใต้คาน ไม่ฝังทะลุฝาครอบด้านบน */
const FIXTURE_TOP_INSET=.012;
let threeRenderer=null,threeRendererPromise=null;

function disposeThreeObject(root){
  root.traverse(o=>{
    if(o.shadow&&o.shadow.map)o.shadow.map.dispose();
    if(o.userData&&o.userData.sharedAsset)return;
    if(o.geometry)o.geometry.dispose();
    const materials=o.material?(Array.isArray(o.material)?o.material:[o.material]):[];
    materials.forEach(m=>{
      const textures=new Set();Object.values(m).forEach(v=>{if(v&&v.isTexture)textures.add(v);});
      textures.forEach(v=>v.dispose());
      m.dispose();
    });
  });
  root.clear();
}

class ThreeBoothRenderer{
  constructor(THREE,OrbitControls,GLTFLoader){
    this.THREE=THREE;
    this.modelLoader=new GLTFLoader();this.fixtureTemplates=new Map();this.fixtureLoads=new Map();this.fixtureErrors=new Map();
    this.furnitureTemplates=new Map();this.furnitureLoads=new Map();this.furnitureErrors=new Map();
    this.downlightTemplate=null;this.downlightLoad=null;this.downlightError=null;
    this.floorImage=null;this.floorImagePromise=null;this.floorImagePromiseSource='';this.floorImageSourceKey='';this.floorImageError=false;
    this.seamlessFloorCanvases=new WeakMap();
    this.wallStickerImages=new Map();this.wallStickerLoads=new Map();this.wallStickerErrors=new Set();
    this.shell=el('div','three-shell');
    this.host=el('div','three-host');
    this.tools=el('div','three-tools');
    this.hint=el('div','three-hint','ลากเพื่อหมุน · เลื่อนเพื่อซูม');
    this.shell.append(this.host,this.tools,this.hint);
    this.viewButtons=new Map();
    [['perspective','Perspective'],['front','ด้านหน้า'],['top','ด้านบน']].forEach(([key,label])=>{
      const b=el('button','',label);b.type='button';b.onclick=()=>this.setCameraView(key);
      this.tools.appendChild(b);this.viewButtons.set(key,b);
    });
    const reset=el('button','reset','Reset');reset.type='button';
    reset.title='คืนค่าการออกแบบทั้งหมดเหมือนตอนเปิดเว็บครั้งแรก';
    reset.setAttribute('aria-label','คืนค่าการออกแบบทั้งหมด');
    reset.onclick=resetBoothToInitialState;this.tools.appendChild(reset);

    const probe=document.createElement('canvas');
    if(!probe.getContext('webgl2')&&!probe.getContext('webgl'))throw new Error('WebGL unavailable');

    this.scene=new THREE.Scene();
    this.scene.background=new THREE.Color('#101217');
    this.camera=new THREE.PerspectiveCamera(42,1,.05,250);
    this.renderer=new THREE.WebGLRenderer({antialias:true,alpha:false,powerPreference:'high-performance',preserveDrawingBuffer:true});
    this.renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));
    this.renderer.outputColorSpace=THREE.SRGBColorSpace;
    this.renderer.toneMapping=THREE.ACESFilmicToneMapping;
    this.renderer.toneMappingExposure=1.05;
    this.renderer.shadowMap.enabled=true;
    this.renderer.shadowMap.type=THREE.PCFSoftShadowMap;
    this.host.appendChild(this.renderer.domElement);

    this.controls=new OrbitControls(this.camera,this.renderer.domElement);
    this.controls.enableDamping=true;
    this.controls.dampingFactor=.075;
    this.controls.enablePan=false;
    this.controls.minPolarAngle=0;
    this.controls.maxPolarAngle=Math.PI/2-.025;
    this.controls.zoomToCursor=true;
    this.applyingCameraPreset=false;
    this.onControlsChange=()=>{
      if(this.applyingCameraPreset||!this.active)return;
