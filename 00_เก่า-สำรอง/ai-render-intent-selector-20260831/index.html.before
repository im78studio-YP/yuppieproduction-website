  furnitureItem({catalogId:'high-table-stool-set',category:'hospitality',type:'table',name:'ชุดโต๊ะสูง + เก้าอี้ 2 ตัว',icon:'◉',size:{w:2.05,d:.8,h:1.08},unitPrice:21500,color:'#8f9398',
    modelUrl:'assets/furniture/high-table-stool-set.glb'}),
  furnitureItem({catalogId:'plant-medium',category:'decor',type:'plant',name:'ต้นไม้',icon:'♧',size:{w:.55,d:.55,h:1.2},unitPrice:3500,color:'#4f8653'})];
/* My Asset is intentionally kept separate from the built-in catalogue.  The
   catalogue remains deterministic while customer GLB files can be added and
   removed without changing the shipped HTML. */
const CUSTOM_ASSETS=[];
const CUSTOM_ASSET_URLS=new Map();
const MY_ASSET_DB_NAME='yp-web-ai-my-assets-v1',MY_ASSET_STORE='assets';
let myAssetDbPromise=null,pendingMyAssetFile=null,myAssetDimensionReadPromise=null;
const allObjectCatalog=()=>OBJECT_CATALOG.concat(CUSTOM_ASSETS);
const MAX_BOOTH_HEIGHT=4.9;
const HEIGHTS=[2.4,3,3.5,4,4.5,4.9];
const TYPES=[
 {k:'inline',n:'Inline',s:'เปิด 1 ด้าน',on:true,walls:['back','left','right'],
  note:'ผนัง 3 ด้าน เปิดเฉพาะด้านหน้าที่ติดทางเดิน — ผนังด้านขวาในภาพทำโปร่งไว้ให้มองเห็นข้างใน'},
