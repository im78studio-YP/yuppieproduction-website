  const collision=obj.collision&&typeof obj.collision==='object'?obj.collision:{},catalogCollision=item?.collision||{};
  const defaultLayer=item?.category==='structure'?'structure':item?.category==='decor'?'decoration':'furniture';
  collision.layer=SCENE_COLLISION_LAYERS.includes(collision.layer)?collision.layer:(catalogCollision.layer||defaultLayer);
  collision.shapeMode=collision.shapeMode||catalogCollision.shapeMode||(isEntranceFrameObject(obj)?'compound':'box');
  collision.tolerance=clampNumber(Number(collision.tolerance)||.002,0,.05);obj.collision=collision;
  const placement=obj.placement&&typeof obj.placement==='object'?obj.placement:{};
  placement.mode=obj.attachment?.targetId?'attached':(placement.mode==='surface'?'surface':'free');
