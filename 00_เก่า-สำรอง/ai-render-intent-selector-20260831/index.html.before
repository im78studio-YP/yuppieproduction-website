      if(pattern){const matrix=new DOMMatrix().translate(canvas.width/2+offsetX,canvas.height/2+offsetY).rotate(rotation).scale(tileW/iw,tileH/ih).translate(-iw/2,-ih/2);
        if(pattern.setTransform)pattern.setTransform(matrix);ctx.fillStyle=pattern;ctx.fillRect(0,0,canvas.width,canvas.height);}
    }else{
      const quarter=Math.abs(rotation%180)===90,rotW=quarter?ih:iw,rotH=quarter?iw:ih,scale=mode==='cover'?Math.max(canvas.width/rotW,canvas.height/rotH):Math.min(canvas.width/rotW,canvas.height/rotH);
