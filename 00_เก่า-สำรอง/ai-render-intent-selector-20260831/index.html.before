function normalizeLogoPlacement(spec=S){
  if(!['wall','floor'].includes(spec.logoMount))spec.logoMount='wall';
  const active=logoActiveWalls(spec);
  /* Island ซ่อนชุดแบรนด์ แต่เก็บรูปแบบติดตั้งเดิมไว้ เพื่อคืนค่าเมื่อสลับกลับไปบูธแบบมีผนัง */
  if(!active.length&&spec.type!=='island')spec.logoMount='floor';
  if(!active.some(face=>face.k===spec.logoWall))spec.logoWall=active[0]?.k||'back';
  spec.logoFloorRotation=((Math.round((Number(spec.logoFloorRotation)||0)/90)*90)%360+360)%360;
  const floorSpan=spec.logoFloorRotation%180===90?spec.D:spec.W;
  const maxWidth=Math.max(.3,Math.min(4,spec.logoMount==='wall'?logoWallLength(spec):floorSpan));
  spec.logoWidth=placementRound(clampNumber(Number(spec.logoWidth)||2,.3,maxWidth));
  spec.logoDepth=Math.round(clampNumber(Number(spec.logoDepth)||.05,.01,.2)*100)/100;
  spec.logoBaseWidth=Number(spec.logoBaseWidth)>0?placementRound(clampNumber(Number(spec.logoBaseWidth),.1,floorSpan)):0;
  const floorDepthSpan=spec.logoFloorRotation%180===90?spec.W:spec.D;
  spec.logoBaseDepth=Number(spec.logoBaseDepth)>0?placementRound(clampNumber(Number(spec.logoBaseDepth),.1,floorDepthSpan)):0;
  const physical=brandPhysicalSize(spec),height=physical.height,width=physical.width,wallLength=logoWallLength(spec),halfW=Math.min(width/2,wallLength/2);
  spec.logoWallU=placementRound(clampNumber(Number(spec.logoWallU)||wallLength/2,halfW,Math.max(halfW,wallLength-halfW)));
  const wallRatio=wallLength?spec.logoWallU/wallLength:.5;spec.logoPos=wallRatio<.34?'left':wallRatio>.66?'right':'center';
  spec.logoWallY=placementRound(clampNumber(Number(spec.logoWallY)||Math.max(height/2,spec.H-.3-height/2),height/2,Math.max(height/2,spec.H-height/2)));
  const base=logoBaseSize(spec),floorFootprint=footprintSize({w:Math.max(width,base.width),d:Math.max(spec.logoDepth,base.depth),h:height},spec.logoFloorRotation),halfX=floorFootprint.w/2,halfZ=floorFootprint.d/2;
  spec.logoFloorX=placementRound(clampNumber(Number(spec.logoFloorX)||spec.W/2,halfX,Math.max(halfX,spec.W-halfX)));
  spec.logoFloorZ=placementRound(clampNumber(Number(spec.logoFloorZ)||spec.D/2,halfZ,Math.max(halfZ,spec.D-halfZ)));
