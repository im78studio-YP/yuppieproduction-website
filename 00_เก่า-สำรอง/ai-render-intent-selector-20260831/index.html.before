function normalizeAssetOrientation(obj){
  if(!obj||typeof obj!=='object')return'horizontal';
  const mode=ASSET_ORIENTATION_PRESETS[obj.orientation]?obj.orientation:'horizontal',preset=ASSET_ORIENTATION_PRESETS[mode];
  obj.orientation=mode;obj.rotationX=Number.isFinite(Number(obj.rotationX))?Number(obj.rotationX):preset.rotationX;
  obj.rotationZ=Number.isFinite(Number(obj.rotationZ))?Number(obj.rotationZ):preset.rotationZ;
