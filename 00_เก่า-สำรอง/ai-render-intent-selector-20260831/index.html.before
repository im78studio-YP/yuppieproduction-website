      this.commitCameraState();
    };
    this.controls.addEventListener('change',this.onControlsChange);

    this.objectMeshes=new Map();this.brandingRoot=null;this.brandingHitTarget=null;this.selectionHelper=null;this.selectionHelpers=[];this.pointerDrag=null;
    this.anchorGuideGroup=null;this.snapPreviewGroup=null;this.hoveredAnchorMarker=null;this.activeAnchorMarker=null;
    this.raycaster=new THREE.Raycaster();this.pointer=new THREE.Vector2();
    this.anchorScreenPoint=new THREE.Vector3();
    this.dragPlane=new THREE.Plane(new THREE.Vector3(0,1,0),0);this.dragPoint=new THREE.Vector3();
    this.verticalDragPlane=new THREE.Plane();this.verticalDragPoint=new THREE.Vector3();
    this.logoDragPlane=new THREE.Plane();this.logoDragPoint=new THREE.Vector3();
    this.onObjectPointerDown=e=>this.beginObjectDrag(e);
    this.onObjectPointerMove=e=>this.moveObjectDrag(e);
    this.onObjectPointerUp=e=>this.finishObjectDrag(e);
