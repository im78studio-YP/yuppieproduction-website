  note:'บูธหัวมุม ผนัง 2 ด้าน เปิดด้านหน้าและด้านขวา'},
 {k:'penin',n:'Peninsular',s:'เปิด 3 ด้าน',on:true,walls:['back'],
  note:'ผนังด้านหลังด้านเดียว เปิดหน้า ซ้าย ขวา · ความหนาผนัง 30 ซม. — พบบ่อยในบูธ 6×6 ขึ้นไป'},
 {k:'backdrop',n:'Photo Backdrop',s:'ผนังหลัง 1 ด้าน',on:true,walls:['back'],wallThickness:.3,
  note:'ขนาดเริ่มต้น 6 × 3 × 2.4 ม. · ปรับขนาดได้ · ผนังด้านหลัง 1 ผนัง · ความหนาผนัง 30 ซม.'},
 {k:'photo360',n:'มุมถ่ายภาพ 360',s:'ผนังหลังโค้ง',on:true,walls:['back'],fixed:true,wallThickness:.3,curved:true,
  note:'พื้นที่ 6 × 3 × 2.4 ม. · ผนังด้านหลังโค้ง · ความหนาผนัง 30 ซม. · กำหนดรัศมี R ได้'},
 {k:'island',n:'Island',s:'เปิด 4 ด้าน',on:true,walls:[],
  note:'พื้นที่เริ่มต้น 6 × 6 × 2.4 ม. · พื้นปูพรม · เปิดโล่งทั้ง 4 ด้าน ไม่มีผนังบูธหลัก · เพิ่มโครงสร้าง ห้อง หรือ Asset ได้อย่างอิสระ'},
 {k:'cross',n:'Cross-Aisle',s:'คร่อมทางเดิน',on:false,walls:[],note:''}];
const CORNER_SIDES=[
  {k:'left',n:'หัวมุมซ้าย',s:'ผนังหลัง + ขวา · เปิดหน้า + ซ้าย',walls:['back','right'],open:'ซ้าย'},
  {k:'right',n:'หัวมุมขวา',s:'ผนังหลัง + ซ้าย · เปิดหน้า + ขวา',walls:['back','left'],open:'ขวา'}];

const ST_SIZE=[{k:'none',n:'ไม่มี',s:'ค่าเริ่มต้น'},{k:'a',n:'1.2 × 1.2',s:'1.44 ตร.ม.',w:1.2,d:1.2},
  {k:'b',n:'1.2 × 1.5',s:'1.80 ตร.ม.',w:1.2,d:1.5},{k:'c',n:'1.2 × 2.0',s:'2.40 ตร.ม.',w:1.2,d:2.0},
  {k:'full',n:'เต็มผนัง',s:'กว้างสุดเท่าที่ใส่ได้'},{k:'custom',n:'กำหนดเอง',s:'ใส่ขนาดเอง'}];
const ST_H=[{k:2.4,n:'2.4 ม.',s:'ค่าเริ่มต้น'},{k:0,n:'กำหนดเอง',s:''}];
const ST_POS=[{k:'left',n:'ชิดซ้าย'},{k:'center',n:'ตรงกลาง'},{k:'right',n:'ชิดขวา'}];
const ST_DOOR=[{k:'left',n:'ประตูซ้าย'},{k:'front',n:'ประตูหน้า'},{k:'right',n:'ประตูขวา'}];
const ST_DOOR_TYPE=[{k:'swing',n:'บานเปิด',s:'เปิดเข้าด้านในห้อง'},{k:'slide',n:'บานเลื่อน',s:'เลื่อนไปตามแนวผนัง'}];
const LIGHTCOL=[{k:'warm',n:'แสงวอร์ม',s:'3000K',c:'#ffd9a0'},
  {k:'white',n:'แสงขาว',s:'6500K',c:'#e2ecff'}];
const LIGHTWALL=[{k:'back',n:'ผนังหลัง',s:'ค่าเริ่มต้น'},{k:'all',n:'ทุกผนัง',s:'รอบบูธ'}];
const LIGHT_MODELS=[
  /* Clear Light V2: เลนส์/หน้าปล่อยแสงของไฟอยู่บนแกน +Y ของ GLB
     เมื่อตั้งหมุน X +90° จะชี้เข้าในบูธตามแกน +Z ของจุดยึดทุกผนัง
     ใช้ mesh 3 เป็นตัวเรือนและยึดระนาบด้านหลัง (แกน Z ต่ำสุด) */
  {k:'clear100',n:'Clear Light',s:'โคมหลัก 100W',url:'./assets/lights/Spotlight_Clear_100watts_V2.glb?v=20260824-v2',scale:1,spacing:2.0,spacingRule:'min',wallRotationX:Math.PI/2,baseMeshIndex:3,baseAxis:'z',baseSide:'min',templateRotationY:0,topInset:-.15,fixtureOffsetZ:.10,beamMode:'wallWash',wallWashHeight:.55,wallWashGap:.03,beamAngle:.80,beamPenumbra:.96,beamDecay:1.25,beamDistanceFactor:2.5,wallBeamMix:.68,wallDiffuseMix:.24,wallDiffuseAngle:1.16,wallDiffusePenumbra:1,wallDiffuseDecay:1.15,floorBeamMix:.08,bracketMeshIndices:[0,2,10],bracketFlipAxis:'y',bracketFlipAngle:Math.PI,bracketOffsetZ:-.20,lightSource:[0,-.126,.054]},
  /* Arm Light V4: mesh 10 คือก้อนฐานยึดผนังที่ปลายก้านด้านหลัง
     (mesh 9 เป็นเพียงแผ่น/ชิ้นส่วนที่ปลายหัวโคม) จึงต้องใช้ mesh 10
     เป็นระนาบอ้างอิง แล้วกลับแนวก้านให้หัวโคมหันออกทางเดิน */
  {k:'arm',n:'Arm Light',s:'เลือกทรงโคม · คิด 10W',url:'./assets/lights/Arm-Light-V4.glb?v=20260824-v4',scale:1,spacing:1.0,backWallClearance:1.0,wallRotationX:Math.PI/2,baseMeshIndex:10,baseAxis:'z',baseSide:'min',templateRotationY:Math.PI,mountMode:'ceiling',modelFlipZ:true,lightSource:[0,-.07,.33],beamMode:'downwash',beamTargetHeightRatio:.83,beamTargetDepth:.04,beamAngle:.58,beamPenumbra:.88,beamDecay:1.6,beamDistanceFactor:2.5,beamMix:.72,beamDiffuseMix:.20,beamDiffuseAngle:.80,beamDiffusePenumbra:1,beamDiffuseDecay:1.15,
    /* ฐานติดขอบผนัง แล้วก้านยื่นเข้าทางเดินเสมอ: หลัง = +Z · ซ้าย = +X · ขวา = -X */
    wallRotations:{back:0,left:Math.PI/2,right:-Math.PI/2}}];
const OFFLINE_LIGHT_MODELS_SCRIPT='./assets/lights/embedded-light-models.js?v=20260824-clear-v2';
let offlineLightModelsPromise=null;
function fixtureModelSource(def){
  if(location.protocol!=='file:')return Promise.resolve(def.url);
  const cached=globalThis.OFFLINE_LIGHT_MODELS?.[def.k];if(cached)return Promise.resolve(cached);
  if(!offlineLightModelsPromise)offlineLightModelsPromise=new Promise((resolve,reject)=>{
    const script=document.createElement('script');script.src=OFFLINE_LIGHT_MODELS_SCRIPT;
    script.onload=()=>globalThis.OFFLINE_LIGHT_MODELS?resolve(globalThis.OFFLINE_LIGHT_MODELS):reject(new Error('Embedded light models are unavailable'));
    script.onerror=()=>reject(new Error('Embedded light model bundle failed to load'));
    document.head.appendChild(script);
  });
  return offlineLightModelsPromise.then(models=>{const source=models[def.k];if(!source)throw new Error('Embedded light model is missing: '+def.k);return source;});
}
const OFFLINE_FURNITURE_MODELS_SCRIPT='./assets/furniture/embedded-furniture-models.js';
let offlineFurnitureModelsPromise=null;
function furnitureModelSource(item){
  if(item?.customAsset){
    let source=CUSTOM_ASSET_URLS.get(item.catalogId);
    if(!source&&item.file&&globalThis.URL?.createObjectURL){
      source=URL.createObjectURL(item.file);CUSTOM_ASSET_URLS.set(item.catalogId,source);
    }
    return source?Promise.resolve(source):Promise.reject(new Error('My Asset file is unavailable: '+item.name));
  }
  if(location.protocol!=='file:')return Promise.resolve(item.modelUrl);
  const cached=globalThis.OFFLINE_FURNITURE_MODELS?.[item.catalogId];if(cached)return Promise.resolve(cached);
  if(!offlineFurnitureModelsPromise)offlineFurnitureModelsPromise=new Promise((resolve,reject)=>{
    const script=document.createElement('script');script.src=OFFLINE_FURNITURE_MODELS_SCRIPT;
    script.onload=()=>globalThis.OFFLINE_FURNITURE_MODELS?resolve(globalThis.OFFLINE_FURNITURE_MODELS):reject(new Error('Embedded furniture models are unavailable'));
    script.onerror=()=>reject(new Error('Embedded furniture model bundle failed to load'));
    document.head.appendChild(script);
  });
  return offlineFurnitureModelsPromise.then(models=>{const source=models[item.catalogId];if(!source)throw new Error('Embedded furniture model is missing: '+item.catalogId);return source;});
}
const LIGHT_WATTS=[{k:100,n:'100W',price:1500,intensity:52},{k:10,n:'10W',price:1500,intensity:52}];
const lightDefaultWatts=fixtureKey=>fixtureKey==='arm'?10:100;
const LIGHT_SPACING=1.0;
const STORAGE_LIGHT_BLOCK_RATIO=.70;
const BRAND_TOP_GAP_M=.30;
const brandCenterY=(hostTop,height)=>hostTop-BRAND_TOP_GAP_M-height/2;
