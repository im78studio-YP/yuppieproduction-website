function sceneObjectOrientedSize(obj,sizeOverride=null){
  const size=sizeOverride||obj?.size||{w:0,d:0,h:0},w=Math.max(0,Number(size.w)||0),d=Math.max(0,Number(size.d)||0),h=Math.max(0,Number(size.h)||0),
