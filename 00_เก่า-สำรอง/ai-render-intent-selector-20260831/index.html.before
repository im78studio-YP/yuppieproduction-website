  update(spec){
    const key=this.visualKey(spec);if(key===this.currentKey)return;
    this.currentKey=key;this.buildId=(this.buildId||0)+1;this.scene.remove(this.boothGroup);disposeThreeObject(this.boothGroup);
    this.objectMeshes=new Map();this.brandingRoot=null;this.brandingHitTarget=null;this.selectionHelper=null;this.selectionHelpers=[];this.anchorGuideGroup=null;this.snapPreviewGroup=null;
    this.hoveredAnchorMarker=null;this.activeAnchorMarker=null;
