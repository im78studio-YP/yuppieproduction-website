function sceneAttachmentActive(obj){return !!(obj?.attachment?.targetId&&obj.attachment.status==='attached');}
function resolveSceneAttachment(obj,spec=S){
  normalizeSceneObjectModel(obj);const attachment=obj?.attachment;if(!attachment?.targetId)return false;
  const target=sceneTargetNode(attachment.targetId,spec);if(!target){attachment.status='missing';obj.placement.mode='free';return false;}
  if(isEntranceFrameObject(obj)&&attachment.syncDimensions.includes('depth')){
    obj.structure.projection=target.dimensions.depth;normalizeEntranceFrameObject(obj,spec);
  }
  const source=localScenePorts(obj).find(port=>port.id===attachment.sourcePort),targetPort=target.ports.find(port=>port.id===attachment.targetPort);
  if(!source||!targetPort){attachment.status='invalid';obj.placement.mode='free';return false;}
  const rad=((Number(obj.rotationY)||0)%360)*Math.PI/180,c=Math.cos(rad),s=Math.sin(rad),offset=attachment.offset||{};
  const sourceX=source.position.x*c+source.position.z*s,sourceZ=-source.position.x*s+source.position.z*c;
  obj.position.x=+placementRound(targetPort.position.x-sourceX+(Number(offset.x)||0)).toFixed(3);
