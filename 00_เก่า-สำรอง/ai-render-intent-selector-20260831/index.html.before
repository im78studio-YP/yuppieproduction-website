    if(!source||this.wallStickerErrors.has(source))return null;
    if(this.wallStickerImages.has(source))return this.wallStickerImages.get(source);
    if(this.wallStickerLoads.has(source))return null;
    const load=new Promise(resolve=>{const image=new Image();image.decoding='async';
      image.onload=()=>{this.wallStickerImages.set(source,image);this.wallStickerLoads.delete(source);resolve(image);
        this.currentKey='';if(this.active)this.update(BoothSpec);};
      image.onerror=()=>{this.wallStickerErrors.add(source);this.wallStickerLoads.delete(source);resolve(null);};image.src=source;});
