  placement.policy={preferredTarget:String(declaredPolicy.preferredTarget||policyDefaults.preferredTarget),
    allowedTargets:Array.isArray(declaredPolicy.allowedTargets)?[...new Set(declaredPolicy.allowedTargets.filter(target=>SCENE_PLACEMENT_TARGETS.includes(target)))]:policyDefaults.allowedTargets,
    requiresSurface:typeof declaredPolicy.requiresSurface==='boolean'?declaredPolicy.requiresSurface:policyDefaults.requiresSurface,
    defaultSpawn:String(declaredPolicy.defaultSpawn||policyDefaults.defaultSpawn),
    allowOutsideBooth:typeof declaredPolicy.allowOutsideBooth==='boolean'?declaredPolicy.allowOutsideBooth:policyDefaults.allowOutsideBooth};
