const logoPhysicalWidth=(spec=S)=>brandPhysicalSize(spec).width;
const logoPhysicalHeight=(spec=S)=>brandPhysicalSize(spec).height;
function logoBaseSize(spec=S){
  const physical=brandPhysicalSize(spec),turned=Math.abs(Number(spec.logoFloorRotation)||0)%180===90;
  const maxWidth=Math.max(.1,turned?Number(spec.D)||1:Number(spec.W)||1),maxDepth=Math.max(.1,turned?Number(spec.W)||1:Number(spec.D)||1);
  const defaultWidth=clampNumber(physical.width,.1,maxWidth),defaultDepth=clampNumber(Math.max(.18,(Number(spec.logoDepth)||.05)+.14),.1,maxDepth);
  const customWidth=Number(spec.logoBaseWidth),customDepth=Number(spec.logoBaseDepth);
  return{width:clampNumber(customWidth>0?customWidth:defaultWidth,.1,maxWidth),depth:clampNumber(customDepth>0?customDepth:defaultDepth,.1,maxDepth),defaultWidth,defaultDepth,maxWidth,maxDepth};
}
function logoActiveWalls(spec=S){
  const base=TYPES.find(item=>item.k===spec.type),side=spec.type==='corner'?CORNER_SIDES.find(item=>item.k===spec.cornerSide):null,walls=side?.walls||base?.walls||[];
  return WALL_FACES.filter(face=>walls.includes(face.k));
