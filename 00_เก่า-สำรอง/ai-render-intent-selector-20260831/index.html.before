    camera:currentCameraManifest(spec),permissions:{allowOptionalProps:ai.allowOptionalProps,optionalCategories:{...ai.optionalPermissions},
      aiStaging:{enabled:staging.enabled,density:staging.density,allowFurniture:staging.allowFurniture,allowProducts:staging.allowProducts,
        allowPeople:staging.allowPeople,allowDecor:staging.allowDecor,allowPlants:staging.allowPlants,allowNewPermanentStructures:false,
        geometryFidelity:spec.geometryFidelity,stagingFreedom:spec.stagingFreedom},
