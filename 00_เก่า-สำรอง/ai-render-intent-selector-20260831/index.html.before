    const T=this.THREE,g=new T.BoxGeometry(size[0],size[1],size[2]);
    const m=options.material||new T.MeshStandardMaterial({color,roughness:options.roughness??.72,
      metalness:options.metalness??.02,transparent:(options.opacity??1)<1,opacity:options.opacity??1});
    const mesh=new T.Mesh(g,m);mesh.position.set(position[0],position[1],position[2]);
