      spec.lightWall,spec.lightWatts,spec.lightAdj,spec.brand,logoKey,spec.logoType,spec.logoShape,spec.lockup,spec.logoPos,
      spec.logoScale,spec.nameScale,spec.logoMount,spec.logoWall,spec.logoWidth,spec.logoDepth,spec.logoBaseWidth,spec.logoBaseDepth,spec.logoBaseColor,spec.logoColor,spec.logoWallU,spec.logoWallY,
      spec.logoFloorX,spec.logoFloorZ,spec.logoFloorRotation,spec.sideLogo,spec.sidePos,spec.wallRadius,spec.carpetTextureId||0,
      spec.carpetTextureMode||'builtin',spec.carpetTextureActiveId||'',spec.tileTextureId||0,
