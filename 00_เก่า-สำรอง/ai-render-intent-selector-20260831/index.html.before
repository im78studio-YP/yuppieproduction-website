  floorImageSource(source){
    if(!source)return null;
    if(this.floorImageSourceKey===source&&(this.floorImage||this.floorImageError))return this.floorImage;
    if(this.floorImagePromise&&this.floorImagePromiseSource===source)return null;
    this.floorImage=null;this.floorImageError=false;this.floorImagePromise=null;this.floorImageSourceKey=source;this.floorImagePromiseSource=source;
    if(!this.floorImagePromise){
      this.floorImagePromise=new Promise(resolve=>{
        const image=new Image();image.decoding='async';
        image.onload=()=>{if(this.floorImageSourceKey!==source){resolve(null);return;}
          this.floorImage=image;this.floorImagePromise=null;this.floorImagePromiseSource='';resolve(image);
          this.currentKey='';if(this.active)this.update(BoothSpec);};
        image.onerror=()=>{if(this.floorImageSourceKey===source){this.floorImageError=true;this.floorImagePromise=null;this.floorImagePromiseSource='';}resolve(null);};
        image.src=source;
