const PLACEMENT_GRID=.05;
const MAGNETIC_SNAP_DISTANCE=.15;
const FRONT_ASSET_STAGING_GAP=.25;
/* ทดลองเปิดการซ้อน Asset: ขอบบูธ ห้องเก็บของ และแท่น 360 ยังเป็นพื้นที่ห้ามวาง
   การวางอัตโนมัติยังค้นหาช่องว่างก่อน เพื่อลดการกอง Asset โดยไม่ตั้งใจ */
const ALLOW_ASSET_OVERLAP=true;
const placementStepLabel=()=>Math.round(PLACEMENT_GRID*100)+' ซม.';
