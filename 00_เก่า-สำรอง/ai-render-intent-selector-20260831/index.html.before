}
function sceneAttachmentLabel(attachment){
  if(!attachment?.targetId)return'วางอิสระ';
  const side=attachment.targetPort==='storage-left-front'?'ด้านซ้าย':attachment.targetPort==='storage-right-front'?'ด้านขวา':attachment.targetPort;
  return attachment.targetId==='storage-room'?'เชื่อม'+side+'ของห้องเก็บของ':'เชื่อมกับ '+attachment.targetId+' · '+side;
}
function downlightBeamDefaults(spec=S){
  return{length:Math.max(.5,Number(spec.W)||6),depth:.3,thickness:.2,height:Math.max(.5,Number(spec.H)||2.4),lightCount:5,color:'#f2f3f5',lightColor:'#fff4d6',wallAttached:true};
}
function normalizeDownlightBeamObject(obj,spec=S){
  if(!isDownlightBeamObject(obj))return obj;
  const defaults=downlightBeamDefaults(spec),config=obj.structure&&typeof obj.structure==='object'?obj.structure:{};
  const length=placementRound(clampNumber(Number(config.length)||defaults.length,.5,Math.max(.5,Number(spec.W)||6)));
  const depth=assetDimensionValue(config.depth,defaults.depth);
  const thickness=assetDimensionValue(config.thickness,defaults.thickness);
  let height=assetDimensionValue(config.height,defaults.height);
  const lightCount=Math.round(clampNumber(Number(config.lightCount)||defaults.lightCount,1,12));
  const color=/^#[0-9a-fA-F]{6}$/.test(String(config.color||''))?String(config.color).toLowerCase():defaults.color;
  const lightColor=/^#[0-9a-fA-F]{6}$/.test(String(config.lightColor||''))?String(config.lightColor).toLowerCase():defaults.lightColor;
