const SCENE_APPEARANCE_MODES=Object.freeze(['original','tint','solid']);
const ASSET_ORIENTATION_PRESETS=Object.freeze({
  horizontal:{label:'แนวนอน',rotationX:0,rotationZ:0},
  upright:{label:'แนวตั้ง',rotationX:0,rotationZ:90},
  'side-left':{label:'ตะแคงซ้าย',rotationX:-90,rotationZ:0},
  'side-right':{label:'ตะแคงขวา',rotationX:90,rotationZ:0}
