}
const logoWallLength=(spec=S)=>wallFaceLength(spec,spec.logoWall||'back');
const brandSurfaceWidth=(spec=S)=>{
  if(spec.logoMount==='floor')return spec.logoFloorRotation%180===90?spec.D:spec.W;
  return logoWallLength(spec);
};
function brandPhysicalSize(spec=S){
  const span=Math.max(.3,brandSurfaceWidth(spec)),maxWidth=span*BRAND_MAX_WIDTH_RATIO;
  const logoFraction=logoScaleFactor(spec.logoScale,span),nameFraction=nameScaleFactor(spec.nameScale,span);
  const logoWidth=maxWidth*logoFraction,nameWidth=maxWidth*nameFraction,showLogo=logoFraction>0,showName=nameFraction>0;
  const sideBySide=showLogo&&showName&&spec.lockup!=='stack',gap=sideBySide?Math.min(.18,span*.03):0;
  const rawWidth=sideBySide?logoWidth+nameWidth+gap:Math.max(logoWidth,nameWidth);
  const width=Math.max(.05,Math.min(maxWidth,rawWidth));
  const logoAR=Math.max(.35,Number(spec.logoAR)||2.2),logoHeight=Math.min(spec.H*.72,logoWidth/logoAR);
  const chars=Math.max(2,String(spec.brand||'YOUR BRAND').length*.62),nameHeight=Math.min(spec.H*.3,nameWidth/chars);
  const rawHeight=showLogo&&showName&&spec.lockup==='stack'?logoHeight+nameHeight+Math.min(.14,spec.H*.05):Math.max(logoHeight,nameHeight);
  return{width,height:Math.max(.15,Math.min(spec.H*.9,rawHeight||.15)),span,maxWidth,logoWidth,nameWidth};
