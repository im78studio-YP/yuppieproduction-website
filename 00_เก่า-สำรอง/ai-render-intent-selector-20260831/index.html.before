function defaultScenePlacementPolicy(item={}){
  const source=item.placementPolicy&&typeof item.placementPolicy==='object'?item.placementPolicy:{};
  const preferred=String(source.preferredTarget||(item.backWallOnly?'back-wall':item.mount==='ceiling'?'ceiling':item.mount==='wall'?'wall':'floor'));
  const allowed=Array.isArray(source.allowedTargets)?source.allowedTargets:SCENE_PLACEMENT_TARGETS;
  return{preferredTarget:preferred,allowedTargets:[...new Set(allowed.filter(target=>SCENE_PLACEMENT_TARGETS.includes(target)))],
    requiresSurface:source.requiresSurface===true,defaultSpawn:String(source.defaultSpawn||'front-staging'),allowOutsideBooth:source.allowOutsideBooth!==false};
}
function defaultSceneCapabilities(item={}){
  const declared=Array.isArray(item.capabilities)?item.capabilities:null,source=[...(declared||[
    item.mount==='ceiling'?'ceilingMountable':item.mount==='wall'?'wallMountable':'floorPlaceable','free3DPlaceable','surfaceSnappable',
    item.category==='structure'?'resizable':'rotatable','styleable',item.category==='decor'?'repeatable':null]),'free3DPlaceable','surfaceSnappable'];
