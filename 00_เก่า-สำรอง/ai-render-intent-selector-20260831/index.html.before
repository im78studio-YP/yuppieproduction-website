    const cached=this.seamlessFloorCanvases.get(image);if(cached)return cached;
    const sourceW=Math.max(1,image.naturalWidth||image.width||1),sourceH=Math.max(1,image.naturalHeight||image.height||1);
    const scale=Math.min(1,1024/Math.max(sourceW,sourceH));
    const cellW=Math.max(1,Math.round(sourceW*scale)),cellH=Math.max(1,Math.round(sourceH*scale));
    const canvas=document.createElement('canvas');canvas.width=cellW*2;canvas.height=cellH*2;
    const ctx=canvas.getContext('2d');ctx.imageSmoothingEnabled=true;ctx.imageSmoothingQuality='high';
    const draw=(x,y,flipX,flipY)=>{ctx.save();ctx.translate(x+(flipX?cellW:0),y+(flipY?cellH:0));ctx.scale(flipX?-1:1,flipY?-1:1);ctx.drawImage(image,0,0,cellW,cellH);ctx.restore();};
    draw(0,0,false,false);draw(cellW,0,true,false);draw(0,cellH,false,true);draw(cellW,cellH,true,true);
    this.seamlessFloorCanvases.set(image,canvas);return canvas;
  }
  floorTexture(image,repeat=[1,1],rotation=0,seamless=false){
    const T=this.THREE,source=seamless?this.seamlessFloorCanvas(image):image;
    const texture=seamless?new T.CanvasTexture(source):new T.Texture(source);texture.colorSpace=T.SRGBColorSpace;
    texture.wrapS=texture.wrapT=T.RepeatWrapping;
    const repeatScale=seamless ? .5 : 1;
    texture.repeat.set(Math.max(.5,repeat[0]*repeatScale),Math.max(.5,repeat[1]*repeatScale));
    if(rotation){texture.center.set(.5,.5);texture.rotation=rotation;}
    texture.anisotropy=Math.min(8,this.renderer.capabilities.getMaxAnisotropy());texture.needsUpdate=true;
    return texture;
  }
  patternTexture(kind,base,accent,repeat=[1,1]){
    const T=this.THREE,c=document.createElement('canvas');c.width=256;c.height=256;
    const x=c.getContext('2d');x.fillStyle=base;x.fillRect(0,0,256,256);
    if(kind==='wood'){
      for(let i=0;i<18;i++){const px=i*16+(i%3)*2;x.strokeStyle=i%2?'rgba(40,20,8,.20)':'rgba(255,255,255,.10)';
        x.lineWidth=i%3===0?3:1;x.beginPath();x.moveTo(px,0);x.bezierCurveTo(px+7,70,px-5,170,px+4,256);x.stroke();}
    }else if(kind==='sticker'){
      x.fillStyle=accent;x.globalAlpha=.92;x.beginPath();x.moveTo(0,178);x.lineTo(256,42);x.lineTo(256,120);x.lineTo(0,256);x.closePath();x.fill();
      x.globalAlpha=.22;x.fillStyle='#ffffff';x.beginPath();x.arc(196,188,62,0,Math.PI*2);x.fill();x.globalAlpha=1;
    }else if(kind==='laminate'){
      const gr=x.createLinearGradient(0,0,256,256);gr.addColorStop(0,'rgba(255,255,255,.18)');gr.addColorStop(.48,'rgba(255,255,255,0)');gr.addColorStop(1,'rgba(0,0,0,.08)');
      x.fillStyle=gr;x.fillRect(0,0,256,256);
    }else if(kind==='carpet'||kind==='grass'||kind==='concrete'){
      for(let i=0;i<1500;i++){const px=(i*73)%256,py=(i*151)%256,v=(i%9)/9;
        x.fillStyle=kind==='grass'?(i%2?'rgba(220,255,190,.15)':'rgba(5,35,8,.18)'):
          kind==='carpet'?(i%2?'rgba(255,255,255,.08)':'rgba(0,0,0,.10)'):
          (v>.5?'rgba(255,255,255,.06)':'rgba(0,0,0,.08)');x.fillRect(px,py,1,kind==='grass'?4:1);}
    }else if(kind==='marble'){
      for(let i=0;i<7;i++){x.strokeStyle=i%2?'rgba(105,112,120,.20)':'rgba(255,255,255,.42)';x.lineWidth=i%3===0?3:1;
        x.beginPath();x.moveTo(-20,i*42);x.bezierCurveTo(70,i*29+18,145,i*51-22,280,i*37+5);x.stroke();}
    }else if(kind==='tile'){
      x.strokeStyle='rgba(0,0,0,.18)';x.lineWidth=2;for(let i=0;i<=256;i+=64){x.beginPath();x.moveTo(i,0);x.lineTo(i,256);x.stroke();x.beginPath();x.moveTo(0,i);x.lineTo(256,i);x.stroke();}
    }
    const texture=new T.CanvasTexture(c);texture.colorSpace=T.SRGBColorSpace;
    texture.wrapS=texture.wrapT=T.RepeatWrapping;texture.repeat.set(Math.max(1,repeat[0]),Math.max(1,repeat[1]));
    texture.anisotropy=Math.min(4,this.renderer.capabilities.getMaxAnisotropy());return texture;
  }
  surfaceMaterial(kind,base,accent,repeat=[1,1],imageSource=null,imageRotation=0,imageSeamless=false,physical=false){
    const T=this.THREE,rough={paint:.82,laminate:.38,wood:.7,sticker:.48,carpet:1,grass:1,marble:.36,concrete:.94,tile:.68}[kind]??.78;
    const params={color:base,roughness:rough,metalness:kind==='laminate'?.04:0};
    if(kind!=='paint'){
      const floorImage=imageSource?this.floorImageSource(imageSource):null;
      params.color=floorImage?base:'#ffffff';
      params.map=floorImage?this.floorTexture(floorImage,repeat,imageRotation,imageSeamless):this.patternTexture(kind,base,accent,repeat);
      if(kind==='sticker')params.emissive=new T.Color(accent).multiplyScalar(.025);
    }
    return physical?new T.MeshPhysicalMaterial(params):new T.MeshStandardMaterial(params);
  }
  floorMaterial(spec){
    if(spec.floor==='sticker')return new this.THREE.MeshStandardMaterial({color:0xe8e9e6,roughness:.82,metalness:0});
    let kind=spec.floor;
    if(spec.floor==='tile')kind=spec.tile==='marble'?'marble':spec.tile==='conc'?'concrete':spec.tile.startsWith('wood')?'wood':'tile';
    const tileDef=TILES.find(item=>item.k===spec.tile);
    const activeCarpetUpload=spec.floor==='carpet'?activeCarpetTexture(spec):null;
    const activeUpload=spec.floor==='tile'?activeTileTexture(spec):null;
    const imageSource=spec.floor==='carpet'?(activeCarpetUpload?.data||CARPET_TEXTURE_URL):
      spec.floor==='grass'?GRASS_TEXTURE_URL:
      spec.floor==='tile'?(activeUpload?.data||tileDef?.texture||null):null;
    const materialBase=(spec.floor==='tile'&&imageSource)||activeCarpetUpload||spec.floor==='grass'?'#ffffff':floorColor();
    const rotateTileImage=spec.floor==='tile'&&imageSource&&spec.W>=spec.D;
    const textureModule=spec.floor==='grass'?.5:1.2;
    const repeat=rotateTileImage?[Math.max(1,spec.D/textureModule),Math.max(1,spec.W/textureModule)]:
      [Math.max(1,spec.W/textureModule),Math.max(1,spec.D/textureModule)];
    const isVinyl=spec.floor==='tile';
    const seamlessFloorImage=!!activeCarpetUpload||(isVinyl&&!!imageSource);
    const material=this.surfaceMaterial(kind,materialBase,spec.secondary,repeat,imageSource,rotateTileImage?Math.PI/2:0,seamlessFloorImage,isVinyl);
    if(isVinyl){
      material.roughness=.35;material.metalness=0;
      material.clearcoat=.25;material.clearcoatRoughness=.35;material.specularIntensity=.55;
    }
    return material;
  }
  addFloorSticker(group,spec,floorY){
    if(spec.floor!=='sticker'||!spec.floorStickerData)return null;
    const image=this.floorImageSource(spec.floorStickerData);if(!image)return null;
    const T=this.THREE,texture=this.artworkTexture(image,spec.floorStickerW,spec.floorStickerD,{mode:spec.floorStickerMode,patternSize:spec.floorStickerPatternSize,
      offsetX:spec.floorStickerOffsetX,offsetY:spec.floorStickerOffsetY,rotation:spec.floorStickerRotation}),material=new T.MeshStandardMaterial({
      color:0xffffff,map:texture,roughness:.58,metalness:0,transparent:true,alphaTest:.015,side:T.DoubleSide});
    const geometry=new T.PlaneGeometry(Math.max(.1,spec.floorStickerW),Math.max(.1,spec.floorStickerD));
    const mesh=new T.Mesh(geometry,material);mesh.rotation.x=-Math.PI/2;mesh.position.set(spec.W/2,floorY+.002,spec.D/2);
    mesh.name='floor-sticker-graphic';mesh.castShadow=false;mesh.receiveShadow=true;mesh.renderOrder=2;group.add(mesh);return mesh;
  }
  wallMaterial(spec,length,face){
    return this.surfaceMaterial('paint',palette().wall,spec.secondary,[Math.max(1,length/1.2),Math.max(1,spec.H/1.2)]);
  }
  curvedWallSticker(group,spec,sticker,t,floorY){
    const info=wallCurveInfo(spec),material=this.wallStickerMaterial(sticker.data,sticker.w,sticker.h,sticker);if(!info||!material)return null;
    const T=this.THREE,arcWidth=Math.min(info.arcLength,Math.max(.1,Number(sticker.w)||.1)),height=Math.min(spec.H,Math.max(.1,Number(sticker.h)||.1));
    const halfAngle=Math.min(arcWidth/(2*info.radius),Math.max(.001,info.arcAngle/2-.002)),segments=Math.max(24,Math.min(96,Math.ceil(arcWidth*24)));
    const positions=[],uvs=[],indices=[],rings=[],bottom=floorY+(spec.H-height)/2,top=bottom+height;
    const vertex=(point,y,u,v)=>{const index=positions.length/3;positions.push(point.x,y,point.z);uvs.push(u,v);return index;};
    for(let i=0;i<=segments;i++){const u=i/segments,angle=(u-.5)*halfAngle*2,x=info.half+info.radius*Math.sin(angle),point=info.pointAt(x/info.width,t/2+.003);
      rings.push({bottom:vertex(point,bottom,u,0),top:vertex(point,top,u,1)});}
    for(let i=0;i<segments;i++){const a=rings[i],b=rings[i+1];indices.push(a.bottom,b.bottom,b.top,a.bottom,b.top,a.top);}
    const geometry=new T.BufferGeometry();geometry.setAttribute('position',new T.Float32BufferAttribute(positions,3));geometry.setAttribute('uv',new T.Float32BufferAttribute(uvs,2));geometry.setIndex(indices);geometry.computeVertexNormals();
    const mesh=new T.Mesh(geometry,material);mesh.name='wall-sticker-back-curved';mesh.castShadow=false;mesh.receiveShadow=true;mesh.renderOrder=2;group.add(mesh);return mesh;
  }
  addWallStickers(group,spec,t,floorY){
    const walls=typ().walls;
    walls.forEach(face=>{if(wallFinishKind(spec,face)!=='sticker')return;const sticker=wallStickerFor(face,spec);if(!sticker.data)return;
      if(face==='back'&&isCurvedWallType(spec)){this.curvedWallSticker(group,spec,sticker,t,floorY);return;}
      const material=this.wallStickerMaterial(sticker.data,sticker.w,sticker.h,sticker);if(!material)return;
      const width=Math.min(wallFaceLength(spec,face),Math.max(.1,Number(sticker.w)||.1)),height=Math.min(spec.H,Math.max(.1,Number(sticker.h)||.1));
      const mesh=new this.THREE.Mesh(new this.THREE.PlaneGeometry(width,height),material);mesh.name='wall-sticker-'+face;mesh.castShadow=false;mesh.receiveShadow=true;mesh.renderOrder=2;
      if(face==='back'){mesh.position.set(spec.W/2,spec.H/2,t+.003);}
      else if(face==='left'){mesh.position.set(t+.003,spec.H/2,spec.D/2);mesh.rotation.y=Math.PI/2;}
      else{mesh.position.set(spec.W-t-.003,spec.H/2,spec.D/2);mesh.rotation.y=-Math.PI/2;}
      group.add(mesh);
    });
  }
  curvedWall(group,spec,t,floorY){
    const info=wallCurveInfo(spec);if(!info)return null;
    const T=this.THREE,segments=64,height=spec.H,positions=[],uvs=[],indices=[],rings=[];
    const vertex=(point,y,u,v)=>{const index=positions.length/3;positions.push(point.x,y,point.z);uvs.push(u,v);return index;};
    for(let i=0;i<=segments;i++){
      const u=i/segments,front=info.pointAt(u,t/2),back=info.pointAt(u,-t/2);
      rings.push({fb:vertex(front,floorY,u,0),ft:vertex(front,floorY+height,u,1),bb:vertex(back,floorY,u,0),bt:vertex(back,floorY+height,u,1)});
    }
    const quad=(a,b,c,d)=>indices.push(a,b,c,a,c,d);
    for(let i=0;i<segments;i++){
      const a=rings[i],b=rings[i+1];
      quad(a.fb,b.fb,b.ft,a.ft);quad(b.bb,a.bb,a.bt,b.bt);quad(a.ft,b.ft,b.bt,a.bt);quad(b.fb,a.fb,a.bb,b.bb);
    }
    const first=rings[0],last=rings[rings.length-1];
    quad(first.fb,first.ft,first.bt,first.bb);quad(last.fb,last.bb,last.bt,last.ft);
    const geometry=new T.BufferGeometry();geometry.setAttribute('position',new T.Float32BufferAttribute(positions,3));
    geometry.setAttribute('uv',new T.Float32BufferAttribute(uvs,2));geometry.setIndex(indices);geometry.computeVertexNormals();
    const material=this.wallMaterial(spec,info.arcLength,'back');material.side=T.DoubleSide;
    const mesh=new T.Mesh(geometry,material);mesh.name='booth-wall-back-curved';mesh.castShadow=true;mesh.receiveShadow=true;mesh.userData.wallCurveRadius=info.radius;group.add(mesh);
    const edgePoints=[];
    for(let i=0;i<=segments;i++){const p=info.pointAt(i/segments,t/2+.001);edgePoints.push(new T.Vector3(p.x,floorY+height+.002,p.z));}
    const edgeGeometry=new T.BufferGeometry().setFromPoints(edgePoints),edgeMaterial=new T.LineBasicMaterial({color:0x111317,transparent:true,opacity:.38});
    const edge=new T.Line(edgeGeometry,edgeMaterial);edge.name='booth-wall-back-curved-edge';edge.renderOrder=3;group.add(edge);
    return{info,mesh};
  }
  storageMaterial(spec,face){
    const a=palette(),selected=spec.stSurf==='sticker'&&(spec.stFace==='all'||spec.stFace===face||
      (face==='front'&&(spec.stFace==='front-left'||spec.stFace==='front-right'))||
      (face==='left'&&spec.stFace==='front-left')||(face==='right'&&spec.stFace==='front-right'));
    return this.surfaceMaterial(selected?'sticker':'paint',selected?a.acc:stPaintColor(a),a.sec,[1.5,1.5]);
  }
  brandTexture(spec,bg){
    const T=this.THREE,c=document.createElement('canvas'),stage=document.createElement('canvas');c.width=stage.width=1024;c.height=stage.height=512;
    const x=c.getContext('2d'),sx=stage.getContext('2d'),a=palette(),generation=this.buildId;let texture=null;
    const visibleBounds=(context,canvas)=>{
      const pixels=context.getImageData(0,0,canvas.width,canvas.height).data;let minX=canvas.width,minY=canvas.height,maxX=-1,maxY=-1;
      for(let py=0;py<canvas.height;py+=2)for(let px=0;px<canvas.width;px+=2){if(pixels[(py*canvas.width+px)*4+3]<16)continue;
        if(px<minX)minX=px;if(px>maxX)maxX=px;if(py<minY)minY=py;if(py>maxY)maxY=py;}
      return maxX<minX||maxY<minY?null:{minX,minY,maxX,maxY};
    };
    /* คงพื้นที่วาดเดิมไว้เสมอ เพื่อให้ขนาดโลโก้และขนาดชื่อปรับแยกจากกัน
       การครอปตามขอบรวมจะทำให้การขยายชิ้นหนึ่งไปย่ออีกชิ้นโดยไม่ตั้งใจ */
    const trimToOutput=()=>{x.clearRect(0,0,c.width,c.height);x.drawImage(stage,0,0);};
    const anchorFloorOutput=()=>{
      if(spec.logoMount!=='floor'||spec.logoShape!=='cutout')return;
      const bounds=visibleBounds(x,c);if(!bounds)return;
      const bottomMargin=4,shift=Math.max(0,c.height-bottomMargin-bounds.maxY);if(shift<1)return;
      const copy=document.createElement('canvas');copy.width=c.width;copy.height=c.height;copy.getContext('2d').drawImage(c,0,0);
      x.clearRect(0,0,c.width,c.height);x.drawImage(copy,0,Math.floor(shift));
    };
    const captureVisibleBounds=()=>{
      const bounds=visibleBounds(x,c),normalized=bounds?{
        minX:bounds.minX/c.width,maxX:Math.min(1,(bounds.maxX+2)/c.width),
        minY:bounds.minY/c.height,maxY:Math.min(1,(bounds.maxY+2)/c.height)
      }:null;
      if(!texture)return normalized;
      texture.userData=texture.userData||{};texture.userData.brandVisibleBounds=normalized;
      const listeners=texture.userData.brandBoundsListeners||[];listeners.slice().forEach(listener=>listener(normalized));
      return normalized;
    };
    const draw=image=>{
      sx.clearRect(0,0,stage.width,stage.height);
      const panel=spec.logoShape==='panel',panelColor=spec.logoType==='light'?'#fff8dc':spec.logoType==='sticker'?'#ffffff':bg;
      if(panel){sx.fillStyle=panelColor;sx.fillRect(0,0,stage.width,stage.height);}
      const dark=lum(panel?panelColor:bg)<.55;
      const ink=dark?'#ffffff':shade(a.acc,.68),logoInk=spec.logoColor||spec.primary||'#2e7d4f',brand=(spec.brand||'YOUR BRAND').toUpperCase();
      const availableWidth=brandSurfaceWidth(spec),logoScale=logoScaleFactor(spec.logoScale,availableWidth),nameScale=nameScaleFactor(spec.nameScale,availableWidth);
      const logoMetrics=(rw,rh)=>{
        if(logoScale<=0)return{w:0,h:0};
        let w=rw*logoScale,h=rh*logoScale;
        if(image){const ar=Math.max(.01,image.naturalWidth/image.naturalHeight);h=w/ar;if(h>rh*logoScale){h=rh*logoScale;w=h*ar;}}
        return{w,h};
      };
      const logo=(rx,ry,rw,rh,centerY=null,fixedSize=null)=>{
        const size=fixedSize||logoMetrics(rw,rh);if(size.w<=0)return size;
        const cx=rx+rw/2,cy=centerY==null?ry+rh/2:centerY,dx=cx-size.w/2,dy=cy-size.h/2;
        if(image){const tint=document.createElement('canvas'),tw=Math.max(2,Math.ceil(size.w)),th=Math.max(2,Math.ceil(size.h));tint.width=tw;tint.height=th;
          const tx=tint.getContext('2d');tx.drawImage(image,0,0,tw,th);tx.globalCompositeOperation='source-in';tx.fillStyle=logoInk;tx.fillRect(0,0,tw,th);sx.drawImage(tint,dx,dy,size.w,size.h);}
        else{sx.strokeStyle=logoInk;sx.lineWidth=7;sx.setLineDash([18,12]);sx.strokeRect(dx,dy,size.w,size.h);sx.setLineDash([]);
          sx.fillStyle=logoInk;sx.globalAlpha=.65;sx.font='700 '+Math.max(16,Math.min(48,size.h*.32))+'px Inter, sans-serif';sx.textAlign='center';sx.textBaseline='middle';sx.fillText('LOGO',cx,cy);sx.globalAlpha=1;}
        return size;
      };
      const nameMetrics=(rw,rh)=>{if(nameScale<=0)return{fs:0,w:0,h:0};
        sx.font='700 100px Inter, "Noto Sans Thai", sans-serif';const unit=Math.max(.01,sx.measureText(brand).width/100);
        const fs=Math.max(1,Math.min(rh*.86,rw/unit)*nameScale);return{fs,w:fs*unit,h:fs};};
      const name=(rx,ry,rw,rh,centerY=null,fixedSize=null)=>{const size=fixedSize||nameMetrics(rw,rh);if(size.fs<=0)return size;
        sx.fillStyle=ink;sx.textAlign='center';sx.textBaseline='middle';sx.font='700 '+size.fs+'px Inter, "Noto Sans Thai", sans-serif';
        sx.fillText(brand,rx+rw/2,centerY==null?ry+rh/2:centerY);return size;};
      /* พื้นที่วาดกว้าง 90% ของผืนป้าย: ค่า 200 จึงเท่ากับ 90% ของผนัง/พื้นที่จริง */
      if(logoScale<=0&&nameScale>0)name(51,96,922,320);
      else if(nameScale<=0)logo(51,56,922,400);
      else if(spec.lockup==='stack'){
        const logoSize=logoMetrics(922,230),nameSize=nameMetrics(922,180);
        const gap=Math.max(12,Math.min(30,(logoSize.h+nameSize.h)*.1)),total=logoSize.h+gap+nameSize.h,top=(stage.height-total)/2;
        logo(51,0,922,230,top+logoSize.h/2);name(51,0,922,180,top+logoSize.h+gap+nameSize.h/2);
      }
      else{
        const areaW=922,logoNatural=logoMetrics(areaW,340),nameNatural=nameMetrics(areaW,240);
        const gapMeters=Math.min(.18,availableWidth*.03),gap=Math.max(12,Math.min(36,areaW*gapMeters/Math.max(.1,availableWidth)));
        const fit=Math.min(1,(areaW-gap)/Math.max(1,logoNatural.w+nameNatural.w));
        const logoSize={w:logoNatural.w*fit,h:logoNatural.h*fit},nameSize={fs:nameNatural.fs*fit,w:nameNatural.w*fit,h:nameNatural.h*fit};
        const total=logoSize.w+gap+nameSize.w,centerY=stage.height/2;let cursor=(stage.width-total)/2;
        if(spec.lockup==='logoLeft'){
          logo(cursor,0,logoSize.w,logoSize.h,centerY,logoSize);cursor+=logoSize.w+gap;
          name(cursor,0,nameSize.w,nameSize.h,centerY,nameSize);
        }else{
          name(cursor,0,nameSize.w,nameSize.h,centerY,nameSize);cursor+=nameSize.w+gap;
          logo(cursor,0,logoSize.w,logoSize.h,centerY,logoSize);
        }
      }
      trimToOutput();anchorFloorOutput();captureVisibleBounds();
    };
    draw(null);texture=new T.CanvasTexture(c);texture.colorSpace=T.SRGBColorSpace;captureVisibleBounds();
    if(spec.logo){const image=new Image();image.onload=()=>{if(this.buildId!==generation)return;draw(image);texture.needsUpdate=true;
        if(this.active)this.renderer.render(this.scene,this.camera);};image.src=spec.logo;}
    return texture;
  }
  brandMaterial(spec,bg){
    const T=this.THREE,texture=this.brandTexture(spec,bg),light=spec.logoType==='light';
    return new T.MeshStandardMaterial({map:texture,transparent:true,alphaTest:.025,side:T.DoubleSide,
      roughness:light?.28:.64,emissive:light?new T.Color('#ffe0a0'):new T.Color('#000000'),emissiveIntensity:light?.22:0});
  }
  brandPlane(group,spec,width,height,position,rotationY,bg,name,material=null){
    const T=this.THREE,mesh=new T.Mesh(new T.PlaneGeometry(width,height),material||this.brandMaterial(spec,bg));mesh.position.set(...position);mesh.rotation.y=rotationY;
    mesh.name=name;mesh.castShadow=true;group.add(mesh);return mesh;
  }
  brandCurvedPlane(group,spec,width,height,centerX,centerY,surfaceOffset,bg,name,material=null){
    const info=wallCurveInfo(spec);if(!info)return this.brandPlane(group,spec,width,height,[centerX,centerY,surfaceOffset],0,bg,name,material);
    const T=this.THREE,segments=Math.max(24,Math.min(96,Math.ceil(width*24))),positions=[],uvs=[],indices=[],rings=[];
    const edgeAngle=info.arcAngle/2,halfAngle=Math.min(width/(2*info.radius),Math.max(.001,edgeAngle-.002));
    const rawCenterAngle=Math.asin(clampNumber((centerX-info.half)/info.radius,-1,1));
    const centerAngle=clampNumber(rawCenterAngle,-edgeAngle+halfAngle,edgeAngle-halfAngle);
    const bottomY=centerY-height/2,topY=centerY+height/2;
    const vertex=(point,y,u,v)=>{const index=positions.length/3;positions.push(point.x,y,point.z);uvs.push(u,v);return index;};
    for(let i=0;i<=segments;i++){
      const u=i/segments,angle=centerAngle+(u-.5)*halfAngle*2,x=info.half+info.radius*Math.sin(angle);
      const point=info.pointAt(x/info.width,surfaceOffset);
      rings.push({bottom:vertex(point,bottomY,u,0),top:vertex(point,topY,u,1)});
    }
    for(let i=0;i<segments;i++){
      const a=rings[i],b=rings[i+1];indices.push(a.bottom,b.bottom,b.top,a.bottom,b.top,a.top);
    }
    const geometry=new T.BufferGeometry();geometry.setAttribute('position',new T.Float32BufferAttribute(positions,3));
    geometry.setAttribute('uv',new T.Float32BufferAttribute(uvs,2));geometry.setIndex(indices);geometry.computeVertexNormals();
    const mesh=new T.Mesh(geometry,material||this.brandMaterial(spec,bg));mesh.name=name;mesh.castShadow=true;
    mesh.userData.curvedBranding=true;mesh.userData.wallCurveRadius=info.radius;mesh.userData.arcWidth=halfAngle*2*info.radius;
    group.add(mesh);return mesh;
  }
  dimensionLabel(group,text,position,span,name){
    const T=this.THREE,canvas=document.createElement('canvas');canvas.width=384;canvas.height=96;
    const ctx=canvas.getContext('2d');ctx.clearRect(0,0,canvas.width,canvas.height);
    /* ป้ายมิติแบบโปร่งใส: ให้เห็นเฉพาะตัวเลข ไม่บังภาพบูธด้วยกรอบสีดำ */
    ctx.fillStyle='#ff7ab8';ctx.font='600 28px Inter,"Noto Sans Thai",sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(text,canvas.width/2,canvas.height/2+1);
    const texture=new T.CanvasTexture(canvas);texture.colorSpace=T.SRGBColorSpace;texture.minFilter=T.LinearFilter;
    const material=new T.SpriteMaterial({map:texture,transparent:true,depthTest:false,depthWrite:false,toneMapped:false});
    const sprite=new T.Sprite(material),height=Math.max(.17,span*.035);sprite.scale.set(height*4,height,1);sprite.position.set(...position);
    sprite.name=name;sprite.userData.dimensionText=text;sprite.renderOrder=32;group.add(sprite);return sprite;
  }
  dimensionGuide(group,points,label,labelPosition,span,name){
    const T=this.THREE,geometry=new T.BufferGeometry().setFromPoints(points),material=new T.LineBasicMaterial({
      color:0xe0a83c,transparent:true,opacity:.88,depthTest:false,depthWrite:false});
    const guide=new T.LineSegments(geometry,material);guide.name=name;guide.renderOrder=31;group.add(guide);
    this.dimensionLabel(group,label,labelPosition,span,name+'-label');
  }
  addBoothDimensions(group,spec,floorY){
    const T=this.THREE,span=Math.max(spec.W,spec.D,spec.H),offset=Math.max(.24,span*.045),tick=Math.max(.08,span*.015),y=floorY+.035;
    const p=(x,py,z)=>new T.Vector3(x,py,z),fmt=value=>String(+Number(value).toFixed(2));
    this.dimensionGuide(group,[
      p(0,y,spec.D+offset),p(spec.W,y,spec.D+offset),
      p(0,y,spec.D),p(0,y,spec.D+offset+tick),
      p(spec.W,y,spec.D),p(spec.W,y,spec.D+offset+tick)
    ],fmt(spec.W)+' ม.',[spec.W/2,y+tick*1.8,spec.D+offset],span,'booth-dimension-width');
    this.dimensionGuide(group,[
      p(spec.W+offset,y,0),p(spec.W+offset,y,spec.D),
      p(spec.W,y,0),p(spec.W+offset+tick,y,0),
      p(spec.W,y,spec.D),p(spec.W+offset+tick,y,spec.D)
    ],fmt(spec.D)+' ม.',[spec.W+offset,y+tick*1.8,spec.D/2],span,'booth-dimension-depth');
    if(spec.type!=='island')this.dimensionGuide(group,[
      p(-offset,0,0),p(-offset,spec.H,0),
      p(0,0,0),p(-offset-tick,0,0),
      p(0,spec.H,0),p(-offset-tick,spec.H,0)
    ],fmt(spec.H)+' ม.',[-offset,spec.H/2,-tick],span,'booth-dimension-height');
  }
  brandLayerMaterials(spec,bg){
    const T=this.THREE,front=this.brandMaterial(spec,bg),edge=new T.MeshStandardMaterial({
      color:new T.Color(spec.logoColor||spec.primary||'#2e7d4f'),alphaMap:front.map,transparent:true,alphaTest:.025,side:T.DoubleSide,
      roughness:.68,metalness:.04});
    return{front,edge};
  }
  brandSelectionProxy(holder,spec,width,height,depth,materials,anchor){
    const T=this.THREE,hitMaterial=new T.MeshBasicMaterial({transparent:true,opacity:0,depthWrite:false,colorWrite:false,side:T.DoubleSide});
    const proxy=new T.Mesh(new T.BoxGeometry(.08,.08,Math.max(.02,depth)),hitMaterial);
    proxy.name='brand-selection-proxy';proxy.userData.brandPlacement=true;proxy.userData.brandSelectionProxy=true;holder.add(proxy);
    const update=bounds=>{
      const visible=bounds||{minX:.48,maxX:.52,minY:.48,maxY:.52},panel=spec.logoShape==='panel',margin=panel?.01:.03;
      const visibleWidth=Math.max(.01,visible.maxX-visible.minX),visibleHeight=Math.max(.01,visible.maxY-visible.minY);
      const boxWidth=Math.min(width,Math.max(.08,width*visibleWidth+margin*2));
      const boxHeight=Math.min(height,Math.max(.08,height*visibleHeight+margin*2));
      const localX=clampNumber(width*((visible.minX+visible.maxX)/2-.5),-width/2+boxWidth/2,width/2-boxWidth/2);
      const localY=clampNumber(height*(.5-(visible.minY+visible.maxY)/2),-height/2+boxHeight/2,height/2-boxHeight/2);
      if(proxy.geometry)proxy.geometry.dispose();proxy.geometry=new T.BoxGeometry(boxWidth,boxHeight,Math.max(.02,depth));
      proxy.position.set(...anchor.position);proxy.rotation.y=anchor.rotationY||0;proxy.translateX(localX);proxy.position.y+=localY;
      proxy.userData.brandVisibleBounds=visible;proxy.userData.brandSelectionSize={width:boxWidth,height:boxHeight};
      if(this.selectionHelper&&this.selectionHelper.name==='brand-selection')this.selectionHelper.update();
      if(this.active)this.renderer.render(this.scene,this.camera);
    };
    const texture=materials?.front?.map;update(texture?.userData?.brandVisibleBounds);
    if(texture){texture.userData=texture.userData||{};(texture.userData.brandBoundsListeners||(texture.userData.brandBoundsListeners=[])).push(update);}
    this.brandingHitTarget=proxy;return proxy;
  }
  addPlacedBranding(group,spec,t,floorY){
    const T=this.THREE,physical=brandPhysicalSize(spec),width=spec.logoShape==='panel'?physical.width:brandSurfaceWidth(spec),height=width/2,depth=Number(spec.logoDepth)||.05;
    /* ซ้อนหน้าตัดทุกประมาณ 4 มม. ให้ด้านข้างอ่านเป็นมวลต่อเนื่อง โดยยังเบากว่าการหา contour ของ PNG แบบเรียลไทม์ */
    const layers=Math.max(3,Math.min(36,Math.ceil(depth/.004)+1)),a=palette();
    if(spec.logoMount==='floor'){
      const holder=new T.Group();holder.name='brand-diecut-floor-standing';holder.position.set(spec.logoFloorX,floorY,spec.logoFloorZ);
      holder.rotation.y=(Number(spec.logoFloorRotation)||0)*Math.PI/180;group.add(holder);
      const materials=this.brandLayerMaterials(spec,'#ffffff');
      for(let i=0;i<layers;i++){
        const z=-depth/2+(depth*i/(layers-1)),front=i===layers-1;
        this.brandPlane(holder,spec,width,height,[0,height/2+.10,z],0,'#ffffff','brand-diecut-floor-layer-'+i,front?materials.front:materials.edge);
      }
      const baseSize=logoBaseSize(spec),baseW=baseSize.width,baseD=baseSize.depth,baseMat=new T.MeshStandardMaterial({color:spec.logoBaseColor||'#20252d',roughness:.58,metalness:.08});
      const base=new T.Mesh(new T.BoxGeometry(baseW,.10,baseD),baseMat);base.position.set(0,.05,0);base.name='brand-diecut-floor-base';base.castShadow=true;base.receiveShadow=true;holder.add(base);
      this.brandSelectionProxy(holder,spec,width,height,depth,materials,{position:[0,height/2+.10,0],rotationY:0});
      holder.traverse(part=>{part.userData.brandPlacement=true;});this.brandingRoot=holder;
      return;
    }
    const holder=new T.Group();holder.name='brand-diecut-wall-placement';group.add(holder);
    const face=spec.logoWall||'back',bg=wallFaceColor(spec,face,a),materials=this.brandLayerMaterials(spec,bg),centerY=floorY+spec.logoWallY;
    for(let i=0;i<layers;i++){
      const offset=.012+depth*i/(layers-1),front=i===layers-1,material=front?materials.front:materials.edge,name='brand-diecut-wall-layer-'+i;
      if(face==='back'&&isCurvedWallType(spec)){
        const curve=wallCurveInfo(spec),fraction=clampNumber(spec.logoWallU/Math.max(.001,curve.arcLength),0,1),angle=(fraction-.5)*curve.arcAngle;
        const centerX=curve.half+curve.radius*Math.sin(angle);
        this.brandCurvedPlane(holder,spec,width,height,centerX,centerY,t/2+offset,bg,name,material);
      }else if(face==='back')this.brandPlane(holder,spec,width,height,[spec.logoWallU,centerY,t+offset],0,bg,name,material);
      else if(face==='left')this.brandPlane(holder,spec,width,height,[t+offset,centerY,spec.logoWallU],Math.PI/2,bg,name,material);
      else this.brandPlane(holder,spec,width,height,[spec.W-t-offset,centerY,spec.logoWallU],-Math.PI/2,bg,name,material);
    }
    let anchor;
    if(face==='back'&&isCurvedWallType(spec)){
      const curve=wallCurveInfo(spec),fraction=clampNumber(spec.logoWallU/Math.max(.001,curve.arcLength),0,1),point=curve.pointAt(fraction,t/2+.012+depth/2);
      anchor={position:[point.x,centerY,point.z],rotationY:point.rotationY};
    }else if(face==='back')anchor={position:[spec.logoWallU,centerY,t+.012+depth/2],rotationY:0};
    else if(face==='left')anchor={position:[t+.012+depth/2,centerY,spec.logoWallU],rotationY:Math.PI/2};
    else anchor={position:[spec.W-t-.012-depth/2,centerY,spec.logoWallU],rotationY:-Math.PI/2};
    this.brandSelectionProxy(holder,spec,width,height,depth,materials,anchor);
    holder.traverse(part=>{part.userData.brandPlacement=true;});this.brandingRoot=holder;
  }
  addBranding(group,spec,t,floorY){
    const a=palette(),place=(s,e,w,align)=>align==='left'?s+w/2:align==='right'?e-w/2:(s+e)/2;
    this.addPlacedBranding(group,spec,t,floorY);
    const sideWall=cornerWallKey();
    if(spec.logoMount==='wall'&&spec.type==='corner'&&spec.sideLogo&&typ().walls.includes(sideWall)){
      const free=sideFreeLen(t);if(free>=.8){const start=spec.D-free,w=Math.min(3,free*.72),h=Math.min(w/2,spec.H*.38),ww=h*2;
        const z=spec.sidePos==='outer'?spec.D-ww/2-Math.min(.18,free*.05):start+free/2;
        const x=sideWall==='left'?t+.012:spec.W-t-.012,rotation=sideWall==='left'?Math.PI/2:-Math.PI/2;
      this.brandPlane(group,spec,ww,h,[x,brandCenterY(spec.H,h),z],rotation,wallFaceColor(spec,sideWall,a),'brand-lockup-side');}
    }
  }
  fixtureState(key){
    return this.fixtureTemplates.has(key)?'ready':this.fixtureLoads.has(key)?'loading':this.fixtureErrors.has(key)?'error':'idle';
  }
  requestFixtureTemplate(key){
    if(this.fixtureTemplates.has(key)||this.fixtureLoads.has(key)||this.fixtureErrors.has(key))return;
    const def=LIGHT_MODELS.find(model=>model.k===key)||LIGHT_MODELS[0],T=this.THREE;
    const load=fixtureModelSource(def).then(source=>this.modelLoader.loadAsync(source)).then(gltf=>{
      const model=gltf.scene,template=new T.Group();model.scale.setScalar(def.scale);model.rotation.set(def.wallRotationX||0,0,def.wallRotationZ||0);template.add(model);
      /* โคมแต่ละรุ่นอาจมีแกนส่งออกไม่เหมือนกัน: ค่าเดิมคงไว้ให้ Clear Light
         แต่ Arm V4 ใช้แกนตามไฟล์ จึงไม่พลิกกลับด้านฐานยึด */
      template.rotation.y=Number.isFinite(def.templateRotationY)?def.templateRotationY:Math.PI;
      if(def.baseNormal)template.quaternion.premultiply(new T.Quaternion().setFromUnitVectors(new T.Vector3(...def.baseNormal).normalize(),new T.Vector3(0,0,-1)));
      if(def.baseRoll)template.quaternion.premultiply(new T.Quaternion().setFromAxisAngle(new T.Vector3(0,0,1),def.baseRoll));
      template.updateMatrixWorld(true);const box=new T.Box3().setFromObject(template);
      if(box.isEmpty())throw new Error('Empty light model');
      let baseMesh=null,baseBox=null;let meshIndex=0;
      template.traverse(part=>{if(part.isMesh){part.userData.fixtureMeshIndex=meshIndex;if(Number.isInteger(def.baseMeshIndex)&&meshIndex===def.baseMeshIndex)baseMesh=part;meshIndex++;}});
      if(Number.isInteger(def.baseMeshIndex)){
        if(baseMesh)baseBox=new T.Box3().setFromObject(baseMesh);}
      const center=box.getCenter(new T.Vector3()),anchor=baseBox?baseBox.getCenter(new T.Vector3()):center;
      if(baseBox&&def.baseAxis){const axis=def.baseAxis,side=def.baseSide==='max'?'max':'min';anchor[axis]=baseBox[side][axis];}
      else if(baseBox)anchor.z=baseBox.min.z;
      template.position.set(-anchor.x,-anchor.y,-anchor.z);
      if(Array.isArray(def.bracketMeshIndices)&&Number.isFinite(def.bracketFlipAngle)){
        template.updateMatrixWorld(true);
        const axisKey=def.bracketFlipAxis==='x'?'x':def.bracketFlipAxis==='z'?'z':'y';
        const axis=new T.Vector3(axisKey==='x'?1:0,axisKey==='y'?1:0,axisKey==='z'?1:0);
        const flip=new T.Matrix4().makeRotationAxis(axis,def.bracketFlipAngle);
        const inverseTemplate=template.matrixWorld.clone().invert(),targets=[];
        template.traverse(part=>{if(part.isMesh&&def.bracketMeshIndices.includes(part.userData.fixtureMeshIndex))targets.push(part);});
        if(targets.length){
          /* พลิกแต่ละชิ้นรอบศูนย์กลางของตัวเอง เพื่อให้ขายึดถอยกลับเข้าหาผนัง
             โดยไม่ย้ายชิ้นส่วนด้านข้างออกจากตัวหน้ากระจายแสง */
          targets.forEach(part=>{
          const partCenterWorld=new T.Box3().setFromObject(part).getCenter(new T.Vector3()),partCenterLocal=partCenterWorld.applyMatrix4(inverseTemplate);
          const flipAroundCenter=new T.Matrix4().makeTranslation(partCenterLocal.x,partCenterLocal.y,partCenterLocal.z).multiply(flip).multiply(new T.Matrix4().makeTranslation(-partCenterLocal.x,-partCenterLocal.y,-partCenterLocal.z));
          const bracketOffset=new T.Matrix4().makeTranslation(0,0,Number.isFinite(def.bracketOffsetZ)?def.bracketOffsetZ:0);
          const local=inverseTemplate.clone().multiply(part.matrixWorld),flipped=bracketOffset.multiply(flipAroundCenter).multiply(local),wrapper=new T.Group();
          wrapper.name='fixture-bracket-flipped';wrapper.matrixAutoUpdate=false;wrapper.matrix.copy(flipped);
          const parent=part.parent;if(parent)parent.remove(part);part.matrixAutoUpdate=true;part.position.set(0,0,0);part.rotation.set(0,0,0);part.scale.set(1,1,1);part.updateMatrix();
          template.add(wrapper);wrapper.add(part);
          });
        }
        template.updateMatrixWorld(true);
      }
      template.name='fixture-template-'+def.k;
      template.userData.mountMode=def.mountMode||'wall';template.userData.baseAnchor=anchor.toArray();
      template.userData.size=box.getSize(new T.Vector3()).toArray();
      template.traverse(o=>{o.userData.sharedAsset=true;if(o.isMesh){o.castShadow=true;o.receiveShadow=true;}});
      this.fixtureTemplates.set(key,template);return template;
    }).catch(error=>{this.fixtureErrors.set(key,error);return null;}).finally(()=>{
      this.fixtureLoads.delete(key);syncLightModelStatus();
      if(this.fixtureTemplates.has(key)&&BoothSpec.lightFixture===key){this.currentKey='';this.update(BoothSpec);}
    });
    this.fixtureLoads.set(key,load);syncLightModelStatus();
  }
  fixtureModel(key){
    const template=this.fixtureTemplates.get(key);return template?template.clone(true):null;
  }
  requestFurnitureTemplate(item){
    const key=item?.catalogId;if(!key||!item.modelUrl||this.furnitureTemplates.has(key)||this.furnitureLoads.has(key)||this.furnitureErrors.has(key))return;
    const T=this.THREE,load=furnitureModelSource(item).then(source=>this.modelLoader.loadAsync(source)).then(gltf=>{
      const model=gltf.scene,template=new T.Group();model.scale.setScalar(item.modelScale||1);
      model.rotation.y=T.MathUtils.degToRad(item.modelRotationY||0);template.add(model);template.updateMatrixWorld(true);
      const box=new T.Box3().setFromObject(template);if(box.isEmpty())throw new Error('Empty furniture model');
      const center=box.getCenter(new T.Vector3());model.position.x-=center.x;model.position.y-=box.min.y;model.position.z-=center.z;
      /* Uploaded assets use the dimensions entered in My Asset as their
         placement envelope, keeping visual scale and collision scale aligned. */
      if(item.customAsset){
        template.updateMatrixWorld(true);
        const fitted=new T.Box3().setFromObject(template),raw=fitted.getSize(new T.Vector3()),target=item.size||{};
        if(raw.x>.0001&&raw.y>.0001&&raw.z>.0001)
          template.scale.set((target.w||raw.x)/raw.x,(target.h||raw.y)/raw.y,(target.d||raw.z)/raw.z);
      }
      template.updateMatrixWorld(true);
      template.name='furniture-template-'+key;template.userData.size=new T.Box3().setFromObject(template).getSize(new T.Vector3()).toArray();
      template.traverse(o=>{o.userData.sharedAsset=true;if(o.isMesh){o.castShadow=true;o.receiveShadow=true;}});
      this.furnitureTemplates.set(key,template);return template;
    }).catch(error=>{this.furnitureErrors.set(key,error);return null;}).finally(()=>{
      this.furnitureLoads.delete(key);
      if(this.furnitureTemplates.has(key)&&S.objects.some(object=>object.catalogId===key)){this.currentKey='';this.update(BoothSpec);}
    });
    this.furnitureLoads.set(key,load);
  }
  furnitureModel(item){
    if(!item?.modelUrl)return null;
    const template=this.furnitureTemplates.get(item.catalogId);if(template)return template.clone(true);
    this.requestFurnitureTemplate(item);return null;
  }
  requestDownlightTemplate(){
    if(this.downlightTemplate||this.downlightLoad||this.downlightError)return;
    const T=this.THREE;
    this.downlightLoad=this.modelLoader.loadAsync(DOWNLIGHT_MODEL_URL).then(gltf=>{
      const model=gltf.scene,template=new T.Group();template.add(model);template.updateMatrixWorld(true);
      let box=new T.Box3().setFromObject(template);if(box.isEmpty())throw new Error('Empty downlight model');
      const size=box.getSize(new T.Vector3()),diameter=Math.max(size.x,size.z,.0001),scale=.12/diameter;
      model.scale.setScalar(scale);template.updateMatrixWorld(true);box=new T.Box3().setFromObject(template);
      const center=box.getCenter(new T.Vector3());model.position.x-=center.x;model.position.z-=center.z;model.position.y-=box.max.y;
      template.updateMatrixWorld(true);template.traverse(part=>{part.userData.sharedAsset=true;if(part.isMesh){part.castShadow=true;part.receiveShadow=true;}});
      this.downlightTemplate=template;return template;
    }).catch(error=>{this.downlightError=error;return null;}).finally(()=>{
      this.downlightLoad=null;if(this.downlightTemplate&&S.objects.some(isDownlightBeamObject)){this.currentKey='';this.update(BoothSpec);}
    });
  }
  downlightModel(){
    if(this.downlightTemplate)return this.downlightTemplate.clone(true);
    this.requestDownlightTemplate();return null;
  }
  fixtureMountTransform(point,spec,t,def){
    const surface=t+FIXTURE_WALL_GAP,normalSpan=point.w==='back'?spec.D:spec.W;
    const yaw=def?.wallRotations?.[point.w] ?? (point.w==='back'?0:point.w==='left'?Math.PI/2:-Math.PI/2);
    const top=spec.H-(Number.isFinite(def?.topInset)?def.topInset:FIXTURE_TOP_INSET);
    /* local +Z ของโคม = ทิศยื่นเข้าในบูธ หลังหมุนด้วย yaw ของผนังนั้น */
    if(point.w==='back'){
      if(isCurvedWallType(spec)){
        const curve=wallCurveInfo(spec),surfacePoint=curve.pointAt(point.u/spec.W,t/2+FIXTURE_WALL_GAP);
        return{position:[surfacePoint.x,top,surfacePoint.z],rotationY:surfacePoint.rotationY,targetDepth:normalSpan*.55,inward:[surfacePoint.normalX,0,surfacePoint.normalZ]};
      }
      return{position:[point.u,top,surface],rotationY:yaw,targetDepth:normalSpan*.55-surface,inward:[0,0,1]};
    }
    if(point.w==='left')return{position:[surface,top,point.u],rotationY:yaw,targetDepth:normalSpan*.55-surface,inward:[1,0,0]};
    return{position:[spec.W-surface,top,point.u],rotationY:yaw,targetDepth:normalSpan*.55-surface,inward:[-1,0,0]};
  }
  addSpotlights(group,spec,t,floorY){
    if(!spec.lights)return;
    const T=this.THREE,points=lightPoints(t),lightDef=lightWattDef(),tone=LIGHTCOL.find(c=>c.k===spec.lightCol),span=Math.max(spec.W,spec.D,spec.H);
    const hasModel=this.fixtureTemplates.has(spec.lightFixture);if(!hasModel)this.requestFixtureTemplate(spec.lightFixture);
    const fixtureTemplate=hasModel?this.fixtureTemplates.get(spec.lightFixture):null;
    const modelDrop=fixtureTemplate?Math.max(.14,(fixtureTemplate.userData.size?.[1]||0)/2+.02):.14;
    const lightInset=FIXTURE_LIGHT_INSET-FIXTURE_WALL_GAP,modelDef=lightModelDef(),lightSource=modelDef.lightSource||[0,-.14,lightInset];
    points.forEach((p,i)=>{
      const transform=this.fixtureMountTransform(p,spec,t,modelDef),mount=new T.Group();
      /* Arm Light มีหน้าปล่อยแสงชี้ลง: เล็งใต้หัวโคมและเอียงเข้าบูธเล็กน้อย
         ไม่ใช้ targetDepth กลางบูธแบบไฟรุ่นอื่น เพื่อไม่ให้กรวยแสงยิงชนผนังตรงข้าม */
      const beamTargetDepth=modelDef.beamMode==='downwash'
        ?(Number.isFinite(modelDef.beamTargetDepth)?modelDef.beamTargetDepth:
          lightSource[2]+(Number.isFinite(modelDef.beamInward)?modelDef.beamInward:0))
        : transform.targetDepth;
      const fixtureOffsetZ=Number.isFinite(modelDef.fixtureOffsetZ)?modelDef.fixtureOffsetZ:0;
      const wallWash=modelDef.beamMode==='wallWash';
      const floorTargetDepth=modelDef.beamMode==='downwash'?beamTargetDepth:beamTargetDepth-fixtureOffsetZ;
      mount.name='spotlight-mount';mount.userData.wall=p.w;mount.userData.u=p.u;mount.userData.inward=transform.inward;
      mount.position.set(...transform.position);mount.rotation.y=transform.rotationY;
      if(Number.isFinite(modelDef.fixtureOffsetZ))mount.translateZ(modelDef.fixtureOffsetZ);
      const fixture=new T.Group();fixture.name='spotlight-fixture';fixture.userData.fixtureModel=spec.lightFixture;
      const model=hasModel?this.fixtureModel(spec.lightFixture):null;
      if(model){fixture.add(model);const ceilingMount=fixtureTemplate?.userData.mountMode==='ceiling';
        /* หมุนแยกจาก template: Clear กลับด้านเฉพาะแนวขายึดรอบแกนแสง
           จึงหันแผ่นยึดเข้าผนัง โดยไม่เปลี่ยนทิศแกน +Z ของลำแสง */
        if(Number.isFinite(modelDef.fixtureRotationZ))fixture.rotation.z=modelDef.fixtureRotationZ;
        else if(ceilingMount&&modelDef.modelFlipZ)fixture.rotation.z=Math.PI;
        fixture.position.set(0,ceilingMount?0:-modelDrop,0);}
      else{const fallback=new T.Mesh(new T.CylinderGeometry(.055,.082,.18,12),new T.MeshStandardMaterial({color:0x353a42,roughness:.38,metalness:.72,
          emissive:new T.Color(tone.c),emissiveIntensity:.08}));fallback.rotation.x=Math.PI/2;fallback.castShadow=true;
        fixture.add(fallback);fixture.position.set(0,-.14,lightInset);fixture.userData.fallback=true;}
      mount.add(fixture);
      /* ให้ลำแสงเริ่มจากหน้าหัวโคมจริง ไม่ใช่จุดคงที่กลางก้าน/ชิดผนัง */
      const beamMix=Math.max(0,Math.min(1,wallWash
        ?(Number.isFinite(modelDef.wallBeamMix)?modelDef.wallBeamMix:1)
        :(Number.isFinite(modelDef.beamMix)?modelDef.beamMix:1)));
      const beamAngle=Math.max(.05,Math.min(Math.PI/2-.01,Number.isFinite(modelDef.beamAngle)?modelDef.beamAngle:(wallWash?.38:.43)));
      const beamPenumbra=Math.max(0,Math.min(1,Number.isFinite(modelDef.beamPenumbra)?modelDef.beamPenumbra:(wallWash?.72:.58)));
      const beamDecay=Math.max(.1,Number.isFinite(modelDef.beamDecay)?modelDef.beamDecay:2);
      const beamDistance=span*Math.max(1,Number.isFinite(modelDef.beamDistanceFactor)?modelDef.beamDistanceFactor:2.2);
      const light=new T.SpotLight(tone.c,lightDef.intensity*beamMix,beamDistance,beamAngle,beamPenumbra,beamDecay);light.position.set(...lightSource);light.name='spotlight';
      light.castShadow=i<Math.min(8,points.length);if(light.castShadow){light.shadow.mapSize.set(512,512);light.shadow.bias=-.0005;light.shadow.normalBias=.012;}
      const aim=new T.Object3D();aim.name='spotlight-target';
      if(wallWash){
        const wallHeight=Number.isFinite(modelDef.wallWashHeight)?modelDef.wallWashHeight:.55;
        const wallGap=Number.isFinite(modelDef.wallWashGap)?modelDef.wallWashGap:.03;
        aim.position.set(0,floorY+spec.H*wallHeight-transform.position[1],wallGap-fixtureOffsetZ);
      }else{
        const targetHeight=Number.isFinite(modelDef.beamTargetHeightRatio)
          ?floorY+spec.H*Math.max(0,Math.min(1,modelDef.beamTargetHeightRatio))
          :floorY;
        aim.position.set(0,targetHeight-transform.position[1],beamTargetDepth);
      }
      light.target=aim;mount.add(aim,light);group.add(mount);
      const diffuseMix=Math.max(0,Math.min(1,wallWash
        ?(Number.isFinite(modelDef.wallDiffuseMix)?modelDef.wallDiffuseMix:0)
        :(Number.isFinite(modelDef.beamDiffuseMix)?modelDef.beamDiffuseMix:0)));
      if(diffuseMix>0){
          const diffuseAngle=Math.max(.05,Math.min(Math.PI/2-.01,wallWash
            ?(Number.isFinite(modelDef.wallDiffuseAngle)?modelDef.wallDiffuseAngle:1.05)
            :(Number.isFinite(modelDef.beamDiffuseAngle)?modelDef.beamDiffuseAngle:1.05)));
          const diffusePenumbra=Math.max(0,Math.min(1,wallWash
            ?(Number.isFinite(modelDef.wallDiffusePenumbra)?modelDef.wallDiffusePenumbra:1)
            :(Number.isFinite(modelDef.beamDiffusePenumbra)?modelDef.beamDiffusePenumbra:1)));
          const diffuseDecay=Math.max(.1,wallWash
            ?(Number.isFinite(modelDef.wallDiffuseDecay)?modelDef.wallDiffuseDecay:1.2)
            :(Number.isFinite(modelDef.beamDiffuseDecay)?modelDef.beamDiffuseDecay:1.2));
          const diffuseLight=new T.SpotLight(tone.c,lightDef.intensity*diffuseMix,beamDistance,diffuseAngle,diffusePenumbra,diffuseDecay);
          diffuseLight.position.set(...lightSource);diffuseLight.name='spotlight-diffuse';diffuseLight.castShadow=false;
          const diffuseAim=new T.Object3D();diffuseAim.name='spotlight-diffuse-target';
          diffuseAim.position.copy(aim.position);diffuseLight.target=diffuseAim;mount.add(diffuseAim,diffuseLight);
      }
      if(wallWash){
        const floorMix=Math.max(0,Math.min(1,Number.isFinite(modelDef.floorBeamMix)?modelDef.floorBeamMix:0));
        if(floorMix>0){
          const floorLight=new T.SpotLight(tone.c,lightDef.intensity*floorMix,beamDistance,.92,.98,1.5);
          floorLight.position.set(...lightSource);floorLight.name='spotlight-floor-fill';floorLight.castShadow=false;
          const floorAim=new T.Object3D();floorAim.name='spotlight-floor-target';
          floorAim.position.set(0,floorY-transform.position[1],floorTargetDepth);
          floorLight.target=floorAim;mount.add(floorAim,floorLight);
        }
      }
    });
  }
  storageWall(group,G,floorY,spec,face,color){
    const t=STORAGE_ROOM_WALL_THICKNESS,front=face==='front'||face==='back',doorFace=spec.stDoor===face;
    const length=front?G.w:G.d,z=face==='front'?G.y+G.d-t/2:G.y+t/2,x=face==='left'?G.x+t/2:G.x+G.w-t/2;
    const material=this.storageMaterial(spec,face),add=(size,position,suffix)=>{
      if(size.some(value=>value<=.008))return;
      this.box(group,size,position,color,{material,name:'storage-'+face+(suffix?'-'+suffix:'')});
    };
    if(!doorFace){
      if(front)add([G.w,G.h,t],[G.x+G.w/2,floorY+G.h/2,z],'panel');
      else add([t,G.h,G.d],[x,floorY+G.h/2,G.y+G.d/2],'panel');
      return;
    }
    const doorWidth=front?Math.min(.8,G.w*.62):Math.min(.8,G.d*.62),doorHeight=Math.min(2.05,G.h*.86),along=doorAlong(length,doorWidth);
    if(front){
      add([along,G.h,t],[G.x+along/2,floorY+G.h/2,z],'before-door');
      const after=G.w-along-doorWidth;add([after,G.h,t],[G.x+along+doorWidth+after/2,floorY+G.h/2,z],'after-door');
      add([doorWidth,G.h-doorHeight,t],[G.x+along+doorWidth/2,floorY+doorHeight+(G.h-doorHeight)/2,z],'door-header');
    }else{
      add([t,G.h,along],[x,floorY+G.h/2,G.y+along/2],'before-door');
      const after=G.d-along-doorWidth;add([t,G.h,after],[x,floorY+G.h/2,G.y+along+doorWidth+after/2],'after-door');
      add([t,G.h-doorHeight,doorWidth],[x,floorY+doorHeight+(G.h-doorHeight)/2,G.y+along+doorWidth/2],'door-header');
    }
  }
  door(group,G,floorY,spec){
    const T=this.THREE,dh=Math.min(2.05,G.h*.86),front=spec.stDoor==='front';
    const width=front?Math.min(.8,G.w*.62):Math.min(.8,G.d*.62),run=front?G.w:G.d,along=doorAlong(run,width);
    const sliding=spec.stDoorType==='slide',assembly=new T.Group();assembly.name='storage-door-'+(sliding?'slide':'swing');
    if(front)assembly.position.set(G.x+along,floorY,G.y+G.d+.018);
    else{assembly.position.set(spec.stDoor==='left'?G.x-.018:G.x+G.w+.018,floorY,G.y+along);assembly.rotation.y=-Math.PI/2;}
    if(!sliding){
      const angle=Math.PI/5;assembly.rotation.y+=front?angle:(spec.stDoor==='left'?angle:-angle);
    }
    const material=this.storageMaterial(spec,spec.stDoor);
    const leaf=new T.Mesh(new T.BoxGeometry(width,dh,.035),material);leaf.position.set(width/2,dh/2,0);leaf.castShadow=true;
    leaf.name=sliding?'storage-door-slide-leaf':'storage-door-swing-leaf';assembly.add(leaf);
    const edge=new T.LineSegments(new T.EdgesGeometry(leaf.geometry),new T.LineBasicMaterial({color:0xe0a83c}));
    edge.position.copy(leaf.position);edge.name='storage-door-edge';assembly.add(edge);
    const hardware=new T.MeshStandardMaterial({color:0xd6b45f,roughness:.3,metalness:.72});
    const handle=new T.Mesh(new T.BoxGeometry(.025,.18,.045),hardware);handle.position.set(width*(sliding?.5:.84),dh*.52,.035);
    handle.name='storage-door-handle';assembly.add(handle);
    if(sliding){
      const rail=new T.Mesh(new T.BoxGeometry(width*1.28,.04,.055),hardware);rail.position.set(width*.5,dh+.06,0);
      rail.name='storage-door-slide-rail';assembly.add(rail);
      const seam=new T.Mesh(new T.BoxGeometry(.018,dh*.92,.042),hardware);seam.position.set(width*.5,dh*.48,.024);
      seam.name='storage-door-slide-seam';assembly.add(seam);
    }
    assembly.userData.doorType=spec.stDoorType;assembly.userData.doorSide=spec.stDoor;group.add(assembly);
  }
  applyCatalogAppearance(root,obj){
    normalizeSceneObjectModel(obj);const T=this.THREE,appearance=obj.appearance||{},meshes=[];
    root.traverse(part=>{if(!part.isMesh||!part.material)return;const source=Array.isArray(part.material)?part.material:[part.material];
      const cloned=source.map(material=>{
        if(appearance.mode==='solid'){
          const next=new T.MeshStandardMaterial({color:appearance.color||'#f5f5f5',roughness:.72,metalness:.02,
            side:material.side,flatShading:material.flatShading===true,transparent:false,opacity:1});
          next.name=(material.name||'material')+'-solid-override';next.needsUpdate=true;return next;
        }
        const next=material.clone();if(appearance.mode==='tint'&&appearance.color&&next.color)next.color.set(appearance.color);next.needsUpdate=true;return next;
      });
      part.material=Array.isArray(part.material)?cloned:cloned[0];meshes.push(part);});
    if(!appearance.textureData)return;
    const buildId=this.buildId,loader=new T.TextureLoader();loader.load(appearance.textureData,texture=>{
      if(buildId!==this.buildId||!root.parent){texture.dispose();return;}texture.colorSpace=T.SRGBColorSpace;texture.wrapS=T.ClampToEdgeWrapping;texture.wrapT=T.ClampToEdgeWrapping;
      meshes.forEach(part=>{const materials=Array.isArray(part.material)?part.material:[part.material];materials.forEach(material=>{
        material.map=texture;material.color?.set('#ffffff');material.transparent=true;material.alphaTest=.01;material.needsUpdate=true;});});
      this.renderer.render(this.scene,this.camera);
    },undefined,()=>announceCatalog('โหลดสติ๊กเกอร์ของ '+selectedAssetName(obj)+' ไม่สำเร็จ','error'));
  }
  buildCatalogObject(obj){
    const T=this.THREE,item=objectCatalogDef(obj.catalogId),s=obj.size,root=new T.Group(),accent=palette().acc;
    const furniture=this.furnitureModel(item);
    if(furniture){
      /* GLB templates are normalized once when loaded.  Apply the object's
         current dimensions to the clone so the settings panel changes the
         rendered model as well as its selection/collision envelope. */
      const source=Array.isArray(furniture.userData?.size)?furniture.userData.size:null;
      if(source&&source.length===3&&source.every(value=>Number(value)>.0001)){
        const base=furniture.scale.clone();
        furniture.scale.set(base.x*(Number(s.w)||source[0])/source[0],base.y*(Number(s.h)||source[1])/source[1],base.z*(Number(s.d)||source[2])/source[2]);
      }
      root.add(furniture);root.name='catalog-object-'+obj.type;
      root.traverse(part=>{part.userData.objectId=obj.id;});this.applyCatalogAppearance(root,obj);return root;}
    const base=(item&&item.color)||'#8a919c',dark='#2c3037',light='#e5e3dc';
    const bx=(size,pos,color=base,options={})=>this.box(root,size,pos,color,options);
    const mesh=(geometry,color,position,options={})=>{
      const material=options.material||new T.MeshStandardMaterial({color,roughness:options.roughness??.72,
        metalness:options.metalness??.02,emissive:options.emissive||0x000000,emissiveIntensity:options.emissiveIntensity||0});
      const part=new T.Mesh(geometry,material);part.position.set(...position);part.castShadow=true;part.receiveShadow=true;root.add(part);return part;
    };
    if(isEntranceFrameObject(obj)){
      const cfg=normalizeEntranceFrameObject(obj).structure,finish=new T.MeshStandardMaterial({color:cfg.color,roughness:.72,metalness:.01});
      bx([cfg.pierWidth,cfg.thickness,cfg.projection],[0,cfg.height-cfg.thickness/2,0],cfg.color,{material:finish.clone(),name:'entrance-frame-canopy'});
      bx([cfg.pierWidth,Math.max(.05,cfg.height-cfg.thickness),cfg.thickness],[0,Math.max(.05,cfg.height-cfg.thickness)/2,cfg.projection/2-cfg.thickness/2],cfg.color,{material:finish.clone(),name:'entrance-frame-front-pier'});
      root.userData.structureType='entrance-frame';root.userData.structureConfig={...cfg};
    }else if(isDownlightBeamObject(obj)){
      const cfg=normalizeDownlightBeamObject(obj).structure,finish=new T.MeshStandardMaterial({color:cfg.color,roughness:.68,metalness:.01});
      bx([cfg.length,cfg.thickness,cfg.depth],[0,cfg.height-cfg.thickness/2,0],cfg.color,{material:finish,name:'downlight-beam-body'});
      const spacing=cfg.length/(cfg.lightCount+1),underside=cfg.height-cfg.thickness-.006;
      for(let index=0;index<cfg.lightCount;index++){
        const x=-cfg.length/2+spacing*(index+1),model=this.downlightModel();
        if(model){model.position.set(x,underside,0);model.name='downlight-model';root.add(model);}
        const light=new T.SpotLight(cfg.lightColor,42,Math.max(2,cfg.height*1.7),.52,.72,1.55);light.position.set(x,underside-.025,0);light.castShadow=false;light.name='downlight-light';
        const target=new T.Object3D();target.position.set(x,0,Math.min(.35,cfg.depth));target.name='downlight-target';light.target=target;root.add(target,light);
      }
      root.userData.structureType='downlight-beam';root.userData.structureConfig={...cfg};
    }else if(obj.type==='counter'){
      bx([s.w,s.h-.08,s.d],[0,(s.h-.08)/2,0],base);
      bx([s.w+.08,.08,s.d+.06],[0,s.h-.04,0],light,{roughness:.42});
      bx([s.w*.72,.09,.025],[0,s.h*.57,s.d/2+.014],accent,{edges:false});
    }else if(obj.type==='shelf'){
      bx([.07,s.h,s.d],[-s.w/2+.035,s.h/2,0],base);bx([.07,s.h,s.d],[s.w/2-.035,s.h/2,0],base);
      bx([s.w,.06,s.d],[0,.03,0],base);
      [0.34,0.66,.97].filter(y=>y<s.h-.08).forEach(y=>bx([s.w-.08,.055,s.d],[0,y,0],light));
      bx([s.w-.08,s.h-.08,.035],[0,s.h/2,-s.d/2+.018],shade(base,.82),{edges:false});
    }else if(obj.type==='screen'){
      bx([s.w,.08,s.d],[0,.04,0],dark);bx([.08,s.h*.46,.08],[0,s.h*.28,0],dark,{edges:false});
      const panelH=s.h*.48,panelMat=new T.MeshStandardMaterial({color:0x13171e,roughness:.28,metalness:.22,
        emissive:new T.Color(accent),emissiveIntensity:.16});
      bx([s.w,.055,panelH],[0,s.h-panelH/2,.02],dark,{material:panelMat});
    }else if(obj.type==='table'){
      bx([s.w,.08,s.d],[0,s.h-.04,0],base,{roughness:.5});
      const lx=s.w/2-.07,lz=s.d/2-.07;
      [[-lx,-lz],[lx,-lz],[-lx,lz],[lx,lz]].forEach(([x,z])=>bx([.055,s.h-.08,.055],[x,(s.h-.08)/2,z],dark,{edges:false}));
    }else if(obj.type==='chair'){
      const seatY=s.h*.48;bx([s.w,.08,s.d],[0,seatY,0],base);
      bx([s.w,.08,s.h-seatY],[0,(seatY+s.h)/2,-s.d/2+.04],base);
      const lx=s.w/2-.055,lz=s.d/2-.055;
      [[-lx,-lz],[lx,-lz],[-lx,lz],[lx,lz]].forEach(([x,z])=>bx([.045,seatY,.045],[x,seatY/2,z],dark,{edges:false}));
    }else if(obj.type==='plant'){
      const potH=s.h*.27;mesh(new T.CylinderGeometry(s.w*.28,s.w*.38,potH,18),'#76543a',[0,potH/2,0],{roughness:.85});
      mesh(new T.CylinderGeometry(.025,.035,s.h*.48,10),'#44633b',[0,potH+s.h*.22,0]);
      [[0,s.h*.69,0],[s.w*.17,s.h*.76,0],[-s.w*.15,s.h*.84,.08],[.02,s.h*.94,-.08]].forEach((p,i)=>{
        const leaf=mesh(new T.SphereGeometry(s.w*(i? .21:.25),12,8),i%2?'#548f57':'#3f7947',p,{roughness:.9});
        leaf.scale.set(1,.72,.78);});
    }else if(obj.type==='sign'){
      bx([s.w,.07,s.d],[0,.035,0],dark);bx([.06,s.h*.55,.06],[0,s.h*.3,0],dark,{edges:false});
      bx([s.w,.055,s.h*.48],[0,s.h*.73,0],accent,{roughness:.5});
    }else if(obj.type==='display'){
      bx([s.w,s.h*.34,s.d],[0,s.h*.17,0],light);
      bx([s.w*.78,s.h*.28,s.d*.78],[0,s.h*.48,0],base);
      bx([s.w*.56,s.h*.25,s.d*.56],[0,s.h*.745,0],light);
      bx([s.w*.66,.055,s.d*.66],[0,s.h-.027,0],accent,{roughness:.42});
    }else bx([s.w,s.h,s.d],[0,s.h/2,0],base);
    root.name='catalog-object-'+obj.type;root.traverse(part=>{part.userData.objectId=obj.id;});this.applyCatalogAppearance(root,obj);return root;
  }
  addCatalogObjects(group,spec,floorY){
    spec.objects.forEach(obj=>{
      normalizeSceneObjectModel(obj);const root=this.buildCatalogObject(obj);this.applyCatalogObjectTransform(root,obj,floorY);
      root.visible=obj.visible!==false;group.add(root);this.objectMeshes.set(obj.id,root);
    });
  }
  applyCatalogObjectTransform(root,obj,floorY=0){
    const T=this.THREE,heading=new T.Quaternion().setFromAxisAngle(new T.Vector3(0,1,0),T.MathUtils.degToRad(Number(obj.rotationY)||0)),
      local=new T.Quaternion().setFromEuler(new T.Euler(T.MathUtils.degToRad(Number(obj.rotationX)||0),0,T.MathUtils.degToRad(Number(obj.rotationZ)||0),'XYZ'));
    root.position.set(Number(obj.position?.x)||0,Number(floorY)+(Number(obj.position?.y)||0)+sceneObjectOrientationLift(obj),Number(obj.position?.z)||0);
    root.quaternion.copy(heading).multiply(local);root.scale.set(obj.transform?.flipX?-1:1,obj.transform?.flipY?-1:1,1);
  }
  addPhoto360Platform(group,spec,floorY){
    const layout=photo360PlatformLayout(spec);if(!layout)return;
    const T=this.THREE,geometry=new T.CylinderGeometry(layout.diameter/2,layout.diameter/2,layout.height,64,1,false);
    const sideMaterial=new T.MeshStandardMaterial({color:0x20252d,roughness:.78,metalness:.04});
    const topMaterial=new T.MeshStandardMaterial({color:0x3b424d,roughness:.68,metalness:.08});
    const platform=new T.Mesh(geometry,[sideMaterial,topMaterial,sideMaterial]);
    platform.position.set(layout.x,floorY+layout.height/2,layout.z);platform.name='photo360-platform';
    platform.castShadow=true;platform.receiveShadow=true;group.add(platform);
  }
  clearSelectionHelpers(){
    (this.selectionHelpers||[]).forEach(helper=>{const parent=helper.parent;if(parent)parent.remove(helper);disposeThreeObject(helper);});
    this.selectionHelpers=[];this.selectionHelper=null;
  }
  sceneObjectTargets(id){
    const objectRoot=this.objectMeshes.get(id);if(objectRoot)return[objectRoot];
    if(id==='system-brand')return this.brandingRoot?[this.brandingRoot]:[];
    const matches=[],test=name=>{
      if(id==='system-floor')return name==='booth-floor'||name==='booth-floor-edge';
      if(id.startsWith('system-wall-sticker-'))return name==='wall-sticker-'+id.slice('system-wall-sticker-'.length);
      if(id==='system-floor-sticker')return name==='floor-sticker-graphic';
      if(id.startsWith('system-wall-')){const face=id.slice('system-wall-'.length);return name==='booth-wall-'+face||name.startsWith('booth-wall-'+face+'-');}
      if(id==='system-storage')return name.startsWith('storage-');
      if(id==='system-lights')return name.startsWith('spotlight');
      if(id==='system-photo360')return name==='photo360-platform';
      return false;
    };
    this.boothGroup?.traverse(node=>{if(node!==this.boothGroup&&test(String(node.name||''))&&!matches.some(parent=>node.parent===parent||parent.children?.includes(node)))matches.push(node);});
    return matches;
  }
  applySceneVisibility(){
    this.objectMeshes.forEach((root,id)=>{root.visible=objectById(id)?.visible!==false;});
    systemSceneItems().forEach(item=>this.sceneObjectTargets(item.id).forEach(target=>target.visible=item.visible!==false));
  }
  setSceneSelection(ids=[],primaryId=null){
    this.clearMagneticSnapPreview();this.clearAnchorGuides();this.clearSelectionHelpers();
    [...new Set(ids)].forEach(id=>{const primary=id===primaryId,targets=this.sceneObjectTargets(id).filter(root=>root.visible!==false&&(root.isMesh||root.isGroup));targets.forEach(root=>{
      const helper=new this.THREE.BoxHelper(root,primary?0xf72585:0x67c7e8);helper.name=primary?'object-selection-primary':'object-selection-secondary';
      helper.material.depthTest=false;helper.material.transparent=true;helper.material.opacity=primary ? .98 : .78;helper.renderOrder=20;this.boothGroup.add(helper);this.selectionHelpers.push(helper);
      if(primary&&!this.selectionHelper)this.selectionHelper=helper;
    });});
    if(!this.selectionHelper)this.selectionHelper=this.selectionHelpers[0]||null;
    if(primaryId&&objectById(primaryId))this.buildObjectAnchorGuides(primaryId);
  }
  focusSceneItem(id){
    const targets=this.sceneObjectTargets(id).filter(target=>target.visible!==false);if(!targets.length)return false;
    const box=new this.THREE.Box3();targets.forEach(target=>box.expandByObject(target));if(box.isEmpty())return false;
    const center=box.getCenter(new this.THREE.Vector3()),size=box.getSize(new this.THREE.Vector3()),maxSize=Math.max(size.x,size.y,size.z,.25),direction=this.camera.position.clone().sub(this.controls.target);
    if(direction.lengthSq()<.001)direction.set(1,.65,1);direction.normalize();const distance=Math.max(maxSize*1.8,1.4);
    this.applyingCameraPreset=true;this.controls.target.copy(center);this.camera.position.copy(center).addScaledVector(direction,distance);this.camera.near=Math.max(.01,distance/1000);this.camera.far=Math.max(this.camera.far,distance*20);this.camera.updateProjectionMatrix();
    this.camera.lookAt(center);this.controls.update();this.applyingCameraPreset=false;this.currentView='custom';this.viewButtons.forEach(button=>button.classList.remove('on'));this.commitCameraState();this.renderer.render(this.scene,this.camera);return true;
  }
  setSelected(id){this.setSelectedObjects(id?[id]:[],id);}
  setSelectedObjects(ids=[],primaryId=null){
    this.setSceneSelection(ids,primaryId);
  }
  setBrandSelected(selected){
    this.clearMagneticSnapPreview();this.clearAnchorGuides();
    this.clearSelectionHelpers();
    const target=this.brandingHitTarget||this.brandingRoot;if(!selected||!target)return;
    this.selectionHelper=new this.THREE.BoxHelper(target,0xe0a83c);this.selectionHelper.name='brand-selection';
    this.selectionHelper.material.depthTest=false;this.selectionHelper.material.transparent=true;this.selectionHelper.material.opacity=.95;
    this.selectionHelper.renderOrder=20;this.boothGroup.add(this.selectionHelper);this.selectionHelpers=[this.selectionHelper];
  }
  buildBooth(spec){
    const T=this.THREE,g=this.boothGroup,t=boothWallThickness(spec),floorY=spec.raise/100,a=palette();
    const span=Math.max(spec.W,spec.D,spec.H),groundGeo=new T.PlaneGeometry(span*5,span*5);
    const groundMat=new T.MeshStandardMaterial({color:0x15181d,roughness:1});
    const ground=new T.Mesh(groundGeo,groundMat);ground.name='scene-ground';ground.rotation.x=-Math.PI/2;
    ground.position.set(spec.W/2,-.045,spec.D/2);ground.receiveShadow=true;g.add(ground);

    /* ไม่ยกพื้น = แผ่นพรม/พื้นหนา 3 มม.; ยกพื้นยังใช้ความสูงเดิม 5/10/15 ซม.
       คงผิวด้านบนไว้ที่ระดับ floorY เพื่อไม่ให้วัตถุและผนังขยับตามความหนา */
    const slabHeight=floorY>0?floorY:.003;
    const slabCenterY=floorY>0?floorY/2:-slabHeight/2;
    this.box(g,[spec.W,slabHeight,spec.D],[spec.W/2,slabCenterY,spec.D/2],floorColor(),
      {material:this.floorMaterial(spec),castShadow:false,name:'booth-floor'});
    this.addFloorSticker(g,spec,floorY);
    const walls=typ().walls;
    if(walls.includes('back')){
      if(isCurvedWallType(spec))this.curvedWall(g,spec,t,floorY);
      else this.box(g,[spec.W,spec.H,t],[spec.W/2,spec.H/2,t/2],a.wall,
        {material:this.wallMaterial(spec,spec.W,'back'),name:'booth-wall-back'});
    }
    if(walls.includes('left'))this.box(g,[t,spec.H,spec.D],[t/2,spec.H/2,spec.D/2],a.wall,
      {material:this.wallMaterial(spec,spec.D,'left'),name:'booth-wall-left'});
    if(walls.includes('right'))this.box(g,[t,spec.H,spec.D],[spec.W-t/2,spec.H/2,spec.D/2],a.wall,
      {material:this.wallMaterial(spec,spec.D,'right'),name:'booth-wall-right'});
    this.addWallStickers(g,spec,t,floorY);

    if(hasStore()){
      const panels=storagePanels(t),G=panels.G,storeColor=stPaintColor(a);
      this.storageWall(g,G,floorY,spec,'front',storeColor);
      if(panels.back)this.storageWall(g,G,floorY,spec,'back',storeColor);
      if(panels.left)this.storageWall(g,G,floorY,spec,'left',storeColor);
      if(panels.right)this.storageWall(g,G,floorY,spec,'right',storeColor);
      this.door(g,G,floorY,spec);
    }
    this.addPhoto360Platform(g,spec,floorY);
    this.addCatalogObjects(g,spec,floorY);
    if(spec.type!=='island')this.addBranding(g,spec,t,floorY);
    this.addSpotlights(g,spec,t,floorY);
    this.addBoothDimensions(g,spec,floorY);
  }
  setCameraView(view){
    const spec=BoothSpec,span=Math.max(spec.W,spec.D,spec.H),floorY=spec.raise/100;
    const target=new this.THREE.Vector3(spec.W/2,Math.max(floorY+.2,spec.H*.42),spec.D/2);
    this.camera.up.set(0,1,0);
    if(view==='front')this.camera.position.set(spec.W/2,target.y,spec.D+span*1.55);
    else if(view==='top'){
      this.camera.up.set(0,0,-1);this.camera.position.set(spec.W/2,span*2.05,spec.D/2+.001);
      target.set(spec.W/2,0,spec.D/2);
    }else if(view==='perspective')this.camera.position.set(spec.W*.72,Math.max(spec.H*.72,2.2),spec.D+span*1.35);
    else this.camera.position.set(spec.W+span*.9,Math.max(spec.H+span*.5,3.2),spec.D+span*.9);
    this.applyingCameraPreset=true;this.controls.target.copy(target);this.camera.lookAt(target);
    const damping=this.controls.enableDamping;this.controls.enableDamping=false;this.controls.update();this.controls.enableDamping=damping;
    this.currentView=view;this.applyingCameraPreset=false;
    this.viewButtons.forEach((b,k)=>b.classList.toggle('on',k===view));
    this.renderer.render(this.scene,this.camera);this.commitCameraState();
  }
}

function showThreeFallback(container,message){
  container.classList.add('three-active');
  const status=el('div','three-status','<div>'+esc(message)+'<br><button class="btn sm">เปิดผังพื้น</button></div>');
  status.querySelector('button').onclick=()=>selectView('plan');container.replaceChildren(status);
}
function loadThreeRenderer(){
  if(threeRendererPromise)return threeRendererPromise;
  threeRendererPromise=Promise.all([
    import('three'),
    import('three/addons/controls/OrbitControls.js'),
    import('three/addons/loaders/GLTFLoader.js')])
    .then(([THREE,controls,gltf])=>threeRenderer=new ThreeBoothRenderer(THREE,controls.OrbitControls,gltf.GLTFLoader));
  return threeRendererPromise;
}
let lightThumbRenderers=new Map();
let lightThumbQueuePromise=null;
function lightThumbFallback(host,model){
  if(!host||!host.isConnected)return;
  const fallback=el('div','light-model-thumb-fallback',model.k==='arm'?'ARM LIGHT':'CLEAR LIGHT');
  fallback.setAttribute('aria-label','ไม่มีภาพตัวอย่าง · '+model.n);host.replaceWith(fallback);
}
function waitForLightTemplate(model){
  if(!threeRenderer)return Promise.reject(new Error('Three.js renderer is unavailable'));
  threeRenderer.requestFixtureTemplate(model.k);
  return new Promise((resolve,reject)=>{
    const started=Date.now();
    const poll=()=>{
      if(threeRenderer.fixtureTemplates.has(model.k))return resolve(threeRenderer.fixtureTemplates.get(model.k));
      if(threeRenderer.fixtureErrors.has(model.k))return reject(threeRenderer.fixtureErrors.get(model.k));
      if(Date.now()-started>60000)return reject(new Error('Light model preview timed out'));
      setTimeout(poll,80);
    };poll();
  });
}
function renderLightModelThumb(model,host){
  if(!host||!host.isConnected||lightThumbRenderers.has(model.k))return;
  waitForLightTemplate(model).then(template=>{
    if(!host.isConnected)return;
    const T=threeRenderer.THREE,scene=new T.Scene();scene.background=new T.Color('#151a21');
    const camera=new T.PerspectiveCamera(32,4/3,.01,1000);
    const renderer=new T.WebGLRenderer({antialias:true,alpha:false,powerPreference:'low-power'});
    renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));renderer.outputColorSpace=T.SRGBColorSpace;
    renderer.toneMapping=T.ACESFilmicToneMapping;renderer.toneMappingExposure=1.08;host.replaceChildren(renderer.domElement);host.classList.add('is-ready');
    if(model.k==='arm')host.classList.add('arm-preview');
    const hemi=new T.HemisphereLight(0xdbe7f6,0x151821,1.5),key=new T.DirectionalLight(0xfff1d2,2.5),fill=new T.DirectionalLight(0x9fc8ff,1.15);
    key.position.set(3,5,4);fill.position.set(-4,2,-3);scene.add(hemi,key,fill);
    const display=new T.Group(),root=template.clone(true);display.add(root);display.rotation.set(.14,-.58,0);scene.add(display);
    const resize=()=>{
      if(!host.isConnected)return;
      const rect=host.getBoundingClientRect(),w=Math.max(1,Math.floor(rect.width)),h=Math.max(1,Math.floor(rect.height));
      renderer.setSize(w,h,false);camera.aspect=w/h;camera.updateProjectionMatrix();renderer.render(scene,camera);
    };
    display.updateMatrixWorld(true);let box=new T.Box3().setFromObject(display),size=box.getSize(new T.Vector3()),center=box.getCenter(new T.Vector3());display.position.sub(center);display.updateMatrixWorld(true);
    box=new T.Box3().setFromObject(display);size=box.getSize(size);const maxDim=Math.max(size.x,size.y,size.z),fit=maxDim*1.28;
    camera.position.set(fit*1.55,fit*.82,fit*1.72);camera.lookAt(0,0,0);camera.near=Math.max(.001,fit/100);camera.far=fit*20;camera.updateProjectionMatrix();resize();
    const observer=new ResizeObserver(resize);observer.observe(host);lightThumbRenderers.set(model.k,{renderer,scene,camera,display,observer});
  }).catch(()=>lightThumbFallback(host,model));
}
function queueLightModelThumbs(){
  if(lightThumbQueuePromise)return lightThumbQueuePromise;
  if(!threeRenderer)return Promise.resolve();
  lightThumbQueuePromise=Promise.all(LIGHT_MODELS.map(model=>{
    const host=document.querySelector('#oLightModel [data-thumb-key="'+model.k+'"]');
    return host?renderLightModelThumb(model,host):null;
  })).catch(()=>{});
  return lightThumbQueuePromise;
}
function renderThreeView(container){
  container.classList.add('three-active');
  if(threeRenderer){threeRenderer.mount(container);threeRenderer.update(BoothSpec);queueLightModelThumbs();return;}
  if(!container.querySelector('.three-status'))
    container.innerHTML='<div class="three-status">กำลังโหลด Three.js '+THREE_VERSION+'…</div>';
  loadThreeRenderer().then(r=>{queueLightModelThumbs();if(S.view==='three'){r.mount(container);r.update(BoothSpec);}})
    .catch(()=>{if(S.view==='three')showThreeFallback(container,'อุปกรณ์นี้ไม่รองรับ WebGL หรือโหลด Three.js ไม่สำเร็จ');});
}
function selectView(view){
  S.view=view;document.querySelectorAll('.tab').forEach(x=>{
    const active=x.dataset.v===view;x.classList.toggle('on',active);x.setAttribute('aria-selected',String(active));});render();
}

/* ================= ผังพื้น ================= */
function planSVG(){
  const W=S.W,D=S.D,VW=420,VH=300,pad=44;
  const sc=Math.min((VW-pad*2)/W,(VH-pad*2)/D);
  const ox=(VW-W*sc)/2,oy=(VH-D*sc)/2;
  const P=(x,y)=>[ox+x*sc,oy+y*sc];
  const a=palette(),t=boothWallThickness(S),curve=wallCurveInfo(S);
  let g=`<defs><marker id="plan-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M 0 0 L 8 4 L 0 8 z" fill="#ff7ab8"/></marker></defs>
    <rect width="${VW}" height="${VH}" fill="#0a0b0e"/>`;
  g+=`<rect x="${ox}" y="${oy}" width="${(W*sc).toFixed(1)}" height="${(D*sc).toFixed(1)}"
       fill="${floorColor()}" opacity=".35" stroke="#333a44" stroke-width="1"/>`;
  if(S.floor==='sticker'&&S.floorStickerData){
    const sw=Math.min(W,Math.max(.1,S.floorStickerW))*sc,sd=Math.min(D,Math.max(.1,S.floorStickerD))*sc;
    const sx=ox+(W*sc-sw)/2,sy=oy+(D*sc-sd)/2,cx=sx+sw/2,cy=sy+sd/2,rotation=Number(S.floorStickerRotation||0),mode=S.floorStickerMode||'single';
    const dx=(Number(S.floorStickerOffsetX)||0)*sc,dy=(Number(S.floorStickerOffsetY)||0)*sc;
    let artwork='';
    if(mode==='repeat'){
      const pw=Math.max(.1,Number(S.floorStickerPatternSize)||1.2)*sc,ph=pw/Math.max(.01,Number(S.floorStickerAR)||1);
      artwork=`<defs><pattern id="floor-sticker-pattern" patternUnits="userSpaceOnUse" x="${(cx+dx).toFixed(1)}" y="${(cy+dy).toFixed(1)}" width="${pw.toFixed(1)}" height="${ph.toFixed(1)}" patternTransform="rotate(${rotation} ${cx.toFixed(1)} ${cy.toFixed(1)})"><image href="${S.floorStickerData}" width="${pw.toFixed(1)}" height="${ph.toFixed(1)}" preserveAspectRatio="none"/></pattern></defs><rect x="${sx.toFixed(1)}" y="${sy.toFixed(1)}" width="${sw.toFixed(1)}" height="${sd.toFixed(1)}" fill="url(#floor-sticker-pattern)"/>`;
    }else artwork=`<image href="${S.floorStickerData}" x="${(sx+dx).toFixed(1)}" y="${(sy+dy).toFixed(1)}" width="${sw.toFixed(1)}" height="${sd.toFixed(1)}" preserveAspectRatio="xMidYMid ${mode==='cover'?'slice':'meet'}" transform="rotate(${rotation} ${(cx+dx).toFixed(1)} ${(cy+dy).toFixed(1)})"/>`;
    g+=`<defs><clipPath id="floor-sticker-clip"><rect x="${sx.toFixed(1)}" y="${sy.toFixed(1)}" width="${sw.toFixed(1)}" height="${sd.toFixed(1)}"/></clipPath></defs>
      <g clip-path="url(#floor-sticker-clip)">${artwork}</g>
      <rect x="${sx.toFixed(1)}" y="${sy.toFixed(1)}" width="${sw.toFixed(1)}" height="${sd.toFixed(1)}" fill="none" stroke="#f72585" stroke-width="1"/>`;
  }
  const wall=(x,y,w,d)=>{const p=P(x,y);
    return `<rect x="${p[0].toFixed(1)}" y="${p[1].toFixed(1)}" width="${(w*sc).toFixed(1)}"
      height="${(d*sc).toFixed(1)}" fill="${a.wall}" stroke="rgba(0,0,0,.45)" stroke-width=".8"/>`;};
  const curvedBackWall=()=>{
    if(!curve)return wall(0,0,W,t);
    const front=[],back=[],segments=64;
    for(let i=0;i<=segments;i++){const p=curve.pointAt(i/segments,t/2),q=P(p.x,p.z);front.push(q[0].toFixed(1)+','+q[1].toFixed(1));}
    for(let i=segments;i>=0;i--){const p=curve.pointAt(i/segments,-t/2),q=P(p.x,p.z);back.push(q[0].toFixed(1)+','+q[1].toFixed(1));}
    return `<polygon points="${front.concat(back).join(' ')}" fill="${a.wall}" stroke="rgba(0,0,0,.45)" stroke-width=".8"/>`;
  };
  const wl=typ().walls;
  if(wl.indexOf('left')>=0&&sceneItemVisible('system-wall-left'))g+=wall(0,0,t,D);
  if(wl.indexOf('right')>=0&&sceneItemVisible('system-wall-right'))g+=wall(W-t,0,t,D);
  if(wl.indexOf('back')>=0&&sceneItemVisible('system-wall-back'))g+=curvedBackWall();
  if(hasStore()&&sceneItemVisible('system-storage')){const G=storeGeom(t),p=P(G.x,G.y);
    g+=`<rect x="${p[0].toFixed(1)}" y="${p[1].toFixed(1)}" width="${(G.w*sc).toFixed(1)}"
      height="${(G.d*sc).toFixed(1)}" fill="${S.stSurf==='sticker'?a.acc:stPaintColor(a)}"
      stroke="rgba(0,0,0,.5)" stroke-width=".8"/>`;
    if(G.w*sc>56)g+=`<text x="${(p[0]+G.w*sc/2).toFixed(1)}" y="${(p[1]+G.d*sc/2+4).toFixed(1)}"
      font-size="10" fill="${inkOn(S.stSurf==='sticker'?a.acc:stPaintColor(a))}" text-anchor="middle"
      font-family="'Noto Sans Thai',sans-serif">ห้องเก็บของ</text>`;
    const dw=Math.min(.8,G.w*.62),dd=Math.min(.8,G.d*.62);
    const dl=(x1,y1,x2,y2)=>{const A=P(x1,y1),B=P(x2,y2);
      return `<line x1="${A[0]}" y1="${A[1]}" x2="${B[0]}" y2="${B[1]}" stroke="#f5c469" stroke-width="3.5"/>`;};
    const ax=G.x+doorAlong(G.w,dw), ay=G.y+doorAlong(G.d,dd);
    if(S.stDoorType==='slide'){
      if(S.stDoor==='front')g+=dl(ax,G.y+G.d,ax+dw,G.y+G.d)+dl(ax,G.y+G.d-.07,ax+dw,G.y+G.d-.07);
      if(S.stDoor==='left') g+=dl(G.x,ay,G.x,ay+dd)+dl(G.x+.07,ay,G.x+.07,ay+dd);
      if(S.stDoor==='right')g+=dl(G.x+G.w,ay,G.x+G.w,ay+dd)+dl(G.x+G.w-.07,ay,G.x+G.w-.07,ay+dd);
    }else{
      if(S.stDoor==='front')g+=dl(ax,G.y+G.d,ax,G.y+G.d-dw);
      if(S.stDoor==='left') g+=dl(G.x,ay,G.x+dd,ay);
      if(S.stDoor==='right')g+=dl(G.x+G.w,ay,G.x+G.w-dd,ay);
    }}
  const photoPlatform=photo360PlatformLayout(S);
  if(photoPlatform&&sceneItemVisible('system-photo360')){
    const center=P(photoPlatform.x,photoPlatform.z),radius=photoPlatform.diameter*sc/2;
    g+=`<circle cx="${center[0].toFixed(1)}" cy="${center[1].toFixed(1)}" r="${radius.toFixed(1)}"
      fill="#343b45" fill-opacity=".92" stroke="#f72585" stroke-width="1.5"/>
      <text x="${center[0].toFixed(1)}" y="${(center[1]+3.5).toFixed(1)}" fill="#f2f3f5" font-size="9"
      font-weight="600" text-anchor="middle" font-family="'Noto Sans Thai',sans-serif">แท่น 360 Ø1 ม.</text>`;
  }
  const objectNode=obj=>{
    const item=objectCatalogDef(obj.catalogId),name=item?.name||'องค์ประกอบ',shape=placementShape(obj.size,obj.position.x,obj.position.z,obj.rotationY||0);
    const ordered=[[-1,-1],[1,-1],[1,1],[-1,1]].map(([a,b])=>P(
      shape.x+shape.axes[0].x*shape.half[0]*a+shape.axes[1].x*shape.half[1]*b,
      shape.z+shape.axes[0].z*shape.half[0]*a+shape.axes[1].z*shape.half[1]*b));
    const points=ordered.map(point=>point.map(value=>value.toFixed(1)).join(',')).join(' '),center=P(shape.x,shape.z);
    const front=P(shape.x+shape.axes[1].x*shape.half[1]*.78,shape.z+shape.axes[1].z*shape.half[1]*.78);
    const bounds=footprintSize(obj.size,obj.rotationY||0),selected=obj.id===objectEditor.selectedId,locked=objectLocked(obj),fill=item?.color||'#626b78';
    const label=bounds.w*sc>=48&&bounds.d*sc>=25?name:(item?.icon||'▪');
    const aria=name+' · X '+obj.position.x.toFixed(2)+' เมตร · Z '+obj.position.z.toFixed(2)+' เมตร · หมุน '+(obj.rotationY||0)+' องศา'+(locked?' · ล็อกอยู่':'');
    let node=`<g class="plan-object${selected?' selected':''}${locked?' locked':''}" data-object-id="${esc(obj.id)}" role="button" tabindex="0"
      aria-label="${esc(aria)}" aria-pressed="${selected}"><title>${esc(aria)}</title>
      <polygon class="plan-footprint" points="${points}" fill="${fill}" fill-opacity=".88"
        stroke="${locked?'#8a919c':selected?'#ff7ab8':'#d8dde5'}" stroke-width="${selected?'2.5':'1.15'}"/>`;
    node+=`<line x1="${center[0].toFixed(1)}" y1="${center[1].toFixed(1)}" x2="${front[0].toFixed(1)}" y2="${front[1].toFixed(1)}"
      stroke="#ff7ab8" stroke-width="1.4" marker-end="url(#plan-arrow)"/>`;
    node+=`<text x="${center[0].toFixed(1)}" y="${(center[1]+3.5).toFixed(1)}" fill="${inkOn(fill)}" font-size="9"
      font-weight="600" text-anchor="middle" paint-order="stroke" stroke="${fill}" stroke-width="2.5"
      font-family="'Noto Sans Thai',sans-serif">${esc(label)}</text>`;
    if(selected)ordered.forEach(point=>{node+=`<circle cx="${point[0].toFixed(1)}" cy="${point[1].toFixed(1)}" r="2.6" fill="#ff7ab8" stroke="#0a0b0e" stroke-width="1"/>`;});
    return node+'</g>';
  };
  S.objects.filter(obj=>obj.visible!==false).forEach(obj=>{g+=objectNode(obj);});
  if(S.type!=='island'&&sceneItemVisible('system-brand')){
    const base=logoBaseSize(S),brandSize=brandPhysicalSize(S);let x,z,rotation,size;
    if(S.logoMount==='floor'){
      x=S.logoFloorX;z=S.logoFloorZ;rotation=S.logoFloorRotation;size={w:Math.max(brandSize.width,base.width),d:Math.max(S.logoDepth,base.depth),h:brandSize.height};
    }else if(S.logoWall==='back'&&curve){
      const fraction=clampNumber(S.logoWallU/Math.max(.001,curve.arcLength),0,1),angle=(fraction-.5)*curve.arcAngle;
      const centerX=curve.half+curve.radius*Math.sin(angle),point=curve.pointAtX(centerX,t/2+S.logoDepth/2);
      x=point.x;z=point.z;rotation=point.rotationY*180/Math.PI;size={w:brandSize.width,d:S.logoDepth,h:brandSize.height};
    }else if(S.logoWall==='back'){
      x=S.logoWallU;z=t+S.logoDepth/2;rotation=0;size={w:brandSize.width,d:S.logoDepth,h:brandSize.height};
    }else if(S.logoWall==='left'){
      x=t+S.logoDepth/2;z=S.logoWallU;rotation=90;size={w:brandSize.width,d:S.logoDepth,h:brandSize.height};
    }else{
      x=W-t-S.logoDepth/2;z=S.logoWallU;rotation=90;size={w:brandSize.width,d:S.logoDepth,h:brandSize.height};
    }
    const shape=placementShape(size,x,z,rotation),ordered=[[-1,-1],[1,-1],[1,1],[-1,1]].map(([aa,bb])=>P(
      shape.x+shape.axes[0].x*shape.half[0]*aa+shape.axes[1].x*shape.half[1]*bb,
      shape.z+shape.axes[0].z*shape.half[0]*aa+shape.axes[1].z*shape.half[1]*bb)),center=P(x,z),title=logoPlacementSummary(S);
    g+=`<g class="plan-logo-placement"><title>${esc(title)}</title><polygon points="${ordered.map(point=>point.map(value=>value.toFixed(1)).join(',')).join(' ')}"
      fill="${a.acc}" fill-opacity=".76" stroke="#f6d487" stroke-width="1.6"/><text x="${center[0].toFixed(1)}" y="${(center[1]+3).toFixed(1)}"
      fill="${inkOn(a.acc)}" font-size="8" font-weight="700" text-anchor="middle" paint-order="stroke" stroke="${a.acc}" stroke-width="2"
      font-family="'Noto Sans Thai',sans-serif">${S.logoMount==='floor'?'โลโก้ตั้งพื้น':'โลโก้ติดผนัง'}</text></g>`;
  }
  const selectedObject=objectById(objectEditor.selectedId),selectedItem=selectedObject&&objectCatalogDef(selectedObject.catalogId);
  const legend=S.objects.length?('Asset '+S.objects.length+' ชิ้น · ลูกศร = ด้านหน้า'+(selectedItem?' · เลือก '+selectedItem.name:'')):'ยังไม่มี Asset ในผัง';
  g+=`<rect x="10" y="10" width="250" height="23" rx="6" fill="#11151b" stroke="#303641"/>
    <text x="20" y="25.5" fill="#cbd1da" font-size="9.5" font-family="'Noto Sans Thai',sans-serif">${esc(legend)}</text>`;
  const open=(x1,y1,x2,y2)=>{const p=P(x1,y1),q=P(x2,y2);
    return `<line x1="${p[0]}" y1="${p[1]}" x2="${q[0]}" y2="${q[1]}" stroke="#f72585" stroke-width="2.5"
      stroke-dasharray="6 5" opacity=".85"/>`;};
  g+=open(0,D,W,D);
  if(wl.indexOf('right')<0)g+=open(W,0,W,D);
  if(wl.indexOf('left')<0)g+=open(0,0,0,D);
  const c=P(W/2,D),tt=P(W/2,0),rr=P(W,D/2);
  g+=`<text x="${c[0]}" y="${(c[1]+20).toFixed(1)}" font-size="11" fill="#f72585" text-anchor="middle"
       font-family="'Noto Sans Thai',sans-serif">ด้านเปิด / ทางเดิน</text>`;
  g+=`<text x="${tt[0]}" y="${(tt[1]-12).toFixed(1)}" font-size="11" fill="#8a919c" text-anchor="middle"
       font-family="Inter,sans-serif">กว้าง ${W} m</text>`;
  g+=`<text x="${(rr[0]+32).toFixed(1)}" y="${(rr[1]+4).toFixed(1)}" font-size="11" fill="#8a919c"
       text-anchor="middle" font-family="Inter,sans-serif">ลึก ${D} m</text>`;
  return `<svg viewBox="0 0 ${VW} ${VH}" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">${g}</svg>`;
}

function bindPlanObjectInteractions(container){
  container.querySelectorAll('.plan-object').forEach(node=>{
    const activate=restoreFocus=>{
      const id=node.dataset.objectId;selectObject(id);
      if(restoreFocus)requestAnimationFrame(()=>[...container.querySelectorAll('.plan-object')].find(item=>item.dataset.objectId===id)?.focus());
    };
    node.addEventListener('click',()=>activate(false));
    node.addEventListener('keydown',event=>{
      if(event.key==='Enter'||event.key===' '){event.preventDefault();activate(true);}
    });
  });
}

/* ================= 3D isometric ================= */
const C30=Math.cos(Math.PI/6),S30=.5;
const isoRaw=(x,y,z)=>[(x-y)*C30,(x+y)*S30-z];
function isoSVG(){
  const W=S.W,D=S.D,H=S.H,a=palette(),VW=1000,VH=600,t=boothWallThickness(S),z0=S.raise/100,curve=wallCurveInfo(S);
  const wl=typ().walls,solids=[];
  if(S.raise>0)solids.push({x:0,y:0,z:0,w:W,d:D,h:z0,col:shade(floorColor(),1.12),k:'platform'});
  if(wl.indexOf('back')>=0){
    if(curve)solids.push({curve,x:0,y:0,z:0,w:W,d:t,h:H,col:wallFaceColor(S,'back',a),k:'curved-wall',face:'back',pri:1});
    else solids.push({x:0,y:0,z:0,w:W,d:t,h:H,col:wallFaceColor(S,'back',a),k:'wall',face:'back',pri:1});
  }
  if(wl.indexOf('left')>=0)solids.push({x:0,y:0,z:0,w:t,d:D,h:H,col:wallFaceColor(S,'left',a),k:'wall',face:'left'});
  if(wl.indexOf('right')>=0)solids.push({x:W-t,y:0,z:0,w:t,d:D,h:H,col:wallFaceColor(S,'right',a),k:'wall',face:'right',ghost:1});
  S.objects.filter(isEntranceFrameObject).forEach(object=>{
    const cfg=normalizeEntranceFrameObject(object).structure,x=object.position.x-cfg.pierWidth/2,y=object.position.z-cfg.projection/2;
    solids.push({x,y,z:z0+cfg.height-cfg.thickness,w:cfg.pierWidth,d:cfg.projection,h:cfg.thickness,col:cfg.color,k:'entrance-frame'});
    solids.push({x,y:y+cfg.projection-cfg.thickness,z:z0,w:cfg.pierWidth,d:cfg.thickness,h:cfg.height-cfg.thickness,col:cfg.color,k:'entrance-frame'});
  });
  if(hasStore()){const G=storeGeom(t);
    solids.push({x:G.x,y:G.y,z:z0,w:G.w,d:G.d,h:G.h,col:stPaintColor(a),k:'store'});}
  const LP=lightPoints(t);
  LP.forEach(L=>{
    if(L.w==='back') solids.push({x:L.u-.07,y:t,z:H,w:.14,d:.18,h:.09,col:'#3c4046',k:'lamp'});
    else if(L.w==='left') solids.push({x:t,y:L.u-.07,z:H,w:.18,d:.14,h:.09,col:'#3c4046',k:'lamp'});
    else solids.push({x:W-t-.18,y:L.u-.07,z:H,w:.18,d:.14,h:.09,col:'#33373c',k:'lamp'});});

  const pts=[];const push=(x,y,z)=>pts.push(isoRaw(x,y,z));
  solids.forEach(s=>{
    if(s.curve){for(let i=0;i<=64;i++){const u=i/64,front=s.curve.pointAt(u,t/2),back=s.curve.pointAt(u,-t/2);
        push(front.x,front.z,0);push(front.x,front.z,H);push(back.x,back.z,0);push(back.x,back.z,H);}return;}
    for(const X of[s.x,s.x+s.w])for(const Y of[s.y,s.y+s.d])for(const Z of[s.z,s.z+s.h])push(X,Y,Z);
  });
  [[0,0,0],[W,0,0],[0,D,0],[W,D,0],[0,0,H]].forEach(c=>push(c[0],c[1],c[2]));
  const xs=pts.map(p=>p[0]),ys=pts.map(p=>p[1]);
  const mnx=Math.min.apply(null,xs),mxx=Math.max.apply(null,xs);
  const mny=Math.min.apply(null,ys),mxy=Math.max.apply(null,ys);
  const pad=72,sc=Math.min((VW-pad*2)/(mxx-mnx||1),(VH-pad*2)/(mxy-mny||1));
  const ox=pad-mnx*sc+((VW-pad*2)-(mxx-mnx)*sc)/2,oy=pad-mny*sc+((VH-pad*2)-(mxy-mny)*sc)/2;
  const P=(x,y,z)=>{const r=isoRaw(x,y,z);return[r[0]*sc+ox,r[1]*sc+oy];};
  const pp=cs=>cs.map(c=>{const q=P(c[0],c[1],c[2]);return q[0].toFixed(1)+','+q[1].toFixed(1);}).join(' ');
  const amb=S.lights?LIGHTCOL.find(c=>c.k===S.lightCol).c:(a.warm?'#ffd9a0':'#cfe0ff');
  const backWallColor=wallFaceColor(S,'back',a),ink=inkOn(backWallColor);
  const _sfBg=(function(){ if(!hasStore())return a.wall;
    const F=S.stFace,stick=S.stSurf==='sticker';
    const fr=stick&&(F==='all'||F==='front'||F==='front-left'||F==='front-right');
    return fr? a.acc : stPaintColor(a);})();
  const LOGOINK2=(lum(_sfBg)>.62&&Math.abs(lum(_sfBg)-lum(a.acc))>.18)?a.acc:inkOn(_sfBg);

  let g=`<defs>
    <linearGradient id="bgv" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#171a20"/><stop offset="1" stop-color="#0c0e11"/></linearGradient>
    <radialGradient id="sp" cx=".5" cy=".3" r=".62">
      <stop offset="0" stop-color="${amb}" stop-opacity=".10"/><stop offset="1" stop-color="${amb}" stop-opacity="0"/></radialGradient>
    <filter id="sf" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="6"/></filter>
    <filter id="silh"><feFlood flood-color="${S.wallCol==='white'?a.acc:ink}" result="fc"/>
      <feComposite in="fc" in2="SourceAlpha" operator="in"/></filter>
    <filter id="silh2"><feFlood flood-color="${LOGOINK2}" result="fc2"/>
      <feComposite in="fc2" in2="SourceAlpha" operator="in"/></filter></defs>
  <rect width="${VW}" height="${VH}" fill="url(#bgv)"/><rect width="${VW}" height="${VH}" fill="url(#sp)"/>`;

  g+=`<polygon points="${pp([[0,0,0],[W,0,0],[W,D,0],[0,D,0]])}" fill="${a.floor}" stroke="#2f353d" stroke-width="1"/>`;
  if(S.raise===0)
    g+=`<polygon points="${pp([[0,0,.004],[W,0,.004],[W,D,.004],[0,D,.004]])}" fill="${floorColor()}" opacity=".97"/>`;
  if(S.floor==='tile'&&TILES.find(x=>x.k===S.tile).grain){
    const gz=S.raise>0?z0+.001:.006;
    for(let i=.3;i<W;i+=.3){const p1=P(i,0,gz),p2=P(i,D,gz);
      g+=`<line x1="${p1[0].toFixed(1)}" y1="${p1[1].toFixed(1)}" x2="${p2[0].toFixed(1)}" y2="${p2[1].toFixed(1)}"
        stroke="#000" stroke-width=".7" opacity=".13"/>`;}}
  solids.forEach(s=>{if(s.k==='platform'||s.ghost||s.curve)return;
    g+=`<polygon points="${pp([[s.x+.08,s.y+.08,.006],[s.x+s.w+.22,s.y+.08,.006],[s.x+s.w+.22,s.y+s.d+.22,.006],[s.x+.08,s.y+s.d+.22,.006]])}"
      fill="#000" opacity=".3" filter="url(#sf)"/>`;});

  /* คีย์เท่ากันเมื่อผนังสองด้านเริ่มที่มุมเดียวกัน — ให้ผนังหลังวาดทีหลังเสมอ
   งานจริงผนังหลังคือแผงเต็มความกว้างที่ตั้งก่อน แล้วผนังข้างมาชน */
  solids.sort((p,q)=>((p.x+p.y+p.z*.6)-(q.x+q.y+q.z*.6))||((p.pri||0)-(q.pri||0)));
  solids.forEach(s=>{
    if(s.curve){
      const frontTop=[],frontBottom=[],backTop=[],backBottom=[],segments=64;
      for(let i=0;i<=segments;i++){
        const u=i/segments,front=s.curve.pointAt(u,t/2),back=s.curve.pointAt(u,-t/2);
        frontTop.push(P(front.x,front.z,s.h));frontBottom.push(P(front.x,front.z,s.z));
        backTop.push(P(back.x,back.z,s.h));backBottom.push(P(back.x,back.z,s.z));
      }
      const cTop=shade(s.col,1.24),cFront=shade(s.col,.94),cBack=shade(s.col,.67),edge=' stroke="rgba(0,0,0,.3)" stroke-width=".7"';
      g+=`<polygon points="${frontBottom.concat(frontTop.slice().reverse()).map(p=>p[0].toFixed(1)+','+p[1].toFixed(1)).join(' ')}" fill="${cFront}"${edge}/>`;
      g+=`<polygon points="${frontTop.concat(backTop.slice().reverse()).map(p=>p[0].toFixed(1)+','+p[1].toFixed(1)).join(' ')}" fill="${cTop}"${edge}/>`;
      g+=`<polygon points="${backBottom.concat(backTop.slice().reverse()).map(p=>p[0].toFixed(1)+','+p[1].toFixed(1)).join(' ')}" fill="${cBack}"${edge}/>`;
      return;
    }
    const top=s.z+s.h;let cT,cL,cR;
    if(s.k==='store'){
      const F=S.stFace,stick=S.stSurf==='sticker';
      const fr=stick&&(F==='all'||F==='front'||F==='front-left'||F==='front-right');
      const ri=stick&&(F==='all'||F==='right'||F==='front-right');
      cT=shade(s.col,1.24);cL=fr?shade(a.acc,.96):shade(s.col,.94);cR=ri?shade(a.acc,.70):shade(s.col,.67);
      if(s.doorSide)cT=shade(s.col,1.24);
    }else{cT=shade(s.col,1.24);cL=shade(s.col,.94);cR=shade(s.col,.67);}
    const op=s.ghost?' opacity=".24"':'';
    const E=` stroke="rgba(0,0,0,.3)" stroke-width=".7"${op}`;
    if(s.k!=='store')g+=`<polygon points="${pp([[s.x,s.y,top],[s.x+s.w,s.y,top],[s.x+s.w,s.y+s.d,top],[s.x,s.y+s.d,top]])}" fill="${cT}"${E}/>`;
    g+=`<polygon points="${pp([[s.x,s.y+s.d,s.z],[s.x+s.w,s.y+s.d,s.z],[s.x+s.w,s.y+s.d,top],[s.x,s.y+s.d,top]])}" fill="${cL}"${E}/>`;
    g+=`<polygon points="${pp([[s.x+s.w,s.y,s.z],[s.x+s.w,s.y+s.d,s.z],[s.x+s.w,s.y+s.d,top],[s.x+s.w,s.y,top]])}" fill="${cR}"${E}/>`;
  });

  /* ---- ชุดโลโก้ + ชื่อแบรนด์ วางบนผนัง ---- */
  const txtAll=(S.brand||'YOUR BRAND').toUpperCase();
  /* สีตัวอักษร/โลโก้ ปรับตามผิวที่ไปเกาะ */
  const nameColOn=bg=>(lum(bg)>.62&&Math.abs(lum(bg)-lum(a.acc))>.18)?a.acc:inkOn(bg);
  const storeFrontBg = (function(){
    if(!hasStore())return a.wall;
    const F=S.stFace,stick=S.stSurf==='sticker';
    const fr=stick&&(F==='all'||F==='front'||F==='front-left'||F==='front-right');
    return fr? a.acc : stPaintColor(a);})();
  const anchorFor=(align,bw,fw)=>{const m=fw*.05;
    return align==='left'? m+bw/2 : align==='right'? fw-m-bw/2 : fw/2;};
  function lockup(M,fw,fh,layout,align,vTop,bg,filtId){
    /* align = ตำแหน่งของทั้งชุดบนผนัง: left | center | right */
    const wallInk=inkOn(bg), nameCol=nameColOn(bg), FID=filtId||'silh';
    const AR=S.logo?S.logoAR:2.2;
    let out=`<g transform="${M}">`;
    const logoScale=logoScaleFactor(S.logoScale,fw);
    const drawLogo=(x,y,w,h)=>{
      if(logoScale<=0)return'';
      const sw=w,sh=h,sx=x,sy=y;
      const padX=sw*.10,padY=sh*.16;
      let o='';
      if(S.logoShape==='panel'&&S.logoType==='light'){
        o+=`<rect x="${(sx-padX*1.9).toFixed(2)}" y="${sy.toFixed(2)}" width="${(sw+padX*3.8).toFixed(2)}"
          height="${(sh+padY*1.9).toFixed(2)}" rx="${(sh*.14).toFixed(3)}" fill="#ffe9a8" opacity=".22"/>`;
        o+=`<rect x="${(sx-padX).toFixed(2)}" y="${sy.toFixed(2)}" width="${(sw+padX*2).toFixed(2)}"
          height="${(sh+padY).toFixed(2)}" rx="${(sh*.10).toFixed(3)}" fill="#fff9e8" opacity=".97"/>`;
      }else if(S.logoShape==='panel'&&S.logoType==='sticker'){
        o+=`<rect x="${(sx-padX).toFixed(2)}" y="${sy.toFixed(2)}" width="${(sw+padX*2).toFixed(2)}"
          height="${(sh+padY).toFixed(2)}" rx="${(sh*.09).toFixed(3)}" fill="${wallInk==='#ffffff'?'#ffffff':'#1a1a1a'}" opacity=".9"/>`;}
      if(S.logo){
        const f=S.logoType==='diecut'?` filter="url(#${FID})"`:'';
        o+=`<image href="${S.logo}" x="${sx.toFixed(2)}" y="${sy.toFixed(2)}" width="${sw.toFixed(2)}"
          height="${sh.toFixed(2)}" preserveAspectRatio="xMidYMid meet"${f}/>`;
      }else{
        o+=`<rect x="${sx.toFixed(2)}" y="${sy.toFixed(2)}" width="${sw.toFixed(2)}" height="${sh.toFixed(2)}"
          rx="${(sh*.1).toFixed(3)}" fill="none" stroke="${wallInk}" stroke-width="${(sh*.04).toFixed(3)}"
          stroke-dasharray="${(sh*.13).toFixed(3)} ${(sh*.09).toFixed(3)}" opacity=".45"/>`;
        o+=`<text x="${(sx+sw/2).toFixed(2)}" y="${(sy+sh*.62).toFixed(2)}" font-size="${(sh*.3).toFixed(3)}"
          fill="${wallInk}" text-anchor="middle" font-family="Inter,sans-serif" opacity=".4">LOGO</text>`;}
      return o;};
    const drawName=(x,y,fs,anchor)=>`<text x="${x.toFixed(2)}" y="${y.toFixed(2)}" font-size="${fs.toFixed(3)}"
      fill="${nameCol}" text-anchor="${anchor}" font-family="Inter,sans-serif" font-weight="700"
      letter-spacing="${(fs*.05).toFixed(3)}" opacity=".95">${esc(txtAll)}</text>`;

    const showLogo=logoScale>0,showName=S.nameScale>0;
    const NS=nameScaleFactor(S.nameScale,fw);
    const uw=Math.max(.2,unitTextW(txtAll));
    if(!showLogo&&showName){             /* โลโก้ = 0 → จัดชื่อให้อยู่กึ่งกลางพื้นที่ป้าย */
      const fs=Math.min(fh*.28,(fw*.9)/uw)*NS,tw=fs*uw,anchor=anchorFor(align,tw,fw);
      out+=drawName(anchor,vTop+fs,fs,'middle');
    }else if(!showName){                 /* ชื่อ = 0 → โชว์เฉพาะโลโก้ */
      let lw=fw*.9,lh=lw/AR; const maxH=fh*.9;
      if(lh>maxH){lh=maxH;lw=lh*AR;}
      const sw=lw*logoScale,sh=lh*logoScale,anchor=anchorFor(align,sw,fw);
      out+=drawLogo(anchor-sw/2,vTop,sw,sh);
    }else if(layout==='stack'){
      let lw=fw*.9,lh=lw/AR; const maxH=fh*.55;
      if(lh>maxH){lh=maxH;lw=lh*AR;}
      const fs=Math.min(fh*.18,(fw*.9)/uw)*NS;
      const tw=fs*uw;
      const sw=lw*logoScale,sh=lh*logoScale,bw=Math.max(sw,tw), anchor=anchorFor(align,bw,fw);
      out+=drawLogo(anchor-sw/2,vTop,sw,sh);
      out+=drawName(anchor,vTop+sh+Math.max(fs*1.05,sh*.26),fs,'middle');
    }else{
      let lh=fh*.45,lw=lh*AR; const maxW=fw*.43;
      if(lw>maxW){lw=maxW;lh=lw/AR;}
      const gap=fw*.03;
      let fs=Math.min(fh*.2,(fw*.43)/uw)*NS,tw=fs*uw,logoW=lw*logoScale,total=logoW+gap+tw;
      if(total>fw*.9){const fit=(fw*.9-gap)/Math.max(.001,logoW+tw);logoW*=fit;tw*=fit;fs*=fit;}
      const bw=logoW+gap+tw, anchor=anchorFor(align,bw,fw), u0=anchor-bw/2;
      const cy=vTop+lh/2;
      if(layout==='logoLeft'){
        const logoH=lw?lh*(logoW/lw):0;
        out+=drawLogo(u0,vTop,logoW,logoH);
        out+=drawName(u0+logoW+gap,cy+fs*.36,fs,'start');
      }else{
        out+=drawName(u0,cy+fs*.36,fs,'start');
        const logoH=lw?lh*(logoW/lw):0;
        out+=drawLogo(u0+tw+gap,vTop,logoW,logoH);
      }
    }
    return out+'</g>';
  }

  const onStore=lockOnStore();
  const stG=hasStore()?storeGeom(t):null;
  if(S.type!=='island'&&S.logoMount==='wall'&&onStore&&stG){
    /* ผนังห้องเก็บของทำหน้าที่เป็นผนังบูธ */
    const o=P(stG.x,stG.y+stG.d,z0+stG.h);
    const M=`matrix(${(C30*sc).toFixed(3)},${(S30*sc).toFixed(3)},0,${sc.toFixed(3)},${o[0].toFixed(2)},${o[1].toFixed(2)})`;
    g+=lockup(M,stG.w,stG.h,S.lockup,S.logoPos,BRAND_TOP_GAP_M,storeFrontBg,'silh2');
  }else if(S.type!=='island'&&S.logoMount==='wall'&&wl.indexOf('back')>=0){
    const BS=backFreeSpan(t),point=curve?curve.pointAt(0,t/2+.012):{x:BS.s,z:t};
    const o=P(curve?point.x:BS.s,curve?point.z:t,H);
    const M=`matrix(${(C30*sc).toFixed(3)},${(S30*sc).toFixed(3)},0,${sc.toFixed(3)},${o[0].toFixed(2)},${o[1].toFixed(2)})`;
    g+=lockup(M,curve?W:BS.e-BS.s,H,S.lockup,S.logoPos,BRAND_TOP_GAP_M,backWallColor,'silh');
  }
  if(S.type!=='island'&&S.logoMount==='floor'){
    const floorBrandWidth=Math.max(logoPhysicalWidth(S),logoBaseSize(S).width),rad=S.logoFloorRotation*Math.PI/180,dx=Math.cos(rad)*floorBrandWidth/2,dz=-Math.sin(rad)*floorBrandWidth/2,
      y0=z0+.10,y1=y0+logoPhysicalHeight(S),bl=P(S.logoFloorX-dx,S.logoFloorZ-dz,y0),br=P(S.logoFloorX+dx,S.logoFloorZ+dz,y0),
      tr=P(S.logoFloorX+dx,S.logoFloorZ+dz,y1),tl=P(S.logoFloorX-dx,S.logoFloorZ-dz,y1),center=P(S.logoFloorX,S.logoFloorZ,(y0+y1)/2);
    g+=`<polygon points="${[bl,br,tr,tl].map(point=>point[0].toFixed(1)+','+point[1].toFixed(1)).join(' ')}" fill="#f6f7f8" fill-opacity=".92"
      stroke="${a.acc}" stroke-width="2"/><text x="${center[0].toFixed(1)}" y="${(center[1]+3).toFixed(1)}" fill="${a.acc}" font-size="10"
      font-weight="700" text-anchor="middle" font-family="'Noto Sans Thai',sans-serif">โลโก้ไดคัท 3D</text>`;
  }

  /* ---- โลโก้บนผนังด้านข้าง (เฉพาะบูธมุม) ---- */
  const sideWall=cornerWallKey();
  if(S.type!=='island'&&S.logoMount==='wall'&&S.type==='corner'&&S.sideLogo&&wl.indexOf(sideWall)>=0){
    /* จุดเริ่มที่ปลายผนังฝั่งทางเดิน แล้ววิ่งเข้าหาผนังหลัง — กันตัวหนังสือกลับด้าน */
    const o=sideWall==='left'?P(t,D,H):P(W-t,D,H);
    const Cside=sideWall==='left'?C30:-C30,Sside=sideWall==='left'?-S30:S30;
    const M=`matrix(${(Cside*sc).toFixed(3)},${(Sside*sc).toFixed(3)},0,${sc.toFixed(3)},${o[0].toFixed(2)},${o[1].toFixed(2)})`;
    const fl=sideFreeLen(t);                     /* วัดจากช่วงที่เหลือ ไม่ใช่ผนังทั้งผืน */
    const sideLayout = fl>=4 ? S.lockup : 'stack';
    if(fl>=.8) g+=lockup(M,fl,H,sideLayout,S.sidePos==='center'?'center':'left',BRAND_TOP_GAP_M,wallFaceColor(S,sideWall,a),'silh');
  }

  const st=solids.find(x=>x.k==='store');
  if(st){
    const dh=Math.min(2.05,st.h*.86),ink2='rgba(0,0,0,.45)';
    if(S.stDoor==='front'){
      const dw=Math.min(.8,st.w*.62),o=P(st.x,st.y+st.d,st.z+st.h);
      const dx=doorAlong(st.w,dw);
      const M=`matrix(${(C30*sc).toFixed(3)},${(S30*sc).toFixed(3)},0,${sc.toFixed(3)},${o[0].toFixed(2)},${o[1].toFixed(2)})`;
      g+=`<g transform="${M}"><rect x="${dx.toFixed(2)}" y="${(st.h-dh).toFixed(2)}" width="${dw.toFixed(2)}"
        height="${dh.toFixed(2)}" rx=".04" fill="none" stroke="${ink2}" stroke-width=".035"/>
        <circle cx="${(dx+dw*.86).toFixed(2)}" cy="${(st.h-dh*.5).toFixed(2)}" r=".05" fill="${ink2}"/></g>`;
    }else if(S.stDoor==='right'){
      const dd=Math.min(.8,st.d*.62),o=P(st.x+st.w,st.y,st.z+st.h);
      const M=`matrix(${(-C30*sc).toFixed(3)},${(S30*sc).toFixed(3)},0,${sc.toFixed(3)},${o[0].toFixed(2)},${o[1].toFixed(2)})`;
      const du=doorAlong(st.d,dd);
      g+=`<g transform="${M}"><rect x="${du.toFixed(2)}" y="${(st.h-dh).toFixed(2)}" width="${dd.toFixed(2)}"
        height="${dh.toFixed(2)}" rx=".04" fill="none" stroke="${ink2}" stroke-width=".035"/>
        <circle cx="${(du+dd*.86).toFixed(2)}" cy="${(st.h-dh*.5).toFixed(2)}" r=".05" fill="${ink2}"/></g>`;}
  }

  /* ---- ลำแสงจากสปอตไลท์ ---- */
  if(S.lights&&LP.length){
    const LCOL=LIGHTCOL.find(c=>c.k===S.lightCol).c;
    LP.forEach(L=>{
      let q;
      if(L.w==='back')      q=[[L.u-.09,t+.18,H],[L.u+.09,t+.18,H],[L.u+.6,t+1.5,z0],[L.u-.6,t+1.5,z0]];
      else if(L.w==='left') q=[[t+.18,L.u-.09,H],[t+.18,L.u+.09,H],[t+1.5,L.u+.6,z0],[t+1.5,L.u-.6,z0]];
      else                  q=[[W-t-.18,L.u-.09,H],[W-t-.18,L.u+.09,H],[W-t-1.5,L.u+.6,z0],[W-t-1.5,L.u-.6,z0]];
      g+=`<polygon points="${pp(q)}" fill="${LCOL}" opacity=".062" filter="url(#sf)"/>`;
      const hd = L.w==='back'? P(L.u,t+.19,H+.03)
               : L.w==='left'? P(t+.19,L.u,H+.03)
               : P(W-t-.19,L.u,H+.03);
      g+=`<circle cx="${hd[0].toFixed(1)}" cy="${hd[1].toFixed(1)}" r="${(sc*.055).toFixed(1)}"
           fill="${LCOL}" opacity=".9"/>`;
      g+=`<circle cx="${hd[0].toFixed(1)}" cy="${hd[1].toFixed(1)}" r="${(sc*.14).toFixed(1)}"
           fill="${LCOL}" opacity=".22" filter="url(#sf)"/>`;
    });
  }

  const d1=P(0,D,0),d2=P(W,D,0),e1=P(W,D,0),e2=P(W,0,0);
  const L=(A,B,dx,dy)=>`<line x1="${(A[0]+dx).toFixed(1)}" y1="${(A[1]+dy).toFixed(1)}"
    x2="${(B[0]+dx).toFixed(1)}" y2="${(B[1]+dy).toFixed(1)}" stroke="#4c535e" stroke-width="1.2"/>`;
  g+=L(d1,d2,-6,34)+L(e1,e2,34,20);
  g+=`<text x="${((d1[0]+d2[0])/2-8).toFixed(0)}" y="${((d1[1]+d2[1])/2+52).toFixed(0)}" fill="#8a919c"
    font-size="14" text-anchor="middle" font-family="Inter,sans-serif">กว้าง ${W} m</text>`;
  g+=`<text x="${((e1[0]+e2[0])/2+62).toFixed(0)}" y="${((e1[1]+e2[1])/2+30).toFixed(0)}" fill="#8a919c"
    font-size="14" text-anchor="middle" font-family="Inter,sans-serif">ลึก ${D} m</text>`;
  g+=`<rect x="22" y="18" rx="7" width="280" height="27" fill="#000" opacity=".4"/>
    <text x="34" y="36" fill="#7d858f" font-size="12" font-family="Inter,sans-serif">ภาพจำลอง · ${typ().n} · ${esc(pair().n)}</text>`;
  return `<svg viewBox="0 0 ${VW} ${VH}" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">${g}</svg>`;
}

/* ================= แผนภาพกำกับด้าน ================= */
function dimDiagram(){
  const w=280,h=96,bx=92,by=20,bw=110,bh=52;
  return `<svg viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg">
   <rect x="${bx}" y="${by}" width="${bw}" height="${bh}" fill="#1b1e25" stroke="#3a414c" stroke-width="1"/>
   <rect x="${bx}" y="${by}" width="${bw}" height="5" fill="#f72585"/>
   <line x1="${bx}" y1="${by+bh}" x2="${bx+bw}" y2="${by+bh}" stroke="#f72585" stroke-width="2" stroke-dasharray="4 3"/>
   <text x="${bx+bw/2}" y="${by+bh+15}" font-size="9" fill="#f72585" text-anchor="middle"
     font-family="'Noto Sans Thai',sans-serif">ทางเดิน</text>
   <line x1="${bx}" y1="${by-8}" x2="${bx+bw}" y2="${by-8}" stroke="#8a919c" stroke-width="1"/>
   <text x="${bx+bw/2}" y="${by-11}" font-size="9" fill="#c8cdd4" text-anchor="middle"
     font-family="'Noto Sans Thai',sans-serif">กว้าง</text>
   <line x1="${bx+bw+8}" y1="${by}" x2="${bx+bw+8}" y2="${by+bh}" stroke="#8a919c" stroke-width="1"/>
   <text x="${bx+bw+26}" y="${by+bh/2+3}" font-size="9" fill="#c8cdd4" text-anchor="middle"
     font-family="'Noto Sans Thai',sans-serif">ลึก</text>
   <text x="${bx-8}" y="${by+10}" font-size="9" fill="#6b7280" text-anchor="end"
     font-family="'Noto Sans Thai',sans-serif">ผนังหลัง</text></svg>`;
}

/* ================= render ================= */
function render(){
  const v=document.getElementById('view');
  if(S.view==='three'){renderThreeView(v);return;}
  if(threeRenderer)threeRenderer.unmount(v);else v.classList.remove('three-active');
  if(S.view==='plan'){v.innerHTML=planSVG();bindPlanObjectInteractions(v);}
  else{
    v.innerHTML=S.photo
      ?`<div class="photoslot" style="border-style:solid;border-color:var(--line)">
          <img src="${S.photo}"><div style="color:var(--tx2)">รูปงานจริงที่แนบไว้ · กดเพื่อเปลี่ยน</div></div>`
      :`<div class="photoslot"><div style="font-size:30px">🖼️</div>
          <div><b style="color:var(--tx2)">ช่องใส่รูปงานจริงของ 78Studio</b><br>
          หน้าจอจริงจะแสดงรูปบูธที่เคยทำในลักษณะเดียวกัน<br>ซึ่งน่าเชื่อถือกว่าภาพเรนเดอร์มาก</div>
          <button class="btn sm">ลองแนบรูปดู</button></div>`;
    v.querySelector('.photoslot').onclick=()=>fp.click();}
}

function syncLightModelStatus(){
  const box=document.getElementById('lightModelStatus');if(!box)return;
  if(!S.lights){box.textContent='';box.dataset.state='idle';return;}
  const model=lightModelDef(),state=threeRenderer&&threeRenderer.fixtureState?threeRenderer.fixtureState(model.k):'idle';
  const wattLabel=lightWattDef().n+' / จุด';
  box.dataset.state=state;
  box.textContent=state==='ready'?'โหลดโมเดล 3D แล้ว · ระบบคิด '+wattLabel:
    state==='loading'?'กำลังโหลดโมเดล '+model.n+'…':
    state==='error'?'โหลดโมเดลไม่สำเร็จ · ใช้โคมสำรองและยังคิด '+wattLabel:
    'โมเดลจะโหลดเมื่อเปิดมุมมอง 3D · ระบบคิด '+wattLabel;
}

function sync(){
  normalizeAIRenderingSettings(S);
  if(isFixedBoothType(S.type)){S.W=6;S.D=3;S.H=2.4;}
  S.W=Math.max(1,Math.min(30,S.W||1));S.D=Math.max(1,Math.min(30,S.D||1));
  S.H=Math.max(2.4,Math.min(MAX_BOOTH_HEIGHT,S.H||2.4));
  if(S.type==='photo360')S.wallRadius=Math.max(wallCurveMinRadius(S),Math.min(100,Number(S.wallRadius)||PHOTO360_DEFAULT_RADIUS));
  if(!typ().walls.length)S.lights=false;
  if(!LOGOSHAPES.some(shape=>shape.k===S.logoShape))S.logoShape='cutout';
  if(!/^#[0-9a-fA-F]{6}$/.test(String(S.logoBaseColor||'')))S.logoBaseColor='#20252d';
  if(!/^#[0-9a-fA-F]{6}$/.test(String(S.logoColor||'')))S.logoColor=S.primary||'#2e7d4f';
  normalizeLogoPlacement(S);
  S.logoScale=Math.max(0,Math.min(BRAND_SCALE_MAX,Number.isFinite(Number(S.logoScale))?Math.round(Number(S.logoScale)):BRAND_SCALE_DEFAULT));
  S.nameScale=Math.max(0,Math.min(BRAND_SCALE_MAX,Number.isFinite(Number(S.nameScale))?Math.round(Number(S.nameScale)):BRAND_SCALE_DEFAULT));
  if(typeof S.floorStickerLock!=='boolean')S.floorStickerLock=true;
  S.floorStickerRotation=((Math.round((Number(S.floorStickerRotation)||0)/90)*90)%360+360)%360;
  if(!STICKER_MODES.some(item=>item.k===S.floorStickerMode))S.floorStickerMode='single';
  S.floorStickerPatternSize=clampNumber(Number(S.floorStickerPatternSize)||1.2,.1,Math.max(S.W,S.D)*2);
  S.floorStickerOffsetX=clampNumber(Number(S.floorStickerOffsetX)||0,-S.W/2,S.W/2);
  S.floorStickerOffsetY=clampNumber(Number(S.floorStickerOffsetY)||0,-S.D/2,S.D/2);
  normalizeFloorStickerSize(S);
  S.stagingFreedom=promptFidelityValue(S.stagingFreedom);S.promptFidelity=S.stagingFreedom;
  if(typeof S.placementSnap!=='boolean')S.placementSnap=true;
  if(typeof S.magneticSnap!=='boolean')S.magneticSnap=true;
  if(!Array.isArray(S.objects))S.objects=[];
  if(!S.sceneItemState||typeof S.sceneItemState!=='object'||Array.isArray(S.sceneItemState))S.sceneItemState={};
  S.objects.forEach(object=>{normalizeObjectAIRule(object);if(isEntranceFrameObject(object))normalizeEntranceFrameObject(object,S);if(isDownlightBeamObject(object))normalizeDownlightBeamObject(object,S);normalizeSceneObjectModel(object);});
  resolveSceneAttachments(S);
  if(!Array.isArray(S.wallStickerFaces))S.wallStickerFaces=[];
  S.wallStickerFaces=S.wallStickerFaces.filter(face=>WALL_FACES.some(item=>item.k===face));
  WALL_FACES.forEach(({k})=>{const sticker=wallStickerFor(k);
    if(typeof sticker.lock!=='boolean')sticker.lock=true;
    sticker.rotation=((Math.round((Number(sticker.rotation)||0)/90)*90)%360+360)%360;
    if(!STICKER_MODES.some(item=>item.k===sticker.mode))sticker.mode='cover';
    sticker.patternSize=clampNumber(Number(sticker.patternSize)||1.2,.1,Math.max(wallFaceLength(S,k),S.H)*2);
    sticker.offsetX=clampNumber(Number(sticker.offsetX)||0,-wallFaceLength(S,k)/2,wallFaceLength(S,k)/2);
    sticker.offsetY=clampNumber(Number(sticker.offsetY)||0,-S.H/2,S.H/2);
    normalizeWallStickerSize(k);});
  if(S.wallMat==='sticker'){
    S.wallStickerFaces=[...new Set([...S.wallStickerFaces,...typ().walls])];S.wallMat='paint';
  }else S.wallMat='paint';
  if(!LIGHT_MODELS.some(model=>model.k===S.lightFixture))S.lightFixture=LIGHT_MODELS[0].k;
  if(!ST_DOOR_TYPE.some(type=>type.k===S.stDoorType))S.stDoorType='swing';
  S.lightWatts=lightDefaultWatts(S.lightFixture);
  if(S.stHmode===0)S.stHv=Math.max(1.5,Math.min(MAX_BOOTH_HEIGHT,S.stHv||2.4));
  reconcileCatalogLayout();
  resolveSceneAttachments(S);
  const retainedSelection=selectedSceneItemIds().filter(sceneItemExists);setObjectSelection(retainedSelection,sceneItemExists(objectEditor.selectedId)?objectEditor.selectedId:(retainedSelection.at(-1)||null));
  syncObjectControls();

  document.querySelectorAll('#oCat .cat').forEach(b=>b.classList.toggle('on',b.dataset.k===S.cat));
  document.querySelectorAll('#oCI .sw1').forEach(b=>b.classList.toggle('on',b.dataset.c.toLowerCase()===S.primary.toLowerCase()));
  document.getElementById('cPick').value=S.primary;
  const hxi=document.getElementById('cHex');if(document.activeElement!==hxi)hxi.value=S.primary.toUpperCase();
  document.getElementById('swMain').style.background=S.primary;
  const sug=suggestedSec();
  if(!S.secTouched)S.secondary=sug;
  document.getElementById('cPick2').value=S.secondary;
  const hx2=document.getElementById('cHex2');if(document.activeElement!==hx2)hx2.value=S.secondary.toUpperCase();
  document.getElementById('swSec').style.background=S.secondary;
  document.getElementById('secAuto').textContent=S.secTouched?'· คุณกำหนดเอง':'· ระบบแนะนำให้';
  document.querySelectorAll('#oWallCol .opt').forEach(b=>b.classList.toggle('on',b.dataset.k===S.wallCol));
  document.querySelectorAll('#oWallFaceFinish .wall-face-row').forEach(row=>{
    const face=row.dataset.face,active=typ().walls.includes(face),sticker=wallFinishKind(S,face)==='sticker';row.hidden=!active;
    row.querySelectorAll('.opt').forEach(button=>{const selected=(button.dataset.k==='sticker')===sticker;
      button.classList.toggle('on',selected);button.setAttribute('aria-pressed',String(selected));});});
  buildWallStickerSettings();
  document.querySelectorAll('#oPair .th').forEach(b=>{
    const t=PAIRS.find(x=>x.k===b.dataset.k),p=S.primary;
    b.innerHTML='<div class="sw"><i style="background:'+p+'"></i><i style="background:'+t.sec(p)+
      '"></i><i style="background:'+t.base(p)+'"></i></div><b>'+t.n+'</b><span>'+t.s+'</span>';
    b.classList.toggle('on',b.dataset.k===S.pair);
    if(b.dataset.k===cat().pr)b.appendChild(el('span','rec','แนะนำ'));});

  document.querySelectorAll('#oPreset .opt').forEach(b=>b.classList.toggle('on',b.dataset.k===S.W+'x'+S.D));
  document.querySelectorAll('#oHeight .opt').forEach(b=>b.classList.toggle('on',+b.dataset.k===S.H));
  document.getElementById('dW').dataset.resetDefault='6';
  document.getElementById('dD').dataset.resetDefault=S.type==='island'?'6':'3';
  document.getElementById('dH').dataset.resetDefault='2.4';
  document.getElementById('dH').value=S.H;
  document.getElementById('areaTxt').textContent=(S.W*S.D).toFixed(1)+' ตร.ม.';
  document.getElementById('areaHint').textContent=
    isFixedBoothType(S.type)?'ขนาดมาตรฐานของรูปแบบนี้ · แก้ไขไม่ได้':((S.W*S.D)>=54?'บูธใหญ่ — พื้นที่กลางบูธเว้นไว้วางสินค้าได้':'');
  document.getElementById('dimDiagram').innerHTML=dimDiagram();

  document.querySelectorAll('#oType .opt').forEach(b=>b.classList.toggle('on',b.dataset.k===S.type));
  const cornerActive=S.type==='corner',cornerWrap=document.getElementById('cornerSideWrap');
  cornerWrap.hidden=!cornerActive;
  if(cornerActive)document.querySelectorAll('#oCornerSide .opt').forEach(b=>b.classList.toggle('on',b.dataset.k===S.cornerSide));
  const fixedType=isFixedBoothType(S.type);
  ['dW','dD','dH'].forEach(id=>{const input=document.getElementById(id);if(input)input.disabled=fixedType;});
  document.querySelectorAll('#oPreset .opt,#oHeight .opt').forEach(button=>button.disabled=fixedType);
  const curveWrap=document.getElementById('photo360CurveWrap'),curveRange=document.getElementById('photo360RadiusRange'),curveInput=document.getElementById('photo360Radius'),curveNote=document.getElementById('photo360CurveNote'),
    curveMobileRange=document.getElementById('photo360RadiusMobileRange'),curveMobileInput=document.getElementById('photo360RadiusMobileInput'),curveMobileValue=document.getElementById('photo360RadiusMobileValue'),
    curveMobileSummary=document.getElementById('photo360RadiusMobileSummary'),curveMobileNote=document.getElementById('photo360RadiusMobileNote');
  if(curveWrap)curveWrap.hidden=S.type!=='photo360';
  if(S.type==='photo360'){
    const minRadius=wallCurveMinRadius(S).toFixed(2),radius=Number(S.wallRadius).toFixed(2);
    if(curveRange){curveRange.min=minRadius;curveRange.value=radius;}
    if(curveInput){curveInput.min=minRadius;curveInput.value=radius;}
    if(curveMobileRange){curveMobileRange.min=minRadius;curveMobileRange.value=radius;}
    if(curveMobileInput){curveMobileInput.min=minRadius;curveMobileInput.value=radius;}
    if(curveMobileValue)curveMobileValue.textContent=radius;
    if(curveMobileSummary)curveMobileSummary.textContent=radius+' ม.';
  }
  if(curveNote&&S.type==='photo360'){const curve=wallCurveInfo(S),note='โค้งเว้าเข้าหาพื้นที่ถ่ายภาพ · R ต่ำสุด '+wallCurveMinRadius(S).toFixed(2)+' ม. · ความลึกโค้ง '+curve.sagitta.toFixed(2)+' ม. · แนวโค้งยาว '+curve.arcLength.toFixed(2)+' ม.';curveNote.textContent=note;if(curveMobileNote)curveMobileNote.textContent=note;}
  if(S.type!=='photo360'&&document.getElementById('mPhoto360Radius')?.classList.contains('show'))closePhoto360RadiusModal(false);
  document.getElementById('typeNote').textContent=typ().note;

  document.querySelectorAll('#oStSize .opt').forEach(b=>b.classList.toggle('on',b.dataset.k===S.stSize));
  const needDims=(S.stSize==='custom'||S.stSize==='full');
  document.getElementById('stCustom').style.display=needDims?'flex':'none';
  document.getElementById('stWf').style.display=S.stSize==='custom'?'block':'none';
  document.getElementById('stBody').style.display=hasStore()?'block':'none';
  if(hasStore()){
    if(!S.doorTouched){const ad=autoDoorFor(); if(ad!==S.stDoor)S.stDoor=ad;}
    document.querySelectorAll('#oStH .opt').forEach(b=>{
      b.classList.toggle('on',+b.dataset.k===S.stHmode);
      if(b.dataset.k==='2.4'){const cap=maxStH();
        b.innerHTML= cap<2.4 ? cap.toFixed(2)+' ม.<small>สูงสุดของบูธนี้</small>' : '2.4 ม.<small>ค่าเริ่มต้น</small>';}});
    document.getElementById('stHCustom').style.display=S.stHmode===0?'flex':'none';
    const stHeightInput=document.getElementById('stHv');stHeightInput.max=Math.max(1.5,maxStH()).toFixed(2);
    if(document.activeElement!==stHeightInput)stHeightInput.value=S.stHv;
    document.querySelectorAll('#oStPos .opt').forEach(b=>b.classList.toggle('on',b.dataset.k===S.stPos));
    document.querySelectorAll('#oStDoor .opt').forEach(b=>{
      const blocked=doorBlocked(b.dataset.k,boothWallThickness(S));
      b.classList.toggle('off',blocked);
      b.classList.toggle('on',!blocked&&b.dataset.k===S.stDoor);});
    document.querySelectorAll('#oStDoorType .opt').forEach(b=>b.classList.toggle('on',b.dataset.k===S.stDoorType));
    const sideFace=(S.stDoor!=='front');
    const offLbl=sideFace?['ชิดมุมใน','กึ่งกลาง','ชิดทางเดิน']:['ชิดซ้าย','กึ่งกลาง','ชิดขวา'];
    document.querySelectorAll('#oDoorOff .opt').forEach((b,i)=>{
      b.textContent=offLbl[i];
      b.classList.toggle('on',b.dataset.k===S.doorOff);});
    document.querySelectorAll('#oStSurf .opt').forEach(b=>b.classList.toggle('on',b.dataset.k===S.stSurf));
    document.querySelectorAll('#oStFace .opt').forEach(b=>b.classList.toggle('on',b.dataset.k===S.stFace));
    document.getElementById('oStFaceWrap').style.display=S.stSurf==='sticker'?'block':'none';
    document.getElementById('stPaintWrap').style.display=S.stSurf==='paint'?'block':'none';
    document.querySelectorAll('#oStPaint .opt').forEach(b=>b.classList.toggle('on',b.dataset.k===S.stPaint));
    const g=storeGeom(boothWallThickness(S)),dm=stDims(),want=S.stHmode===0?S.stHv:S.stHmode;
    let n='ด้านที่ชิดผนังบูธ ระบบใช้ผนังบูธเป็นผนังห้องให้เลย';
    const share=(g.w*g.d)/(S.W*S.D);
    if(share>=.55)
      n='ห้องกินพื้นที่ '+Math.round(share*100)+'% ของบูธ — เหลือพื้นที่ใช้งานน้อย ลองลดขนาดห้องดู';
    else
    if(g.h<want-.005 && S.raise>0)
      n='ความสูงห้องถูกลดเป็น '+g.h.toFixed(2)+' ม. เพราะบูธยกพื้น '+S.raise+' ซม. — ยอดห้องจะเสมอกับยอดผนังพอดี';
    else if(S.stDoor==='front'&&!S.doorTouched)
      n='ห้องชิดผนังทั้งสองข้าง เปิดประตูด้านข้างไม่ได้ ระบบจึงย้ายประตูมาไว้ด้านหน้า';
    else if(lockOnStore())n='ห้องกว้างเกินครึ่งผนัง — ระบบย้ายชุดโลโก้และชื่อมาไว้หน้าห้องเก็บของให้อัตโนมัติ';
    else if(g.h<want-.01)n='ความสูงห้องถูกลดลงเท่าความสูงบูธ ('+S.H+' ม.)';
    else if(S.stDoor==='left')n='ประตูซ้ายมองไม่เห็นจากมุมนี้ — ดูตำแหน่งได้ชัดในแท็บผังพื้น';
    else if(!S.doorTouched)n='ระบบเลือกด้านประตูให้หันเข้าในบูธอัตโนมัติ — เปลี่ยนเองได้';
    document.getElementById('stNote').textContent=n;}

  const hasLightWall=typ().walls.length>0;
  document.querySelectorAll('#oLights .opt').forEach(b=>{
    const unavailable=b.dataset.k==='on'&&!hasLightWall;
    b.disabled=unavailable;b.classList.toggle('off',unavailable);
    b.classList.toggle('on',(b.dataset.k==='on')===S.lights);
  });
  document.getElementById('lightBody').style.display=S.lights?'block':'none';
  if(S.lights){
    document.querySelectorAll('#oLightModel .light-model-card').forEach(b=>{const active=b.dataset.k===S.lightFixture;
      b.classList.toggle('on',active);b.setAttribute('aria-pressed',String(active));});
    document.querySelectorAll('#oLightCol .opt').forEach(b=>b.classList.toggle('on',b.dataset.k===S.lightCol));
    document.querySelectorAll('#oLightWatts .opt').forEach(b=>b.classList.toggle('on',+b.dataset.k===S.lightWatts));
    document.querySelectorAll('#oLightWall .opt').forEach(b=>b.classList.toggle('on',b.dataset.k===S.lightWall));
    const wattStandard=document.getElementById('lightWattStandard');
    if(wattStandard)wattStandard.textContent=lightWattDef().n+' / จุด';
    const spacing=lightSpacing(),LC=lightCounts(boothWallThickness(S)),auto=LC.autoTotal;
    document.getElementById('lcount').textContent=LC.total;
    const spacingLabel=lightModelDef()?.spacingRule==='min'?'ระยะขั้นต่ำ ':'ระยะมาตรฐาน ';
    let ln=spacingLabel+spacing.toFixed(1)+' ม./จุด · ระบบคำนวณให้ '+auto+' จุด · '+lightTotalWatts()+'W รวม';
    if(lightBlocker(boothWallThickness(S)))ln+=' · หักช่วงผนังที่ห้องสูงตั้งแต่ 70% บังแล้ว';
    else if(hasStore())ln+=' · ห้องสูงไม่ถึง 70% จึงใช้ระยะผนังเดิม';
    if(S.lightAdj)ln+=' · คุณปรับเป็น '+LC.total+' จุด';
    document.getElementById('lightNote').textContent=ln;}
  syncLightModelStatus();
  document.querySelectorAll('#oRaise .opt').forEach(b=>b.classList.toggle('on',+b.dataset.k===S.raise));
  document.querySelectorAll('#oFloor .opt').forEach(b=>b.classList.toggle('on',b.dataset.k===S.floor));
  buildFloorSub();
  document.getElementById('raiseNote').textContent=S.raise===1
    ?'ยกพื้นบาง 1 ซม. สำหรับปรับระดับและเก็บขอบพื้น ไม่เหมาะสำหรับซ่อนงานระบบ · แนะนำสำหรับปูไม้รองพื้นก่อนปูพรม สำหรับพื้นที่ที่จัดการยาก เช่น ปูพรมทับพรม หรือปูพรมบนพื้นไม่เรียบ'
    :(S.raise>0?'ยกพื้นช่วยซ่อนสายไฟและทำให้บูธดูเป็นระเบียบขึ้น':'ประหยัดที่สุด ใช้พื้นของฮอลล์ตามเดิม');

  const islandBrandDisabled=S.type==='island',brandSettings=document.getElementById('settingsBrand'),islandBrandNote=document.getElementById('islandBrandNote');
  if(brandSettings)brandSettings.classList.toggle('island-brand-disabled',islandBrandDisabled);
  if(islandBrandNote)islandBrandNote.hidden=!islandBrandDisabled;
  document.getElementById('logoType').value=S.logoType;
  document.getElementById('logoTypeNote').textContent=LOGOTYPES.find(t=>t.k===S.logoType).s;
  document.querySelectorAll('#oLogoShape .opt').forEach(button=>button.classList.toggle('on',button.dataset.k===S.logoShape));
  document.getElementById('logoShapeNote').textContent=S.logoShape==='cutout'
    ?(S.logo&&S.logoHasTransparency===false
      ?'ไฟล์โลโก้นี้ไม่มีพื้นโปร่งใส จึงยังเห็นเป็นกรอบสี่เหลี่ยม · กรุณาใช้ PNG พื้นหลังโปร่งใส หรือเลือกป้ายแผ่นสี่เหลี่ยม'
      :'ระบบใช้ความโปร่งใสของไฟล์เป็นแนวตัด และไม่สร้างพื้นหลังสี่เหลี่ยม · แนะนำไฟล์ PNG พื้นหลังโปร่งใส')
    :'ระบบสร้างแผ่นพื้นหลังเต็มกรอบ เหมาะกับป้ายบอร์ดหรือกล่องไฟทรงสี่เหลี่ยม';
  const hasLogoWall=logoActiveWalls(S).length>0;
  document.querySelectorAll('#oLogoMount .opt').forEach(b=>{
    const unavailable=b.dataset.k==='wall'&&!hasLogoWall;
    b.hidden=unavailable;b.disabled=unavailable;b.classList.toggle('on',!unavailable&&b.dataset.k===S.logoMount);
  });
  document.getElementById('logoWallControls').hidden=S.logoMount!=='wall';
  document.getElementById('logoFloorControls').hidden=S.logoMount!=='floor';
  const logoAdvancedDetails=document.getElementById('logoAdvancedDetails');logoAdvancedDetails.hidden=S.logoMount!=='floor';
  if(S.logoMount!=='floor')logoAdvancedDetails.open=false;
  document.getElementById('logoBasePick').value=S.logoBaseColor;
  const logoBaseHex=document.getElementById('logoBaseHex');if(document.activeElement!==logoBaseHex)logoBaseHex.value=S.logoBaseColor.toUpperCase();
  document.getElementById('logoColorPick').value=S.logoColor;
  const logoColorHex=document.getElementById('logoColorHex');if(document.activeElement!==logoColorHex)logoColorHex.value=S.logoColor.toUpperCase();
  const setLogoPair=(rangeId,inputId,value,min,max)=>{const range=document.getElementById(rangeId),input=document.getElementById(inputId);
    [range,input].forEach(control=>{control.min=Number(min).toFixed(2);control.max=Number(max).toFixed(2);control.value=Number(value).toFixed(2);});};
  const physicalBrand=brandPhysicalSize(S),logoHeight=physicalBrand.height,baseSize=logoBaseSize(S);
  setLogoPair('logoDepthRange','logoDepthInput',S.logoDepth,.01,.2);
  document.getElementById('logoBaseWidthInput').dataset.resetDefault=baseSize.defaultWidth.toFixed(2);
  document.getElementById('logoBaseDepthInput').dataset.resetDefault=baseSize.defaultDepth.toFixed(2);
  setLogoPair('logoBaseWidthRange','logoBaseWidthInput',baseSize.width,.1,baseSize.maxWidth);
  setLogoPair('logoBaseDepthRange','logoBaseDepthInput',baseSize.depth,.1,baseSize.maxDepth);
  document.querySelectorAll('#oLogoWall .opt').forEach(b=>{const active=logoActiveWalls(S).some(face=>face.k===b.dataset.k);
    b.hidden=!active;b.disabled=!active;b.classList.toggle('on',active&&b.dataset.k===S.logoWall);});
  document.querySelectorAll('#oLogoFloorRotation .opt').forEach(b=>b.classList.toggle('on',+b.dataset.k===S.logoFloorRotation));
  document.getElementById('logoPlacementNote').textContent=S.logoMount==='wall'
    ?'ป้ายกว้าง '+physicalBrand.width.toFixed(2)+' ม. × สูง '+logoHeight.toFixed(2)+' ม. × หนา '+S.logoDepth.toFixed(2)+' ม. · จุดกึ่งกลางตามแนวผนัง '+S.logoWallU.toFixed(2)+' ม. · สูงจากพื้น '+S.logoWallY.toFixed(2)+' ม. · Snap '+placementStepLabel()+' · คลิกหรือแตะโลโก้ในภาพแล้วลากเพื่อย้าย'
    :'ป้ายตั้งพื้นกว้าง '+physicalBrand.width.toFixed(2)+' ม. × สูง '+logoHeight.toFixed(2)+' ม. · ฐานกว้าง '+baseSize.width.toFixed(2)+' × ลึก '+baseSize.depth.toFixed(2)+' ม. · พิกัด X '+S.logoFloorX.toFixed(2)+' / Z '+S.logoFloorZ.toFixed(2)+' ม. · หมุน '+S.logoFloorRotation+'° · ยึดขอบล่างกับฐานอัตโนมัติ · Snap '+placementStepLabel()+' · คลิกหรือแตะโลโก้ในภาพแล้วลากเพื่อย้าย';
  const logoScaleRange=document.getElementById('lsRange');
  if(logoScaleRange){logoScaleRange.value=S.logoScale;document.getElementById('lsVal').value=S.logoScale;}
  const nameScaleRange=document.getElementById('nsRange');
  if(nameScaleRange){nameScaleRange.value=S.nameScale;document.getElementById('nsVal').value=S.nameScale;}
  updateScaleResetButtons();
  syncLogoLockupVisibility();
  document.querySelectorAll('#oLockup .opt').forEach(b=>b.classList.toggle('on',b.dataset.k===S.lockup));
  const isCorner=S.type==='corner';
  document.getElementById('sideOnly').textContent=isCorner?'':'— เฉพาะบูธหัวมุม (Corner)';
  const bs=document.getElementById('btnSide');
  const freeL=sideFreeLen(boothWallThickness(S)), sideOK=isCorner&&S.logoMount==='wall'&&S.logoWall==='back'&&freeL>=.8;
  document.getElementById('sideWrap').style.display=(isCorner&&S.logoMount==='wall'&&S.logoWall==='back')?'block':'none';
  bs.classList.toggle('off',!sideOK);
  bs.classList.toggle('on',sideOK&&S.sideLogo);
  bs.textContent=(sideOK&&S.sideLogo?'✓ ':'')+'เพิ่มชุดโลโก้และชื่อบนผนังด้านข้าง';
  if(isCorner&&!sideOK)document.getElementById('sideOnly').textContent='— ห้องเก็บของบังผนังข้างจนหมด';
  document.getElementById('sidePosWrap').style.display=(sideOK&&S.sideLogo)?'block':'none';
  if(isCorner&&S.sideLogo)
    document.querySelectorAll('#oSidePos .opt').forEach(b=>b.classList.toggle('on',b.dataset.k===S.sidePos));

  const a=palette();
  document.getElementById('sw1').style.background=a.acc;
  document.getElementById('sw2').style.background=a.sec;
  document.getElementById('pairName').textContent='ผนัง'+wallFinishSummary();
  document.getElementById('tagSize').textContent='กว้าง '+S.W+' × ลึก '+S.D+' × สูง '+S.H+' ม. · '+(S.W*S.D).toFixed(1)+' ตร.ม.';
  document.getElementById('tagType').textContent=typ().n;
  document.getElementById('view').setAttribute('aria-label','พื้นที่ออกแบบบูธ กว้าง '+S.W+' เมตร ลึก '+S.D+' เมตร สูง '+S.H+' เมตร');

  const gg=hasStore()?storeGeom(boothWallThickness(S)):null;
  const rows=[['ธุรกิจ',cat().n],
    ['ขนาด','กว้าง '+S.W+' × ลึก '+S.D+' × สูง '+S.H+' ม.'],
    ['รูปแบบบูธ',typ().n+' · ผนัง '+(typ().walls.length?typ().walls.length+' ด้าน':'ไม่มี')+
      (S.type==='photo360'?' · รัศมี R '+Number(S.wallRadius).toFixed(2)+' ม.':'')],
    ['สีหลัก (CI)',S.primary.toUpperCase()],['สีรอง',S.secondary.toUpperCase()],['คู่สีแนะนำ',pair().n],
    ['ห้องเก็บของ',gg?stChosenLabel()+' · สูง '+gg.h.toFixed(2).replace(/0$/,'')+' ม. · '+
      ST_POS.find(x=>x.k===S.stPos).n+' · '+ST_DOOR.find(x=>x.k===S.stDoor).n+' · '+
      ST_DOOR_TYPE.find(x=>x.k===S.stDoorType).n+' · '+
      (S.stSurf==='paint'?'ทาสี '+ST_PAINT.find(x=>x.k===S.stPaint).n
        :'สติ๊กเกอร์ '+ST_FACE.find(x=>x.k===S.stFace).n):'ไม่มี'],
    ['พื้น',(S.raise?'ยก '+S.raise+' ซม. · ':'ไม่ยกพื้น · ')+floorName()],
    ['ผนัง',wallFinishSummary()+(wallStickerSummary()?' · '+wallStickerSummary():'')],
    ['โลโก้',S.type==='island'?'ไม่มี':LOGOTYPES.find(t=>t.k===S.logoType).n+' · '+LOGOSHAPES.find(shape=>shape.k===S.logoShape).n+' · '+LOCKUPS.find(t=>t.k===S.lockup).n+
      ' · '+logoPlacementSummary(S)+
      (S.type==='corner'&&S.sideLogo?' · +ผนังข้าง ('+SIDEPOS.find(x=>x.k===S.sidePos).n+')':'')],
    ['ไฟแสงสว่าง',S.lights?('สปอตไลท์ '+lightTotal()+' จุด · '+lightModelDef().n+' · '+LIGHTCOL.find(c=>c.k===S.lightCol).n+
      ' · '+lightWattDef().n+' / ดวง · '+LIGHTWALL.find(w=>w.k===S.lightWall).n):'ไม่มี'],
    ['คลังอุปกรณ์',objectListLabel()]];
  document.getElementById('spec').innerHTML=rows.map(r=>
    `<div class="kv"><b>${r[0]}</b><span>${esc(r[1])}</span></div>`).join('');

  const estimateLines=priceLines();
  document.getElementById('price').textContent='฿'+fmt(priceTotal());
  document.getElementById('plines').innerHTML=estimateLines.map(r=>
    `<div class="kv"><b style="color:var(--tx2);font-weight:400">${r[0]}</b></div>`).join('');
  document.getElementById('summaryCount').textContent=String(estimateLines.length);
  syncPromptFidelityControls();
  updatePromptPreview();
  refreshGlobalNumericResets();
  render();
}

/* ================= right tool dock ================= */
const workspace=document.getElementById('workspace');
const dockPanel=document.getElementById('dockPanel');
const moveToolSection=(sectionId,bodyId)=>{
  const section=document.getElementById(sectionId),body=document.getElementById(bodyId);
  if(section&&body)body.appendChild(section);
};
moveToolSection('settingsSize','dockBoothBody');
moveToolSection('settingsType','dockBoothBody');
moveToolSection('settingsColors','dockBrandBody');
moveToolSection('settingsStorage','dockStorageBody');
moveToolSection('settingsFloor','dockFinishBody');
moveToolSection('settingsWall','dockFinishBody');
moveToolSection('settingsBrand','dockSignageBody');
moveToolSection('settingsLights','dockLightingBody');
const brandBar=document.querySelector('.brandbar'),signageSection=document.getElementById('settingsBrand');
if(brandBar&&signageSection)signageSection.querySelector('.sech').after(brandBar);
const summaryRow=document.querySelector('.row2'),selectedCard=summaryRow&&summaryRow.querySelector('.selected-card'),dockCatalogPage=document.getElementById('dockCatalogPage');
if(selectedCard&&dockCatalogPage)dockCatalogPage.appendChild(selectedCard);
if(summaryRow)summaryRow.remove();
document.querySelectorAll('.dock-page').forEach(p=>p.dataset.toolPage=p.dataset.dockPage);
document.querySelectorAll('.dock-tool').forEach(b=>{
  b.dataset.tool=b.dataset.dockPage;
  const page=document.querySelector('.dock-page[data-dock-page="'+b.dataset.dockPage+'"]');
  if(page)b.setAttribute('aria-controls',page.id||'dockPanel');
});
function showDockPage(page,source){
  workspace.classList.remove('dock-collapsed');
  workspace.classList.toggle('asset-panel-open',page==='catalog');
  workspace.classList.toggle('asset-tool-active',page==='catalog');
  dockPanel.setAttribute('aria-hidden','false');
  document.querySelectorAll('.dock-page').forEach(p=>{
    const active=p.dataset.dockPage===page;p.classList.toggle('on',active);p.setAttribute('aria-hidden',String(!active));
  });
  document.querySelectorAll('.dock-tool').forEach(b=>{
    const active=b===source;b.classList.toggle('on',active);b.setAttribute('aria-pressed',String(active));
  });
  const activePage=document.querySelector('.dock-page.on');
  if(activePage)activePage.scrollTop=0;
  if(page==='prompt')updatePromptPreview();
}
document.querySelectorAll('.dock-tool').forEach(b=>b.onclick=()=>showDockPage(b.dataset.dockPage,b));
const promptCopyButton=document.getElementById('promptCopy');
if(promptCopyButton)promptCopyButton.onclick=copyDesignPrompt;
const promptCleanScreenshotButton=document.getElementById('promptCleanScreenshot');
if(promptCleanScreenshotButton)promptCleanScreenshotButton.onclick=downloadCleanScreenshot;
const promptRenderConceptButton=document.getElementById('promptRenderConcept');
if(promptRenderConceptButton)promptRenderConceptButton.onclick=()=>runAIRender('concept');
const promptRender3dButton=document.getElementById('promptRender3d');
if(promptRender3dButton)promptRender3dButton.onclick=()=>runAIRender('from3d');
document.querySelectorAll('[data-render-quality]').forEach(button=>button.onclick=()=>setRenderQuality(button.dataset.renderQuality));
const conceptAddAll=document.getElementById('conceptAddAll');if(conceptAddAll)conceptAddAll.onclick=()=>confirmAIConceptSuggestions('all');
const conceptAddSelected=document.getElementById('conceptAddSelected');if(conceptAddSelected)conceptAddSelected.onclick=()=>confirmAIConceptSuggestions('selected');
const conceptReject=document.getElementById('conceptReject');if(conceptReject)conceptReject.onclick=clearAIConceptProposal;
const promptRunABButton=document.getElementById('promptRunAB');
if(promptRunABButton)promptRunABButton.onclick=runAIRenderABTest;
const promptVariantSelect=document.getElementById('promptVariant');
if(promptVariantSelect)promptVariantSelect.onchange=e=>{
  normalizeAIRenderingSettings(S).promptVariant=e.target.value==='compact'?'compact':'full';updatePromptPreview();
};
syncAIRenderControls();
const promptRenderStyleSelect=document.getElementById('promptRenderStyle');
if(promptRenderStyleSelect)promptRenderStyleSelect.onchange=e=>setPromptRenderStyle(e.target.value);
document.querySelectorAll('[data-staging-enabled]').forEach(button=>button.onclick=()=>setPromptStagingEnabled(button.dataset.stagingEnabled==='true'));
const promptStagingDensity=document.getElementById('promptStagingDensity');
if(promptStagingDensity)promptStagingDensity.onchange=e=>setPromptStagingDensity(e.target.value);
const stagingPermissionInputs={promptStagingFurniture:'allowFurniture',promptStagingProducts:'allowProducts',promptStagingPeople:'allowPeople',promptStagingDecor:'decorPlants'};
Object.entries(stagingPermissionInputs).forEach(([id,key])=>{const input=document.getElementById(id);if(input)input.onchange=e=>setPromptStagingPermission(key,e.target.checked);});
const promptFidelityRange=document.getElementById('promptFidelityRange');
const promptFidelityInput=document.getElementById('promptFidelityVal');
if(promptFidelityRange)promptFidelityRange.oninput=e=>setPromptFidelity(e.target.value);
if(promptFidelityInput){
  const commitPromptFidelity=()=>setPromptFidelity(promptFidelityInput.value);
  promptFidelityInput.addEventListener('change',commitPromptFidelity);
  promptFidelityInput.addEventListener('keydown',e=>{
    if(e.key==='Enter'){e.preventDefault();commitPromptFidelity();promptFidelityInput.blur();}
  });
}
const placementSnapInput=document.getElementById('placementSnapEnabled');
if(placementSnapInput)placementSnapInput.onchange=e=>{S.placementSnap=!!e.target.checked;sync();};
const magneticSnapInput=document.getElementById('magneticSnapEnabled');
if(magneticSnapInput)magneticSnapInput.onchange=e=>{
  S.magneticSnap=!!e.target.checked;if(!S.magneticSnap)(S.objects||[]).forEach(obj=>{if(obj.placement)obj.placement.anchorAttachment=null;});
  if(threeRenderer){threeRenderer.currentKey='';threeRenderer.clearMagneticSnapPreview();}sync();
};
function closeDockPanel(returnFocus=true){
  workspace.classList.remove('asset-panel-open');
  workspace.classList.add('dock-collapsed');
  dockPanel.setAttribute('aria-hidden','true');
  if(returnFocus)requestAnimationFrame(()=>document.querySelector('.dock-tool.on')?.focus());
}
document.getElementById('dockClose').onclick=()=>closeDockPanel(true);
document.getElementById('dockUpdate').onclick=()=>{
  if(/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName||''))document.activeElement.blur();
  sync();
  closeDockPanel(true);
};
document.getElementById('btnPositionLogo3D').onclick=()=>{
  if(S.view!=='three')selectView('three');
  selectLogoPlacement(true);
  const status=document.getElementById('objectLayoutStatus');if(status)status.textContent='เลือกโลโก้แล้ว ลากบนภาพ 3D เพื่อย้ายตำแหน่ง';
  if(window.matchMedia&&window.matchMedia('(max-width:820px)').matches)closeDockPanel(false);
  requestAnimationFrame(()=>document.getElementById('view')?.scrollIntoView({block:'center',behavior:'smooth'}));
};

const summaryToggle=document.getElementById('summaryToggle'),summaryPopover=document.getElementById('summaryPopover'),summaryClose=document.getElementById('summaryClose');
function closeHeaderSummary(returnFocus=true){
  if(summaryPopover.hidden)return;
  summaryPopover.hidden=true;summaryToggle.setAttribute('aria-expanded','false');
  if(returnFocus)summaryToggle.focus();
}
function toggleHeaderSummary(){
  const open=summaryPopover.hidden;summaryPopover.hidden=!open;summaryToggle.setAttribute('aria-expanded',String(open));
  if(open)summaryClose.focus();
}
summaryToggle.onclick=toggleHeaderSummary;
summaryClose.onclick=()=>closeHeaderSummary(true);
document.addEventListener('pointerdown',event=>{
  if(!summaryPopover.hidden&&!summaryPopover.contains(event.target)&&!summaryToggle.contains(event.target))closeHeaderSummary(false);
});
document.addEventListener('keydown',event=>{if(event.key==='Escape'&&!summaryPopover.hidden)closeHeaderSummary(true);});

/* ================= inputs ================= */
function numericResetRange(input){
  const linkedId=input.dataset.resetRange;
  if(linkedId)return document.getElementById(linkedId);
  const group=input.closest('.nscale,.floor-sticker-control,.prompt-fidelity-control,.booth-curve-field');
  return group?.querySelector('input[type="range"]')||null;
}
function numericResetChanged(input){
  const current=Number(input.value),initial=Number(input.dataset.resetDefault),step=Math.abs(Number(input.step))||1;
  return Number.isFinite(current)&&Number.isFinite(initial)&&Math.abs(current-initial)>Math.max(1e-7,step/1000);
}
function updateNumericResetButton(input){
  const button=input._resetButton;if(!button)return;
  const initial=input.dataset.resetDefault,fieldName=input.getAttribute('aria-label')||'ค่านี้';
  button.title='กลับเป็นค่าเริ่มต้น '+initial;button.setAttribute('aria-label','รีเซ็ต'+fieldName+'เป็นค่าเริ่มต้น '+initial);
  button.hidden=!numericResetChanged(input);
}
function installNumericReset(input){
  if(!input||input.dataset.resetReady==='1'||!Number.isFinite(Number(input.dataset.resetDefault)))return;
  if(input.id==='lsVal'||input.id==='nsVal'){input.dataset.resetReady='1';return;}
  const button=document.createElement('button'),range=numericResetRange(input);
  button.type='button';button.className='field-reset';button.textContent='↶';button.hidden=true;
  input.insertAdjacentElement('afterend',button);input.dataset.resetReady='1';input._resetButton=button;
  const update=()=>updateNumericResetButton(input);
  input.addEventListener('input',update);input.addEventListener('change',update);
  if(range){range.addEventListener('input',update);range.addEventListener('change',update);}
  button.addEventListener('click',event=>{
    event.preventDefault();event.stopPropagation();
    const resetValue=input.dataset.resetDefault;
    input.value=resetValue;if(range)range.value=resetValue;
    input.dispatchEvent(new Event('input',{bubbles:true}));
    input.dispatchEvent(new Event('change',{bubbles:true}));
    update();
  });
  update();
}
function installGlobalNumericResets(root=document){
  if(root.matches?.('input[type="number"][data-reset-default]'))installNumericReset(root);
  root.querySelectorAll?.('input[type="number"][data-reset-default]').forEach(installNumericReset);
}
function refreshGlobalNumericResets(){
  document.querySelectorAll('input[type="number"][data-reset-ready="1"]').forEach(updateNumericResetButton);
}
let numericResetObserver=null;
function initGlobalNumericResets(){
  installGlobalNumericResets(document);
  if(typeof MutationObserver==='undefined')return;
  numericResetObserver=new MutationObserver(records=>records.forEach(record=>record.addedNodes.forEach(node=>{
    if(node.nodeType===1)installGlobalNumericResets(node);
  })));
  numericResetObserver.observe(document.body,{childList:true,subtree:true});
}
function syncLogoLockupVisibility(){const section=document.getElementById('logoLockupSection');if(section)section.hidden=!(S.logoScale>0&&S.nameScale>0);}
function updateScaleResetButtons(){
  [['resetLogoScale','lsVal'],['resetNameScale','nsVal']].forEach(([buttonId,inputId])=>{
    const button=document.getElementById(buttonId),input=document.getElementById(inputId);if(!button||!input)return;
    const value=Number(input.value);button.hidden=!Number.isFinite(value)||value===BRAND_SCALE_DEFAULT;
  });
}
document.getElementById('brand').oninput=e=>{S.brand=e.target.value;render();};
document.getElementById('cPick').oninput=e=>setPrimary(e.target.value);
document.getElementById('cHex').oninput=e=>{const v=e.target.value.trim();
  if(/^#?[0-9a-fA-F]{6}$/.test(v)){S.primary=v[0]==='#'?v:'#'+v;S.colTouched=true;sync();}};
document.getElementById('nsRange').oninput=e=>{S.nameScale=+e.target.value;
  document.getElementById('nsVal').value=S.nameScale;syncLogoLockupVisibility();sync();};
document.getElementById('lsRange').oninput=e=>{S.logoScale=+e.target.value;
  document.getElementById('lsVal').value=S.logoScale;syncLogoLockupVisibility();sync();};
const commitScaleInput=(id,key,min,max)=>{
  const input=document.getElementById(id);if(!input)return;
  const commit=()=>{
    const value=Number(input.value);
    if(!Number.isFinite(value)){sync();return;}
    S[key]=Math.max(min,Math.min(max,Math.round(value)));
    sync();
  };
  input.addEventListener('input',updateScaleResetButtons);
  input.addEventListener('change',commit);
  input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();commit();input.blur();}});
};
commitScaleInput('lsVal','logoScale',0,BRAND_SCALE_MAX);
commitScaleInput('nsVal','nameScale',0,BRAND_SCALE_MAX);
document.getElementById('resetLogoScale').onclick=()=>{S.logoScale=BRAND_SCALE_DEFAULT;sync();};
document.getElementById('resetNameScale').onclick=()=>{S.nameScale=BRAND_SCALE_DEFAULT;sync();};
const bindLogoDimensionPair=(rangeId,inputId,key)=>{
  const range=document.getElementById(rangeId),input=document.getElementById(inputId);if(!range||!input)return;
  const store=value=>{const numeric=Number(value),initial=Number(input.dataset.resetDefault),step=Math.abs(Number(input.step))||.05;
    if(Number.isFinite(numeric))S[key]=Number.isFinite(initial)&&Math.abs(numeric-initial)<=step/100?0:numeric;};
  range.oninput=()=>{store(range.value);sync();};
  const commit=()=>{store(input.value);sync();};
  input.addEventListener('change',commit);input.addEventListener('keydown',event=>{if(event.key==='Enter'){event.preventDefault();commit();input.blur();}});
};
[['logoDepthRange','logoDepthInput','logoDepth'],['logoBaseWidthRange','logoBaseWidthInput','logoBaseWidth'],['logoBaseDepthRange','logoBaseDepthInput','logoBaseDepth']]
  .forEach(args=>bindLogoDimensionPair(...args));
document.getElementById('cPick2').oninput=e=>{S.secondary=e.target.value;S.secTouched=true;sync();};
document.getElementById('cHex2').oninput=e=>{const v=e.target.value.trim();
  if(/^#?[0-9a-fA-F]{6}$/.test(v)){S.secondary=v[0]==='#'?v:'#'+v;S.secTouched=true;sync();}};
document.getElementById('logoBasePick').oninput=e=>{S.logoBaseColor=e.target.value;sync();};
document.getElementById('logoBaseHex').oninput=e=>{const v=e.target.value.trim();
  if(/^#?[0-9a-fA-F]{6}$/.test(v)){S.logoBaseColor=(v[0]==='#'?v:'#'+v).toLowerCase();sync();}};
document.getElementById('logoColorPick').oninput=e=>{S.logoColor=e.target.value;S.logoColorTouched=true;sync();};
document.getElementById('logoColorHex').oninput=e=>{const v=e.target.value.trim();
  if(/^#?[0-9a-fA-F]{6}$/.test(v)){S.logoColor=(v[0]==='#'?v:'#'+v).toLowerCase();S.logoColorTouched=true;sync();}};
['dW','dD','dH'].forEach((id,i)=>{document.getElementById(id).oninput=e=>{
  if(isFixedBoothType(S.type)){syncDims();return;}
  const v=parseFloat(e.target.value);if(isNaN(v))return;
  if(i===0)S.W=v;if(i===1)S.D=v;if(i===2)S.H=v;sync();};});
document.getElementById('stW').oninput=e=>{S.stW=parseFloat(e.target.value)||1.2;sync();};
document.getElementById('stD').oninput=e=>{S.stD=parseFloat(e.target.value)||1.2;sync();};
document.getElementById('stHv').oninput=e=>{S.stHv=parseFloat(e.target.value)||2.4;sync();};
const setPhoto360Radius=value=>{const radius=parseFloat(value),min=wallCurveMinRadius(S);if(Number.isFinite(radius))S.wallRadius=Math.max(min,Math.min(100,radius));sync();};
document.getElementById('photo360RadiusRange').oninput=e=>setPhoto360Radius(e.target.value);
const photo360RadiusInput=document.getElementById('photo360Radius');
photo360RadiusInput.oninput=e=>{
  const radius=parseFloat(e.target.value),min=wallCurveMinRadius(S);
  if(Number.isFinite(radius)&&radius>=min&&radius<=100)setPhoto360Radius(radius);
};
photo360RadiusInput.onchange=e=>setPhoto360Radius(e.target.value);
const photo360RadiusModal=document.getElementById('mPhoto360Radius'),photo360RadiusMobileOpen=document.getElementById('photo360RadiusMobileOpen'),
  photo360RadiusMobileRange=document.getElementById('photo360RadiusMobileRange'),photo360RadiusMobileInput=document.getElementById('photo360RadiusMobileInput');
function openPhoto360RadiusModal(){
  if(S.type!=='photo360')return;
  photo360RadiusModal.classList.add('show');photo360RadiusModal.setAttribute('aria-hidden','false');document.body.classList.add('radius-modal-open');
  requestAnimationFrame(()=>photo360RadiusMobileRange.focus());
}
function closePhoto360RadiusModal(returnFocus=true){
  photo360RadiusModal.classList.remove('show');photo360RadiusModal.setAttribute('aria-hidden','true');document.body.classList.remove('radius-modal-open');
  if(returnFocus&&photo360RadiusMobileOpen.offsetParent!==null)photo360RadiusMobileOpen.focus();
}
photo360RadiusMobileOpen.onclick=openPhoto360RadiusModal;
document.getElementById('photo360RadiusMobileClose').onclick=()=>closePhoto360RadiusModal();
document.getElementById('photo360RadiusMobileDone').onclick=()=>closePhoto360RadiusModal();
photo360RadiusMobileRange.oninput=e=>setPhoto360Radius(e.target.value);
photo360RadiusMobileInput.oninput=e=>{
  const radius=parseFloat(e.target.value),min=wallCurveMinRadius(S);
  if(Number.isFinite(radius)&&radius>=min&&radius<=100)setPhoto360Radius(radius);
};
photo360RadiusMobileInput.onchange=e=>setPhoto360Radius(e.target.value);
document.addEventListener('keydown',event=>{if(event.key==='Escape'&&photo360RadiusModal.classList.contains('show')){event.preventDefault();closePhoto360RadiusModal();}});
if(window.matchMedia){window.matchMedia('(min-width:821px)').addEventListener('change',event=>{if(event.matches&&photo360RadiusModal.classList.contains('show'))closePhoto360RadiusModal(false);});}
document.addEventListener('keydown',e=>{
  if(e.key==='Escape'&&selectedSceneItemIds().length&&!document.querySelector('.modal.show')){
    e.preventDefault();setObjectSelection([]);logoEditor.selected=false;syncObjectControls();if(threeRenderer)threeRenderer.setSceneSelection([],null);if(S.view==='plan')render();return;
  }
  if(/^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName))return;
  const mod=e.ctrlKey||e.metaKey;
  if(mod&&e.key.toLowerCase()==='z'){e.preventDefault();e.shiftKey?redoObjectChange():undoObjectChange();}
  else if(mod&&e.key.toLowerCase()==='y'){e.preventDefault();redoObjectChange();}
  else if((e.key==='Delete'||e.key==='Backspace')&&objectEditor.selectedId){e.preventDefault();deleteSelectedObject();}
});

function dominantColor(img){try{
  const n=52,c=document.createElement('canvas');c.width=n;c.height=n;
  const x=c.getContext('2d',{willReadFrequently:true});x.drawImage(img,0,0,n,n);
  const d=x.getImageData(0,0,n,n).data,B={};
  for(let i=0;i<d.length;i+=4){if(d[i+3]<160)continue;
    const r=d[i],g2=d[i+1],b=d[i+2],mx=Math.max(r,g2,b),mn=Math.min(r,g2,b);
    const sat=mx?(mx-mn)/mx:0,li=mx/255;if(sat<.22||li<.16||li>.97)continue;
    const key=[r>>5,g2>>5,b>>5].join(',');const q=B[key]||(B[key]={n:0,r:0,g:0,b:0});
    q.n++;q.r+=r;q.g+=g2;q.b+=b;}
  let best=null;for(const k in B)if(!best||B[k].n>best.n)best=B[k];
  return best?toHex([best.r/best.n,best.g/best.n,best.b/best.n]):null;
}catch(e){return null;}}
function imageHasTransparency(img){try{
  const c=document.createElement('canvas'),max=240,scale=Math.min(1,max/Math.max(1,img.naturalWidth||1,img.naturalHeight||1));
  c.width=Math.max(1,Math.round((img.naturalWidth||1)*scale));c.height=Math.max(1,Math.round((img.naturalHeight||1)*scale));
  const x=c.getContext('2d',{willReadFrequently:true});x.drawImage(img,0,0,c.width,c.height);const data=x.getImageData(0,0,c.width,c.height).data;
  for(let i=3;i<data.length;i+=4)if(data[i]<250)return true;return false;
}catch(e){return false;}}

const fl=document.createElement('input');fl.type='file';fl.accept='image/*';fl.hidden=true;
const fp=document.createElement('input');fp.type='file';fp.accept='image/*';fp.hidden=true;
document.body.appendChild(fl);document.body.appendChild(fp);
document.getElementById('btnLogo').onclick=()=>fl.click();
fl.onchange=e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();
  r.onload=()=>{S.logo=r.result;const im=new Image();
    im.onload=()=>{S.logoAcc=dominantColor(im);
      S.logoAR=(im.naturalWidth&&im.naturalHeight)?(im.naturalWidth/im.naturalHeight):2.2;
      S.logoHasTransparency=imageHasTransparency(im);
      if(S.logoAcc&&!S.logoColorTouched)S.logoColor=S.logoAcc;
      const pv=document.getElementById('logoPrev');pv.src=r.result;pv.style.display='block';
      const bc=document.getElementById('btnLogoCol');bc.style.display=S.logoAcc?'block':'none';
      if(S.logoAcc)bc.style.borderColor=S.logoAcc;sync();};
    im.src=r.result;};
  r.readAsDataURL(f);};
document.getElementById('btnLogoCol').onclick=()=>{if(S.logoAcc)setPrimary(S.logoAcc);};
fp.onchange=e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();
  r.onload=()=>{S.photo=r.result;render();};r.readAsDataURL(f);};

const releaseNotesModal=document.getElementById('mRelease');
const QUICK_SETUP_STEPS=Object.freeze(['intro','business','layout','brand','floor','room','loading']);
const QUICK_SETUP_PROGRESS_STEPS=Object.freeze(['business','layout','brand','floor','room']);
const QUICK_SETUP_TYPE_KEYS=Object.freeze(['inline','corner','penin','island']);
let quickSetupStep='intro',quickSetupDraft=null,quickBusinessAttempted=false,quickLayoutAttempted=false,quickBrandAttempted=false,quickSetupCompleting=false;
const quickBoothDefaults=type=>window.YPQuickSetupContext?.boothDefaultsFor(type)||({inline:{width:6,depth:3,height:2.4,displaySize:'3 × 6 ม.',openSides:1},corner:{width:6,depth:3,height:2.4,displaySize:'3 × 6 ม.',openSides:2},penin:{width:6,depth:6,height:2.4,displaySize:'6 × 6 ม.',openSides:3},island:{width:6,depth:6,height:2.4,displaySize:'6 × 6 ม.',openSides:4}}[type]||null);
const normalizedQuickHex=(value,fallback='#2E7D4F')=>window.YPQuickSetupContext?.normalizeHexColor(value,fallback)||(/^#[0-9a-fA-F]{6}$/.test(String(value||''))?String(value).toUpperCase():fallback);
function quickSetupDraftFromEditor(){
  const boothType=QUICK_SETUP_TYPE_KEYS.includes(S.type)?S.type:'inline',preset=quickBoothDefaults(boothType)||quickBoothDefaults('inline');
  return{businessCategoryId:S.cat||'',businessCategoryLabel:businessCategoryLabel(S),customBusinessCategory:String(S.customBusinessCategory||''),
    boothType,cornerSide:boothType==='corner'?(S.cornerSide||'right'):'',width:preset.width,depth:preset.depth,height:preset.height,
    primary:normalizedQuickHex(S.primary||'#2E7D4F'),brandTouched:false,raise:RAISE.some(item=>item.k===S.raise)?S.raise:0,
    floor:FLOORS.some(item=>item.k===S.floor)?S.floor:'carpet',carpet:CARPETS.some(item=>item.k===S.carpet)?S.carpet:'grey',addStorage:S.stSize!=='none'};
}
function createQuickChoice({value,label,detail='',selected=false,onSelect}){
  const button=document.createElement('button');button.type='button';button.className='quick-choice';button.dataset.value=value;button.setAttribute('role','radio');button.setAttribute('aria-checked',String(selected));
  button.innerHTML='<span>'+esc(label)+'</span>'+(detail?'<small>'+esc(detail)+'</small>':'')+'<span class="quick-choice-check" aria-hidden="true">✓</span>';
  button.onclick=()=>onSelect(value);return button;
}
function bindQuickRadioKeys(container){
  container.addEventListener('keydown',event=>{
    if(!['ArrowRight','ArrowDown','ArrowLeft','ArrowUp'].includes(event.key))return;
    const buttons=[...container.querySelectorAll('[role=radio]:not([disabled])')],index=buttons.indexOf(document.activeElement);if(index<0)return;
    event.preventDefault();const next=(index+(event.key==='ArrowRight'||event.key==='ArrowDown'?1:-1)+buttons.length)%buttons.length;buttons[next].focus();buttons[next].click();
  });
}
function buildQuickBusinessChoices(){
  const host=document.getElementById('quickBusinessGroups');host.innerHTML='';
  CATGROUPS.forEach(group=>{const section=document.createElement('section');section.className='quick-business-group';section.appendChild(el('h3',null,group.g));
    const grid=el('div','quick-choice-grid');group.items.forEach(category=>grid.appendChild(createQuickChoice({value:category.k,label:category.n,
      selected:quickSetupDraft?.businessCategoryId===category.k,onSelect:value=>{quickSetupDraft.businessCategoryId=value;quickSetupDraft.businessCategoryLabel=category.n;
        if(!quickSetupDraft.brandTouched)quickSetupDraft.primary=normalizedQuickHex(category.col||quickSetupDraft.primary);
        quickBusinessAttempted=value==='other';updateQuickBusinessStep();if(value==='other')requestAnimationFrame(()=>document.getElementById('quickBusinessCustom').focus());}})));section.appendChild(grid);host.appendChild(section);});
  bindQuickRadioKeys(host);
}
function quickBusinessValidation(){
  if(!quickSetupDraft?.businessCategoryId)return'กรุณาเลือกหมวดธุรกิจ';
  if(quickSetupDraft.businessCategoryId==='other'&&!String(quickSetupDraft.customBusinessCategory||'').trim())return'กรุณาระบุประเภทธุรกิจของคุณ';
  return'';
}
function updateQuickBusinessStep(){
  const selected=quickSetupDraft?.businessCategoryId||'';
  document.querySelectorAll('#quickBusinessGroups [role=radio]').forEach(button=>button.setAttribute('aria-checked',String(button.dataset.value===selected)));
  const customWrap=document.getElementById('quickBusinessCustomWrap'),customInput=document.getElementById('quickBusinessCustom');customWrap.hidden=selected!=='other';
  if(document.activeElement!==customInput)customInput.value=quickSetupDraft?.customBusinessCategory||'';
  const error=quickBusinessValidation();document.getElementById('quickBusinessError').textContent=quickBusinessAttempted?error:'';customInput.setAttribute('aria-invalid',String(!!error&&selected==='other'));
  document.getElementById('quickBusinessNext').disabled=!!error;
}
function buildQuickLayoutChoices(){
  const typeHost=document.getElementById('quickBoothTypes');typeHost.innerHTML='';
  TYPES.filter(item=>item.on&&QUICK_SETUP_TYPE_KEYS.includes(item.k)).forEach(type=>{const preset=quickBoothDefaults(type.k);typeHost.appendChild(createQuickChoice({value:type.k,label:type.n,detail:(preset?.displaySize||'')+' · เปิด '+(preset?.openSides||0)+' ด้าน',
    selected:quickSetupDraft?.boothType===type.k,onSelect:value=>{const previous=quickSetupDraft.boothType,picked=quickBoothDefaults(value);quickSetupDraft.boothType=value;
      if(picked)Object.assign(quickSetupDraft,{width:picked.width,depth:picked.depth,height:picked.height});
      if(value==='corner'&&previous!=='corner')quickSetupDraft.cornerSide='';if(value!=='corner')quickSetupDraft.cornerSide='';
      quickLayoutAttempted=value==='corner';updateQuickLayoutStep();}}));});
  bindQuickRadioKeys(typeHost);
  const cornerHost=document.getElementById('quickCornerSides');cornerHost.innerHTML='';CORNER_SIDES.forEach(side=>cornerHost.appendChild(createQuickChoice({value:side.k,label:side.n,detail:side.s,
    selected:quickSetupDraft?.cornerSide===side.k,onSelect:value=>{quickSetupDraft.cornerSide=value;quickLayoutAttempted=false;updateQuickLayoutStep();}})));bindQuickRadioKeys(cornerHost);
}
function quickLayoutValidation(){
  if(!QUICK_SETUP_TYPE_KEYS.includes(quickSetupDraft?.boothType))return'กรุณาเลือกรูปแบบบูธ';
  if(quickSetupDraft.boothType==='corner'&&!['left','right'].includes(quickSetupDraft.cornerSide))return'กรุณาเลือกหัวมุมซ้ายหรือหัวมุมขวา';
  return'';
}
function updateQuickLayoutStep(){
  document.querySelectorAll('#quickBoothTypes [role=radio]').forEach(button=>button.setAttribute('aria-checked',String(button.dataset.value===quickSetupDraft?.boothType)));
  const corner=quickSetupDraft?.boothType==='corner',cornerHost=document.getElementById('quickCornerSides');cornerHost.hidden=!corner;
  document.querySelectorAll('#quickCornerSides [role=radio]').forEach(button=>button.setAttribute('aria-checked',String(button.dataset.value===quickSetupDraft?.cornerSide)));
  const type=TYPES.find(item=>item.k===quickSetupDraft?.boothType),preset=quickBoothDefaults(quickSetupDraft?.boothType),error=quickLayoutValidation(),side=CORNER_SIDES.find(item=>item.k===quickSetupDraft?.cornerSide);
  document.getElementById('quickLayoutSummary').textContent=type&&preset?'รูปแบบ '+type.n+(corner&&side?' · '+side.n:'')+' · '+preset.displaySize+' (กว้าง '+preset.width+' × ลึก '+preset.depth+' × สูง '+preset.height+' ม.) · เปิด '+preset.openSides+' ด้าน':'กรุณาเลือกรูปแบบบูธ';
  document.getElementById('quickLayoutError').textContent=quickLayoutAttempted?error:'';document.getElementById('quickLayoutNext').disabled=!!error;
}
function quickBrandValidation(){return /^#[0-9a-fA-F]{6}$/.test(String(quickSetupDraft?.primary||''))?'':'กรุณากรอกรหัสสี HEX 6 หลัก เช่น #F72585';}
function updateQuickBrandStep(){
  const picker=document.getElementById('quickBrandPicker'),hex=document.getElementById('quickBrandHex'),preview=document.getElementById('quickBrandPreview'),error=quickBrandValidation();
  if(!error){picker.value=quickSetupDraft.primary.toLowerCase();preview.style.background=quickSetupDraft.primary;}
  if(document.activeElement!==hex)hex.value=quickSetupDraft.primary;hex.setAttribute('aria-invalid',String(!!error));document.getElementById('quickBrandError').textContent=quickBrandAttempted?error:'';document.getElementById('quickBrandNext').disabled=!!error;
}
function buildQuickFloorChoices(){
  const raiseHost=document.getElementById('quickRaiseOptions');raiseHost.innerHTML='';RAISE.forEach(item=>raiseHost.appendChild(createQuickChoice({value:String(item.k),label:item.n,detail:item.s,selected:Number(quickSetupDraft?.raise)===item.k,onSelect:()=>{quickSetupDraft.raise=item.k;updateQuickFloorStep();}})));bindQuickRadioKeys(raiseHost);
  const floorHost=document.getElementById('quickFloorOptions');floorHost.innerHTML='';FLOORS.forEach(item=>floorHost.appendChild(createQuickChoice({value:item.k,label:item.n,detail:item.s,selected:quickSetupDraft?.floor===item.k,onSelect:value=>{quickSetupDraft.floor=value;updateQuickFloorStep();}})));bindQuickRadioKeys(floorHost);
  const carpetHost=document.getElementById('quickCarpetOptions');carpetHost.innerHTML='';CARPETS.forEach(item=>carpetHost.appendChild(createQuickChoice({value:item.k,label:item.k==='grey'?'เทาดำ':item.n,detail:item.k==='grey'?'ค่าเริ่มต้น':'',selected:quickSetupDraft?.carpet===item.k,onSelect:value=>{quickSetupDraft.carpet=value;updateQuickFloorStep();}})));bindQuickRadioKeys(carpetHost);
}
function updateQuickFloorStep(){
  document.querySelectorAll('#quickRaiseOptions [role=radio]').forEach(button=>button.setAttribute('aria-checked',String(Number(button.dataset.value)===Number(quickSetupDraft?.raise))));
  document.querySelectorAll('#quickFloorOptions [role=radio]').forEach(button=>button.setAttribute('aria-checked',String(button.dataset.value===quickSetupDraft?.floor)));
  document.querySelectorAll('#quickCarpetOptions [role=radio]').forEach(button=>button.setAttribute('aria-checked',String(button.dataset.value===quickSetupDraft?.carpet)));
  document.getElementById('quickCarpetSection').hidden=quickSetupDraft?.floor!=='carpet';
}
function buildQuickRoomChoices(){
  const host=document.getElementById('quickRoomOptions');host.innerHTML='';[
    {value:'none',label:'ไม่เพิ่มห้อง',detail:'ค่าเริ่มต้น'},
    {value:'storage',label:'เพิ่มห้องเก็บของ',detail:'สร้างขนาดมาตรฐาน 1.2 × 1.2 ม.'}
  ].forEach(item=>host.appendChild(createQuickChoice({value:item.value,label:item.label,detail:item.detail,selected:item.value===(quickSetupDraft?.addStorage?'storage':'none'),onSelect:value=>{quickSetupDraft.addStorage=value==='storage';updateQuickRoomStep();}})));bindQuickRadioKeys(host);
}
function updateQuickRoomStep(){
  const selected=quickSetupDraft?.addStorage?'storage':'none';document.querySelectorAll('#quickRoomOptions [role=radio]').forEach(button=>button.setAttribute('aria-checked',String(button.dataset.value===selected)));
  document.getElementById('quickRoomSummary').textContent=quickSetupDraft?.addStorage?'ระบบจะเพิ่มห้องเก็บของมาตรฐาน และเปิดให้ปรับขนาด/ตำแหน่งต่อในเมนู “เพิ่มห้อง”':'เริ่มด้วยพื้นที่บูธโล่ง โดยยังเพิ่มห้องภายหลังได้';
}
function setQuickSetupStep(step,{focus=true}={}){
  if(!QUICK_SETUP_STEPS.includes(step))return;quickSetupStep=step;
  document.querySelectorAll('[data-quick-step]').forEach(panel=>{const active=panel.dataset.quickStep===step;panel.hidden=!active;panel.classList.remove('is-entering');if(active){void panel.offsetWidth;panel.classList.add('is-entering');panel.querySelector('.quick-step-scroll')?.scrollTo(0,0);}});
  const index=QUICK_SETUP_PROGRESS_STEPS.indexOf(step);document.querySelectorAll('[data-progress-step]').forEach(item=>{const itemIndex=QUICK_SETUP_PROGRESS_STEPS.indexOf(item.dataset.progressStep),loading=step==='loading';item.classList.toggle('current',!loading&&itemIndex===index);item.classList.toggle('complete',loading||index>=0&&itemIndex<index);item.setAttribute('aria-current',!loading&&itemIndex===index?'step':'false');});
  if(step==='business'){buildQuickBusinessChoices();updateQuickBusinessStep();}
  if(step==='layout'){buildQuickLayoutChoices();updateQuickLayoutStep();}
  if(step==='brand')updateQuickBrandStep();
  if(step==='floor'){buildQuickFloorChoices();updateQuickFloorStep();}
  if(step==='room'){buildQuickRoomChoices();updateQuickRoomStep();}
  const focusIds={intro:'releaseTitle',business:'quickBusinessTitle',layout:'quickLayoutTitle',brand:'quickBrandTitle',floor:'quickFloorTitle',room:'quickRoomTitle',loading:'quickLoadingTitle'};
  if(focus)requestAnimationFrame(()=>focusIds[step]&&document.getElementById(focusIds[step])?.focus());
}
function completeQuickSetup(){
  if(quickSetupCompleting)return false;
  quickBusinessAttempted=true;quickLayoutAttempted=true;quickBrandAttempted=true;const businessError=quickBusinessValidation(),layoutError=quickLayoutValidation(),brandError=quickBrandValidation();
  if(businessError){setQuickSetupStep('business');updateQuickBusinessStep();return false;}if(layoutError){setQuickSetupStep('layout');updateQuickLayoutStep();return false;}if(brandError){setQuickSetupStep('brand');updateQuickBrandStep();return false;}
  const category=ALLCATS.find(item=>item.k===quickSetupDraft.businessCategoryId),type=TYPES.find(item=>item.k===quickSetupDraft.boothType),preset=quickBoothDefaults(quickSetupDraft.boothType);if(!category||!type||!preset)return false;
  quickSetupCompleting=true;setQuickSetupStep('loading');
  window.setTimeout(()=>{
    const categoryChanged=S.cat!==category.k;S.cat=category.k;S.customBusinessCategory=category.k==='other'?String(quickSetupDraft.customBusinessCategory||'').trim():'';
    if(categoryChanged&&!S.pairTouched)S.pair=category.pr;
    S.type=type.k;S.cornerSide=type.k==='corner'?quickSetupDraft.cornerSide:'right';S.W=preset.width;S.D=preset.depth;S.H=preset.height;
    S.primary=normalizedQuickHex(quickSetupDraft.primary);S.colTouched=true;S.logoColor=S.primary;S.logoColorTouched=false;
    S.raise=Number(quickSetupDraft.raise)||0;S.floor=quickSetupDraft.floor||'carpet';S.carpet=quickSetupDraft.carpet||'grey';
    S.stSize=quickSetupDraft.addStorage?'a':'none';if(quickSetupDraft.addStorage){S.stW=1.2;S.stD=1.2;S.stHmode=2.4;S.stPos='right';S.doorTouched=false;}
    S.lights=type.k!=='island';S.view='three';syncDims();sync();closeDockPanel(false);
    loadThreeRenderer().then(renderer=>renderer.setCameraView('perspective')).catch(()=>{});
    quickSetupCompleting=false;closeReleaseNotes(false);quickSetupDraft=null;
  },360);
  return true;
}
function closeReleaseNotes(discardDraft=true){
  if(quickSetupCompleting)return;
  if(!releaseNotesModal.classList.contains('show'))return;
  if(discardDraft)quickSetupDraft=null;
  releaseNotesModal.classList.remove('show');releaseNotesModal.setAttribute('aria-hidden','true');
  document.querySelector('.dock-tool.on')?.focus();
}
function initQuickSetup(){
  quickSetupDraft=quickSetupDraftFromEditor();quickBusinessAttempted=false;quickLayoutAttempted=false;quickBrandAttempted=false;quickSetupCompleting=false;setQuickSetupStep('intro',{focus:false});
  document.getElementById('releaseStart').onclick=()=>{if(!quickSetupDraft)quickSetupDraft=quickSetupDraftFromEditor();setQuickSetupStep('business');};
  document.getElementById('releaseSkip').onclick=()=>closeReleaseNotes(true);
  document.getElementById('quickBusinessBack').onclick=()=>setQuickSetupStep('intro');
  document.getElementById('quickBusinessNext').onclick=()=>{quickBusinessAttempted=true;const error=quickBusinessValidation();updateQuickBusinessStep();if(!error)setQuickSetupStep('layout');};
  document.getElementById('quickLayoutBack').onclick=()=>setQuickSetupStep('business');document.getElementById('quickLayoutNext').onclick=()=>{quickLayoutAttempted=true;const error=quickLayoutValidation();updateQuickLayoutStep();if(!error)setQuickSetupStep('brand');};
  document.getElementById('quickBrandBack').onclick=()=>setQuickSetupStep('layout');document.getElementById('quickBrandNext').onclick=()=>{quickBrandAttempted=true;const error=quickBrandValidation();updateQuickBrandStep();if(!error)setQuickSetupStep('floor');};
  document.getElementById('quickFloorBack').onclick=()=>setQuickSetupStep('brand');document.getElementById('quickFloorNext').onclick=()=>setQuickSetupStep('room');
  document.getElementById('quickRoomBack').onclick=()=>setQuickSetupStep('floor');document.getElementById('quickRoomFinish').onclick=completeQuickSetup;
  document.getElementById('quickBusinessCustom').oninput=event=>{quickSetupDraft.customBusinessCategory=event.target.value;quickBusinessAttempted=true;updateQuickBusinessStep();};
  document.getElementById('quickBrandPicker').oninput=event=>{quickSetupDraft.primary=normalizedQuickHex(event.target.value);quickSetupDraft.brandTouched=true;quickBrandAttempted=false;updateQuickBrandStep();};
  document.getElementById('quickBrandHex').oninput=event=>{let value=event.target.value.trim().toUpperCase();if(value&&!value.startsWith('#'))value='#'+value;quickSetupDraft.primary=value;quickSetupDraft.brandTouched=true;quickBrandAttempted=true;updateQuickBrandStep();};
}
document.addEventListener('keydown',event=>{
  if(!releaseNotesModal.classList.contains('show'))return;
  if(event.key==='Escape'){event.preventDefault();closeReleaseNotes();return;}
  if(event.key!=='Tab')return;
  const focusable=[...releaseNotesModal.querySelectorAll('button:not([disabled]),input:not([disabled]),select:not([disabled]),textarea:not([disabled]),[tabindex]:not([tabindex="-1"])')].filter(node=>!node.closest('[hidden]'));
  const first=focusable[0],last=focusable[focusable.length-1];if(!first||!last)return;
  if(event.shiftKey&&document.activeElement===first){event.preventDefault();last.focus();}
  else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first.focus();}
});
initQuickSetup();requestAnimationFrame(()=>document.getElementById('releaseClose').focus());
window.YPQuickSetupBridge={getState:()=>({step:quickSetupStep,draft:quickSetupDraft?{...quickSetupDraft}:null,open:releaseNotesModal.classList.contains('show')}),
  open(){quickSetupDraft=quickSetupDraftFromEditor();quickSetupCompleting=false;releaseNotesModal.classList.add('show');releaseNotesModal.setAttribute('aria-hidden','false');setQuickSetupStep('intro');},close:()=>closeReleaseNotes(true)};

function openM(id){document.getElementById(id).classList.add('show');}
function closeM(id){document.getElementById(id).classList.remove('show');}
function sendQuote(){
  const n=document.getElementById('qn').value.trim(),t=document.getElementById('qt').value.trim();
  if(!n||!t){alert('กรุณากรอกชื่อและเบอร์โทร');return;}
  document.getElementById('qMsg').innerHTML='ขอบคุณคุณ <b>'+esc(n)+'</b> ทีมงานจะติดต่อกลับที่ '+esc(t)+
    '<br><span style="color:var(--tx3);font-size:11.5px">แนบ: '+cat().n+' · กว้าง '+S.W+' ลึก '+S.D+
    ' · '+typ().n+'</span>';
  document.getElementById('qForm').style.display='none';
  document.getElementById('qDone').style.display='block';}

document.querySelectorAll('.qi').forEach(i=>{i.style.cssText=
  'width:100%;padding:10px 12px;border-radius:10px;background:var(--bg2);border:1px solid var(--line);outline:none';});
document.getElementById('stW').value=1.2;document.getElementById('stD').value=1.2;
document.getElementById('stHv').value=2.4;
build();syncDims();sync();initGlobalNumericResets();loadMyAssets();
if(document.fonts&&document.fonts.ready)document.fonts.ready.then(()=>render());
window.addEventListener('resize',positionObjectToolbar,{passive:true});
window.getBoothSpec=()=>JSON.parse(serializeBoothSpec());
window.getAIRenderingState=()=>JSON.parse(JSON.stringify({...normalizeAIRenderingSettings(S),aiStaging:normalizeAIStagingSettings(S),
  geometryFidelity:S.geometryFidelity,stagingFreedom:S.stagingFreedom}));
window.getCameraManifest=()=>currentCameraManifest(S);
window.getGeometryManifest=()=>JSON.parse(JSON.stringify(buildGeometryManifest(S)));
window.exportCleanScreenshot=(options={})=>createCleanScreenshot(options);
window.YPAssetEditorBridge={
  getState(){
    const ids=selectedObjectIds(),obj=objectById(objectEditor.selectedId);if(!obj)return{selection:null,selectedIds:[],selectionCount:0,multiSelect:objectEditor.multiSelect,moveMode:objectEditor.moveMode,canUndo:!!objectEditor.past.length,canRedo:!!objectEditor.future.length};
    const item=objectCatalogDef(obj.catalogId);normalizeSceneObjectModel(obj,item);
    return{
      selection:{
        id:obj.id,catalogId:obj.catalogId,name:selectedAssetName(obj),type:obj.type||item?.type||'asset',customAsset:item?.customAsset===true,
        locked:objectLocked(obj),canOrient:obj.capabilities?.rotatable!==false,orientation:obj.orientation||'horizontal',
        rotationX:Number(obj.rotationX)||0,rotationY:Number(obj.rotationY)||0,rotationZ:Number(obj.rotationZ)||0,
        size:{w:Number(obj.size?.w)||0,d:Number(obj.size?.d)||0,h:Number(obj.size?.h)||0},
        position:{x:Number(obj.position?.x)||0,y:Number(obj.position?.y)||0,z:Number(obj.position?.z)||0},
        flipX:obj.transform?.flipX===true,flipY:obj.transform?.flipY===true,
        appearance:{mode:obj.appearance?.mode||'original',color:obj.appearance?.color||'#f5f5f5',hasSticker:!!obj.appearance?.textureData}
      },
      selectedIds:ids,selectionCount:ids.length,multiSelect:objectEditor.multiSelect,canGroup:ids.length>1,
      canUngroup:ids.some(id=>!!objectById(id)?.groupId),moveMode:objectEditor.moveMode,canUndo:!!objectEditor.past.length,canRedo:!!objectEditor.future.length
    };
  },
  setMoveMode:setObjectMoveMode,setName:updateSelectedObjectName,setSize(axis,value,keepRatio=true){const lock=document.getElementById('assetSizeLock');if(lock)lock.checked=keepRatio!==false;updateSelectedObjectSize(axis,value);},
  setAppearanceMode:updateSelectedObjectAppearanceMode,setColor:updateSelectedObjectColor,
  toggleLock:toggleSelectedObjectLock,rotate:rotateSelectedObject,setOrientation:setSelectedObjectOrientation,flip:flipSelectedObject,
  openSettings:openAssetSettings,resetSize:resetSelectedObjectSize,duplicate:duplicateSelectedObject,remove:deleteSelectedObject,
  toggleMultiSelect:toggleMultiObjectSelection,align:alignSelectedObjects,group:groupSelectedObjects,ungroup:ungroupSelectedObjects,
  undo:undoObjectChange,redo:redoObjectChange
};
/* Validate the data-only manifest once during startup; later callers always receive a fresh snapshot. */
buildGeometryManifest(S);
window.addEventListener('beforeunload',()=>{if(threeRenderer)threeRenderer.dispose();},{once:true});
</script>
<script type="module" src="js/asset-editor/asset-editor.js?v=20260829-3"></script>
</body>
</html>
