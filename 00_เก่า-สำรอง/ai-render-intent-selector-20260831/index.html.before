    this.renderer.domElement.addEventListener('pointerup',this.onObjectPointerUp);
    this.renderer.domElement.addEventListener('pointercancel',this.onObjectPointerUp);
    this.renderer.domElement.addEventListener('lostpointercapture',this.onObjectLostPointerCapture);
    this.renderer.domElement.addEventListener('pointerleave',this.onObjectPointerLeave);

    this.scene.add(new THREE.HemisphereLight(0xe9f0ff,0x242017,1.15));
    const key=new THREE.DirectionalLight(0xffffff,1.8);
    key.position.set(8,12,10);key.castShadow=true;
    key.shadow.mapSize.set(1024,1024);key.shadow.bias=-.0003;
    this.scene.add(key);
    const fill=new THREE.DirectionalLight(0xffd9a0,.45);fill.position.set(-7,6,5);this.scene.add(fill);

    this.boothGroup=new THREE.Group();this.scene.add(this.boothGroup);
