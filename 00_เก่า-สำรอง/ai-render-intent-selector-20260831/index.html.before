    const canvas=document.createElement('canvas');canvas.width=ratio>=1?maxSide:Math.max(128,Math.round(maxSide*ratio));canvas.height=ratio>=1?Math.max(128,Math.round(maxSide/ratio)):maxSide;
    const ctx=canvas.getContext('2d'),iw=Math.max(1,image.naturalWidth||image.width||1),ih=Math.max(1,image.naturalHeight||image.height||1),rotation=Number(settings.rotation)||0;
    const pxX=canvas.width/w,pxY=canvas.height/h,offsetX=(Number(settings.offsetX)||0)*pxX,offsetY=(Number(settings.offsetY)||0)*pxY,mode=STICKER_MODES.some(item=>item.k===settings.mode)?settings.mode:'single';
