const SCENE_OBJECT_SCHEMA_VERSION=3;
const MIN_ASSET_DIMENSION=.01,MAX_ASSET_DIMENSION=5;
const MAX_ASSET_WIDTH=MAX_ASSET_DIMENSION,MAX_ASSET_DEPTH=MAX_ASSET_DIMENSION,MAX_ASSET_HEIGHT=MAX_ASSET_DIMENSION;
function assetDimensionValue(value,fallback=MIN_ASSET_DIMENSION){
