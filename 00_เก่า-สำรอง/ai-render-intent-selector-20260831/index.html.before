const MAX_CARPET_TEXTURE_UPLOADS=3;
const MAX_TILE_TEXTURE_UPLOADS=3;
function carpetTextureUploadsFor(spec=S){
  const uploads=Array.isArray(spec.carpetTextureUploads)?spec.carpetTextureUploads.filter(item=>item&&item.data):[];
  if(uploads.length)return uploads.slice(0,MAX_CARPET_TEXTURE_UPLOADS);
  return spec.carpetTextureData?[{id:'legacy-carpet-upload',name:spec.carpetTextureName||'ลายพรมที่อัปโหลด',data:spec.carpetTextureData}]:[];
}
function activeCarpetTexture(spec=S){
  if(spec.carpetTextureMode!=='custom')return null;
  const uploads=carpetTextureUploadsFor(spec);if(!uploads.length)return null;
  return uploads.find(item=>item.id===spec.carpetTextureActiveId)||uploads[0];
}
function tileTextureUploadsFor(spec=S){
  const uploads=Array.isArray(spec.tileTextureUploads)?spec.tileTextureUploads.filter(item=>item&&item.data):[];
  if(uploads.length)return uploads.slice(0,MAX_TILE_TEXTURE_UPLOADS);
  return spec.tileTextureData?[{id:'legacy-upload',name:spec.tileTextureName||'ลายที่อัปโหลด',data:spec.tileTextureData}]:[];
}
function activeTileTexture(spec=S){
  if(spec.tileTextureMode!=='custom')return null;
  const uploads=tileTextureUploadsFor(spec);if(!uploads.length)return null;
  return uploads.find(item=>item.id===spec.tileTextureActiveId)||uploads[0];
}
const FLOOR_STICKER_STEP=.05;
const floorStickerRound=value=>Math.round(Number(value)/FLOOR_STICKER_STEP)*FLOOR_STICKER_STEP;
const floorStickerArea=(spec=S)=>spec.floorStickerData?Math.max(0,Number(spec.floorStickerW)||0)*Math.max(0,Number(spec.floorStickerD)||0):0;
const floorStickerAspect=(spec=S)=>Math.abs((Number(spec.floorStickerRotation)||0)%180)===90?1/Math.max(.01,Number(spec.floorStickerAR)||1):Math.max(.01,Number(spec.floorStickerAR)||1);
function normalizeFloorStickerSize(spec=S){
  const maxW=Math.max(.1,Number(spec.W)||1),maxD=Math.max(.1,Number(spec.D)||1),ar=floorStickerAspect(spec);
  let w=Math.max(.1,Number(spec.floorStickerW)||Math.min(2,maxW)),d=Math.max(.1,Number(spec.floorStickerD)||Math.min(1,maxD));
  if(spec.floorStickerLock!==false){
    d=w/ar;
    if(d>maxD){d=maxD;w=d*ar;}
    if(w>maxW){w=maxW;d=w/ar;}
  }
  spec.floorStickerW=+Math.max(.1,Math.min(maxW,floorStickerRound(w))).toFixed(2);
  spec.floorStickerD=+Math.max(.1,Math.min(maxD,floorStickerRound(d))).toFixed(2);
}
function setFloorStickerDimension(axis,value){
  const numeric=Number(value);if(!Number.isFinite(numeric))return;
  const ar=floorStickerAspect(S);
  if(axis==='w'){
    S.floorStickerW=numeric;if(S.floorStickerLock!==false)S.floorStickerD=numeric/ar;
  }else{
    S.floorStickerD=numeric;if(S.floorStickerLock!==false)S.floorStickerW=numeric*ar;
  }
  normalizeFloorStickerSize(S);
}
function setDefaultFloorStickerSize(aspect){
  S.floorStickerAR=Math.max(.01,Number(aspect)||1);S.floorStickerLock=true;S.floorStickerRotation=0;
  let w=Math.min(S.W,2),d=w/S.floorStickerAR,maxD=Math.min(S.D,1.5);
  if(d>maxD){d=maxD;w=d*S.floorStickerAR;}
  S.floorStickerW=w;S.floorStickerD=d;normalizeFloorStickerSize(S);
  S.floorStickerResetW=S.floorStickerW;S.floorStickerResetD=S.floorStickerD;
}
function setFloorStickerRotation(value){S.floorStickerRotation=((Math.round(Number(value)/90)*90)%360+360)%360;normalizeFloorStickerSize(S);}
const WALL_STICKER_STEP=.05;
const STICKER_MODES=[{k:'single',n:'ภาพเดียว'},{k:'cover',n:'เต็มพื้นที่'},{k:'repeat',n:'ต่อลาย'}];
const stickerModeName=mode=>STICKER_MODES.find(item=>item.k===mode)?.n||'ภาพเดียว';
const wallStickerRound=value=>Math.round(Number(value)/WALL_STICKER_STEP)*WALL_STICKER_STEP;
function wallStickerDefault(){return{data:null,name:'',id:0,ar:2,w:2,h:1,resetW:2,resetH:1,lock:true,rotation:0,mode:'cover',patternSize:1.2,offsetX:0,offsetY:0};}
function wallStickerFor(face,spec=S){
  if(!spec.wallStickers||typeof spec.wallStickers!=='object')spec.wallStickers={};
  if(!spec.wallStickers[face]||typeof spec.wallStickers[face]!=='object')spec.wallStickers[face]=wallStickerDefault();
  return spec.wallStickers[face];
}
function wallFaceLength(spec,face){
  if(face==='back'){const curve=wallCurveInfo(spec);return curve?curve.arcLength:Math.max(.1,Number(spec.W)||1);}
  return Math.max(.1,Number(spec.D)||1);
}
function wallStickerAspect(face,spec=S){
  const sticker=wallStickerFor(face,spec),base=Math.max(.01,Number(sticker.ar)||1);
  return Math.abs((Number(sticker.rotation)||0)%180)===90?1/base:base;
}
function normalizeWallStickerSize(face,spec=S){
  const sticker=wallStickerFor(face,spec),maxW=wallFaceLength(spec,face),maxH=Math.max(.1,Number(spec.H)||1),ar=wallStickerAspect(face,spec);
  let w=Math.max(.1,Number(sticker.w)||Math.min(2,maxW)),h=Math.max(.1,Number(sticker.h)||Math.min(1,maxH));
  if(sticker.lock!==false){h=w/ar;if(h>maxH){h=maxH;w=h*ar;}if(w>maxW){w=maxW;h=w/ar;}}
  sticker.w=+Math.max(.1,Math.min(maxW,wallStickerRound(w))).toFixed(2);
  sticker.h=+Math.max(.1,Math.min(maxH,wallStickerRound(h))).toFixed(2);
  return sticker;
}
function setWallStickerDimension(face,axis,value){
  const numeric=Number(value);if(!Number.isFinite(numeric))return;
  const sticker=wallStickerFor(face),ar=wallStickerAspect(face);
  if(axis==='w'){sticker.w=numeric;if(sticker.lock!==false)sticker.h=numeric/ar;}
  else{sticker.h=numeric;if(sticker.lock!==false)sticker.w=numeric*ar;}
  normalizeWallStickerSize(face);
}
function setDefaultWallStickerSize(face,aspect){
  const sticker=wallStickerFor(face),maxW=wallFaceLength(S,face),maxH=S.H;
  sticker.ar=Math.max(.01,Number(aspect)||1);sticker.lock=true;sticker.rotation=0;
  let w=Math.min(maxW,2),h=w/sticker.ar;if(h>Math.min(maxH,1.5)){h=Math.min(maxH,1.5);w=h*sticker.ar;}
  sticker.w=w;sticker.h=h;normalizeWallStickerSize(face);
  sticker.resetW=sticker.w;sticker.resetH=sticker.h;
}
function setWallStickerRotation(face,value){const sticker=wallStickerFor(face);sticker.rotation=((Math.round(Number(value)/90)*90)%360+360)%360;normalizeWallStickerSize(face);}
function wallStickerArea(face,spec=S){
  const sticker=wallStickerFor(face,spec);return sticker.data?Math.max(0,Number(sticker.w)||0)*Math.max(0,Number(sticker.h)||0):0;
}
const FIXED_BOOTH_TYPES=new Set(['photo360']);
const isFixedBoothType=type=>FIXED_BOOTH_TYPES.has(type);
const PHOTO360_DEFAULT_RADIUS=3.5;
const BRAND_SCALE_MAX=200,BRAND_SCALE_DEFAULT=25,BRAND_MAX_WIDTH_RATIO=.9;
const brandScaleValue=value=>{
  const raw=Number(value);return Math.max(0,Math.min(BRAND_SCALE_MAX,Number.isFinite(raw)?raw:BRAND_SCALE_DEFAULT));
};
/* ค่า 200 ต้องเท่ากับ 90% ของพื้นที่ติดตั้งจริง ส่วนค่าเริ่มต้น 25 ยังคงขนาดใกล้เคียงงานกว้าง 2 ม. */
const brandScaleFraction=(value,availableWidth=6)=>{
  const v=brandScaleValue(value);if(v===0)return 0;
  const maxWidth=Math.max(.1,(Number(availableWidth)||6)*BRAND_MAX_WIDTH_RATIO);
  const defaultFraction=Math.min(1,2/maxWidth);
  return v<=BRAND_SCALE_DEFAULT
    ?defaultFraction*(v/BRAND_SCALE_DEFAULT)
    :defaultFraction+(1-defaultFraction)*((v-BRAND_SCALE_DEFAULT)/(BRAND_SCALE_MAX-BRAND_SCALE_DEFAULT));
};
const logoScaleFactor=(value,availableWidth=6)=>brandScaleFraction(value,availableWidth);
const nameScaleFactor=(value,availableWidth=6)=>brandScaleFraction(value,availableWidth);
const serializeBoothSpec=()=>JSON.stringify(BoothSpec);
const objectEditor={selectedId:null,selectedIds:[],multiSelect:false,past:[],future:[],seq:0,moveMode:'smart'};
const logoEditor={selected:false};
