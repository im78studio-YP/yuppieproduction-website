      offset:{x:Number(obj.attachment.offset?.x)||0,y:Number(obj.attachment.offset?.y)||0,z:Number(obj.attachment.offset?.z)||0},status:String(obj.attachment.status||'pending')};
  }else obj.attachment=null;
  const transform=obj.transform&&typeof obj.transform==='object'?obj.transform:{};
  transform.flipX=transform.flipX===true;transform.flipY=transform.flipY===true;obj.transform=transform;
  const appearance=obj.appearance&&typeof obj.appearance==='object'?obj.appearance:{};
  appearance.color=/^#[0-9a-fA-F]{6}$/.test(String(appearance.color||''))?String(appearance.color).toLowerCase():null;
  const customGLB=item?.customAsset===true||/^my-asset-/.test(String(obj.catalogId||''));
  appearance.mode=SCENE_APPEARANCE_MODES.includes(appearance.mode)?appearance.mode:(appearance.color?'tint':customGLB?'solid':'original');
  if((appearance.mode==='tint'||appearance.mode==='solid')&&!appearance.color)appearance.color='#f5f5f5';
  appearance.textureData=typeof appearance.textureData==='string'&&appearance.textureData.startsWith('data:image/')?appearance.textureData:null;
  appearance.textureName=appearance.textureData?String(appearance.textureName||'สติ๊กเกอร์ Asset'):'';
  appearance.textureId=appearance.textureData?String(appearance.textureId||Date.now()):'';
  obj.appearance=appearance;
  obj.label=String(obj.label||'').slice(0,60);
  if(!obj.originalSize||typeof obj.originalSize!=='object')obj.originalSize={w:Number(obj.size?.w)||1,d:Number(obj.size?.d)||1,h:Number(obj.size?.h)||1};
  return obj;
}
function entranceFrameDefaults(spec=S){
  return{projection:Math.min(2.4,Math.max(.5,Number(spec.D)||3)),height:Math.min(2.4,Math.max(.5,Number(spec.H)||2.4)),
    pierWidth:Math.min(1,Math.max(.3,Number(spec.W)||6)),thickness:.15,color:'#f2f3f5'};
}
function normalizeEntranceFrameObject(obj,spec=S){
  if(!isEntranceFrameObject(obj))return obj;
  const defaults=entranceFrameDefaults(spec),config=obj.structure&&typeof obj.structure==='object'?obj.structure:{};
  const projection=assetDimensionValue(config.projection,defaults.projection);
  /* The entrance frame is an independent Scene Asset.  Its default follows
     the booth wall, but customers may intentionally extend it above the wall. */
  const height=assetDimensionValue(config.height,defaults.height);
  const pierWidth=assetDimensionValue(config.pierWidth,defaults.pierWidth);
  const thickness=assetDimensionValue(config.thickness,defaults.thickness);
  const color=/^#[0-9a-fA-F]{6}$/.test(String(config.color||''))?String(config.color).toLowerCase():defaults.color;
  obj.type='entranceFrame';obj.structure={projection,height,pierWidth,thickness,color};
  obj.size={w:pierWidth,d:projection,h:height};obj.unitPrice=Math.round(2*(pierWidth*height+pierWidth*projection)*3200);obj.rotationY=0;
  return obj;
}
function entranceFrameArea(obj){
  const cfg=normalizeEntranceFrameObject(obj).structure;
  return 2*(cfg.pierWidth*cfg.height+cfg.pierWidth*cfg.projection);
}
function localScenePorts(obj){
  if(!obj)return[];
  if(isEntranceFrameObject(obj)){
    const cfg=normalizeEntranceFrameObject(obj).structure,z=cfg.projection/2-cfg.thickness/2;
    return[
      {id:'frame-left-front',role:'structure-joint',position:{x:-cfg.pierWidth/2,y:0,z}},
      {id:'frame-right-front',role:'structure-joint',position:{x:cfg.pierWidth/2,y:0,z}}
    ];
  }
  const item=objectCatalogDef(obj.catalogId),ports=Array.isArray(obj.ports)&&obj.ports.length?obj.ports:(Array.isArray(item?.ports)?item.ports:[]);
  return ports.filter(port=>port&&typeof port==='object'&&port.id&&port.position).map(port=>({id:String(port.id),role:String(port.role||'joint'),
    position:{x:Number(port.position.x)||0,y:Number(port.position.y)||0,z:Number(port.position.z)||0}}));
}
function sceneTargetNode(id,spec=S){
  if(id==='storage-room'){
    if(!hasStore())return null;
    const t=boothWallThickness(spec),G=storeGeom(t),frontZ=G.y+G.d-t/2;
    return{id:'storage-room',type:'storage-room',dimensions:{width:G.w,depth:G.d,height:G.h},
      ports:[{id:'storage-left-front',role:'structure-joint',position:{x:G.x,y:0,z:frontZ}},
        {id:'storage-right-front',role:'structure-joint',position:{x:G.x+G.w,y:0,z:frontZ}}]};
  }
  const obj=(spec.objects||[]).find(item=>item.id===id);if(!obj)return null;
  const rad=((Number(obj.rotationY)||0)%360)*Math.PI/180,c=Math.cos(rad),s=Math.sin(rad),base=obj.position||{};
  return{id:obj.id,type:obj.type,dimensions:{width:obj.size?.w||0,depth:obj.size?.d||0,height:obj.size?.h||0},ports:localScenePorts(obj).map(port=>({
    ...port,position:{x:(Number(base.x)||0)+port.position.x*c+port.position.z*s,y:(Number(base.y)||0)+port.position.y,
      z:(Number(base.z)||0)-port.position.x*s+port.position.z*c}}))};
