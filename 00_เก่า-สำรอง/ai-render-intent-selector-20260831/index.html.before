    const canvas=this.renderer.domElement;
    canvas.removeEventListener('pointerdown',this.onObjectPointerDown,true);
    canvas.removeEventListener('pointermove',this.onObjectPointerMove);canvas.removeEventListener('pointerup',this.onObjectPointerUp);
    canvas.removeEventListener('pointercancel',this.onObjectPointerUp);
    canvas.removeEventListener('lostpointercapture',this.onObjectLostPointerCapture);
    canvas.removeEventListener('pointerleave',this.onObjectPointerLeave);
    this.resizeObserver.disconnect();this.controls.removeEventListener('change',this.onControlsChange);this.controls.dispose();
    this.scene.remove(this.boothGroup);disposeThreeObject(this.boothGroup);this.renderer.dispose();
    this.fixtureTemplates.forEach(template=>{template.traverse(o=>{if(o.userData)delete o.userData.sharedAsset;});disposeThreeObject(template);});
    this.fixtureTemplates.clear();this.fixtureLoads.clear();this.fixtureErrors.clear();
    this.furnitureTemplates.forEach(template=>{template.traverse(o=>{if(o.userData)delete o.userData.sharedAsset;});disposeThreeObject(template);});
    this.furnitureTemplates.clear();this.furnitureLoads.clear();this.furnitureErrors.clear();
  }
  start(){
    if(this.raf||!this.active)return;
    const tick=()=>{if(!this.active){this.raf=0;return;}
      this.controls.update();this.renderer.render(this.scene,this.camera);this.raf=requestAnimationFrame(tick);};
    tick();
  }
  resize(){
    const r=this.host.getBoundingClientRect(),w=Math.max(1,Math.floor(r.width)),h=Math.max(1,Math.floor(r.height));
    if(w===this.lastSize[0]&&h===this.lastSize[1])return;
    this.lastSize=[w,h];this.renderer.setSize(w,h,false);this.camera.aspect=w/h;
    this.camera.updateProjectionMatrix();this.renderer.render(this.scene,this.camera);this.commitCameraState();
  }
  cameraManifest(viewportOverride=null){
    const r=this.host.getBoundingClientRect(),position=this.camera.position,target=this.controls.target,up=this.camera.up;
    const viewportWidth=Math.max(1,Math.floor(viewportOverride?.width||r.width||this.lastSize[0]||1));
    const viewportHeight=Math.max(1,Math.floor(viewportOverride?.height||r.height||this.lastSize[1]||1));
    const viewportPixelRatio=viewportOverride?.pixelRatio??this.renderer.getPixelRatio();
    return{id:'camera-active',projection:'perspective',preset:this.currentView||'custom',
      position:manifestVector(position.x,position.y,position.z),target:manifestVector(target.x,target.y,target.z),up:manifestVector(up.x,up.y,up.z),
      fov:manifestNumber(this.camera.fov),near:manifestNumber(this.camera.near),far:manifestNumber(this.camera.far),aspect:manifestNumber(this.camera.aspect,6),
      viewport:{width:viewportWidth,height:viewportHeight,aspect:manifestNumber(viewportWidth/viewportHeight,6),pixelRatio:manifestNumber(viewportPixelRatio,3)}};
  }
  commitCameraState(){
    if(!this.camera||!this.controls)return null;
    if(this.camera.position.distanceToSquared(this.controls.target)<1e-8)return null;
    const state=this.cameraManifest();normalizeAIRenderingSettings(BoothSpec).camera=state;return state;
  }
  pendingSceneAssets(){
    const promises=[];
    if(this.floorImagePromise)promises.push(this.floorImagePromise);
    if(this.downlightLoad)promises.push(this.downlightLoad);
    this.fixtureLoads.forEach(promise=>promises.push(promise));
    this.furnitureLoads.forEach(promise=>promises.push(promise));
    this.wallStickerLoads.forEach(promise=>promises.push(promise));
    return [...new Set(promises.filter(promise=>promise&&typeof promise.then==='function'))];
  }
  async waitForSceneAssets(timeoutMs=10000){
    const deadline=Date.now()+Math.max(0,Number(timeoutMs)||0);
    for(let pass=0;pass<5;pass++){
      const pending=this.pendingSceneAssets();
      if(!pending.length)break;
      const remaining=deadline-Date.now();if(remaining<=0)break;
      let timeoutId=0;
      const outcome=await Promise.race([
        Promise.allSettled(pending).then(()=> 'settled'),
        new Promise(resolve=>{timeoutId=setTimeout(()=>resolve('timeout'),remaining);})
      ]);
      if(timeoutId)clearTimeout(timeoutId);
      if(outcome==='timeout')break;
      this.currentKey='';this.update(BoothSpec);
    }
    this.currentKey='';this.update(BoothSpec);
    return this.pendingSceneAssets().length===0;
  }
  cleanScreenshotFileName(){
    const now=new Date(),pad=value=>String(value).padStart(2,'0');
    const stamp=now.getFullYear()+pad(now.getMonth()+1)+pad(now.getDate())+'-'+pad(now.getHours())+pad(now.getMinutes())+pad(now.getSeconds());
    return 'YP-Booth-Clean-'+manifestNumber(BoothSpec.W)+'x'+manifestNumber(BoothSpec.D)+'-'+stamp+'.png';
  }
  async exportCleanScreenshot(options={}){
    await this.waitForSceneAssets(options.assetTimeoutMs??10000);
    const T=this.THREE,sourceWidth=Math.max(1,this.lastSize[0]||Math.floor(this.host.getBoundingClientRect().width)||16);
    const sourceHeight=Math.max(1,this.lastSize[1]||Math.floor(this.host.getBoundingClientRect().height)||9);
    const sourceAspect=sourceWidth/sourceHeight,minLongEdge=Math.max(1536,Math.floor(Number(options.minLongEdge)||1536));
    const maxLongEdge=Math.max(minLongEdge,Math.floor(Number(options.maxLongEdge)||2048));
    const requestedLongEdge=Math.floor(Number(options.longEdge)||minLongEdge);
    const longEdge=Math.max(minLongEdge,Math.min(maxLongEdge,requestedLongEdge));
    const width=sourceAspect>=1?longEdge:Math.max(1,Math.round(longEdge*sourceAspect));
    const height=sourceAspect>=1?Math.max(1,Math.round(longEdge/sourceAspect)):longEdge;
    const oldSize=this.renderer.getSize(new T.Vector2()),oldPixelRatio=this.renderer.getPixelRatio(),oldAspect=this.camera.aspect;
    const oldBackground=this.scene.background,oldControlsEnabled=this.controls.enabled,wasAnimating=!!this.raf;
    const hidden=[];
    this.boothGroup.traverse(object=>{
      const name=object.name||'';
      if(name==='scene-ground'||name==='object-selection'||name==='brand-selection'||name==='brand-selection-proxy'||
        name==='object-anchor-guides'||name==='magnetic-snap-preview'||
        name==='booth-wall-back-curved-edge'||name.startsWith('booth-dimension-')){
        hidden.push([object,object.visible]);object.visible=false;
      }
    });
    if(this.raf)cancelAnimationFrame(this.raf);this.raf=0;this.controls.enabled=false;
    try{
      this.scene.background=new T.Color(options.background||'#e8eaee');
      this.renderer.setPixelRatio(1);this.renderer.setSize(width,height,false);
      this.camera.aspect=width/height;this.camera.updateProjectionMatrix();this.renderer.render(this.scene,this.camera);
      const canvas=this.renderer.domElement;
      const blob=await new Promise((resolve,reject)=>canvas.toBlob(value=>value?resolve(value):reject(new Error('ไม่สามารถสร้างไฟล์ PNG ได้')),'image/png'));
      const fileName=String(options.fileName||this.cleanScreenshotFileName()).replace(/[\\/:*?"<>|]+/g,'-');
      const camera=this.cameraManifest({width,height,pixelRatio:1}),manifest=buildGeometryManifest(BoothSpec);manifest.camera=camera;
      const maxBytes=Math.max(1,Math.floor(Number(options.maxBytes)||4*1024*1024));
      const preflight={mimeType:blob.type||'image/png',bytes:blob.size,width,height,aspect:manifestNumber(width/height,6),
        sourceAspect:manifestNumber(sourceAspect,6),longEdge,maxLongEdge,withinByteLimit:blob.size<=maxBytes};
      if(!preflight.withinByteLimit)console.warn('[AI Render] Clean Screenshot เกินขนาดแนะนำ',{bytes:blob.size,maxBytes,width,height});
      const preview={kind:'clean-screenshot',width,height,aspect:preflight.aspect,fileName,bytes:blob.size,createdAt:new Date().toISOString(),camera};
      normalizeAIRenderingSettings(BoothSpec).preview=preview;
      const dataUrl=options.includeDataUrl?canvas.toDataURL('image/png'):null;
      if(options.download){
        const url=URL.createObjectURL(blob),link=document.createElement('a');link.href=url;link.download=fileName;link.hidden=true;
        document.body.appendChild(link);link.click();link.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);
      }
      return{blob,dataUrl,width,height,aspect:width/height,fileName,camera,manifest,preflight};
    }finally{
      hidden.forEach(([object,visible])=>{object.visible=visible;});
      this.scene.background=oldBackground;this.renderer.setPixelRatio(oldPixelRatio);this.renderer.setSize(oldSize.x,oldSize.y,false);
      this.camera.aspect=oldAspect;this.camera.updateProjectionMatrix();this.controls.enabled=oldControlsEnabled;
      this.renderer.render(this.scene,this.camera);if(wasAnimating&&this.active)this.start();
    }
  }
  setRayFromEvent(event){
    const r=this.renderer.domElement.getBoundingClientRect();
    this.pointer.set(((event.clientX-r.left)/r.width)*2-1,-((event.clientY-r.top)/r.height)*2+1);
    this.raycaster.setFromCamera(this.pointer,this.camera);
  }
  floorPoint(event){
    this.setRayFromEvent(event);this.dragPlane.constant=-(BoothSpec.raise/100);
    return this.raycaster.ray.intersectPlane(this.dragPlane,this.dragPoint);
  }
  horizontalPoint(event,elevation=0){
    this.setRayFromEvent(event);this.dragPlane.constant=-((BoothSpec.raise/100)+(Number(elevation)||0));
    return this.raycaster.ray.intersectPlane(this.dragPlane,this.dragPoint);
  }
  prepareVerticalDrag(hitPoint){
    const normal=new this.THREE.Vector3();this.camera.getWorldDirection(normal);normal.y=0;
    if(normal.lengthSq()<.0001)normal.set(0,0,1);else normal.normalize();
    this.verticalDragPlane.setFromNormalAndCoplanarPoint(normal,hitPoint);return this.verticalDragPlane;
  }
  verticalPoint(event){
    this.setRayFromEvent(event);return this.raycaster.ray.intersectPlane(this.verticalDragPlane,this.verticalDragPoint);
  }
  surfaceSnapTargets(selectedRoot){
    const targets=[],ignoredName=/^(object-selection|brand-|spotlight|booth-dimension-|floor-sticker-|wall-sticker-)/;
    this.boothGroup.traverse(node=>{
      if(!node.isMesh||!node.visible||node===this.selectionHelper||node.userData?.brandPlacement||node.userData?.anchorGuide)return;
      let parent=node,insideSelected=false;while(parent){if(parent===selectedRoot){insideSelected=true;break;}parent=parent.parent;}
      if(insideSelected||ignoredName.test(String(node.name||'')))return;targets.push(node);
    });
    return targets;
  }
  surfacePlacement(event,obj,root,drag){
    this.setRayFromEvent(event);const hit=this.raycaster.intersectObjects(this.surfaceSnapTargets(root),false)[0];
    if(!hit||!hit.face)return null;
    const normal=hit.face.normal.clone().transformDirection(hit.object.matrixWorld).normalize(),floorY=BoothSpec.raise/100,oriented=sceneObjectOrientedSize(obj);
    const footprint=footprintSize(oriented,obj.rotationY||0),grab=drag.grabOffset;
    let x=hit.point.x-grab.x,y=hit.point.y-floorY-grab.y,z=hit.point.z-grab.z,surface='structure',verticalSurface=false;
    if(Math.abs(normal.y)>=.58){
      verticalSurface=true;
      if(normal.y>0){y=hit.point.y-floorY;surface=hit.object.name==='booth-floor'?'floor':'top';}
      else{y=hit.point.y-floorY-oriented.h;surface='ceiling';}
    }else{
      const radius=Math.abs(normal.x)*footprint.w/2+Math.abs(normal.z)*footprint.d/2;
      x=hit.point.x+normal.x*radius;z=hit.point.z+normal.z*radius;surface='wall';
    }
    y=clampNumber(y,-floorY,Math.max(10,BoothSpec.H*3));
    const targetObjectId=hit.object.userData?.objectId;
    const targetId=targetObjectId||(String(hit.object.name||'').startsWith('storage-')?'storage-room':String(hit.object.name||'surface'));
    return{x:+(verticalSurface?placementValue(x):x).toFixed(3),y:+(verticalSurface?y:placementValue(y)).toFixed(3),
      z:+(verticalSurface?placementValue(z):z).toFixed(3),surface,targetId};
  }
  screenAnchorSnap(event,obj,drag){
    if(!drag.sourceAnchorId||S.magneticSnap===false||obj.placement?.anchorSnap===false)return null;
    const source=sceneObjectSnapAnchors(obj).find(anchor=>anchor.id===drag.sourceAnchorId);if(!source)return null;
    const T=this.THREE,rect=this.renderer.domElement.getBoundingClientRect(),floorY=BoothSpec.raise/100,
      threshold=event.pointerType==='touch'?36:24,offset=drag.sourceAnchorOffset||{x:0,y:0,z:0};let best=null;
    boothSnapAnchors(S,obj.id).forEach(target=>{
      if(target.kind!==source.kind)return;
      const projected=new T.Vector3(target.position.x,floorY+target.position.y,target.position.z).project(this.camera);
      if(projected.z < -1||projected.z > 1)return;
      const clientX=rect.left+(projected.x+1)*rect.width/2,clientY=rect.top+(1-projected.y)*rect.height/2,
        distance=Math.hypot(event.clientX-clientX,event.clientY-clientY);
      if(distance>threshold||best&&distance>=best.distance)return;
      best={distance,sourceAnchorId:source.id,targetId:target.targetId,targetAnchorId:target.id,kind:source.kind,
        position:{x:+(target.position.x-offset.x).toFixed(3),y:+(target.position.y-offset.y).toFixed(3),z:+(target.position.z-offset.z).toFixed(3)},
        previewFrom:{...source.position},previewTo:{...target.position}};
    });
    return best;
  }
  smartSurfacePlacement(event,obj,root,drag){
    if(!drag.sourceAnchorId||obj.placement?.surfaceSnap===false)return null;
    this.setRayFromEvent(event);const hit=this.raycaster.intersectObjects(this.surfaceSnapTargets(root),false)[0];if(!hit||!hit.face)return null;
    const normal=hit.face.normal.clone().transformDirection(hit.object.matrixWorld).normalize(),floorY=BoothSpec.raise/100,
      offset=drag.sourceAnchorOffset||{x:0,y:0,z:0},point=hit.point.clone();
    if(hit.object.name==='scene-ground')point.y=floorY;
    let surface='structure';if(Math.abs(normal.y)>=.58)surface=normal.y>0?(hit.object.name==='booth-floor'||hit.object.name==='scene-ground'?'floor':'top'):'ceiling';else surface='wall';
    const targetObjectId=hit.object.userData?.objectId,targetId=targetObjectId||(String(hit.object.name||'').startsWith('storage-')?'storage-room':String(hit.object.name||'surface')),
      position={x:+(point.x-offset.x).toFixed(3),y:+clampNumber(point.y-floorY-offset.y,-floorY,Math.max(10,BoothSpec.H*3)).toFixed(3),z:+(point.z-offset.z).toFixed(3)},
      source=sceneObjectSnapAnchors(obj).find(anchor=>anchor.id===drag.sourceAnchorId);
    return{...position,surface,targetId,preview:{sourceAnchorId:drag.sourceAnchorId,targetId,targetAnchorId:'surface-point',kind:'surface',
      previewFrom:source?{...source.position}:{x:obj.position.x,y:obj.position.y,z:obj.position.z},previewTo:{x:point.x,y:point.y-floorY,z:point.z}}};
  }
  clearAnchorGuides(){
    this.hoveredAnchorMarker=null;this.activeAnchorMarker=null;
    if(this.renderer?.domElement&&!this.pointerDrag)this.renderer.domElement.style.cursor='';
    if(!this.anchorGuideGroup)return;const parent=this.anchorGuideGroup.parent;if(parent)parent.remove(this.anchorGuideGroup);
    disposeThreeObject(this.anchorGuideGroup);this.anchorGuideGroup=null;
  }
  styleAnchorMarker(marker,state='idle'){
    if(!marker?.material)return;
    const baseColor=Number(marker.userData.anchorBaseColor)||0xffffff,active=state!=='idle';
    marker.material.color.setHex(state==='snapped'?0x24d26f:active?0xff3b30:baseColor);
    marker.material.opacity=state==='snapped'?1:(active ? .98 : (marker.userData.anchorBaseOpacity??.82));
    marker.scale.setScalar(state==='snapped'?1.9:active?1.65:1);
    marker.userData.anchorVisualState=state;
  }
  setHoveredAnchorMarker(marker){
    if(this.pointerDrag)return;
    if(this.hoveredAnchorMarker&&this.hoveredAnchorMarker!==marker)this.styleAnchorMarker(this.hoveredAnchorMarker,'idle');
    this.hoveredAnchorMarker=marker||null;
    if(marker)this.styleAnchorMarker(marker,'hover');
    if(this.renderer?.domElement)this.renderer.domElement.style.cursor=marker?'grab':'';
    if(this.active)this.renderer.render(this.scene,this.camera);
  }
  pickAnchorMarker(event){
    if(objectEditor.moveMode!=='smart'||!this.anchorGuideGroup?.children?.length)return null;
    const rect=this.renderer.domElement.getBoundingClientRect(),hitRadius=event.pointerType==='touch'?28:22;
    if(!rect.width||!rect.height)return null;
    let best=null,bestDistance=Infinity;
    this.anchorGuideGroup.children.forEach(marker=>{
      if(!marker.visible||!marker.userData?.anchorGuide||!marker.userData.snapAnchorId)return;
      marker.getWorldPosition(this.anchorScreenPoint);this.anchorScreenPoint.project(this.camera);
      if(this.anchorScreenPoint.z < -1||this.anchorScreenPoint.z > 1)return;
      const x=rect.left+(this.anchorScreenPoint.x+1)*rect.width/2,y=rect.top+(1-this.anchorScreenPoint.y)*rect.height/2,
        distance=Math.hypot(event.clientX-x,event.clientY-y);
      if(distance<=hitRadius&&distance<bestDistance){best=marker;bestDistance=distance;}
    });
    return best;
  }
  updateAnchorHover(event){
    if(this.pointerDrag||!this.anchorGuideGroup?.children?.length||event.pointerType==='touch')return;
    this.setHoveredAnchorMarker(this.pickAnchorMarker(event));
  }
  setActiveAnchorMarker(marker){
    if(this.hoveredAnchorMarker&&this.hoveredAnchorMarker!==marker)this.styleAnchorMarker(this.hoveredAnchorMarker,'idle');
    this.hoveredAnchorMarker=null;this.activeAnchorMarker=marker||null;
    if(marker)this.styleAnchorMarker(marker,'active');
    if(this.renderer?.domElement)this.renderer.domElement.style.cursor=marker?'grabbing':'';
    const status=document.getElementById('objectLayoutStatus');if(status&&marker)status.textContent='ล็อก Point แล้ว ลากไปยังจุด Snap';
  }
  setActiveAnchorSnapped(snapped){
    if(!this.activeAnchorMarker)return;this.styleAnchorMarker(this.activeAnchorMarker,snapped?'snapped':'active');
    const status=document.getElementById('objectLayoutStatus');if(status)status.textContent=snapped?'Snap สำเร็จ ปล่อยเมาส์ได้':'กำลังลาก Point ไปยังจุด Snap';
  }
  releaseActiveAnchorMarker(){
    if(this.activeAnchorMarker)this.styleAnchorMarker(this.activeAnchorMarker,'idle');
    this.activeAnchorMarker=null;if(this.renderer?.domElement)this.renderer.domElement.style.cursor='';
  }
  buildObjectAnchorGuides(id){
    this.clearAnchorGuides();const obj=objectById(id);if(!obj||objectLocked(obj)||S.magneticSnap===false||obj.placement?.anchorSnap===false||objectEditor.moveMode==='surface')return;
    const T=this.THREE,group=new T.Group();group.name='object-anchor-guides';group.renderOrder=28;
    const radius=clampNumber(Math.max(S.W,S.D,S.H)*.008,.035,.065),floorY=BoothSpec.raise/100;
    sceneObjectSnapAnchors(obj).filter(anchor=>objectEditor.moveMode==='smart'?true:objectEditor.moveMode==='plane'?anchor.level==='base':
      objectEditor.moveMode==='height'?(anchor.kind==='corner'||anchor.kind==='center'):false).forEach(anchor=>{
      const color=anchor.kind==='corner'?0xf0b53a:anchor.kind==='edge'?0x62b9ff:0xffffff,
        material=new T.MeshBasicMaterial({color,transparent:true,opacity:anchor.level==='base'?.96:.7,depthTest:false});
      const marker=new T.Mesh(new T.SphereGeometry(radius,12,8),material);marker.name='object-anchor-'+anchor.id;
      marker.position.set(anchor.position.x,floorY+anchor.position.y,anchor.position.z);marker.renderOrder=28;
      marker.userData.anchorGuide=true;marker.userData.objectId=id;marker.userData.snapAnchorId=anchor.id;
      marker.userData.anchorBaseColor=color;marker.userData.anchorBaseOpacity=anchor.level==='base'?.96:.7;group.add(marker);
    });
    this.anchorGuideGroup=group;this.boothGroup.add(group);
  }
  updateObjectAnchorGuides(id){
    if(!this.anchorGuideGroup)return;const obj=objectById(id),floorY=BoothSpec.raise/100;if(!obj)return;
    const anchors=new Map(sceneObjectSnapAnchors(obj).map(anchor=>[anchor.id,anchor]));
    this.anchorGuideGroup.children.forEach(marker=>{const anchor=anchors.get(marker.userData.snapAnchorId);if(anchor)marker.position.set(anchor.position.x,floorY+anchor.position.y,anchor.position.z);});
  }
  clearMagneticSnapPreview(){
    if(!this.snapPreviewGroup)return;const parent=this.snapPreviewGroup.parent;if(parent)parent.remove(this.snapPreviewGroup);
    disposeThreeObject(this.snapPreviewGroup);this.snapPreviewGroup=null;
  }
  showMagneticSnapPreview(match){
    this.clearMagneticSnapPreview();if(!match)return;
    const T=this.THREE,group=new T.Group(),floorY=BoothSpec.raise/100,from=new T.Vector3(match.previewFrom.x,floorY+match.previewFrom.y,match.previewFrom.z),
      to=new T.Vector3(match.previewTo.x,floorY+match.previewTo.y,match.previewTo.z),color=0x46d79a;
    group.name='magnetic-snap-preview';group.userData.anchorGuide=true;
