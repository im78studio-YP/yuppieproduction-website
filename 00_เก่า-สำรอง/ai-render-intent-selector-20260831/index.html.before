let lastValidLayout=null;

/* ================= helpers ================= */
const el=(t,c,h)=>{const e=document.createElement(t);if(c)e.className=c;if(h!=null)e.innerHTML=h;return e;};
const fmt=n=>Math.round(n).toLocaleString('en-US');
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
const objectSnapshot=()=>JSON.stringify({objects:S.objects,sceneItemState:S.sceneItemState||{}});
const objectById=id=>S.objects.find(o=>o.id===id)||null;
const objectLocked=obj=>obj?.locked===true;
const ASSET_LIST_CATEGORIES=[
  {key:'ai-suggested',label:'AI Suggested'},
  {key:'structure',label:'โครงสร้าง'},
  {key:'branding',label:'โลโก้และกราฟิก'},
  {key:'furniture',label:'เฟอร์นิเจอร์'},
  {key:'equipment',label:'อุปกรณ์'},
  {key:'lighting',label:'แสง'},
  {key:'decor',label:'ของตกแต่ง'}
];
const assetListUI={open:false,query:'',filter:'all',anchorId:null,lastPrimary:null};
const aiConceptUI={proposal:null,suggestions:[],selectedIds:new Set(),lastReport:null,imageUrl:''};
function systemSceneItems(){
  const items=[{id:'system-floor',name:'พื้นบูธ',type:'พื้น',category:'structure',icon:'▱',system:true,locked:true}];
  (typ().walls||[]).forEach(face=>items.push({id:'system-wall-'+face,name:{back:'ผนังหลัง',left:'ผนังซ้าย',right:'ผนังขวา'}[face]||'ผนัง',type:'ผนัง',category:'structure',icon:'▥',system:true,locked:true}));
  if(hasStore())items.push({id:'system-storage',name:'ห้องเก็บของ',type:'ห้อง',category:'structure',icon:'▣',system:true,locked:true});
  if(S.type!=='island')items.push({id:'system-brand',name:'โลโก้และชื่อแบรนด์',type:'กราฟิกแบรนด์',category:'branding',icon:'LOGO',system:true,locked:true});
  if(S.floorStickerData)items.push({id:'system-floor-sticker',name:'สติ๊กเกอร์พื้น',type:'กราฟิกพื้น',category:'branding',icon:'IMG',system:true,locked:true});
  (S.wallStickerFaces||[]).filter(face=>wallStickerFor(face)?.data).forEach(face=>items.push({id:'system-wall-sticker-'+face,name:'สติ๊กเกอร์'+({back:'ผนังหลัง',left:'ผนังซ้าย',right:'ผนังขวา'}[face]||'ผนัง'),type:'กราฟิกผนัง',category:'branding',icon:'IMG',system:true,locked:true}));
  if(S.lights)items.push({id:'system-lights',name:'ชุดไฟบูธ',type:'แสง',category:'lighting',icon:'LIGHT',system:true,locked:true});
  if(S.type==='photo360')items.push({id:'system-photo360',name:'แท่นถ่ายภาพ 360',type:'แท่น',category:'equipment',icon:'360',system:true,locked:true});
  return items.map(item=>{const state=(S.sceneItemState||{})[item.id]||{};return{...item,name:state.name||item.name,visible:state.visible!==false,locked:true};});
}
function objectSceneCategory(obj,item=objectCatalogDef(obj?.catalogId)){
  const category=item?.category||'',type=String(obj?.type||item?.type||'').toLowerCase(),name=String(obj?.label||item?.name||'').toLowerCase();
  if(category==='structure'||/entrance|beam|structure|กรอบ|คาน/.test(type+' '+name))return'structure';
  if(category==='reception'||category==='hospitality'||/counter|chair|table|shelf|display|เคาน์เตอร์|เก้าอี้|โต๊ะ|ชั้น/.test(type+' '+name))return'furniture';
  if(/light|lamp|downlight|ไฟ|โคม/.test(type+' '+name))return'lighting';
  if(category==='decor'||/plant|decor|ต้นไม้|ตกแต่ง/.test(type+' '+name))return'decor';
  if(category==='media'||/sign|screen|logo|graphic|ป้าย|จอ/.test(type+' '+name))return'equipment';
  return'equipment';
}
function sceneItems(){
  const suggestions=aiConceptUI.suggestions.map(suggestion=>({
    id:'ai-suggested-'+suggestion.id,name:suggestion.name,type:suggestion.status||'AI Suggested',category:'ai-suggested',icon:'AI',thumb:'',system:false,
    aiSuggested:true,visible:true,locked:true,suggestion
  }));
  return systemSceneItems().concat(S.objects.map(obj=>{const item=objectCatalogDef(obj.catalogId);normalizeSceneObjectModel(obj,item);return{
    id:obj.id,name:selectedAssetName(obj),type:item?.name||obj.type||'Asset',category:objectSceneCategory(obj,item),icon:item?.icon||'OBJ',thumb:item?.thumbUrl||'',system:false,
    visible:obj.visible!==false,locked:objectLocked(obj),object:obj,item};}),suggestions);
}
const sceneItemById=id=>sceneItems().find(item=>item.id===id)||null;
const sceneItemExists=id=>!!sceneItemById(id);
const sceneItemVisible=id=>sceneItemById(id)?.visible!==false;
const selectedSceneItemIds=()=>{
  const valid=[...new Set([...(objectEditor.selectedIds||[]),objectEditor.selectedId].filter(id=>sceneItemExists(id)))];
  objectEditor.selectedIds=valid;
  if(objectEditor.selectedId&&!valid.includes(objectEditor.selectedId))objectEditor.selectedId=valid.at(-1)||null;
  return valid;
};
const selectedObjectIds=()=>selectedSceneItemIds().filter(id=>objectById(id));
const selectedObjects=()=>selectedObjectIds().map(objectById).filter(Boolean);
const groupObjectIds=groupId=>groupId?S.objects.filter(obj=>obj.groupId===groupId).map(obj=>obj.id):[];
function setObjectSelection(ids=[],primaryId=null){
  const valid=[...new Set(ids)].filter(id=>sceneItemExists(id));
  objectEditor.selectedIds=valid;
  objectEditor.selectedId=primaryId&&valid.includes(primaryId)?primaryId:(valid.at(-1)||null);
  if(!valid.length)resetAssetContextOpenState();
}
function restoreObjectSnapshot(snapshot){
  const parsed=JSON.parse(snapshot);if(Array.isArray(parsed)){S.objects=parsed;return;}
  S.objects=Array.isArray(parsed?.objects)?parsed.objects:[];S.sceneItemState=parsed?.sceneItemState&&typeof parsed.sceneItemState==='object'?parsed.sceneItemState:{};
}
function resetBoothToInitialState(){
  const confirmed=window.confirm('คืนค่าการออกแบบทั้งหมดให้เหมือนตอนเปิดเว็บครั้งแรก?\nAsset และการแก้ไขปัจจุบันทั้งหมดจะถูกล้าง');
  if(!confirmed)return;

  const initial=JSON.parse(INITIAL_BOOTH_SPEC_JSON);
  Object.keys(S).forEach(key=>delete S[key]);
  Object.assign(S,initial);

  setObjectSelection([]);
  objectEditor.multiSelect=false;
  objectEditor.moveMode='smart';
  objectEditor.past.length=0;
  objectEditor.future.length=0;
  objectEditor.seq=0;
  logoEditor.selected=false;
  aiConceptUI.proposal=null;aiConceptUI.suggestions=[];aiConceptUI.selectedIds.clear();aiConceptUI.lastReport=null;
  lastValidLayout=null;

  closeAssetSettings();
  document.querySelectorAll('input[type="file"]').forEach(input=>{input.value='';});
  const brandInput=document.getElementById('brand');
  if(brandInput)brandInput.value=S.brand;
  const catalogStatus=document.getElementById('objectLayoutStatus');
  if(catalogStatus){catalogStatus.textContent='';catalogStatus.className='object-layout-status';}

  if(threeRenderer){
    threeRenderer.currentKey='';
    threeRenderer.currentView='perspective';
    threeRenderer.hasFramed=false;
    threeRenderer.clearMagneticSnapPreview?.();
  }
  syncDims();
  syncLayoutInputs();
  sync();
}
const objectCatalogDef=id=>allObjectCatalog().find(o=>o.catalogId===id)||null;
function normalizeAIStagingSettings(spec=S){
  const api=globalThis.YPAIStaging;
  spec.aiStaging=api?.normalizeAIStaging(spec.aiStaging)||defaultAIStagingSettings();
  const freedom=api?.normalizeAIRenderFreedom({geometryFidelity:spec.geometryFidelity,stagingFreedom:spec.stagingFreedom})||{
    geometryFidelity:10,stagingFreedom:6};
  spec.geometryFidelity=freedom.geometryFidelity;
  spec.stagingFreedom=freedom.stagingFreedom;
  /* promptFidelity is kept as a legacy serialized alias; geometry fidelity is no longer reduced by this control. */
  spec.promptFidelity=freedom.stagingFreedom;
  spec.version=Math.max(3,Number(spec.version)||1);
  return spec.aiStaging;
}
function normalizeAIRenderingSettings(spec=S){
  const staging=normalizeAIStagingSettings(spec);
  const source=spec.aiRendering&&typeof spec.aiRendering==='object'?spec.aiRendering:{};
  source.schemaVersion=AI_RENDER_SCHEMA_VERSION;
  source.allowOptionalProps=staging.enabled;
  source.optionalPermissions={furniture:staging.enabled&&staging.allowFurniture,products:staging.enabled&&staging.allowProducts,
    plants:staging.enabled&&staging.allowPlants,people:staging.enabled&&staging.allowPeople,
    decor:staging.enabled&&staging.allowDecor,props:staging.enabled&&staging.allowDecor};
  source.renderStyle=aiRenderStyle(source.renderStyle).key;
  source.promptVariant=['full','compact'].includes(source.promptVariant)?source.promptVariant:'full';
  source.renderIntent=globalThis.YPAIRenderIntent?.normalizeIntent(source.renderIntent)||'from3d';
  source.quality=globalThis.YPAIRenderIntent?.normalizeQuality(source.quality)||'preview';
  source.camera=source.camera&&typeof source.camera==='object'?source.camera:null;
  source.preview=source.preview&&typeof source.preview==='object'?source.preview:null;
  spec.aiRendering=source;return source;
}
function defaultObjectAIRule(item){
  /* Every object in BoothSpec.objects was explicitly selected by the customer.
     Auto-Staging suggestions live in aiStaging.suggestions and never weaken this lock. */
  return{lockLevel:'LOCKED',geometryLocked:true,styleable:true,
    presenceRequired:true,optionalCategory:null,
    materialIntent:item?.color||'follow-current-scene',
    allowedChanges:['material','color','finish','reflection']};
}
function normalizeObjectAIRule(obj,item=objectCatalogDef(obj?.catalogId)){
  if(!obj||typeof obj!=='object')return null;
  const defaults=defaultObjectAIRule(item),source=obj.ai&&typeof obj.ai==='object'?obj.ai:{};
  source.lockLevel=AI_LOCK_LEVELS.includes(source.lockLevel)?source.lockLevel:defaults.lockLevel;
  source.geometryLocked=typeof source.geometryLocked==='boolean'?source.geometryLocked:defaults.geometryLocked;
  source.styleable=typeof source.styleable==='boolean'?source.styleable:defaults.styleable;
  source.presenceRequired=typeof source.presenceRequired==='boolean'?source.presenceRequired:defaults.presenceRequired;
  source.optionalCategory=AI_OPTIONAL_CATEGORIES.includes(source.optionalCategory)?source.optionalCategory:defaults.optionalCategory;
  source.materialIntent=String(source.materialIntent||defaults.materialIntent||'follow-current-scene');
  const requested=Array.isArray(source.allowedChanges)?source.allowedChanges:defaults.allowedChanges;
  source.allowedChanges=[...new Set(requested.filter(change=>AI_ALLOWED_CHANGES.includes(change)))];
  if(source.lockLevel!=='OPTIONAL'){source.presenceRequired=true;source.optionalCategory=null;}
  obj.ai=source;return source;
}
/* ================= AI geometry manifest =================
   Keep this data-only layer independent from the visual prompt. Geometry remains
   authoritative even when an object is STYLEABLE (appearance may change, transform may not). */
const manifestNumber=(value,digits=4)=>{
  const numeric=Number(value);return Number.isFinite(numeric)?+numeric.toFixed(digits):0;
};
const manifestVector=(x=0,y=0,z=0)=>({x:manifestNumber(x),y:manifestNumber(y),z:manifestNumber(z)});
const manifestSize=(width=0,depth=0,height=0)=>({width:manifestNumber(width),depth:manifestNumber(depth),height:manifestNumber(height)});
function manifestSemantics(lockLevel='LOCKED',options={}){
  const optional=lockLevel==='OPTIONAL',styleable=options.styleable!==false;
  const requested=Array.isArray(options.allowedChanges)?options.allowedChanges:
    (styleable?['material','color','finish','graphic','lighting','reflection']:[]);
  return{lockLevel:AI_LOCK_LEVELS.includes(lockLevel)?lockLevel:'LOCKED',geometryLocked:options.geometryLocked!==false,
    styleable,presenceRequired:optional?options.presenceRequired===true:options.presenceRequired!==false,
    optionalCategory:optional&&AI_OPTIONAL_CATEGORIES.includes(options.optionalCategory)?options.optionalCategory:null,
    materialIntent:String(options.materialIntent||'follow-current-scene'),
    allowedChanges:[...new Set(requested.filter(change=>AI_ALLOWED_CHANGES.includes(change)&&!['position','rotation','scale'].includes(change)))]};
}
function manifestBoothType(spec=S){
  const base=TYPES.find(item=>item.k===spec.type)||{k:spec.type,n:spec.type,walls:[]};
  if(base.k!=='corner')return{...base,walls:[...(base.walls||[])]};
  const side=CORNER_SIDES.find(item=>item.k===spec.cornerSide)||CORNER_SIDES[1];
  return{...base,n:base.n+' · '+side.n,walls:[...side.walls]};
}
function manifestWallNode(face,spec,typeDef,thickness,floorY){
  const common={id:'wall-'+face,type:'wall',name:WALL_FACES.find(item=>item.k===face)?.n||face,parentId:'booth-root',
    materialIntent:wallFinishKind(spec,face)==='sticker'?'preserve-selected-wall-graphic':'preserve-selected-wall-finish',
    semantics:manifestSemantics('LOCKED',{materialIntent:wallFinishKind(spec,face),
      allowedChanges:['material','color','finish','graphic','lighting','reflection']})};
  if(face==='back'&&spec.type==='photo360'){
    const curve=wallCurveInfo(spec);
    return{...common,geometry:{kind:'curved-wall',radius:manifestNumber(curve.radius),arcAngleRad:manifestNumber(curve.arcAngle),
      arcLength:manifestNumber(curve.arcLength),sagitta:manifestNumber(curve.sagitta),thickness:manifestNumber(thickness)},
      dimensions:manifestSize(curve.arcLength,thickness,spec.H),
      transform:{position:manifestVector(spec.W/2,floorY+spec.H/2,curve.sagitta/2),rotationDeg:manifestVector()},
      source:{kind:'derived',path:'BoothSpec.type/wallRadius'}};
  }
  const back=face==='back',width=back?spec.W:thickness,depth=back?thickness:spec.D;
  const x=face==='right'?spec.W-thickness/2:face==='left'?thickness/2:spec.W/2;
  const z=back?thickness/2:spec.D/2;
  return{...common,geometry:{kind:'box'},dimensions:manifestSize(width,depth,spec.H),
    transform:{position:manifestVector(x,floorY+spec.H/2,z),rotationDeg:manifestVector()},
    source:{kind:'derived',path:'BoothSpec.type/dimensions'}};
}
function manifestBrandTransform(spec,physical,floorY,thickness){
  if(spec.logoMount==='floor')return{position:manifestVector(spec.logoFloorX,floorY+.1+physical.height/2,spec.logoFloorZ),
    rotationDeg:manifestVector(0,spec.logoFloorRotation,0)};
  const face=spec.logoWall||'back',centerY=floorY+spec.logoWallY,depth=Number(spec.logoDepth)||.05;
  if(face==='back'&&spec.type==='photo360'){
    const curve=wallCurveInfo(spec),fraction=clampNumber(spec.logoWallU/Math.max(.001,curve.arcLength),0,1),angle=(fraction-.5)*curve.arcAngle;
    const centerX=curve.half+curve.radius*Math.sin(angle),point=curve.pointAtX(centerX,thickness/2+.012+depth/2);
    return{position:manifestVector(point.x,centerY,point.z),rotationDeg:manifestVector(0,point.rotationY*180/Math.PI,0),
      attachment:{face,curveDistance:manifestNumber(spec.logoWallU)}};
  }
  if(face==='left')return{position:manifestVector(thickness+.012+depth/2,centerY,spec.logoWallU),rotationDeg:manifestVector(0,90,0),attachment:{face}};
  if(face==='right')return{position:manifestVector(spec.W-thickness-.012-depth/2,centerY,spec.logoWallU),rotationDeg:manifestVector(0,-90,0),attachment:{face}};
  return{position:manifestVector(spec.logoWallU,centerY,thickness+.012+depth/2),rotationDeg:manifestVector(),attachment:{face}};
}
function manifestLightTransform(point,spec,thickness){
  const def=lightModelDef(),surface=thickness+FIXTURE_WALL_GAP,top=spec.H-(Number.isFinite(def?.topInset)?def.topInset:FIXTURE_TOP_INSET);
  if(point.w==='back'&&spec.type==='photo360'){
    const curve=wallCurveInfo(spec),p=curve.pointAt(point.u/spec.W,thickness/2+FIXTURE_WALL_GAP);
    return{position:manifestVector(p.x,top,p.z),rotationDeg:manifestVector(0,p.rotationY*180/Math.PI,0)};
  }
  if(point.w==='left')return{position:manifestVector(surface,top,point.u),rotationDeg:manifestVector(0,90,0)};
  if(point.w==='right')return{position:manifestVector(spec.W-surface,top,point.u),rotationDeg:manifestVector(0,-90,0)};
  return{position:manifestVector(point.u,top,surface),rotationDeg:manifestVector()};
}
function currentCameraManifest(spec=S){
  if(threeRenderer?.cameraManifest)return threeRenderer.cameraManifest();
  const saved=normalizeAIRenderingSettings(spec).camera;
  return saved?JSON.parse(JSON.stringify(saved)):null;
}
function manifestSceneCollision(obj,item){
  normalizeSceneObjectModel(obj,item);return{layer:obj.collision.layer,shapeMode:obj.collision.shapeMode,tolerance:manifestNumber(obj.collision.tolerance),
    shapes:sceneCollisionShapeDefinitions(obj,item).map(shape=>({id:shape.id,type:shape.type,dimensions:manifestSize(shape.size.w,shape.size.d,shape.size.h),
      offset:manifestVector(shape.offset.x,shape.offset.y,shape.offset.z)}))};
}
function manifestSceneAttachment(obj){
  if(!obj?.attachment?.targetId)return null;const attachment=obj.attachment;
  return{targetId:attachment.targetId,sourcePort:attachment.sourcePort,targetPort:attachment.targetPort,
    syncDimensions:[...(attachment.syncDimensions||[])],offset:manifestVector(attachment.offset?.x,attachment.offset?.y,attachment.offset?.z),status:attachment.status};
}
function buildGeometryManifest(spec=S){
  const typeDef=manifestBoothType(spec),walls=typeDef.walls||[],thickness=boothWallThickness(spec),floorY=(Number(spec.raise)||0)/100;
  const objects=[],push=node=>{objects.push(node);return node;};
  const slabHeight=floorY>0?floorY:.003,slabCenterY=floorY>0?floorY/2:-slabHeight/2;
  push({id:'booth-floor',type:'floor',name:'พื้นบูธ',parentId:'booth-root',geometry:{kind:'box'},
    dimensions:manifestSize(spec.W,spec.D,slabHeight),transform:{position:manifestVector(spec.W/2,slabCenterY,spec.D/2),rotationDeg:manifestVector()},
    materialIntent:(()=>{try{return floorName();}catch(e){return String(spec.floor||'floor');}})(),
    semantics:manifestSemantics('LOCKED',{materialIntent:String(spec.floor||'floor'),allowedChanges:['material','color','finish','graphic','lighting','reflection']}),
    source:{kind:'derived',path:'BoothSpec.W/D/raise/floor'}});
  walls.forEach(face=>push(manifestWallNode(face,spec,typeDef,thickness,floorY)));
  if(hasStore()){
    const panels=storagePanels(thickness),room=panels.G;
    const target=sceneTargetNode('storage-room',spec);
    push({id:'storage-room',type:'storage-room',name:'ห้องเก็บของ',parentId:'booth-root',geometry:{kind:'room',wallThickness:manifestNumber(STORAGE_ROOM_WALL_THICKNESS),panels:{front:true,back:panels.back,left:panels.left,right:panels.right},
      door:{face:spec.stDoor,type:spec.stDoorType,offset:spec.doorOff}},dimensions:manifestSize(room.w,room.d,room.h),ports:(target?.ports||[]).map(port=>({id:port.id,role:port.role,position:manifestVector(port.position.x,floorY+port.position.y,port.position.z)})),
      transform:{position:manifestVector(room.x+room.w/2,floorY+room.h/2,room.y+room.d/2),rotationDeg:manifestVector()},
      materialIntent:String(spec.stSurf||'paint')+':'+String(spec.stPaint||'wall'),
      semantics:manifestSemantics('LOCKED',{materialIntent:String(spec.stSurf||'paint'),allowedChanges:['material','color','finish','graphic','lighting','reflection']}),
      source:{kind:'derived',path:'BoothSpec.st*'}});
  }
  const platform=photo360PlatformLayout(spec);
  if(platform)push({id:'photo360-platform',type:'platform',name:'แท่นถ่ายภาพ 360',parentId:'booth-root',geometry:{kind:'cylinder',diameter:manifestNumber(platform.diameter)},
    dimensions:manifestSize(platform.diameter,platform.diameter,platform.height),
    transform:{position:manifestVector(platform.x,floorY+platform.height/2,platform.z),rotationDeg:manifestVector()},
    materialIntent:'dark-neutral-platform',semantics:manifestSemantics('LOCKED',{allowedChanges:['material','color','finish','lighting','reflection']}),
    source:{kind:'derived',path:'BoothSpec.type'}});
  const physical=brandPhysicalSize(spec),brandingVisible=spec.type!=='island'&&(brandScaleValue(spec.logoScale)>0||brandScaleValue(spec.nameScale)>0);
  if(brandingVisible){
    const transform=manifestBrandTransform(spec,physical,floorY,thickness);
    push({id:'branding-main',type:'branding',name:'โลโก้และชื่อแบรนด์',parentId:'booth-root',geometry:{kind:spec.logoShape||'cutout',mount:spec.logoMount||'wall'},
      dimensions:manifestSize(physical.width,Number(spec.logoDepth)||.05,physical.height),transform,
      materialIntent:'preserve-uploaded-logo-and-brand-identity',
      semantics:manifestSemantics('STYLEABLE',{materialIntent:'brand-identity',allowedChanges:['material','color','finish','graphic','lighting','reflection']}),
      source:{kind:'derived',path:'BoothSpec.logo* / brand'}});
    if(spec.logoMount==='floor'){
      const base=logoBaseSize(spec);
      push({id:'branding-base',type:'support-base',name:'ฐานโลโก้ตั้งพื้น',parentId:'branding-main',geometry:{kind:'box'},
        dimensions:manifestSize(base.width,base.depth,.1),transform:{position:manifestVector(spec.logoFloorX,floorY+.05,spec.logoFloorZ),rotationDeg:manifestVector(0,spec.logoFloorRotation,0)},
        materialIntent:String(spec.logoBaseColor||'#20252d'),semantics:manifestSemantics('LOCKED',{materialIntent:String(spec.logoBaseColor||'#20252d'),allowedChanges:['material','color','finish','reflection']}),
        source:{kind:'derived',path:'BoothSpec.logoBase*'}});
    }
  }
  if(spec.lights)lightPoints(thickness).forEach((point,index)=>push({id:'wall-light-'+String(index+1).padStart(2,'0'),type:'light-fixture',
    name:lightModelDef()?.n||'โคมไฟ',parentId:'booth-root',geometry:{kind:'fixture',catalogId:spec.lightFixture,attachmentFace:point.w,along:manifestNumber(point.u)},
    dimensions:null,transform:manifestLightTransform(point,spec,thickness),materialIntent:(LIGHTCOL.find(item=>item.k===spec.lightCol)?.n||spec.lightCol)+' '+String(spec.lightWatts)+'W',
    semantics:manifestSemantics('STYLEABLE',{materialIntent:'preserve-fixture-count-and-placement',allowedChanges:['material','color','finish','lighting','reflection']}),
    source:{kind:'derived',path:'BoothSpec.lights/light*'}}));
  (Array.isArray(spec.objects)?spec.objects:[]).forEach((obj,index)=>{
    const item=objectCatalogDef(obj.catalogId),size=obj.size||item?.size||{},position=obj.position||{},rule=normalizeObjectAIRule(obj,item);normalizeSceneObjectModel(obj,item);
    push({id:String(obj.id||'asset-'+(index+1)),type:String(obj.type||item?.type||'asset'),name:obj.label||item?.name||String(obj.catalogId||'Asset'),parentId:'booth-root',
      catalogId:obj.catalogId||null,geometry:{kind:isEntranceFrameObject(obj)?'entrance-frame':isDownlightBeamObject(obj)?'downlight-beam':'catalog-object',structure:obj.structure?JSON.parse(JSON.stringify(obj.structure)):null},
      dimensions:manifestSize(size.w,size.d,size.h),orientedBounds:(()=>{const oriented=sceneObjectOrientedSize(obj);return manifestSize(oriented.w,oriented.d,oriented.h);})(),
      transform:{position:manifestVector(position.x,floorY+(Number(position.y)||0),position.z),rotationDeg:manifestVector(obj.rotationX,obj.rotationY,obj.rotationZ),orientation:obj.orientation,
        scale:manifestVector(obj.transform?.flipX?-1:1,obj.transform?.flipY?-1:1,1),mirror:{leftRight:obj.transform?.flipX===true,topBottom:obj.transform?.flipY===true}},
      capabilities:{...obj.capabilities},placement:{...obj.placement},attachment:manifestSceneAttachment(obj),collision:manifestSceneCollision(obj,item),
      ports:localScenePorts(obj).map(port=>({id:port.id,role:port.role,localPosition:manifestVector(port.position.x,port.position.y,port.position.z)})),
      editorLocked:obj.locked===true,groupId:obj.groupId||null,appearance:{color:obj.appearance?.color||null,textureName:obj.appearance?.textureName||null},
      materialIntent:obj.appearance?.textureData?'asset-sticker: '+String(obj.appearance.textureName||'uploaded image'):(obj.appearance?.color||rule.materialIntent),
      semantics:{...JSON.parse(JSON.stringify(rule)),allowedChanges:rule.allowedChanges.filter(change=>!rule.geometryLocked||!['position','rotation','scale'].includes(change))},
      classification:{status:'Customer Selected / Confirmed Geometry',confirmed:true,countsAsSelectedAsset:true,includedInBOQ:true,includedInProductionScope:true,includedInConfirmedGeometry:true},
      source:{kind:'BoothSpec',path:'objects['+index+']'}});
  });
  const ai=normalizeAIRenderingSettings(spec),staging=normalizeAIStagingSettings(spec);
  return{schemaVersion:AI_RENDER_SCHEMA_VERSION,coordinateSystem:{origin:'back-left-floor',handedness:'right-handed',unit:'m',
      axes:{x:'left-to-right',y:'floor-to-up',z:'back-to-front'}},
